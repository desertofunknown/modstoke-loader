<Project>
  <PropertyGroup>
    <!-- Keep source and generated-document paths portable in release symbols. -->
    <PathMap>$(MSBuildProjectDirectory)=/_/$(MSBuildProjectName),$(MSBuildThisFileDirectory)=/_/Modstoke/</PathMap>
    <PathMap Condition="'$(ArtifactsPath)' != ''">$(ArtifactsPath)=/_/artifacts,$(PathMap)</PathMap>
  </PropertyGroup>

  <!--
    Loader components carry the loader version so the startup banner can name the build that runs.
    Keep ModstokeLoaderVersion equal to loader.manifest.json. AssemblyVersion stays at its 1.0.0.0
    default: installed mods bind to it, and raising or lowering it would break them until rebuilt.
    Pass -p:ModstokeBuildLabel=<label> to tell local builds apart; the SDK appends +<commit>.
  -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Modstoke.Loader' Or '$(MSBuildProjectName)' == 'Modstoke.Bootstrap' Or '$(MSBuildProjectName)' == 'Modstoke.Preloader' Or '$(MSBuildProjectName)' == 'Modstoke.Console'">
    <ModstokeLoaderVersion>0.4.1-net11-preview</ModstokeLoaderVersion>
    <FileVersion>0.4.1.0</FileVersion>
    <InformationalVersion>$(ModstokeLoaderVersion)</InformationalVersion>
    <InformationalVersion Condition="'$(ModstokeBuildLabel)' != ''">$(ModstokeLoaderVersion).$(ModstokeBuildLabel)</InformationalVersion>
  </PropertyGroup>
</Project>
