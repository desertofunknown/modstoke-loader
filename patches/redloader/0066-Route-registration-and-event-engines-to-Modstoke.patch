diff --git a/RedLoader/ModRegistrationDriver.cs b/RedLoader/ModRegistrationDriver.cs
new file mode 100644
--- /dev/null
+++ b/RedLoader/ModRegistrationDriver.cs
@@ -0,0 +1,65 @@
+// SPDX-License-Identifier: LGPL-2.1-only
+// Copyright (C) 2026 Alex Cooper
+
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Reflection;
+
+namespace RedLoader;
+
+internal interface IModRegistrationDriver
+{
+    List<Action> Callbacks { get; }
+    bool Register();
+    bool IsActive(List<Action> callbacks);
+    void InitializeMod();
+    void Unregister(string reason, bool silent);
+    void UnregisterInstance(string reason, bool silent);
+}
+
+internal interface IModRegistrationCallbacks
+{
+    void SetRegistered(bool registered);
+    void RegisterCallbacks();
+    void EarlyInitialize();
+    bool RegisterInternal();
+    void UnregisterInternal();
+    void Initialize();
+    void LateInitialize();
+    void Deinitialize();
+    void PrintLoadInfo();
+    void PrintUnloadInfo(string reason);
+    void SubscribeInitialization();
+    void SubscribeLateInitialization();
+}
+
+internal static class ModRegistrationDriverFactory
+{
+    private static readonly Lazy<Bindings> Owner = new(() => new Bindings());
+
+    internal static IModRegistrationDriver Create(ModBase mod) => Owner.Value.Create(mod);
+    internal static ModBase Find(string name, string author) => Owner.Value.Find(name, author);
+
+    private sealed class Bindings
+    {
+        internal readonly Func<ModBase, IModRegistrationDriver> Create;
+        internal readonly Func<string, string, ModBase> Find;
+
+        internal Bindings()
+        {
+            var owner = Assembly.Load("OpenACAI.Endnight.Loader.Core")
+                .GetType("OpenACAI.Endnight.Loader.OpenACAIRedLoaderRegistration", true);
+            Create = Bind<Func<ModBase, IModRegistrationDriver>>(owner, "Create");
+            Find = Bind<Func<string, string, ModBase>>(owner, "Find");
+        }
+
+        private static T Bind<T>(Type owner, string name) where T : Delegate
+        {
+            var parameters = typeof(T).GetMethod("Invoke").GetParameters().Select(parameter => parameter.ParameterType).ToArray();
+            var method = owner.GetMethod(name, BindingFlags.Static | BindingFlags.NonPublic, null, parameters, null)
+                ?? throw new MissingMethodException(owner.FullName, name);
+            return (T)method.CreateDelegate(typeof(T));
+        }
+    }
+}
diff --git a/RedLoader/Utils/Events/MelonEventDriver.cs b/RedLoader/Utils/Events/MelonEventDriver.cs
new file mode 100644
--- /dev/null
+++ b/RedLoader/Utils/Events/MelonEventDriver.cs
@@ -0,0 +1,45 @@
+// SPDX-License-Identifier: LGPL-2.1-only
+// Event contract adapted from RedLoader/MelonLoader's MelonEvent implementation.
+// Original implementation: RedLoader and MelonLoader contributors.
+
+using System;
+using System.Collections.Generic;
+using System.Reflection;
+
+namespace RedLoader
+{
+    internal interface IMelonEventDriver<T> where T : Delegate
+    {
+        bool Disposed { get; }
+        bool CheckIfSubscribed(MethodInfo method, object obj = null);
+        void Subscribe(T action, int priority, bool unsubscribeOnFirstInvocation, List<Action> rollback, Func<bool> canInvoke = null);
+        void Unsubscribe(T action);
+        void Unsubscribe(MethodInfo method, object obj = null);
+        void UnsubscribeAll();
+        MelonEventBase<T>.MelonEventSubscriber[] GetSubscribers();
+        void Invoke(Action<T> delegateInvoker);
+        MelonAction<T>[] BeginInvocation();
+        void InvokeSubscriber(MelonAction<T> subscriber, Action<T> delegateInvoker);
+        void Dispose();
+    }
+
+    internal static class MelonEventDriverFactory<T> where T : Delegate
+    {
+        private static readonly Lazy<Func<bool, IMelonEventDriver<T>>> factory = new(BindFactory);
+
+        internal static IMelonEventDriver<T> Create(bool oneTimeUse)
+        {
+            return factory.Value(oneTimeUse);
+        }
+
+        private static Func<bool, IMelonEventDriver<T>> BindFactory()
+        {
+            var assembly = Assembly.Load("OpenACAI.Endnight.Loader.Core");
+            var type = assembly.GetType("OpenACAI.Loader.OpenACAIRedLoaderEventDispatcher", throwOnError: true);
+            var method = type.GetMethod("Create", BindingFlags.Static | BindingFlags.NonPublic | BindingFlags.DeclaredOnly,
+                binder: null, types: new[] { typeof(bool) }, modifiers: null)
+                ?? throw new MissingMethodException(type.FullName, "Create");
+            return method.MakeGenericMethod(typeof(T)).CreateDelegate<Func<bool, IMelonEventDriver<T>>>();
+        }
+    }
+}
