+    private static TDelegate Bind<TDelegate>(string name, Type itemType = null) where TDelegate : Delegate
+    {
+        var owner = Assembly.Load("OpenACAI.Endnight.Loader.Preloader")
+            .GetType("OpenACAI.Endnight.Loader.Preloader.OpenACAIRedTypeDiscovery", true);
+        var method = owner.GetMethod(name, BindingFlags.NonPublic | BindingFlags.Static | BindingFlags.DeclaredOnly)
+            ?? throw new MissingMethodException(owner.FullName, name);
+        if (itemType != null)
+            method = method.MakeGenericMethod(itemType);
+        return (TDelegate)method.CreateDelegate(typeof(TDelegate));
+    }
