+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Reflection;
+using System.Runtime.CompilerServices;
+using System.Runtime.ExceptionServices;
+using System.Threading;
+using Il2CppInterop.Runtime.InteropTypes;
+using Il2CppInterop.Runtime.Runtime;
+
+namespace Il2CppInterop.Runtime.Injection;
+
+[AttributeUsage(AttributeTargets.Method)]
+internal sealed class NativeJobCallbackMethodAttribute : Attribute
+{
+    public NativeJobCallbackMethodAttribute() { }
+    public NativeJobCallbackMethodAttribute(bool allowsNullRanges) => AllowsNullRanges = allowsNullRanges;
+    public bool AllowsNullRanges { get; }
+}
+
+/// <summary>The native producer invocation contract used by a callback.</summary>
+public enum NativeJobCallbackKind
+{
+    /// <summary>A scheduled job requires valid payload and work-range storage.</summary>
+    Scheduled,
+    /// <summary>An animation producer must leave its possibly absent work-range argument unused.</summary>
+    Animation
+}
+
+/// <summary>Adapts a managed job producer callback to Unity's native reflection-invocation contract.</summary>
+/// <remarks>
+/// Creating a callback does not register or schedule a job. Use PayloadType as the data type and
+/// Target as the callback when creating job reflection data. Keep this object alive until native
+/// registration retains Target. Unity owns registered callbacks until its registration teardown;
+/// do not free reflection data when an individual job completes. Data identities are not published
+/// as general-purpose native CLR type identities.
+/// </remarks>
+public sealed unsafe partial class NativeJobCallback
+{
+    private static readonly object Gate = new();
+    private static readonly Dictionary<(Type, NativeJobCallbackKind), Binding> Bindings = new();
+    private readonly FailureState failure;
+    [ThreadStatic] private static int invocationDepth;
+    internal static bool IsInvoking => invocationDepth != 0;
+    internal static void EnterInvocation() => invocationDepth++;
+    internal static void ExitInvocation() => invocationDepth--;
+    internal Type ManagedPayloadType { get; }
+
+    private sealed record Binding(Type Type, ConstructorInfo Constructor, FieldInfo CallbackField, FieldInfo FailureField);
+
+    private NativeJobCallback(Il2CppSystem.Object target, Il2CppSystem.Type payloadType, Type managedPayloadType,
+        FailureState failure)
+    {
+        Target = target;
+        PayloadType = payloadType;
+        ManagedPayloadType = managedPayloadType;
+        this.failure = failure;
+    }
+
+    /// <summary>The native callback object, not a native delegate.</summary>
+    public Il2CppSystem.Object Target { get; }
+
+    /// <summary>Native data-layout identity of the callback argument, projected when it contains native containers.</summary>
+    public Il2CppSystem.Type PayloadType { get; }
+
+    /// <summary>The first managed failure across this callback's invocations, or null.</summary>
+    public Exception? FirstException => failure.FirstException;
+
+    /// <summary>Rethrows a recorded callback failure with its original stack after job completion.</summary>
+    public void ThrowIfFailed() => failure.ThrowIfFailed();
+    internal void RecordFailure(Exception error) => failure.Record(error);
+
+    /// <summary>Creates a callback for void(ref payload, IntPtr, IntPtr, ref JobRanges, int).</summary>
+    /// <param name="callback">A closed managed delegate; multicast invocation is preserved.</param>
+    /// <param name="attributeTypes">Explicit native marker-attribute mappings for the payload.</param>
+    public static NativeJobCallback Create(Delegate callback, IReadOnlyDictionary<Type, Type>? attributeTypes = null)
+        => Create(callback, NativeJobCallbackKind.Scheduled, attributeTypes);
+
+    /// <summary>Creates a callback with an explicit native producer invocation contract.</summary>
+    /// <remarks>Animation callbacks must not read or write their work-range reference. This does not own or schedule a graph.</remarks>
+    public static NativeJobCallback Create(Delegate callback, NativeJobCallbackKind kind,
+        IReadOnlyDictionary<Type, Type>? attributeTypes = null)
+    {
+        ArgumentNullException.ThrowIfNull(callback);
+        ValidateKind(kind);
+        var invoke = ValidateSignature(callback.GetType());
+        var managedPayload = invoke.GetParameters()[0].ParameterType.GetElementType()!;
+        var projection = NativeJobPayloadPlan.Get(managedPayload);
+        callback = NativeJobPayloadBridge.Adapt(callback, invoke, projection);
+        invoke = ValidateSignature(callback.GetType());
+        var parameters = invoke.GetParameters();
+        var payload = parameters[0].ParameterType.GetElementType()!;
+        var ranges = parameters[3].ParameterType.GetElementType()!;
+        // This also enforces the matched Unity/metadata/architecture contract before any injection.
+        var payloadClass = ValueTypeInjector.RegisterDataType(payload, attributeTypes);
+        var rangesClass = ResolveRanges(ranges);
+        var dataTypes = new Dictionary<Type, IntPtr> { [payload] = payloadClass };
+        if (ranges.IsValueType)
+        {
+            if (ranges == payload)
+                throw new ArgumentException("Job payload and JobRanges must be distinct types.", nameof(callback));
+            dataTypes.Add(ranges, rangesClass);
+        }
+
+        Binding binding;
+        lock (Gate)
+        {
+            var key = (callback.GetType(), kind);
+            if (!Bindings.TryGetValue(key, out binding!))
+            {
+                binding = EmitTarget(callback.GetType(), invoke, kind);
+                ClassInjector.RegisterTypeInIl2Cpp(binding.Type, new RegisterTypeOptions
+                {
+                    LogSuccess = false,
+                    DataTypes = dataTypes
+                });
+                Bindings.Add(key, binding);
+            }
+        }
+
+        var nativeType = new Il2CppSystem.Type(IL2CPP.il2cpp_type_get_object(IL2CPP.il2cpp_class_get_type(payloadClass)));
+        var pointer = IL2CPP.il2cpp_object_new(Il2CppClassPointerStore.GetNativeClassPointer(binding.Type));
+        if (pointer == IntPtr.Zero) throw new OutOfMemoryException("Native job callback allocation failed.");
+        var pin = IL2CPP.il2cpp_gchandle_new(pointer, true);
+        if (pin == IntPtr.Zero) throw new InvalidOperationException("Native job callback pinning failed.");
+        try
+        {
+            var target = (Il2CppObjectBase)binding.Constructor.Invoke(new object[] { pointer });
+            var state = new FailureState();
+            binding.CallbackField.SetValue(target, callback);
+            binding.FailureField.SetValue(target, state);
+
+            // The public wrapper/native registration roots the object. Its managed target must not
+            // root itself back through a strong native handle after we install its managed handle.
+            var owner = new Il2CppSystem.Object(target.Pointer);
+            target.UseWeakNativeReference();
+            ClassInjector.ProcessNewObject(target);
+            GC.KeepAlive(target);
+            return new NativeJobCallback(owner, nativeType, managedPayload, state);
+        }
+        finally
+        {
+            IL2CPP.il2cpp_gchandle_free(pin);
+        }
+    }
+
+    internal static void ValidateKind(NativeJobCallbackKind kind)
+    {
+        if (kind is not (NativeJobCallbackKind.Scheduled or NativeJobCallbackKind.Animation))
+            throw new ArgumentOutOfRangeException(nameof(kind));
+    }
+
+    internal static MethodInfo ValidateSignature(Type type)
+    {
+        var invoke = type.GetMethod("Invoke", BindingFlags.Instance | BindingFlags.Public | BindingFlags.DeclaredOnly);
+        if (!typeof(MulticastDelegate).IsAssignableFrom(type) || type.ContainsGenericParameters ||
+            invoke == null || invoke.ReturnType != typeof(void))
+            throw new ArgumentException("A closed managed void-returning job delegate is required.", nameof(type));
+        var parameters = invoke.GetParameters();
+        if (parameters.Length != 5 || !parameters[0].ParameterType.IsByRef ||
+            parameters[1].ParameterType != typeof(IntPtr) || parameters[2].ParameterType != typeof(IntPtr) ||
+            !parameters[3].ParameterType.IsByRef || parameters[4].ParameterType != typeof(int) ||
+            parameters.Any(parameter => parameter.IsIn || parameter.IsOut ||
+                parameter.GetRequiredCustomModifiers().Length != 0 || parameter.GetOptionalCustomModifiers().Length != 0))
+            throw new ArgumentException("Job callbacks require exactly (ref payload, IntPtr, IntPtr, ref JobRanges, int).", nameof(type));
+        var payload = parameters[0].ParameterType.GetElementType()!;
+        if (!payload.IsValueType || payload.IsByRefLike || payload.IsPrimitive || payload.IsEnum)
+            throw new ArgumentException("The job payload must be a composite CLR value type with a supported native representation.", nameof(type));
+        return invoke;
+    }
+
+    private static IntPtr ResolveRanges(Type managedType)
+    {
+        var nativeClass = IL2CPP.GetIl2CppClass("UnityEngine.CoreModule.dll", "Unity.Jobs.LowLevel.Unsafe", "JobRanges");
+        if (nativeClass == IntPtr.Zero)
+            throw new NotSupportedException("The native JobRanges value class is unavailable.");
+        InjectorHelpers.InitializeClass((Il2CppClass*)nativeClass);
+        if (!IL2CPP.il2cpp_class_is_valuetype(nativeClass) || IL2CPP.il2cpp_class_has_references(nativeClass))
+            throw new NotSupportedException("Native JobRanges is not a reference-free value class.");
+        if (typeof(Il2CppSystem.ValueType).IsAssignableFrom(managedType))
+        {
+            if (Il2CppClassPointerStore.GetNativeClassPointer(managedType) != nativeClass)
+                throw new NotSupportedException("The callback ranges proxy does not identify native JobRanges.");
+            RuntimeHelpers.RunClassConstructor(typeof(NativeValueReference<>).MakeGenericType(managedType).TypeHandle);
+            return nativeClass;
+        }
+
+        var layout = ManagedValueLayout.Create(managedType);
+        uint alignment = 0;
+        if (IL2CPP.il2cpp_class_value_size(nativeClass, ref alignment) != layout.Size ||
+            alignment != layout.Alignment || IL2CPP.il2cpp_class_array_element_size(nativeClass) != layout.Size)
+            throw new NotSupportedException("The callback ranges size or alignment differs from native JobRanges.");
+        var fields = layout.Fields.ToDictionary(field => field.Field.Name, StringComparer.Ordinal);
+        var iterator = IntPtr.Zero;
+        while (IL2CPP.il2cpp_class_get_fields(nativeClass, ref iterator) is var field && field != IntPtr.Zero)
+        {
+            if (((FieldAttributes)IL2CPP.il2cpp_field_get_flags(field) & FieldAttributes.Static) != 0) continue;
+            var name = IL2CPP.il2cpp_field_get_name_(field);
+            if (name == null || !fields.Remove(name, out var managedField) ||
