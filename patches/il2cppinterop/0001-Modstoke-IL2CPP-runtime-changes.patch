+++ b/Il2CppInterop.Native/ParticleTriggerInvokers.cpp
@@ -0,0 +1,109 @@
+// SPDX-License-Identifier: LGPL-3.0-only
+#include <cstddef>
+#include <cstdint>
+
+#if defined(_WIN32)
+#define INTEROP_EXPORT extern "C" __declspec(dllexport)
+#else
+#define INTEROP_EXPORT extern "C" __attribute__((visibility("default")))
+#endif
+
+namespace
+{
+    struct TriggerFrame
+    {
+        void* call;
+        void* createHandle;
+        void* system;
+        void* particles;
+        void* colliders;
+        void* indices;
+        void* starts;
+        std::intptr_t colliderHandle;
+        std::intptr_t indexHandle;
+        std::intptr_t startHandle;
+        std::int32_t type;
+        std::int32_t count;
+        std::uint32_t status;
+        std::uint32_t rootMask;
+    };
+
+    static_assert(sizeof(void*) == 8);
+    static_assert(offsetof(TriggerFrame, colliders) == 32);
+    static_assert(offsetof(TriggerFrame, indices) == 40);
+    static_assert(offsetof(TriggerFrame, starts) == 48);
+    static_assert(offsetof(TriggerFrame, colliderHandle) == 56);
+    static_assert(offsetof(TriggerFrame, indexHandle) == 64);
+    static_assert(offsetof(TriggerFrame, startHandle) == 72);
+    static_assert(offsetof(TriggerFrame, type) == 80);
+    static_assert(offsetof(TriggerFrame, count) == 84);
+    static_assert(offsetof(TriggerFrame, status) == 88);
+    static_assert(offsetof(TriggerFrame, rootMask) == 92);
+    static_assert(sizeof(TriggerFrame) == 96);
+
+    using CreateHandle = std::intptr_t (*)(void*, bool);
+
+    bool Retain(void* array, std::intptr_t& handle, CreateHandle createHandle) noexcept
+    {
+        if (array == nullptr) return true;
+        try
+        {
+            handle = createHandle(array, true);
+            return handle != 0;
+        }
+        catch (...)
+        {
+            // Root allocation must not replace an exception from the Unity call.
+            // The mask reports incomplete capture to CLR; no unrooted value is published.
+            return false;
+        }
+    }
+
+    void Capture(TriggerFrame* frame, void** arrays) noexcept
+    {
+        const auto createHandle = reinterpret_cast<CreateHandle>(frame->createHandle);
+        frame->colliders = arrays[0];
+        frame->indices = arrays[1];
+        frame->starts = arrays[2];
+        if (Retain(arrays[0], frame->colliderHandle, createHandle)) frame->rootMask |= 1;
+        if (Retain(arrays[1], frame->indexHandle, createHandle)) frame->rootMask |= 2;
+        if (Retain(arrays[2], frame->startHandle, createHandle)) frame->rootMask |= 4;
+        frame->status = frame->rootMask == 7 ? 2 : 1;
+    }
+
+    void CallTriggers(TriggerFrame* frame)
+    {
+        // Native stack slots keep all three references visible during allocations and
+        // unwinding. Input int arrays are borrowed by Unity; never clone or de-alias them.
+        void* arrays[3]{frame->colliders, frame->indices, frame->starts};
+        try
+        {
+            frame->count = reinterpret_cast<std::int32_t (*)(void*, std::int32_t, void*, void**)>(
+                frame->call)(frame->system, frame->type, frame->particles, arrays);
+        }
+        catch (...)
+        {
+            // Even argument errors can publish arrays. Retain the actual final slots
+            // before unwinding into il2cpp_runtime_invoke, including partial publication.
+            Capture(frame, arrays);
+            throw;
+        }
+        Capture(frame, arrays);
+    }
+
+    void InvokeTriggers(void* method, const void*, void*, void** args, void*)
+    {
+        reinterpret_cast<void (*)(TriggerFrame*)>(method)(*static_cast<TriggerFrame**>(args[0]));
+    }
+}
+
+INTEROP_EXPORT void* Il2CppInterop_GetParticleTriggerEntry(std::uint32_t abi, std::uint32_t entry)
+{
+    if (abi != 1) return nullptr;
+    switch (entry)
+    {
+        case 0: return reinterpret_cast<void*>(&CallTriggers);
+        case 1: return reinterpret_cast<void*>(&InvokeTriggers);
+        default: return nullptr;
+    }
+}
