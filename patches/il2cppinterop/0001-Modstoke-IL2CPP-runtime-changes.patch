new file mode 100644
index 0000000..6c922b1
--- /dev/null
+++ b/Il2CppInterop.Runtime/Injection/NativeJobTransformAccess.cs
@@ -0,0 +1,70 @@
+using System;
+using System.Runtime.CompilerServices;
+using System.Threading;
+
+namespace Il2CppInterop.Runtime.Injection;
+
+internal static unsafe class NativeJobTransformAccess<TTransforms> where TTransforms : struct
+{
+    private static readonly object Gate = new();
+    private static readonly Lazy<bool> ManagedLayoutValid = new(ValidateManagedLayout);
+    private static NativeValidation? validated;
+
+    internal static IntPtr Read(in TTransforms transforms, NativeJobBindings binding)
+    {
+        if (binding == null) throw new ArgumentNullException(nameof(binding));
+        _ = ManagedLayoutValid.Value;
+        var validation = Volatile.Read(ref validated);
+        if (validation == null)
+        {
+            lock (Gate)
+            {
+                validation = validated;
+                if (validation == null)
+                {
+                    var nativeClass = IL2CPP.GetIl2CppClass("UnityEngine.CoreModule.dll", "UnityEngine.Jobs",
+                        "TransformAccessArray");
+                    if (nativeClass == IntPtr.Zero ||
+                        nativeClass != Il2CppClassPointerStore<TTransforms>.NativeClassPtr)
+                        throw new NotSupportedException("TransformAccessArray does not have the expected native class identity.");
+                    NativeJobBindings.ValidateLayout(nativeClass, 8,
+                        ("m_TransformArray", 0, Il2CppClassPointerStore<IntPtr>.NativeClassPtr));
+                    validation = new NativeValidation(binding, nativeClass);
+                    Volatile.Write(ref validated, validation);
+                }
+            }
+        }
+
+        if (!ReferenceEquals(validation.Binding, binding) ||
+            Il2CppClassPointerStore<TTransforms>.NativeClassPtr != validation.NativeClass)
+            throw new NotSupportedException("TransformAccessArray native binding or class identity has changed.");
+
+        var pointer = Unsafe.As<TTransforms, IntPtr>(ref Unsafe.AsRef(in transforms));
+        if (pointer == IntPtr.Zero)
+            throw new ArgumentException("TransformAccessArray is disposed or default.", nameof(transforms));
+        return pointer;
+    }
+
+    private static bool ValidateManagedLayout()
+    {
+        var type = typeof(TTransforms);
+        if (type.FullName != "UnityEngine.Jobs.TransformAccessArray" ||
+            type.Assembly.GetName().Name != "UnityEngine.CoreModule" ||
+            !type.IsValueType || type.ContainsGenericParameters ||
+            (!type.IsLayoutSequential && !type.IsExplicitLayout) ||
+            RuntimeHelpers.IsReferenceOrContainsReferences<TTransforms>() ||
+            Unsafe.SizeOf<TTransforms>() != IntPtr.Size)
+            throw new NotSupportedException("TransformAccessArray must be the reference-free CoreModule CLR value type.");
+
+        var layout = ManagedValueLayout.Create(type);
+        if (layout.Size != 8 || layout.Alignment != 8 || layout.Fields.Count != 1)
+            throw new NotSupportedException("TransformAccessArray CLR layout differs from the inspected x64 contract.");
+        var field = layout.Fields[0];
+        if (field.Field.Name != "m_TransformArray" || field.Field.FieldType != typeof(IntPtr) ||
+            field.Offset != 0 || field.Layout.Size != 8 || field.Layout.Alignment != 8)
+            throw new NotSupportedException("TransformAccessArray CLR field differs from the expected pointer layout.");
+        return true;
+    }
+
+    private sealed record NativeValidation(NativeJobBindings Binding, IntPtr NativeClass);
+}
