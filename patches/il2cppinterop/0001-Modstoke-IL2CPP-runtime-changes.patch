+// SPDX-License-Identifier: LGPL-3.0-only
+#include <cstddef>
+#include <cstdint>
+#include <cstdlib>
+#include <limits>
+
+#if defined(_WIN32)
+#define INTEROP_EXPORT extern "C" __declspec(dllexport)
+#else
+#define INTEROP_EXPORT extern "C" __attribute__((visibility("default")))
+#endif
+
+namespace
+{
+    struct DisplayFields
+    {
+        std::uint64_t handle;
+        std::int32_t width;
+        std::int32_t height;
+        std::uint32_t refreshNumerator;
+        std::uint32_t refreshDenominator;
+        std::int32_t workX;
+        std::int32_t workY;
+        std::int32_t workWidth;
+        std::int32_t workHeight;
+    };
+
+    struct DisplayInfo
+    {
+        DisplayFields fields;
+        void* name;
+    };
+
+    struct LayoutEntry
+    {
+        DisplayFields fields;
+        std::intptr_t nameHandle;
+    };
+
+    struct LayoutFrame
+    {
+        void* getDisplays;
+        void* convert;
+        void* createHandle;
+        void* freeHandle;
+        void** managerSlot;
+        LayoutEntry* entries;
+        std::int32_t count;
+        std::int32_t retained;
+        std::uint32_t status;
+    };
+
+    static_assert(sizeof(void*) == 8);
+    static_assert(sizeof(DisplayFields) == 40);
+    static_assert(offsetof(DisplayInfo, name) == 40);
+    static_assert(sizeof(DisplayInfo) == 48);
+    static_assert(sizeof(LayoutEntry) == 48);
+    static_assert(offsetof(LayoutFrame, managerSlot) == 32);
+    static_assert(offsetof(LayoutFrame, entries) == 40);
+    static_assert(offsetof(LayoutFrame, count) == 48);
+    static_assert(offsetof(LayoutFrame, retained) == 52);
+    static_assert(offsetof(LayoutFrame, status) == 56);
+    static_assert(sizeof(LayoutFrame) == 64);
+
+    void ReadLayout(LayoutFrame* frame)
+    {
+        frame->status = 1;
+        auto* manager = static_cast<std::byte*>(*frame->managerSlot);
+        if (manager == nullptr) return;
+        auto* vector = reinterpret_cast<std::byte* (*)(void*)>(frame->getDisplays)(manager + 0xA0);
+        if (vector == nullptr) return;
+        auto* data = *reinterpret_cast<std::byte**>(vector);
+        const auto count = *reinterpret_cast<std::uint64_t*>(vector + 0x10);
+        if (count > static_cast<std::uint64_t>(std::numeric_limits<std::int32_t>::max()) ||
+            count > std::numeric_limits<std::size_t>::max() / 80 ||
+            count > std::numeric_limits<std::size_t>::max() / sizeof(LayoutEntry) ||
+            (count != 0 && data == nullptr)) return;
+        frame->count = static_cast<std::int32_t>(count);
+        if (count == 0)
+        {
+            frame->status = 2;
+            return;
+        }
+        frame->entries = static_cast<LayoutEntry*>(std::calloc(static_cast<std::size_t>(count), sizeof(LayoutEntry)));
+        if (frame->entries == nullptr) return;
+
+        const auto convert = reinterpret_cast<DisplayInfo* (*)(DisplayInfo*, void*)>(frame->convert);
+        const auto createHandle = reinterpret_cast<std::intptr_t (*)(void*, bool)>(frame->createHandle);
+        // The engine cache and names are borrowed until a window event invalidates them.
+        // Finish copying on the main thread without yielding or entering a CLR callback.
+        for (std::int32_t i = 0; i < frame->count; ++i)
+        {
+            DisplayInfo display{};
+            convert(&display, data + static_cast<std::size_t>(i) * 80);
+            auto& entry = frame->entries[i];
+            entry.fields = display.fields;
+            if (display.name != nullptr)
+            {
+                entry.nameHandle = createHandle(display.name, true);
+                if (entry.nameHandle == 0) return;
+            }
+            frame->retained = i + 1;
+        }
+        frame->status = 2;
+    }
+
+    void ReleaseLayout(LayoutFrame* frame) noexcept
+    {
+        if (frame->entries == nullptr) return;
+        const auto freeHandle = reinterpret_cast<void (*)(std::intptr_t)>(frame->freeHandle);
+        for (std::int32_t i = 0; i < frame->retained; ++i)
+            if (frame->entries[i].nameHandle != 0) freeHandle(frame->entries[i].nameHandle);
+        std::free(frame->entries);
+        frame->entries = nullptr;
+        frame->retained = 0;
+    }
+
+    void InvokeLayout(void* method, const void*, void*, void** args, void*)
+    {
+        reinterpret_cast<void (*)(LayoutFrame*)>(method)(*static_cast<LayoutFrame**>(args[0]));
+    }
+}
+
+INTEROP_EXPORT void* Il2CppInterop_GetScreenLayoutEntry(std::uint32_t abi, std::uint32_t entry)
+{
+    if (abi != 1) return nullptr;
+    switch (entry)
+    {
+        case 0: return reinterpret_cast<void*>(&ReadLayout);
+        case 1: return reinterpret_cast<void*>(&InvokeLayout);
+        case 2: return reinterpret_cast<void*>(&ReleaseLayout);
+        default: return nullptr;
+    }
+}
