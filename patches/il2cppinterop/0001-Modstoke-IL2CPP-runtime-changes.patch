+                        Arguments = (IntPtr)arguments, NamedCount = checked((uint)properties.Length), NamedProperties = (IntPtr)named
+                    };
+                }
+                native[i] = new NativeEntry
+                {
+                    Owner = entry.Owner, Kind = entry.Kind, Position = entry.Position,
+                    Count = checked((uint)entry.Attributes.Length), Attributes = (IntPtr)declarations
+                };
+            }
+            try
+            {
+                ValueTypeAttributes.InstallHooks();
