+
+    internal void RequireContext()
+    {
+        if (!retained || disposed || !runtime.NativeJobsReady || !ReferenceEquals(runtime, Il2CppInteropRuntime.Instance) ||
+            domain != IL2CPP.il2cpp_domain_get() || IL2CPP.il2cpp_thread_current() == IntPtr.Zero)
+            throw new InvalidOperationException("WWW requires its retained graph and original attached native domain.");
+    }
+
+    internal void Retain()
+    {
+        if (disposed) throw new ObjectDisposedException(nameof(NativeWwwMetadata));
+        if (retained) return;
+        runtime.RetainNativeJob();
+        retained = true;
+        try { RequireContext(); }
+        catch { retained = false; runtime.ReleaseNativeJob(); throw; }
+        RetainMethods();
+        RetainAttributes();
+        imageOwner!.Retain();
+    }
+
+    internal void PublishImage(IntPtr query, IntPtr player)
+    {
+        RequireContext();
+        imageOwner!.Publish(query, player, domain);
+    }
+
+    internal void InitializeBase(Il2CppObjectBase receiver)
+    {
+        try
+        {
+            RequireContext();
+            if (receiver == null) throw new NullReferenceException("The native WWW receiver is null.");
+            var self = receiver.Pointer;
+            if (self == IntPtr.Zero) throw new NullReferenceException("The native WWW receiver is null.");
+            var actualClass = IL2CPP.il2cpp_object_get_class(self);
+            if (!IL2CPP.il2cpp_class_is_assignable_from(Class, actualClass) ||
+                !IL2CPP.il2cpp_class_is_assignable_from(nativeBase, actualClass))
+                throw new InvalidCastException("The native WWW constructor requires a compatible WWW receiver.");
+            var exception = IntPtr.Zero;
+            IL2CPP.il2cpp_runtime_invoke(baseConstructor, self, null, ref exception);
+            Il2CppException.RaiseExceptionIfNecessary(exception);
+        }
