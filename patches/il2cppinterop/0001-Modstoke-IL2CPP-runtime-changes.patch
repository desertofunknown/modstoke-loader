+    public static IntPtr RequirePublishedClass()
+    {
+        lock (Gate) return RequireGraph().Class;
+    }
+
+    /// <summary>Runs the original Texture constructor on an existing MovieTexture receiver.</summary>
+    public static void InitializeTextureBase(Il2CppObjectBase receiver)
+    {
+        NativeMovieTextureMetadata graph;
+        lock (Gate) graph = RequireGraph();
+        graph.InitializeTextureBase(receiver);
+    }
+
+    /// <summary>Binds all restored bodies atomically before the generated wrapper can allocate instances.</summary>
+    public static void BindBodies<T>(IntPtr nativeClass, Action featureRemoved, Action<T> initialize,
+        Action<T> play, Action<T> stop, Action<T> pause, Func<T, Il2CppObjectBase> audioClip,
+        Func<T, bool> getLoop, Action<T, bool> setLoop, Func<T, bool> isPlaying,
+        Func<T, bool> isReadyToPlay, Func<T, float> duration) where T : Il2CppObjectBase
+    {
+        lock (Gate) RequireGraph().BindBodies(nativeClass, featureRemoved, initialize, play, stop, pause,
+            audioClip, getLoop, setLoop, isPlaying, isReadyToPlay, duration);
+    }
+
+    /// <summary>Requires the initial attached bootstrap thread, before any MovieTexture class-pointer store is used.</summary>
+    public static void PublishDuringBootstrap(IntPtr query)
+    {
+        var window = NativeTypePublication.GetWindow(query);
+        lock (Gate)
+        {
+            failure?.Throw();
+            if (published != null)
