+                    ("NavMeshBuildSource", graph.Source), ("NavMeshBuildMarkup", graph.Markup),
+                    ("NavMeshBuildSourceShape", graph.SourceShape), ("NavMeshCollectGeometry", graph.CollectGeometry),
