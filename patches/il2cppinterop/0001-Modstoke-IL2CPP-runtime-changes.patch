+    private IReadOnlyList<NativeJob> CollectDependencies()
+    {
+        var direct = Volatile.Read(ref dependencies);
+        if (direct.Length == 0) return Array.Empty<NativeJob>();
+        var graph = new List<NativeJob>();
+        var seen = new HashSet<NativeJob>();
+        foreach (var dependency in direct)
+            if (seen.Add(dependency)) graph.Add(dependency);
+        for (var index = 0; index < graph.Count; index++)
+            foreach (var dependency in Volatile.Read(ref graph[index].dependencies))
+                if (seen.Add(dependency)) graph.Add(dependency);
+        // Retire leaves before parents, so a completed parent never retains unfinished cleanup.
+        graph.Sort(static (left, right) => left.Order.CompareTo(right.Order));
+        return graph;
+    }
+
+    private NativeJobExecution? FindFailure()
+    {
+        if (Volatile.Read(ref completed)) return completionFailure;
+        if (Execution?.FirstException != null) return Execution;
+        if (dependencyFailure != null) return dependencyFailure;
+        foreach (var dependency in CollectDependencies())
+        {
+            var error = Volatile.Read(ref dependency.completed)
+                ? dependency.completionFailure
+                : dependency.Execution?.FirstException != null ? dependency.Execution : dependency.dependencyFailure;
+            if (error != null) return error;
+        }
+        // Another completion may have replaced the graph with its cached failure while we read it.
+        return Volatile.Read(ref completed) ? completionFailure : null;
+    }
+
+    private NativeJobExecution? CaptureCompletedFailure()
+    {
+        if (Execution?.FirstException != null) return Execution;
+        if (dependencyFailure != null) return dependencyFailure;
+        // Published owners retire leaves first, so each direct dependency has already
+        // cached its graph failure. Do not allocate while releasing native ownership.
+        foreach (var dependency in dependencies)
+            if (Volatile.Read(ref dependency.completed) && dependency.completionFailure != null)
+                return dependency.completionFailure;
+        return null;
+    }
+}
