+        else if (element == typeof(char)) il.Emit(OpCodes.Call, Method(nameof(CharacterReference)));
+        return true;
+    }
+
+    private bool AllowsNull(int index) => allowNullJobRanges && index == 3;
+
+    internal void WriteBack(LocalBuilder failed, string method, LocalBuilder? failureFrame = null)
+    {
+        foreach (var reference in references)
+        {
+            if (reference == null) continue;
+            var next = il.DefineLabel();
+            il.Emit(OpCodes.Ldloc, reference.OwnsStorage);
+            il.Emit(OpCodes.Brfalse, next);
+            il.BeginExceptionBlock();
+            il.Emit(OpCodes.Ldarg, (short)reference.NativeIndex);
+            il.Emit(OpCodes.Conv_I);
+            il.Emit(OpCodes.Ldloc, reference.Address);
+            il.Emit(OpCodes.Ldind_Ref);
+            if (reference.IsNativeValue)
+            {
+                il.Emit(OpCodes.Call, ValueMethod(reference.Element, nameof(NativeValueReference<Il2CppObjectBase>.Write)));
+            }
+            else
+            {
+                il.Emit(OpCodes.Call, reference.Element == typeof(string)
+                    ? typeof(IL2CPP).GetMethod(nameof(IL2CPP.ManagedStringToIl2Cpp))!
+                    : typeof(IL2CPP).GetMethod(nameof(IL2CPP.Il2CppObjectBaseToPtr))!);
+                il.Emit(OpCodes.Call, Method(nameof(StoreReference)));
+            }
+            il.Emit(OpCodes.Ldloc, reference.Address);
+            il.Emit(OpCodes.Ldind_Ref);
+            il.Emit(OpCodes.Call, typeof(GC).GetMethod(nameof(GC.KeepAlive))!);
+            il.BeginCatchBlock(typeof(Exception));
+            il.Emit(OpCodes.Ldstr, method);
+            il.Emit(OpCodes.Ldc_I4, reference.Index * 2 + 1);
+            EmitExceptionReport(il, failureFrame);
+            il.Emit(OpCodes.Ldc_I4_1);
+            il.Emit(OpCodes.Stloc, failed);
+            il.EndExceptionBlock();
+            il.MarkLabel(next);
+        }
+    }
+
+    internal static void EmitPhase(ILGenerator il, LocalBuilder phase, int value)
+    {
+        il.Emit(OpCodes.Ldc_I4, value);
+        il.Emit(OpCodes.Stloc, phase);
+    }
+
+    internal static void EmitCatch(ILGenerator il, string method, LocalBuilder phase, LocalBuilder? failureFrame = null)
+    {
+        il.BeginCatchBlock(typeof(Exception));
+        il.Emit(OpCodes.Ldstr, method);
+        il.Emit(OpCodes.Ldloc, phase);
+        EmitExceptionReport(il, failureFrame);
+    }
+
+    private static void EmitExceptionReport(ILGenerator il, LocalBuilder? failureFrame)
+    {
+        if (failureFrame == null)
+            il.Emit(OpCodes.Call, Method(nameof(ReportException)));
+        else
+        {
+            il.Emit(OpCodes.Ldloc, failureFrame);
+            il.Emit(OpCodes.Call, Method(nameof(ReportDelegateException)));
+        }
+    }
+
+    private static MethodInfo Method(string name) => typeof(NativeCallbackReferences)
+        .GetMethod(name, BindingFlags.Static | BindingFlags.NonPublic)!;
+
+    private static MethodInfo ValueMethod(Type element, string name) => typeof(NativeValueReference<>)
+        .MakeGenericType(element).GetMethod(name, BindingFlags.Static | BindingFlags.NonPublic)!;
+
+    private static ref bool BooleanReference(ref byte value) => ref Unsafe.As<byte, bool>(ref value);
+
+    private static ref char CharacterReference(ref ushort value) => ref Unsafe.As<ushort, char>(ref value);
+
+    private static void RequireAddress(IntPtr address)
+    {
+        if (address == IntPtr.Zero) throw new ArgumentNullException(nameof(address), "Native reference storage is null.");
+    }
+
+    private static void StoreReference(IntPtr address, IntPtr value) =>
+        IL2CPP.il2cpp_gc_wbarrier_set_field(IntPtr.Zero, address, value);
+
+    private static void ReportException(Exception error, string method, int phase)
+    {
+        try
+        {
+            var description = phase switch
+            {
+                -1 => "receiver conversion",
+                -2 => "managed callback",
+                -3 => "return conversion",
+                _ => "argument " + phase / 2 + (phase % 2 == 0 ? " conversion" : " writeback")
+            };
+            Logger.Instance.LogError(error, "Exception in native-to-managed callback {Method}, phase: {Phase}", method, description);
+        }
+        catch
+        {
+            // Diagnostics must never throw across the native callback boundary.
+        }
+    }
+
+    private static void ReportDelegateException(Exception error, string method, int phase, IntPtr failureFrame)
+    {
+        if (!NativeCallbackExceptions.TryCapture(failureFrame, error)) ReportException(error, method, phase);
+    }
+}
