diff --git a/Il2CppInterop.Runtime/Injection/ValueTypeAttributes.cs b/Il2CppInterop.Runtime/Injection/ValueTypeAttributes.cs
new file mode 100644
index 0000000..927a0f8
--- /dev/null
+++ b/Il2CppInterop.Runtime/Injection/ValueTypeAttributes.cs
@@ -0,0 +1,88 @@
+using System;
+using System.Collections.Concurrent;
+using System.Collections.Generic;
+using System.Linq;
+using System.Reflection;
+using System.Runtime.CompilerServices;
+using System.Runtime.InteropServices;
+
+namespace Il2CppInterop.Runtime.Injection;
+
+// Presence queries only. These records do not pretend to be native custom-attribute blobs.
+internal static class ValueTypeAttributes
+{
+    private static readonly ConcurrentDictionary<IntPtr, IntPtr[]> Classes = new();
+    private static readonly ConcurrentDictionary<IntPtr, IntPtr[]> Fields = new();
+    private static readonly PresenceHook ClassHook = new("il2cpp_class_has_attribute", Classes);
+    private static readonly PresenceHook FieldHook = new("il2cpp_field_has_attribute", Fields);
+
+    internal static void InstallHooks()
+    {
+        ClassHook.ApplyHook();
+        FieldHook.ApplyHook();
+    }
+
+    internal static void AddClass(IntPtr pointer, IntPtr[] attributes) => Classes[pointer] = attributes;
+    internal static void AddField(IntPtr pointer, IntPtr[] attributes) => Fields[pointer] = attributes;
+    internal static void RemoveClass(IntPtr pointer) => Classes.TryRemove(pointer, out _);
+    internal static void RemoveField(IntPtr pointer) => Fields.TryRemove(pointer, out _);
+
+    internal static IntPtr[] Resolve(MemberInfo member, IReadOnlyDictionary<Type, Type>? mappings)
+    {
+        var result = new HashSet<IntPtr>();
+        foreach (var attribute in member.CustomAttributes)
+        {
+            var type = attribute.AttributeType;
+            if (IsLayoutAttribute(type)) continue;
+            if (mappings == null || !mappings.TryGetValue(type, out var proxyType))
+                throw new NotSupportedException($"Attribute {type} on {member} needs an explicit native attribute mapping.");
+            if (!typeof(Il2CppSystem.Attribute).IsAssignableFrom(proxyType))
+                throw new ArgumentException($"Attribute mapping for {type} must name an IL2CPP attribute proxy.", nameof(mappings));
+
+            var pointer = Il2CppClassPointerStore.GetNativeClassPointer(proxyType);
+            if (pointer == IntPtr.Zero || !IL2CPP.il2cpp_class_is_assignable_from(
+                    Il2CppClassPointerStore<Il2CppSystem.Attribute>.NativeClassPtr, pointer))
+                throw new NotSupportedException($"Attribute mapping for {type} has no native attribute identity.");
+            // Only marker attributes have a complete contract here; values require native blobs.
+            if (attribute.ConstructorArguments.Count != 0 || attribute.NamedArguments.Count != 0)
+                throw new NotSupportedException($"Attribute {type} on {member} has values that cannot be represented by a presence mapping.");
+            result.Add(pointer);
+        }
+        return result.OrderBy(pointer => pointer.ToInt64()).ToArray();
+    }
+
+    internal static bool IsLayoutAttribute(Type type) =>
+        type == typeof(StructLayoutAttribute) || type == typeof(FieldOffsetAttribute) ||
+        type == typeof(CompilerGeneratedAttribute) || type == typeof(IsReadOnlyAttribute) ||
+        type == typeof(NonSerializedAttribute);
+
+    private sealed class PresenceHook : Hook<PresenceHook.MethodDelegate>
+    {
+        private readonly ConcurrentDictionary<IntPtr, IntPtr[]> _records;
+
+        internal PresenceHook(string export, ConcurrentDictionary<IntPtr, IntPtr[]> records)
+        {
+            TargetMethodName = export;
+            _records = records;
+        }
+
+        public override string TargetMethodName { get; }
+        public override MethodDelegate GetDetour() => Query;
+        public override IntPtr FindTargetMethod() => InjectorHelpers.GetIl2CppExport(TargetMethodName);
+
+        [UnmanagedFunctionPointer(CallingConvention.Cdecl)]
+        internal delegate byte MethodDelegate(IntPtr owner, IntPtr attributeClass);
+
+        private byte Query(IntPtr owner, IntPtr attributeClass)
+        {
+            if (!_records.TryGetValue(owner, out var attributes))
+                return Original(owner, attributeClass);
+            if (attributeClass == IntPtr.Zero) return attributes.Length == 0 ? (byte)0 : (byte)1;
+            // Exact ownership, including an empty set, avoids entering metadata lookup with a null handle.
+            foreach (var actual in attributes)
+                if (actual == attributeClass || IL2CPP.il2cpp_class_is_assignable_from(attributeClass, actual))
+                    return 1;
+            return 0;
+        }
+    }
+}
