+// SPDX-License-Identifier: LGPL-3.0-only
+using System;
+using Il2CppInterop.Runtime.Startup;
+
+namespace Il2CppInterop.Runtime.Injection;
+
+/// <summary>Publishes the original video declaration graph during the native host's first bootstrap.</summary>
+public static class NativeVideoRegistration
+{
+    public const int PublishedGraphVersion = 1;
+    private static readonly object Gate = new();
+    private static NativeVideoPlaybackMetadata? published;
+
+    /// <summary>Resolves a published class by original full name, with '+' separating nested types.</summary>
+    public static IntPtr RequirePublishedClass(string fullName)
+    {
+        lock (Gate)
+        {
+            var graph = published ?? throw new InvalidOperationException(
+                "Native video restoration was not published during startup. Use a matching native host, runtime and preloader.");
+            return fullName switch
+            {
+                "UnityEngineInternal.Video.VideoPlayback" => graph.Playback,
+                "UnityEngineInternal.Video.VideoPlaybackMgr" => graph.Manager,
+                "UnityEngineInternal.Video.VideoPlayback+Callback" => graph.PlaybackCallback,
+                "UnityEngineInternal.Video.VideoPlaybackMgr+Callback" => graph.ManagerCallback,
+                "UnityEngineInternal.Video.VideoPlaybackMgr+MessageCallback" => graph.MessageCallback,
+                "UnityEngineInternal.Video.VideoError" => graph.Error,
+                "UnityEngineInternal.Video.VideoPixelFormat" => graph.PixelFormat,
+                "UnityEngineInternal.Video.VideoAlphaLayout" => graph.AlphaLayout,
+                _ => throw new ArgumentException("The type is not part of the published video graph.", nameof(fullName))
+            };
+        }
+    }
+
+    /// <summary>Requires the loaded host's OpenACAI_IsIl2CppBootstrapWindow export and its initial startup thread.</summary>
+    public static void PublishDuringBootstrap(IntPtr bootstrapWindowQuery)
+    {
+        var window = NativeTypePublication.GetWindow(bootstrapWindowQuery);
+        lock (Gate)
+        {
+            if (published != null) return;
+            if (window(1) != 1)
+                throw new InvalidOperationException("Video types require the original native bootstrap thread and interval.");
+
+            var runtime = Il2CppInteropRuntime.Instance;
+            runtime.RetainNativeJob();
+            try
+            {
+                var address = NativeTypePublication.RequirePlayer();
+                NativeTypePublication.RequireEarlyWindow(window, address);
+                using var graph = new NativeVideoPlaybackMetadata();
+                (string Name, IntPtr Class)[] types =
+                {
+                    ("VideoPlayback", graph.Playback), ("VideoPlaybackMgr", graph.Manager),
+                    ("VideoError", graph.Error), ("VideoPixelFormat", graph.PixelFormat),
+                    ("VideoAlphaLayout", graph.AlphaLayout)
+                };
