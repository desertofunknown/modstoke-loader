+        var klass = IL2CPP.GetIl2CppClass("UnityEngine.CoreModule.dll", "Unity.Jobs.LowLevel.Unsafe", "JobsUtility");
+        if (klass == IntPtr.Zero) throw new MissingMethodException("Native JobsUtility is unavailable.");
+        InjectorHelpers.InitializeClass((Il2CppClass*)klass);
+        var nativeType = Il2CppClassPointerStore<Il2CppSystem.Type>.NativeClassPtr;
+        var nativeObject = Il2CppClassPointerStore<Il2CppSystem.Object>.NativeClassPtr;
+        var nativeIntPtr = Il2CppClassPointerStore<IntPtr>.NativeClassPtr;
+        if (nativeType == IntPtr.Zero || nativeObject == IntPtr.Zero || nativeIntPtr == IntPtr.Zero)
+            throw new NotSupportedException("Native job registration argument or result identities are unavailable.");
+        var selected = IntPtr.Zero;
+        var iterator = IntPtr.Zero;
+        while (IL2CPP.il2cpp_class_get_methods(klass, ref iterator) is var method && method != IntPtr.Zero)
+        {
+            if (IL2CPP.il2cpp_method_get_name_(method) != "CreateJobReflectionData" ||
+                IL2CPP.il2cpp_method_is_instance(method) || IL2CPP.il2cpp_method_is_generic(method) ||
+                IL2CPP.il2cpp_method_is_inflated(method) || IL2CPP.il2cpp_method_get_param_count(method) != 5 ||
+                !IsExactType(IL2CPP.il2cpp_method_get_return_type(method), nativeIntPtr)) continue;
+            var match = true;
+            for (uint index = 0; index < 5; index++)
+                if (!IsExactType(IL2CPP.il2cpp_method_get_param(method, index), index < 2 ? nativeType : nativeObject))
+                {
+                    match = false;
+                    break;
+                }
+            if (!match) continue;
+            if (selected != IntPtr.Zero) throw new AmbiguousMatchException("Native job reflection registration is ambiguous.");
+            var info = UnityVersionHandler.Wrap((Il2CppMethodInfo*)method);
+            if (info == null || info.MethodPointer == IntPtr.Zero || info.InvokerMethod == IntPtr.Zero)
