+++ b/Il2CppInterop.Native/WebRequestInvokers.cpp
@@ -0,0 +1,76 @@
+// SPDX-License-Identifier: LGPL-3.0-only
+#include <cstddef>
+#include <cstdint>
+#include <exception>
+#include <new>
+
+#if defined(_WIN32)
+#define INTEROP_EXPORT extern "C" __declspec(dllexport)
+#else
+#define INTEROP_EXPORT extern "C" __attribute__((visibility("default")))
+#endif
+
+namespace
+{
+    struct RequestFrame
+    {
+        void* create;
+        void* instance;
+        std::uint32_t status;
+        char error[256];
+    };
+
+    static_assert(sizeof(void*) == 8);
+    static_assert(sizeof(RequestFrame) == 280);
+    static_assert(offsetof(RequestFrame, create) == 0);
+    static_assert(offsetof(RequestFrame, instance) == 8);
+    static_assert(offsetof(RequestFrame, status) == 16);
+    static_assert(offsetof(RequestFrame, error) == 20);
+
+    void InitializeRequest(RequestFrame* frame)
+    {
+        frame->status = 1;
+        try
+        {
+            auto* resource = reinterpret_cast<void* (*)()>(frame->create)();
+            // Match Create -> m_Ptr without a managed transition before ownership is stored.
+            // This field contains an unmanaged resource pointer, not a GC reference.
+            *reinterpret_cast<void**>(static_cast<std::uint8_t*>(frame->instance) + 16) = resource;
+            frame->status = 2;
+        }
+        catch (const std::bad_alloc&)
+        {
+            frame->status = 3;
+        }
+        catch (const std::exception& exception)
+        {
+            const auto* message = exception.what();
+            std::size_t length = 0;
+            if (message != nullptr)
+                while (length + 1 < sizeof(frame->error) && message[length] != '\0')
+                {
+                    frame->error[length] = message[length];
+                    ++length;
+                }
+            frame->error[length] = '\0';
+            frame->status = 4;
+        }
+        // IL2CPP exceptions unwind to il2cpp_runtime_invoke with their native identity.
+    }
+
+    void InvokeRequest(void* method, const void*, void*, void** args, void*)
+    {
+        reinterpret_cast<void (*)(RequestFrame*)>(method)(*static_cast<RequestFrame**>(args[0]));
+    }
+}
+
+INTEROP_EXPORT void* Il2CppInterop_GetWebRequestEntry(std::uint32_t abi, std::uint32_t entry)
+{
+    if (abi != 1) return nullptr;
+    switch (entry)
+    {
+        case 0: return reinterpret_cast<void*>(&InitializeRequest);
+        case 1: return reinterpret_cast<void*>(&InvokeRequest);
+        default: return nullptr;
+    }
+}
