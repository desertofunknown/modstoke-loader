+    template<typename T>
+    T Read(const void* address, std::size_t offset)
+    {
+        T value;
+        std::memcpy(&value, static_cast<const std::byte*>(address) + offset, sizeof(T));
+        return value;
+    }
+
+    struct NameView
+    {
+        const char* data;
+        std::size_t size;
+    };
+
+    bool ReadName(const void* address, NameView& name)
+    {
+        const auto size = Read<std::size_t>(address, 0x10);
+        const auto capacity = Read<std::size_t>(address, 0x18);
+        if (size > capacity || capacity >= static_cast<std::size_t>(
+            (std::numeric_limits<std::ptrdiff_t>::max)())) return false;
+        const char* const data = capacity < 16 ? static_cast<const char*>(address) :
+            Read<const char*>(address, 0);
+        if (data == nullptr) return false;
+        // Native lookup uses the first NUL, even when the string's size is larger.
+        const auto terminator = static_cast<const char*>(std::memchr(data, 0, size + 1));
+        if (terminator == nullptr) return false;
+        name = {data, static_cast<std::size_t>(terminator - data)};
+        return true;
+    }
+
+    bool Matches(const std::string& value, const NameView& name, bool ignoreCase)
+    {
+        return ignoreCase ? configuration.EqualsIgnoreCase(nullptr, value.c_str(), name.data) :
+            value.size() == name.size && std::memcmp(value.data(), name.data, name.size) == 0;
+    }
+
+    class NativeString
+    {
+    public:
+        NativeString() noexcept
+        {
+            const std::size_t capacity = 15;
+            std::memcpy(storage + 0x18, &capacity, sizeof(capacity));
+        }
+        ~NativeString() noexcept { assemblyConfiguration.DestroyString(storage); }
+        NativeString(const NativeString&) = delete;
+        NativeString& operator=(const NativeString&) = delete;
+        void* Data() noexcept { return storage; }
+    private:
+        // These buffers are owned by the pinned native string routines, including during unwind.
+        alignas(8) std::byte storage[0x20]{};
+    };
+
+    static_assert(sizeof(NativeString) == 0x20);
+    static_assert(alignof(NativeString) == 8);
+
+    void* LoadAssembly(void* fileName, bool refOnly, void* stackMark)
+    {
+        if (!assemblyConfigured.load(std::memory_order_acquire)) return nullptr;
+        const auto snapshot = std::atomic_load_explicit(&GetRegistry().snapshot, std::memory_order_acquire);
+        if (!snapshot || snapshot->ownedAssemblies.empty() || fileName == nullptr)
+            return assemblyConfiguration.OriginalLoadFrom(fileName, refOnly, stackMark);
+
+        {
+            const auto begin = reinterpret_cast<const char16_t*>(static_cast<const std::byte*>(fileName) + 0x14);
+            auto end = begin;
+            // The pinned loader stops at NUL rather than reading the managed string length.
+            while (*end != u'\0') ++end;
+            NativeString path;
+            NativeString baseName;
+            void* iteratorResult = nullptr;
+            assemblyConfiguration.ReserveString(path.Data(), static_cast<std::size_t>(end - begin));
+            assemblyConfiguration.Utf16ToUtf8(&iteratorResult, begin, end, path.Data());
+            assemblyConfiguration.BasenameNoExtension(baseName.Data(), path.Data());
+            NameView name{};
+            if (ReadName(baseName.Data(), name))
+                for (const auto& record : snapshot->ownedAssemblies)
+                    if (Matches(record.name, name, false))
+                        return assemblyConfiguration.AssemblyGetObject(record.assembly);
+        }
+        return assemblyConfiguration.OriginalLoadFrom(fileName, refOnly, stackMark);
+    }
+
+    void* Lookup(void* image, const void* info, bool ignoreCase)
+    {
+        if (!configured.load(std::memory_order_acquire)) return nullptr;
+        const auto snapshot = std::atomic_load_explicit(&GetRegistry().snapshot, std::memory_order_acquire);
+        const bool owned = snapshot && snapshot->ownedImages.find(image) != snapshot->ownedImages.end();
+        if (!owned)
+        {
+            void* const original = configuration.OriginalLookup(image, info, ignoreCase);
+            if (original != nullptr) return original;
+        }
+        if (!snapshot || image == nullptr || info == nullptr) return nullptr;
+        bool relevant = false;
+        for (const auto& record : snapshot->names)
+        {
+            if (record.image == image && record.parentIndex == noParent)
+            {
+                relevant = true;
+                break;
+            }
+        }
+        if (!relevant) return nullptr;
+
+        NameView namespaze{};
+        NameView root{};
+        if (!ReadName(info, namespaze) ||
+            !ReadName(static_cast<const std::byte*>(info) + 0x20, root) || root.size == 0) return nullptr;
+
+        const auto begin = Read<std::uintptr_t>(info, 0xF8);
+        const auto end = Read<std::uintptr_t>(info, 0x100);
+        if (end < begin || (end - begin) % 0x20 != 0 ||
+            (begin == 0 && end != 0) || begin % alignof(void*) != 0 ||
+            end - begin > static_cast<std::uintptr_t>((std::numeric_limits<std::ptrdiff_t>::max)()))
+            return nullptr;
+
+        if (!owned && begin != end)
+        {
+            // Only the pinned image parser may consume this borrowed root-only view.
+            alignas(8) std::byte rootInfo[0x110]{};
+            std::memcpy(rootInfo, info, 0x40);
+            if (configuration.OriginalLookup(image, rootInfo, ignoreCase) != nullptr) return nullptr;
+        }
+
+        std::size_t selected = noParent;
+        for (std::size_t i = 0; i < snapshot->names.size(); ++i)
+        {
+            const auto& record = snapshot->names[i];
+            if (record.image == image && record.parentIndex == noParent &&
+                Matches(record.name, root, ignoreCase) && Matches(record.namespaze, namespaze, ignoreCase))
+            {
+                selected = i;
+                break;
+            }
+        }
+        if (selected == noParent) return nullptr;
+
+        for (auto address = begin; address != end; address += 0x20)
+        {
+            NameView name{};
+            if (!ReadName(reinterpret_cast<const void*>(address), name) || name.size == 0) return nullptr;
+            std::size_t child = noParent;
+            for (std::size_t i = selected + 1; i < snapshot->names.size(); ++i)
+            {
+                const auto& record = snapshot->names[i];
+                if (record.parentIndex == selected && Matches(record.name, name, ignoreCase))
+                {
+                    child = i;
+                    break;
+                }
+            }
+            // A deeper miss must not reconsider another matching root or sibling.
+            if (child == noParent) return nullptr;
+            selected = child;
+        }
+        return snapshot->names[selected].klass;
+    }
+
+    std::size_t CountTypes(const void* image)
+    {
+        if (!enumerationConfigured.load(std::memory_order_acquire)) return 0;
+        const auto snapshot = std::atomic_load_explicit(&GetRegistry().snapshot, std::memory_order_acquire);
+        if (!snapshot) return enumerationConfiguration.OriginalCount(image);
+        // This native entry also serves array lengths and field offsets.
+        const auto found = snapshot->types.find(image);
+        const auto added = found == snapshot->types.end() ? 0 : found->second.size();
+        if (snapshot->ownedImages.find(image) != snapshot->ownedImages.end()) return added;
+        return enumerationConfiguration.OriginalCount(image) + added;
+    }
+
+    void* GetClass(const void* image, std::size_t index)
+    {
+        if (!enumerationConfigured.load(std::memory_order_acquire)) return nullptr;
+        const auto snapshot = std::atomic_load_explicit(&GetRegistry().snapshot, std::memory_order_acquire);
+        if (!snapshot) return enumerationConfiguration.OriginalClass(image, index);
+        const auto found = snapshot->types.find(image);
+        if (snapshot->ownedImages.find(image) != snapshot->ownedImages.end())
+            return found != snapshot->types.end() && index < found->second.size() ?
+                found->second[index].klass : nullptr;
+        if (found == snapshot->types.end()) return enumerationConfiguration.OriginalClass(image, index);
+
+        const auto original = enumerationConfiguration.OriginalCount(image);
+        if (index < original) return enumerationConfiguration.OriginalClass(image, index);
+        const auto appended = index - original;
+        // The original index export does not check the image's upper bound.
+        return appended < found->second.size() ? found->second[appended].klass : nullptr;
+    }
+
+    class PinnedHandle
+    {
+    public:
+        PinnedHandle() noexcept = default;
+        explicit PinnedHandle(void* object) { Pin(object); }
+        ~PinnedHandle() noexcept
+        {
+            if (handle != 0) enumerationConfiguration.HandleFree(handle);
+        }
+        PinnedHandle(const PinnedHandle&) = delete;
+        PinnedHandle& operator=(const PinnedHandle&) = delete;
+        void Pin(void* object)
+        {
+            if (object == nullptr) throw std::bad_alloc();
+            const auto acquired = enumerationConfiguration.HandleNew(object, true);
+            if (acquired == 0) throw std::bad_alloc();
+            if (handle != 0) enumerationConfiguration.HandleFree(handle);
+            handle = acquired;
+        }
+    private:
+        std::uint32_t handle = 0;
+    };
+
+    void* GetTypes(const void* image, bool exportedOnly)
+    {
+        if (!enumerationConfigured.load(std::memory_order_acquire)) return nullptr;
+        const auto snapshot = std::atomic_load_explicit(&GetRegistry().snapshot, std::memory_order_acquire);
+        bool owned = false;
+        void* arrayClass = nullptr;
+        const std::vector<EnumerationRecord>* records = nullptr;
+        if (snapshot)
+        {
+            const auto owner = snapshot->ownedImages.find(image);
+            if (owner != snapshot->ownedImages.end())
+            {
+                owned = true;
+                arrayClass = owner->second;
+            }
+            const auto found = snapshot->types.find(image);
+            if (found != snapshot->types.end()) records = &found->second;
+        }
+        void* const original = owned ? nullptr : enumerationConfiguration.OriginalGetTypes(image, exportedOnly);
+        std::uintptr_t added = 0;
+        if (records)
+            for (const auto& record : *records)
+                if (!exportedOnly || record.exported) ++added;
+        if (!owned && added == 0) return original;
+
+        PinnedHandle originalRoot;
+        std::uintptr_t length = 0;
+        if (!owned)
+        {
+            originalRoot.Pin(original);
+            length = Read<std::uintptr_t>(original, 0x18);
+            arrayClass = Read<void*>(original, 0);
+        }
+        if (length > (std::numeric_limits<std::uintptr_t>::max)() - added)
+            throw std::overflow_error("Type enumeration array length overflow");
+        // Both routes retain the native MonoType[] class and native allocation's length limit.
+        void* const result = enumerationConfiguration.ArrayNewSpecific(arrayClass, length + added);
+        PinnedHandle resultRoot(result);
+        auto* const slots = reinterpret_cast<void**>(static_cast<std::byte*>(result) + 0x20);
+        for (std::uintptr_t i = 0; i < length; ++i)
+            enumerationConfiguration.WriteBarrier(result, slots + i, Read<void*>(original, 0x20 + i * sizeof(void*)));
+        auto index = length;
+        if (records)
+            for (const auto& record : *records)
+                if (!exportedOnly || record.exported)
+                {
+                    void* const type = enumerationConfiguration.TypeGetObject(record.type);
+                    PinnedHandle typeRoot(type);
+                    enumerationConfiguration.WriteBarrier(result, slots + index, type);
+                    ++index;
+                }
+        return result;
+    }
+
+    bool AddNames(Snapshot& prepared, const Entry* entries, std::uint32_t count)
+    {
+        auto& names = prepared.names;
+        if (count > names.max_size() - names.size()) return false;
+        names.reserve(names.size() + count);
+        for (std::uint32_t i = 0; i < count; ++i)
+        {
+            const auto& entry = entries[i];
+            if (entry.image == nullptr || entry.klass == nullptr || entry.namespaze == nullptr ||
+                entry.nameCount == 0 || entry.names == nullptr) return false;
+            for (std::uint32_t j = 0; j < entry.nameCount; ++j)
+                if (entry.names[j] == nullptr || entry.names[j][0] == '\0') return false;
+            for (const auto& record : names)
+                if (record.klass == entry.klass) return false;
+
+            std::size_t parent = noParent;
+            for (std::uint32_t j = 0; j + 1 < entry.nameCount; ++j)
+            {
+                std::size_t found = noParent;
+                for (std::size_t k = 0; k < names.size(); ++k)
+                {
+                    const auto& record = names[k];
+                    if (record.parentIndex == parent && record.image == entry.image &&
+                        record.namespaze == entry.namespaze && record.name == entry.names[j])
+                    {
+                        found = k;
+                        break;
+                    }
+                }
+                if (found == noParent) return false;
+                parent = found;
+            }
+            const char* const name = entry.names[entry.nameCount - 1];
+            for (const auto& record : names)
+                if (record.parentIndex == parent && record.image == entry.image &&
+                    record.namespaze == entry.namespaze && record.name == name) return false;
+            names.push_back({entry.image, entry.namespaze, name, entry.klass, parent});
+        }
+        return true;
+    }
+
+    bool AddEnumeration(Pending& pending, const EnumerationEntry* entries, std::uint32_t count)
+    {
+        if (pending.published.load(std::memory_order_acquire)) return false;
+        auto prepared = pending.prepared ? std::make_shared<Snapshot>(*pending.prepared) :
+            std::make_shared<Snapshot>();
+        auto& types = prepared->types;
+        constexpr auto maxCount = (std::numeric_limits<std::uint32_t>::max)();
+        for (std::uint32_t i = 0; i < count; ++i)
+        {
+            const auto& entry = entries[i];
+            if (entry.image == nullptr || entry.klass == nullptr || entry.type == nullptr || entry.exported > 1)
+                return false;
+            for (const auto& imageTypes : types)
+                for (const auto& record : imageTypes.second)
+                    if (record.klass == entry.klass) return false;
+            const auto original = prepared->ownedImages.find(entry.image) != prepared->ownedImages.end() ?
+                0 : enumerationConfiguration.OriginalCount(entry.image);
+            auto& imageTypes = types[entry.image];
+            if (original > maxCount || imageTypes.size() >= maxCount - original) return false;
+            imageTypes.push_back({entry.klass, entry.type, entry.exported != 0});
+        }
+        pending.prepared = prepared;
+        return true;
+    }
+}
