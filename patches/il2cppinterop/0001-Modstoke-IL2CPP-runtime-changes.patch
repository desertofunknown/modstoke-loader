index 0000000..0e842b5
--- /dev/null
+++ b/Il2CppInterop.Runtime/Injection/NativeArrayMemory.cs
@@ -0,0 +1,204 @@
+#nullable enable
+using System;
+using System.Runtime.CompilerServices;
+using System.Runtime.InteropServices;
+using Il2CppInterop.Runtime.InteropTypes;
+using Il2CppInterop.Runtime.Runtime;
+using Il2CppInterop.Runtime.Startup;
+
+namespace Il2CppInterop.Runtime.Injection;
+
+/// <summary>Unity tracked allocation and memory operations for reference-free CLR array storage.</summary>
+/// <remarks>
+/// No native generic identity is registered. The caller owns all buffers, aliases and synchronization,
+/// including keeping allocations alive through submitted jobs and releasing them before runtime teardown.
+/// The exception factory must retain the native exception in the returned CLR exception.
+/// </remarks>
+public static unsafe partial class NativeArrayMemory
+{
+    private static readonly object Gate = new();
+    private static Binding? binding;
+
+    public static (int Size, int Alignment) GetElementLayout<T>() where T : struct => ElementLayout<T>.Shape;
+
+    public static IntPtr AllocateTracked(long byteCount, int alignment, int allocator,
+        Func<Il2CppObjectBase, Exception> exceptionFactory)
+    {
+        ArgumentNullException.ThrowIfNull(exceptionFactory);
+        if (byteCount < 0) throw new ArgumentOutOfRangeException(nameof(byteCount));
+        if (alignment < 1 || alignment > 128 || (alignment & (alignment - 1)) != 0)
+            throw new ArgumentOutOfRangeException(nameof(alignment));
+        if (allocator <= 1) throw new ArgumentOutOfRangeException(nameof(allocator), "An owning Unity allocator is required.");
+        using var lease = new CallLease();
+        var current = GetBinding(lease);
+        var skip = 0;
+        var args = stackalloc void*[4];
+        args[0] = &byteCount;
+        args[1] = &alignment;
+        args[2] = &allocator;
+        args[3] = &skip;
+        var error = IntPtr.Zero;
+        // This exact runtime returns non-value, non-byref void* results directly, not boxed.
+        var result = IL2CPP.il2cpp_runtime_invoke(current.Allocate, IntPtr.Zero, args, ref error);
+        RaiseException(error, exceptionFactory);
+        if (result == IntPtr.Zero && byteCount != 0)
+            throw new OutOfMemoryException("Unity could not allocate the requested native array storage.");
+        return result;
+    }
+
+    public static void FreeTracked(IntPtr memory, int allocator, Func<Il2CppObjectBase, Exception> exceptionFactory)
+    {
+        ArgumentNullException.ThrowIfNull(exceptionFactory);
+        if (memory == IntPtr.Zero) return;
+        if (allocator <= 1) throw new ArgumentOutOfRangeException(nameof(allocator), "Borrowed storage cannot be freed.");
+        using var lease = new CallLease();
+        var current = GetBinding(lease);
+        var args = stackalloc void*[2];
+        args[0] = memory.ToPointer();
+        args[1] = &allocator;
+        var error = IntPtr.Zero;
+        IL2CPP.il2cpp_runtime_invoke(current.Free, IntPtr.Zero, args, ref error);
+        RaiseException(error, exceptionFactory);
+    }
+
+    public static void Copy(IntPtr destination, IntPtr source, long byteCount,
+        Func<Il2CppObjectBase, Exception> exceptionFactory)
+    {
+        ArgumentNullException.ThrowIfNull(exceptionFactory);
+        if (byteCount < 0) throw new ArgumentOutOfRangeException(nameof(byteCount));
+        if (byteCount == 0) return;
+        if (destination == IntPtr.Zero) throw new ArgumentNullException(nameof(destination));
+        if (source == IntPtr.Zero) throw new ArgumentNullException(nameof(source));
+        using var lease = new CallLease();
+        var current = GetBinding(lease);
+        var args = stackalloc void*[3];
+        // Actual void* invokers consume pointer values, unlike synthetic IntPtr-valued parameters.
+        args[0] = destination.ToPointer();
+        args[1] = source.ToPointer();
+        args[2] = &byteCount;
+        var error = IntPtr.Zero;
+        IL2CPP.il2cpp_runtime_invoke(current.Copy, IntPtr.Zero, args, ref error);
+        RaiseException(error, exceptionFactory);
+    }
+
+    public static void Clear(IntPtr memory, long byteCount, Func<Il2CppObjectBase, Exception> exceptionFactory)
+    {
+        ArgumentNullException.ThrowIfNull(exceptionFactory);
+        if (byteCount < 0) throw new ArgumentOutOfRangeException(nameof(byteCount));
+        if (byteCount == 0) return;
+        if (memory == IntPtr.Zero) throw new ArgumentNullException(nameof(memory));
+        using var lease = new CallLease();
+        var current = GetBinding(lease);
+        var args = stackalloc void*[2];
+        args[0] = memory.ToPointer();
+        args[1] = &byteCount;
+        var error = IntPtr.Zero;
+        IL2CPP.il2cpp_runtime_invoke(current.Clear, IntPtr.Zero, args, ref error);
+        RaiseException(error, exceptionFactory);
+    }
+
+    private static void RaiseException(IntPtr error, Func<Il2CppObjectBase, Exception> exceptionFactory)
+    {
+        if (error == IntPtr.Zero) return;
+        var native = new Il2CppObjectBase(error);
+        try
+        {
+            throw exceptionFactory(native) ??
+                new InvalidOperationException("The native allocation exception factory returned no exception.");
+        }
+        finally { GC.KeepAlive(native); }
+    }
+
+    private static Binding GetBinding(CallLease lease)
+    {
+        lock (Gate)
+        {
+            if (binding != null && (!ReferenceEquals(binding.Runtime, lease.Runtime) || binding.Domain != lease.Domain))
+                throw new NotSupportedException("Native array memory bindings cannot survive runtime or domain replacement.");
+            return binding ??= new Binding(lease.Runtime, lease.Domain);
+        }
+    }
+
+    private sealed class Binding
+    {
+        internal readonly Il2CppInteropRuntime Runtime;
+        internal readonly IntPtr Domain;
+        internal readonly IntPtr Allocate, Free, Copy, Clear;
+
+        internal Binding(Il2CppInteropRuntime runtime, IntPtr domain)
+        {
+            if (!OperatingSystem.IsWindows() || RuntimeInformation.ProcessArchitecture != Architecture.X64 ||
+                runtime.UnityVersion != new Version(2022, 2, 16))
+                throw new PlatformNotSupportedException("Native array memory requires the matched Windows x64 Unity 2022.2.16 runtime.");
+            Runtime = runtime;
+            Domain = domain;
+            var utility = IL2CPP.GetIl2CppClass("UnityEngine.CoreModule.dll", "Unity.Collections.LowLevel.Unsafe", "UnsafeUtility");
+            var allocator = IL2CPP.GetIl2CppClass("UnityEngine.CoreModule.dll", "Unity.Collections", "Allocator");
+            if (utility == IntPtr.Zero || allocator == IntPtr.Zero)
+                throw new NotSupportedException("Native Unity allocation types are unavailable.");
+            InjectorHelpers.InitializeClass((Il2CppClass*)utility);
+            var integer = Il2CppClassPointerStore<int>.NativeClassPtr;
+            var wide = Il2CppClassPointerStore<long>.NativeClassPtr;
+            if (integer == IntPtr.Zero || wide == IntPtr.Zero)
+                throw new NotSupportedException("Native integer identities are unavailable.");
+            NativeJobBindings.ValidateLayout(allocator, 4, 4, ("value__", 0, integer));
+            Allocate = NativeJobBindings.ResolvePointerReturn(utility, "MallocTracked",
+                (wide, false), (integer, false), (allocator, false), (integer, false));
+            Free = NativeJobBindings.Resolve(utility, "FreeTracked", IntPtr.Zero, (IntPtr.Zero, false), (allocator, false));
+            Copy = NativeJobBindings.Resolve(utility, "MemCpy", IntPtr.Zero,
+                (IntPtr.Zero, false), (IntPtr.Zero, false), (wide, false));
+            Clear = NativeJobBindings.Resolve(utility, "MemClear", IntPtr.Zero, (IntPtr.Zero, false), (wide, false));
+        }
+    }
+
+    private static class ElementLayout<T> where T : struct
+    {
+        internal static readonly (int Size, int Alignment) Shape = Create();
+
+        private static (int, int) Create()
+        {
+            if (RuntimeHelpers.IsReferenceOrContainsReferences<T>())
+                throw new NotSupportedException("Native array elements cannot contain CLR references.");
+            var layout = ManagedValueLayout.Create(typeof(T));
+            if (layout.Size != Unsafe.SizeOf<T>())
+                throw new NotSupportedException("Native array element layout does not match its CLR storage.");
+            return (layout.Size, layout.Alignment);
+        }
+    }
+
+    private readonly struct CallLease : IDisposable
+    {
+        internal readonly Il2CppInteropRuntime Runtime;
+        internal readonly IntPtr Domain;
+        private readonly IntPtr thread;
+
+        public CallLease()
+        {
+            Runtime = Il2CppInteropRuntime.Instance;
+            Domain = IntPtr.Zero;
+            thread = IntPtr.Zero;
+            Runtime.RetainNativeJob();
+            try
+            {
+                Domain = IL2CPP.il2cpp_domain_get();
+                if (Domain == IntPtr.Zero) throw new InvalidOperationException("No active IL2CPP domain is available.");
+                if (IL2CPP.il2cpp_thread_current() == IntPtr.Zero)
+                {
+                    thread = IL2CPP.il2cpp_thread_attach(Domain);
+                    if (thread == IntPtr.Zero) throw new InvalidOperationException("Could not attach the native allocation thread.");
+                }
+            }
+            catch
+            {
+                Runtime.ReleaseNativeJob();
+                throw;
+            }
+        }
+
+        public void Dispose()
+        {
+            try { if (thread != IntPtr.Zero) IL2CPP.il2cpp_thread_detach(thread); }
+            finally { Runtime.ReleaseNativeJob(); }
+        }
+    }
+}
