+    private static void RequireStarted(Il2CppInteropRuntime current)
+    {
+        if (!current.NativeJobsReady || !ReferenceEquals(Il2CppInteropRuntime.Instance, current))
+            throw new InvalidOperationException("Native job registration requires the active, started IL2CPP runtime.");
+    }
+
+    private readonly struct RegistrationThread : IDisposable
+    {
+        private readonly IntPtr ownedThread;
+
+        internal RegistrationThread(IntPtr domain)
+        {
+            ownedThread = IntPtr.Zero;
+            if (IL2CPP.il2cpp_thread_current() != IntPtr.Zero) return;
+            ownedThread = IL2CPP.il2cpp_thread_attach(domain);
+            if (ownedThread == IntPtr.Zero) throw new InvalidOperationException("Could not attach the registration thread to IL2CPP.");
+        }
+
+        public void Dispose()
+        {
+            if (ownedThread != IntPtr.Zero) IL2CPP.il2cpp_thread_detach(ownedThread);
+        }
+    }
+
+    private sealed class RegistrationKey : IEquatable<RegistrationKey>
+    {
+        private readonly Delegate execute;
+        private readonly Type? userType;
+        private readonly NativeJobCallbackKind kind;
+        private readonly int hashCode;
+        internal IReadOnlyDictionary<Type, Type>? Attributes { get; }
+
+        internal RegistrationKey(Delegate execute, NativeJobCallbackKind kind, Type? userType,
+            IReadOnlyDictionary<Type, Type>? attributes)
+        {
+            this.execute = execute;
+            this.userType = userType;
+            this.kind = kind;
+            var attributeHash = 0;
+            if (attributes is { Count: > 0 })
+            {
+                var snapshot = new Dictionary<Type, Type>(attributes.Count);
+                foreach (var entry in attributes)
+                {
+                    ArgumentNullException.ThrowIfNull(entry.Key);
+                    ArgumentNullException.ThrowIfNull(entry.Value);
+                    snapshot.Add(entry.Key, entry.Value);
+                    attributeHash ^= HashCode.Combine(entry.Key, entry.Value);
+                }
+                Attributes = snapshot;
+            }
+            hashCode = HashCode.Combine(execute, kind, userType, Attributes?.Count ?? 0, attributeHash);
+        }
+
+        public bool Equals(RegistrationKey? other)
+        {
+            if (other == null || !execute.Equals(other.execute) || userType != other.userType || kind != other.kind ||
+                (Attributes?.Count ?? 0) != (other.Attributes?.Count ?? 0)) return false;
+            if (Attributes == null) return true;
+            foreach (var entry in Attributes)
+                if (!other.Attributes!.TryGetValue(entry.Key, out var value) || value != entry.Value) return false;
+            return true;
+        }
+
+        public override bool Equals(object? obj) => obj is RegistrationKey other && Equals(other);
+        public override int GetHashCode() => hashCode;
+    }
+}
