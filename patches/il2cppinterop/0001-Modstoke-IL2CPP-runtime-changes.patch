+        record->arrays.emplace(reflectedClass, arrayHandle.Get());
+        arrayHandle.Release();
+        return array;
+    }
+}
+
+INTEROP_EXPORT void* Il2CppInterop_GetMethodParameterEntry(std::uint32_t abi, std::uint32_t kind) noexcept
+{
+    if (abi != 1) return nullptr;
+    if (kind == 0) return reinterpret_cast<void*>(&GetName);
+    if (kind == 1) return reinterpret_cast<void*>(&GetParameters);
+    return nullptr;
+}
+
+INTEROP_EXPORT void* Il2CppInterop_GetAsyncMethodMessageEntry(std::uint32_t abi) noexcept
+{
+    return abi == 1 ? reinterpret_cast<void*>(&InitializeMessage) : nullptr;
+}
+
+INTEROP_EXPORT std::uint32_t Il2CppInterop_ConfigureAsyncMethodMessages(
+    std::uint32_t abi, const AsyncConfig* config, std::uint32_t size) noexcept
+{
+    if (abi != 1 || config == nullptr || size != sizeof(AsyncConfig) ||
+        !configured.load(std::memory_order_acquire)) return 0;
+    try
+    {
+        if (!config->OriginalInitialize || !config->ObjectClass || !config->StringClass || !config->ByteClass)
+            return 0;
+        std::lock_guard<std::mutex> lock(asyncConfigurationMutex);
+        if (asyncConfigured.load(std::memory_order_relaxed))
+            return std::memcmp(&asyncConfiguration, config, sizeof(AsyncConfig)) == 0 ? 1u : 0u;
+        asyncConfiguration = *config;
+        asyncConfigured.store(true, std::memory_order_release);
+        return 1;
+    }
+    catch (...) { return 0; }
+}
+
+INTEROP_EXPORT std::uint32_t Il2CppInterop_ConfigureMethodParameters(
+    std::uint32_t abi, const Config* config, std::uint32_t size) noexcept
+{
+    if (abi != 1 || config == nullptr || size != sizeof(Config)) return 0;
+    try
+    {
+        if (!config->OriginalGetName || !config->OriginalGetParameters || !config->GetMethodObject ||
+            !config->TypeGetObject || !config->ArrayNew || !config->ObjectNew || !config->StringNew ||
+            !config->HandleNew || !config->HandleGet || !config->HandleFree || !config->WriteBarrier ||
+            !config->DefaultValue || !config->ArrayElementClass || !config->ParameterClass) return 0;
+
+        std::lock_guard<std::mutex> lock(configurationMutex);
+        if (configured.load(std::memory_order_relaxed))
+            return std::memcmp(&configuration, config, sizeof(Config)) == 0 ? 1u : 0u;
+        configuration = *config;
+        configured.store(true, std::memory_order_release);
+        return 1;
+    }
+    catch (...) { return 0; }
+}
+
+INTEROP_EXPORT void* Il2CppInterop_RegisterMethodParameters(
+    std::uint32_t abi, const Entry* entries, std::uint32_t count) noexcept
+{
+    if ((abi != 1 && abi != 2) || entries == nullptr || count == 0 ||
+        !configured.load(std::memory_order_acquire)) return nullptr;
+    try
+    {
+        auto batch = std::make_unique<Batch>();
+        batch->records.reserve(count);
+        for (std::uint32_t i = 0; i < count; ++i)
+        {
+            const auto* extended = abi == 2 ? &reinterpret_cast<const EntryWithDefaults*>(entries)[i] : nullptr;
+            const auto& entry = extended == nullptr ? entries[i] : extended->entry;
+            void* const* defaults = extended == nullptr ? nullptr : extended->defaults;
+            if (entry.method == nullptr || entry.count > 255 ||
+                Read<std::uint8_t>(entry.method, 0x52) != entry.count ||
+                (Read<std::uint8_t>(entry.method, 0x53) & 3u) != 0 ||
+                Read<const void*>(entry.method, 0x38) != nullptr ||
+                (entry.count != 0 && entry.names == nullptr)) return nullptr;
+
+            const auto types = Read<const void* const*>(entry.method, 0x30);
+            if (entry.count != 0 && types == nullptr) return nullptr;
+            auto record = std::make_shared<Record>();
+            record->method = entry.method;
+            record->names.reserve(entry.count);
+            record->defaults.resize(entry.count, 0);
+            for (std::uint32_t j = 0; j < entry.count; ++j)
+            {
+                if (entry.names[j] == nullptr || entry.names[j][0] == '\0' || types[j] == nullptr) return nullptr;
+                const auto attributes = Read<std::uint16_t>(types[j], 8);
+                if (abi == 1 && (attributes & 0x1010u) != 0) return nullptr;
+                if ((attributes & 0x1000u) != 0)
+                {
+                    if (defaults == nullptr) return nullptr;
+                    if (defaults[j] != nullptr)
+                    {
+                        // Defaults must survive until reflection creates its own rooted parameter array.
+                        const auto handle = configuration.HandleNew(defaults[j], false);
+                        if (handle == 0) throw std::bad_alloc();
+                        record->defaults[j] = handle;
+                    }
+                }
+                else if (defaults != nullptr && defaults[j] != nullptr) return nullptr;
+                record->names.emplace_back(entry.names[j]);
+            }
+            batch->records.push_back(std::move(record));
+        }
+
+        auto& registry = GetRegistry();
+        {
+            std::unique_lock<std::shared_mutex> lock(registry.mutex);
+            Records updated = registry.records;
+            for (const auto& record : batch->records)
+                if (!updated.emplace(record->method, record).second) return nullptr;
+            registry.records.swap(updated);
+        }
+        return batch.release();
+    }
+    catch (...) { return nullptr; }
+}
+
+INTEROP_EXPORT std::uint32_t Il2CppInterop_UnregisterMethodParameters(std::uint32_t abi, void* batch) noexcept
+{
+    if (abi != 1 || batch == nullptr) return 0;
+    // Only private preparation may be rolled back, before any returned pointer escapes.
+    auto* const owned = static_cast<Batch*>(batch);
+    try
+    {
+        auto& registry = GetRegistry();
+        {
+            std::unique_lock<std::shared_mutex> lock(registry.mutex);
+            for (const auto& record : owned->records)
+            {
+                const auto found = registry.records.find(record->method);
+                if (found != registry.records.end() && found->second == record) registry.records.erase(found);
+            }
+        }
+        delete owned;
+        return 1;
+    }
+    catch (...) { return 0; }
+}
