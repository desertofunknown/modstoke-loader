+        internal IntPtr ArrayNew, ObjectNew, StringNew, RuntimeInvoke, RaiseException;
+        internal IntPtr HandleNew, HandleFree, WriteBarrier, IsAssignable, AttributeClass;
+        internal IntPtr RuntimeTypeClass, RuntimeMethodClass, RuntimeConstructorClass;
+        internal IntPtr RuntimeFieldClass, RuntimePropertyClass, RuntimeParameterClass;
+        internal IntPtr OriginalGetData, GetMethodObject, TypeGetObject, ValueBox, Int32Class;
+        internal IntPtr DataClass, TypedArgumentClass, NamedArgumentClass;
+        internal IntPtr DataConstructor, TypedArgumentConstructor, TypedCollectionConstructor, NamedCollectionConstructor;
+        internal IntPtr BooleanClass, RuntimeAssemblyClass, RuntimeModuleClass, GetPropertyObject, NamedArgumentConstructor;
+    }
+
+    private static readonly Lazy<Binding> Shared = new(() => new Binding());
+    private static IDetour[]? failedHooks;
+    private readonly Binding binding;
+    private readonly Entry[] entries;
