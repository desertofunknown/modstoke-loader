+INTEROP_EXPORT std::uint32_t Il2CppInterop_PublishWwwAssembly(
+    std::uint32_t abi, const Request* request, std::uint32_t size, std::uint32_t* failureStage) noexcept
+{
+    if (failureStage == nullptr) return 0;
+    *failureStage = 0;
+    if (abi != 1 || request == nullptr || size != sizeof(Request)) return 0;
+    const Request value = *request;
+    if (value.Vector == nullptr || value.Begin == nullptr || value.End == nullptr || value.Capacity == nullptr ||
+        value.Entries == nullptr || value.Count != 210 || value.Assembly == nullptr || value.Mutex == nullptr ||
+        value.Lock == nullptr || value.Unlock == nullptr || value.Window == nullptr || value.Domain == nullptr ||
+        value.GetDomain == nullptr || value.GetThread == nullptr || value.MonoManagerSlot == nullptr ||
+        value.CallbackSlot == nullptr) return 0;
+
+    const auto begin = reinterpret_cast<std::uintptr_t>(value.Begin);
+    const auto end = reinterpret_cast<std::uintptr_t>(value.End);
+    const auto capacity = reinterpret_cast<std::uintptr_t>(value.Capacity);
+    const auto bytes = value.Count * sizeof(void*);
+    constexpr auto maxAddress = (std::numeric_limits<std::uintptr_t>::max)();
+    if (reinterpret_cast<std::uintptr_t>(value.Vector) % alignof(void*) != 0 ||
+        begin % alignof(void*) != 0 || begin > maxAddress - bytes || end != begin + bytes ||
+        end > maxAddress - sizeof(void*) || capacity != end + sizeof(void*)) return 0;
+
+    bool acquired = false;
+    bool committed = false;
+    std::uint32_t result = 0;
+    std::uint32_t exceptionStage = 0;
+    void* guard = value.Mutex;
+    try
+    {
+        *failureStage = 1;
+        value.Lock(value.Mutex);
+        acquired = true;
+        *failureStage = 2;
+        bool ready = value.Window(1) == 1 && value.GetDomain() == value.Domain &&
+            value.GetThread() != nullptr && *value.MonoManagerSlot == nullptr && *value.CallbackSlot == nullptr;
+        if (ready)
+            ready = value.Vector[0] == value.Begin && value.Vector[1] == value.End &&
+                value.Vector[2] == value.Capacity && std::memcmp(value.Begin, value.Entries, bytes) == 0;
+        if (ready)
+            for (std::uintptr_t i = 0; i < value.Count; ++i)
+                if (value.Begin[i] == nullptr || value.Begin[i] == value.Assembly)
+                {
+                    ready = false;
+                    break;
+                }
+        if (ready)
+        {
+            *failureStage = 3;
+            // Pinned Win64 stores under the mapped lifecycle mutex, not portable vector synchronization.
+            // Indirect or third-party writers outside that mutex remain unexcluded.
+            *reinterpret_cast<void* volatile*>(value.End) = value.Assembly;
+            std::atomic_thread_fence(std::memory_order_release);
+            *reinterpret_cast<void** volatile*>(value.Vector + 1) = reinterpret_cast<void**>(capacity);
+            committed = true;
+            result = 1;
+        }
+    }
+    catch (...)
+    {
+        exceptionStage = *failureStage;
+        result = committed ? 3u : 2u;
+    }
+
+    if (acquired)
+    {
+        *failureStage = 4;
+        try
+        {
+            // The complete native release routine takes the address of its one-pointer guard.
+            value.Unlock(&guard);
+        }
+        catch (...)
+        {
+            return committed ? 3u : 2u;
+        }
+    }
+    *failureStage = exceptionStage;
+    return result;
+}
