+        {
+            il.Emit(OpCodes.Ldloc, reference.Address);
+            return true;
+        }
+        var type = parameters[index].ParameterType;
+        if (!type.IsByRef) return false;
+        var element = type.GetElementType()!;
+        if (!element.IsValueType && !element.IsPointer) return false;
+        if (!AllowsNull(index))
+        {
+            il.Emit(OpCodes.Ldarg, (short)(index + offset));
+            il.Emit(OpCodes.Conv_I);
+            il.Emit(OpCodes.Call, Method(nameof(RequireAddress)));
+        }
+        il.Emit(OpCodes.Ldarg, (short)(index + offset));
+        if (rawValueReferences && element.IsValueType)
+        {
+            il.Emit(OpCodes.Conv_U);
+            il.Emit(OpCodes.Call, typeof(Unsafe).GetMethods(BindingFlags.Public | BindingFlags.Static)
+                .Single(method => method.Name == nameof(Unsafe.AsRef) && method.GetParameters()[0].ParameterType.IsPointer)
+                .MakeGenericMethod(element));
+        }
