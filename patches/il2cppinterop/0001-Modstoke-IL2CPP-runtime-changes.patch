index 0000000..4ad5b15
--- /dev/null
+++ b/Il2CppInterop.Runtime/Injection/NativeEventDebuggerRegistration.cs
@@ -0,0 +1,86 @@
+// SPDX-License-Identifier: LGPL-3.0-only
+using System;
+using Il2CppInterop.Runtime.InteropTypes;
+using Il2CppInterop.Runtime.Startup;
+
+namespace Il2CppInterop.Runtime.Injection;
+
+/// <summary>Publishes native EventDebugger storage and replay dispatch during the first bootstrap.</summary>
+public static class NativeEventDebuggerRegistration
+{
+    public const int PublishedGraphVersion = 2;
+    private static readonly object Gate = new();
+    private static NativeEventDebuggerMetadata? published;
+
+    /// <summary>Resolves a published debugger class by its original full name.</summary>
+    public static IntPtr RequirePublishedClass(string fullName)
+    {
+        lock (Gate)
+        {
+            var graph = published ?? throw new InvalidOperationException(
+                "Native EventDebugger restoration was not published during startup. Use a matching native host, runtime and preloader.");
+            return fullName switch
+            {
+                "UnityEngine.UIElements.EventDebuggerEventRecord" => graph.Record,
+                "UnityEngine.UIElements.EventDebuggerTrace" => graph.Trace,
+                "UnityEngine.UIElements.EventDebuggerCallTrace" => graph.CallTrace,
+                "UnityEngine.UIElements.EventDebuggerDefaultActionTrace" => graph.DefaultActionTrace,
+                "UnityEngine.UIElements.EventDebuggerPathTrace" => graph.PathTrace,
+                _ => graph.RequireReplayClass(fullName)
+            };
+        }
+    }
+
+    /// <summary>Binds restored iterator bodies before the wrapper can allocate native instances.</summary>
+    public static void BindIterator<T>(IntPtr nativeClass, Func<T, bool> moveNext,
+        Func<T, Il2CppSystem.Object?> genericCurrent, Func<T, Il2CppSystem.Object?> current,
+        Action<T> reset, Action<T> dispose) where T : Il2CppObjectBase
+    {
+        lock (Gate)
+        {
+            var graph = published ?? throw new InvalidOperationException("Native EventDebugger types are not published.");
+            graph.BindReplayIterator(nativeClass, moveNext, genericCurrent, current, reset, dispose);
+        }
+    }
+
+    /// <summary>Requires the loaded host's OpenACAI_IsIl2CppBootstrapWindow export and its initial startup thread.</summary>
+    public static void PublishDuringBootstrap(IntPtr query)
+    {
+        var window = NativeTypePublication.GetWindow(query);
+        lock (Gate)
+        {
+            if (published?.ReplayPublished == true) return;
+            if (window(1) != 1)
+                throw new InvalidOperationException("EventDebugger types require the original native bootstrap thread and interval.");
+
+            var runtime = Il2CppInteropRuntime.Instance;
+            runtime.RetainNativeJob();
+            try
+            {
+                var address = NativeTypePublication.RequirePlayer();
+                NativeTypePublication.RequireEarlyWindow(window, address);
+                if (published == null)
+                {
+                    using var graph = new NativeEventDebuggerMetadata();
+                    (string Name, IntPtr Class)[] types =
+                    {
+                        ("EventDebuggerEventRecord", graph.Record), ("EventDebuggerTrace", graph.Trace),
+                        ("EventDebuggerCallTrace", graph.CallTrace), ("EventDebuggerDefaultActionTrace", graph.DefaultActionTrace),
+                        ("EventDebuggerPathTrace", graph.PathTrace)
+                    };
+                    InjectorHelpers.AddPreparedTypesToLookup("UnityEngine.UIElements", graph.Image, types, () =>
+                    {
+                        NativeTypePublication.RequireEarlyWindow(window, address);
+                        graph.Retain();
+                    });
+                    published = graph;
+                }
+                // Native generic caches may retain the record identity even when replay preparation fails.
+                // Keep the published trace graph usable, and never reclaim exposed class metadata.
+                (published ?? throw new InvalidOperationException("EventDebugger trace publication did not commit."))
+                    .PublishReplay(() => NativeTypePublication.RequireEarlyWindow(window, address));
+            }
+            finally { runtime.ReleaseNativeJob(); }
+        }
+    }
+}
