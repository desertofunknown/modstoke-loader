+    internal void Complete(NativeJobHandle handle)
+    {
+        using var attachment = new NativeThread(Runtime, domain);
+        var arguments = stackalloc void*[1];
+        arguments[0] = &handle;
+        var exception = IntPtr.Zero;
+        IL2CPP.il2cpp_runtime_invoke(complete, IntPtr.Zero, arguments, ref exception);
+        Il2CppException.RaiseExceptionIfNecessary(exception);
+    }
+
+    internal bool IsCompleted(ref NativeJobHandle ownerHandle)
+    {
+        using var attachment = new NativeThread(Runtime, domain);
+        var handle = ownerHandle;
+        var arguments = stackalloc void*[1];
+        arguments[0] = &handle;
+        var exception = IntPtr.Zero;
+        var result = IL2CPP.il2cpp_runtime_invoke(isCompleted, IntPtr.Zero, arguments, ref exception);
+        Il2CppException.RaiseExceptionIfNecessary(exception);
+        if (result == IntPtr.Zero) throw new InvalidOperationException("Unity returned no job completion status.");
+        var pin = IL2CPP.il2cpp_gchandle_new(result, true);
+        if (pin == IntPtr.Zero) throw new InvalidOperationException("Could not retain the native completion status.");
+        try
+        {
+            if (IL2CPP.il2cpp_object_get_class(result) != Il2CppClassPointerStore<bool>.NativeClassPtr)
+                throw new InvalidOperationException("Unity returned an unexpected completion status type.");
+            var pointer = IL2CPP.il2cpp_object_unbox(result);
+            if (pointer == IntPtr.Zero) throw new InvalidOperationException("Native completion status has no value storage.");
+            var completed = *(byte*)pointer != 0;
+            ownerHandle = handle;
+            return completed;
+        }
+        finally { IL2CPP.il2cpp_gchandle_free(pin); }
+    }
+
+    internal static IntPtr Resolve(IntPtr klass, string name, IntPtr resultClass,
+        params (IntPtr Class, bool ByRef)[] parameters) => ResolveNative(klass, name, resultClass, false, false, parameters);
+
+    internal static IntPtr ResolvePointerReturn(IntPtr klass, string name,
+        params (IntPtr Class, bool ByRef)[] parameters) => ResolveNative(klass, name, IntPtr.Zero, false, true, parameters);
+
+    private static IntPtr ResolveNative(IntPtr klass, string name, IntPtr resultClass, bool instance, bool pointerReturn,
+        params (IntPtr Class, bool ByRef)[] parameters)
+    {
+        var iterator = IntPtr.Zero;
+        var selected = IntPtr.Zero;
+        while (IL2CPP.il2cpp_class_get_methods(klass, ref iterator) is var method && method != IntPtr.Zero)
+        {
+            if (IL2CPP.il2cpp_method_get_name_(method) != name || IL2CPP.il2cpp_method_is_instance(method) != instance ||
+                IL2CPP.il2cpp_method_is_generic(method) || IL2CPP.il2cpp_method_is_inflated(method) ||
+                IL2CPP.il2cpp_method_get_param_count(method) != parameters.Length) continue;
+            var result = IL2CPP.il2cpp_method_get_return_type(method);
+            if (pointerReturn ? !IsVoidPointer(result) :
+                resultClass == IntPtr.Zero ? !IsVoid(result) : !IsType(result, resultClass, false)) continue;
+            var matches = true;
+            for (var index = 0; index < parameters.Length; index++)
+                if (parameters[index].Class == IntPtr.Zero
+                    ? parameters[index].ByRef || !IsVoidPointer(IL2CPP.il2cpp_method_get_param(method, (uint)index))
+                    : !IsType(IL2CPP.il2cpp_method_get_param(method, (uint)index),
+                        parameters[index].Class, parameters[index].ByRef))
+                {
+                    matches = false;
+                    break;
+                }
+            if (!matches) continue;
+            if (selected != IntPtr.Zero) throw new AmbiguousMatchException($"Native job method {name} is ambiguous.");
+            var info = UnityVersionHandler.Wrap((Il2CppMethodInfo*)method);
+            if (info == null || info.MethodPointer == IntPtr.Zero || info.InvokerMethod == IntPtr.Zero)
+                throw new MissingMethodException($"Native job method {name} has no callable implementation.");
+            selected = method;
+        }
+        if (selected == IntPtr.Zero) throw new MissingMethodException($"Exact native job method {name} is unavailable.");
+        return selected;
+    }
+
+    private static bool IsType(IntPtr type, IntPtr klass, bool byRef) =>
+        type != IntPtr.Zero && klass != IntPtr.Zero && IL2CPP.il2cpp_type_is_byref(type) == byRef &&
+        IL2CPP.il2cpp_class_from_type(type) == klass;
+
+    private static bool IsVoid(IntPtr type) => type != IntPtr.Zero && !IL2CPP.il2cpp_type_is_byref(type) &&
+        UnityVersionHandler.Wrap((Il2CppTypeStruct*)type)?.Type == Il2CppTypeEnum.IL2CPP_TYPE_VOID;
+
+    private static bool IsVoidPointer(IntPtr type)
+    {
+        if (type == IntPtr.Zero) return false;
+        var signature = UnityVersionHandler.Wrap((Il2CppTypeStruct*)type);
+        return signature != null && !signature.ByRef && !signature.ValueType && signature.Type == Il2CppTypeEnum.IL2CPP_TYPE_PTR &&
+            signature.Data != IntPtr.Zero &&
+            UnityVersionHandler.Wrap((Il2CppTypeStruct*)signature.Data)?.Type == Il2CppTypeEnum.IL2CPP_TYPE_VOID;
+    }
+
+    internal static void ValidateLayout(IntPtr klass, int size,
+        params (string Name, int Offset, IntPtr Class)[] fields)
+        => ValidateLayout(klass, size, 8, fields);
+
+    internal static void ValidateLayout(IntPtr klass, int size, uint expectedAlignment,
+        params (string Name, int Offset, IntPtr Class)[] fields)
+    {
+        if (klass == IntPtr.Zero) throw new NotSupportedException("A required native job value type is unavailable.");
+        InjectorHelpers.InitializeClass((Il2CppClass*)klass);
+        uint alignment = 0;
+        if (!IL2CPP.il2cpp_class_is_valuetype(klass) || IL2CPP.il2cpp_class_has_references(klass) ||
+            IL2CPP.il2cpp_class_value_size(klass, ref alignment) != size || alignment != expectedAlignment ||
+            IL2CPP.il2cpp_class_array_element_size(klass) != size)
+            throw new NotSupportedException("Native job value layout differs from the inspected x64 contract.");
+        var iterator = IntPtr.Zero;
+        var found = 0;
+        while (IL2CPP.il2cpp_class_get_fields(klass, ref iterator) is var field && field != IntPtr.Zero)
+        {
+            if (((FieldAttributes)IL2CPP.il2cpp_field_get_flags(field) & FieldAttributes.Static) != 0) continue;
+            var name = IL2CPP.il2cpp_field_get_name_(field);
+            var index = Array.FindIndex(fields, expected => expected.Name == name);
+            if (index < 0 || (found & (1 << index)) != 0)
+                throw new NotSupportedException("Native job value fields differ from the expected contract.");
+            var expected = fields[index];
+            var type = IL2CPP.il2cpp_field_get_type(field);
+            if (IL2CPP.il2cpp_field_get_offset(field) != sizeof(Il2CppObject) + expected.Offset ||
+                !IsType(type, expected.Class, false))
+                throw new NotSupportedException($"Native job field {name} has an incompatible offset or type.");
+            found |= 1 << index;
+        }
+        if (found != (1 << fields.Length) - 1)
+            throw new NotSupportedException("Native job value fields are incomplete.");
+    }
+
+    private readonly struct NativeThread : IDisposable
+    {
+        private readonly IntPtr owned;
+
+        internal NativeThread(Il2CppInteropRuntime runtime, IntPtr domain)
+        {
+            owned = IntPtr.Zero;
+            if (!runtime.NativeJobsReady || !ReferenceEquals(Il2CppInteropRuntime.Instance, runtime) ||
+                IL2CPP.il2cpp_domain_get() != domain)
+                throw new InvalidOperationException("The job's native runtime or domain is no longer active.");
+            if (IL2CPP.il2cpp_thread_current() != IntPtr.Zero) return;
+            owned = IL2CPP.il2cpp_thread_attach(domain);
+            if (owned == IntPtr.Zero) throw new InvalidOperationException("Could not attach the job caller to IL2CPP.");
+        }
+
+        public void Dispose()
+        {
+            if (owned != IntPtr.Zero) IL2CPP.il2cpp_thread_detach(owned);
+        }
+    }
+}
