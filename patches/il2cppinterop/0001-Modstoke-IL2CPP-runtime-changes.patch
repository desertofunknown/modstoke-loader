+            throw new NotSupportedException("Attribute reflection cannot survive runtime or domain replacement.");
+        entries = source.ToArray();
+        if (entries.Length == 0) throw new ArgumentException("Attribute ownership cannot be empty.", nameof(source));
+        var allocations = new List<IntPtr>();
+        try
+        {
+            var native = new NativeEntry[entries.Length];
+            for (var i = 0; i < entries.Length; i++)
+            {
