+using System;
+using System.Collections.Generic;
+using System.Reflection;
+using System.Reflection.Emit;
+
+namespace Il2CppInterop.Runtime.Injection;
+
+public sealed unsafe partial class NativeJobCallback
+{
+    private static readonly AssemblyBuilder EmissionAssembly = AssemblyBuilder.DefineDynamicAssembly(
+        new AssemblyName("Il2CppNativeJobCallbacks"), AssemblyBuilderAccess.Run);
+    private static readonly ModuleBuilder EmissionModule =
+        EmissionAssembly.DefineDynamicModule("Il2CppNativeJobCallbacks");
+    private static readonly ConstructorInfo AccessGrantConstructor = EmitAccessGrantAttribute();
+    private static readonly HashSet<string> AccessGrantedAssemblies = new(StringComparer.Ordinal);
+    private static long targetTypeSequence;
+
+    // The caller holds Gate for both access grants and type emission.
+    private static Binding EmitTarget(Type delegateType, MethodInfo invoke, NativeJobCallbackKind kind)
+    {
+        var parameters = invoke.GetParameters();
+        var parameterTypes = new Type[parameters.Length];
+        var visitedTypes = new HashSet<Type>();
+        GrantSignatureAccess(delegateType, visitedTypes);
+        GrantSignatureAccess(typeof(FailureState), visitedTypes);
+        GrantSignatureAccess(typeof(NativeJobCallbackMethodAttribute), visitedTypes);
+        GrantSignatureAccess(invoke.ReturnType, visitedTypes);
+        for (var index = 0; index < parameters.Length; index++)
+        {
+            parameterTypes[index] = parameters[index].ParameterType;
+            GrantSignatureAccess(parameterTypes[index], visitedTypes);
+        }
+
+        var target = EmissionModule.DefineType("Il2CppNativeJobCallback_" + ++targetTypeSequence,
+            TypeAttributes.Public | TypeAttributes.Sealed, typeof(Il2CppSystem.Object));
+        var callbackField = target.DefineField("_callback", delegateType, FieldAttributes.Private);
+        var failureField = target.DefineField("_failure", typeof(FailureState), FieldAttributes.Private);
+        var pointerParameters = new[] { typeof(IntPtr) };
+        var constructor = target.DefineConstructor(MethodAttributes.Public | MethodAttributes.HideBySig |
+            MethodAttributes.SpecialName | MethodAttributes.RTSpecialName,
+            CallingConventions.HasThis, pointerParameters);
+        var il = constructor.GetILGenerator();
+        il.Emit(OpCodes.Ldarg_0);
+        il.Emit(OpCodes.Ldarg_1);
+        il.Emit(OpCodes.Call, typeof(Il2CppSystem.Object).GetConstructor(pointerParameters)!);
+        il.Emit(OpCodes.Ret);
+
+        var method = target.DefineMethod("Invoke", MethodAttributes.Public | MethodAttributes.HideBySig,
+            CallingConventions.HasThis, typeof(void), parameterTypes);
+        method.SetCustomAttribute(new CustomAttributeBuilder(
+            typeof(NativeJobCallbackMethodAttribute).GetConstructor(new[] { typeof(bool) })!,
+            new object[] { kind == NativeJobCallbackKind.Animation }));
+        il = method.GetILGenerator();
+        var error = il.DeclareLocal(typeof(Exception));
+        il.Emit(OpCodes.Call, typeof(NativeJobCallback).GetMethod(nameof(EnterInvocation),
+            BindingFlags.Static | BindingFlags.NonPublic)!);
+        il.BeginExceptionBlock();
+        var end = il.BeginExceptionBlock();
+        il.Emit(OpCodes.Ldarg_0);
+        il.Emit(OpCodes.Ldfld, callbackField);
+        for (var index = 0; index < parameterTypes.Length; index++)
+            il.Emit(OpCodes.Ldarg, (short)(index + 1));
+        il.Emit(OpCodes.Callvirt, invoke);
+        il.Emit(OpCodes.Leave, end);
+        il.BeginCatchBlock(typeof(Exception));
+        il.Emit(OpCodes.Stloc, error);
+        il.Emit(OpCodes.Ldarg_0);
+        il.Emit(OpCodes.Ldfld, failureField);
+        il.Emit(OpCodes.Ldloc, error);
+        il.Emit(OpCodes.Call, typeof(FailureState).GetMethod(nameof(FailureState.Record),
+            BindingFlags.Instance | BindingFlags.NonPublic, null, new[] { typeof(Exception) }, null)!);
+        il.Emit(OpCodes.Rethrow);
+        il.EndExceptionBlock();
+        il.BeginFinallyBlock();
+        il.Emit(OpCodes.Call, typeof(NativeJobCallback).GetMethod(nameof(ExitInvocation),
+            BindingFlags.Static | BindingFlags.NonPublic)!);
+        il.EndExceptionBlock();
+        il.Emit(OpCodes.Ret);
+
+        var type = target.CreateType()!;
+        const BindingFlags fields = BindingFlags.Instance | BindingFlags.NonPublic | BindingFlags.DeclaredOnly;
+        return new Binding(type, type.GetConstructor(pointerParameters)!,
+            type.GetField("_callback", fields)!, type.GetField("_failure", fields)!);
+    }
+
+    private static void GrantSignatureAccess(Type type, HashSet<Type> visitedTypes)
+    {
+        if (!visitedTypes.Add(type)) return;
+        var assemblyName = type.Assembly.GetName().Name!;
+        if (!AccessGrantedAssemblies.Contains(assemblyName))
+        {
+            EmissionAssembly.SetCustomAttribute(new CustomAttributeBuilder(AccessGrantConstructor,
+                new object[] { assemblyName }));
+            AccessGrantedAssemblies.Add(assemblyName);
+        }
+
+        if (type.HasElementType) GrantSignatureAccess(type.GetElementType()!, visitedTypes);
+        if (type.DeclaringType != null) GrantSignatureAccess(type.DeclaringType, visitedTypes);
+        if (type.IsGenericType)
+            foreach (var argument in type.GetGenericArguments())
+                GrantSignatureAccess(argument, visitedTypes);
+    }
+
+    private static ConstructorInfo EmitAccessGrantAttribute()
+    {
+        var attribute = EmissionModule.DefineType(
+            "System.Runtime.CompilerServices.IgnoresAccessChecksToAttribute",
+            TypeAttributes.Public | TypeAttributes.Sealed, typeof(Attribute));
+        attribute.SetCustomAttribute(new CustomAttributeBuilder(
+            typeof(AttributeUsageAttribute).GetConstructor(new[] { typeof(AttributeTargets) })!,
+            new object[] { AttributeTargets.Assembly },
+            new[] { typeof(AttributeUsageAttribute).GetProperty(nameof(AttributeUsageAttribute.AllowMultiple))! },
+            new object[] { true }));
+
+        var assemblyName = attribute.DefineField("_assemblyName", typeof(string),
+            FieldAttributes.Private | FieldAttributes.InitOnly);
+        var constructor = attribute.DefineConstructor(MethodAttributes.Public | MethodAttributes.HideBySig |
+            MethodAttributes.SpecialName | MethodAttributes.RTSpecialName,
+            CallingConventions.HasThis, new[] { typeof(string) });
+        var il = constructor.GetILGenerator();
+        il.Emit(OpCodes.Ldarg_0);
+        il.Emit(OpCodes.Call, typeof(Attribute).GetConstructor(BindingFlags.Instance | BindingFlags.NonPublic,
+            null, Type.EmptyTypes, null)!);
+        il.Emit(OpCodes.Ldarg_0);
+        il.Emit(OpCodes.Ldarg_1);
+        il.Emit(OpCodes.Stfld, assemblyName);
+        il.Emit(OpCodes.Ret);
+
+        var property = attribute.DefineProperty("AssemblyName", PropertyAttributes.None, typeof(string),
+            Type.EmptyTypes);
+        var getter = attribute.DefineMethod("get_AssemblyName",
+            MethodAttributes.Public | MethodAttributes.HideBySig | MethodAttributes.SpecialName,
+            CallingConventions.HasThis, typeof(string), Type.EmptyTypes);
+        il = getter.GetILGenerator();
+        il.Emit(OpCodes.Ldarg_0);
+        il.Emit(OpCodes.Ldfld, assemblyName);
+        il.Emit(OpCodes.Ret);
+        property.SetGetMethod(getter);
+        return attribute.CreateType()!.GetConstructor(new[] { typeof(string) })!;
+    }
+}
