+    static_assert(sizeof(void*) == 8);
+    static_assert(sizeof(SpawnerFrame) == 296);
+    static_assert(offsetof(SpawnerFrame, create) == 0);
+    static_assert(offsetof(SpawnerFrame, constructor) == 8);
+    static_assert(offsetof(SpawnerFrame, constructorMethod) == 16);
+    static_assert(offsetof(SpawnerFrame, instance) == 24);
+    static_assert(offsetof(SpawnerFrame, status) == 32);
+    static_assert(offsetof(SpawnerFrame, error) == 36);
+
+    void InitializeSpawner(SpawnerFrame* frame)
+    {
+        frame->status = 1;
+        try
+        {
+            auto* resource = reinterpret_cast<void* (*)()>(frame->create)();
+            // The matched constructor only stores the pointer and ownership flag.
+            // Keep both calls native so no wrapper allocation can interrupt that transfer.
+            reinterpret_cast<void (*)(void*, void*, std::uint8_t, void*)>(frame->constructor)(
+                frame->instance, resource, 1, frame->constructorMethod);
+            frame->status = 2;
+        }
+        catch (const std::bad_alloc&)
+        {
+            frame->status = 3;
+        }
+        catch (const std::exception& exception)
+        {
+            const auto* message = exception.what();
+            std::size_t length = 0;
+            if (message != nullptr)
+                while (length + 1 < sizeof(frame->error) && message[length] != '\0')
+                {
+                    frame->error[length] = message[length];
+                    ++length;
+                }
+            frame->error[length] = '\0';
+            frame->status = 4;
+        }
+        // IL2CPP exceptions unwind to il2cpp_runtime_invoke with their native identity.
+    }
+
+    void InvokeSpawner(void* method, const void*, void*, void** args, void*)
+    {
+        reinterpret_cast<void (*)(SpawnerFrame*)>(method)(*static_cast<SpawnerFrame**>(args[0]));
+    }
+}
+
+INTEROP_EXPORT void* Il2CppInterop_GetVfxSpawnerEntry(std::uint32_t abi, std::uint32_t entry)
