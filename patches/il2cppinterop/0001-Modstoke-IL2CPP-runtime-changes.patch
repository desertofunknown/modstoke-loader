+// SPDX-License-Identifier: LGPL-3.0-only
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Runtime.InteropServices;
+using System.Security.Cryptography;
+using System.Threading;
+using Il2CppInterop.Runtime.Runtime;
+using Il2CppInterop.Runtime.Startup;
+
+namespace Il2CppInterop.Runtime.Injection;
+
+// Native-owned metadata records. Publication retains their owning class graph for the domain lifetime.
+internal sealed unsafe class NativeAttributeReflection : IDisposable
+{
+    internal enum OwnerKind : uint { Class, Method, Field, Property, Parameter, Assembly, Module }
+    internal readonly record struct Argument(IntPtr Class, string? Text, int Integer = 0);
+    internal readonly record struct NamedProperty(IntPtr Property, Argument Value);
+    internal readonly record struct Declaration(IntPtr Constructor, Argument[] Arguments, NamedProperty[]? Properties = null);
