@@ -0,0 +1,84 @@
+// SPDX-License-Identifier: LGPL-3.0-only
+#include <cstddef>
+#include <cstdint>
+#include <exception>
+#include <new>
+
+#if defined(_WIN32)
+#define INTEROP_EXPORT extern "C" __declspec(dllexport)
+#else
+#define INTEROP_EXPORT extern "C" __attribute__((visibility("default")))
+#endif
+
+namespace
+{
+    struct WarmupFrame
+    {
+        void* call;
+        void* collection;
+        void* shader;
+        void* vertices;
+        std::uint32_t fromCollection;
+        std::uint32_t status;
+        char error[256];
+    };
+
+    static_assert(sizeof(void*) == 8);
+    static_assert(sizeof(WarmupFrame) == 296);
+    static_assert(offsetof(WarmupFrame, call) == 0);
+    static_assert(offsetof(WarmupFrame, collection) == 8);
+    static_assert(offsetof(WarmupFrame, shader) == 16);
+    static_assert(offsetof(WarmupFrame, vertices) == 24);
+    static_assert(offsetof(WarmupFrame, fromCollection) == 32);
+    static_assert(offsetof(WarmupFrame, status) == 36);
+    static_assert(offsetof(WarmupFrame, error) == 40);
+
+    void Warmup(WarmupFrame* frame)
+    {
+        frame->status = 1;
+        try
+        {
+            // The setup is one IL2CPP array-reference slot, pinned by the CLR caller.
+            if (frame->fromCollection != 0)
+                reinterpret_cast<void (*)(void*, void*, void**)>(frame->call)(
+                    frame->collection, frame->shader, &frame->vertices);
+            else
+                reinterpret_cast<void (*)(void*, void**)>(frame->call)(frame->shader, &frame->vertices);
+            frame->status = 2;
+        }
+        catch (const std::bad_alloc&)
+        {
+            frame->status = 3;
+        }
+        catch (const std::exception& exception)
+        {
+            const auto* message = exception.what();
+            std::size_t length = 0;
+            if (message != nullptr)
+                while (length + 1 < sizeof(frame->error) && message[length] != '\0')
+                {
+                    frame->error[length] = message[length];
+                    ++length;
+                }
+            frame->error[length] = '\0';
+            frame->status = 4;
+        }
+        // IL2CPP exceptions unwind to il2cpp_runtime_invoke, preserving their identity.
+    }
+
+    void InvokeWarmup(void* method, const void*, void*, void** args, void*)
+    {
+        reinterpret_cast<void (*)(WarmupFrame*)>(method)(*static_cast<WarmupFrame**>(args[0]));
+    }
+}
+
+INTEROP_EXPORT void* Il2CppInterop_GetShaderWarmupEntry(std::uint32_t abi, std::uint32_t entry)
+{
+    if (abi != 1) return nullptr;
+    switch (entry)
+    {
+        case 0: return reinterpret_cast<void*>(&Warmup);
+        case 1: return reinterpret_cast<void*>(&InvokeWarmup);
+        default: return nullptr;
+    }
+}
