+    }
+
+    private IntPtr InvokeRegistration()
+    {
+        var arguments = stackalloc void*[5];
+        arguments[0] = callback.PayloadType.Pointer.ToPointer();
+        arguments[1] = userType.Pointer.ToPointer();
+        arguments[2] = callback.Target.Pointer.ToPointer();
+        arguments[3] = null;
+        arguments[4] = null;
+        var exception = IntPtr.Zero;
+        try
+        {
+            var result = IL2CPP.il2cpp_runtime_invoke(registrationMethod, IntPtr.Zero, arguments, ref exception);
+            Il2CppException.RaiseExceptionIfNecessary(exception);
