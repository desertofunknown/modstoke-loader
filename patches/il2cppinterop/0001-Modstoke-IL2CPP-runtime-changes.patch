+                throw new NotSupportedException("A native WWW field type has no signature: " + names[i]);
+            var type = UnityVersionHandler.NewType();
+            Track(type.Pointer);
+            type.Data = source.Data;
+            type.Type = source.Type;
+            type.ValueType = source.ValueType;
+            type.Attrs = (ushort)FieldAttributes.Private;
+            field->name = (byte*)String(names[i]);
+            field->parent = klass.ClassPointer;
+            field->type = type.TypePointer;
+            field->offset = offsets[i];
+            field->token = checked(0x04000001u + (uint)i);
