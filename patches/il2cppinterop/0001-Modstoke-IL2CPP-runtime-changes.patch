+INTEROP_EXPORT std::uint32_t Il2CppInterop_ConfigureNavMeshSources(
+    std::uint32_t abi, void* componentCall, void* objectCall, void* rootCall,
+    void* instanceId, void* inequality) noexcept
+{
+    if (abi != 1 || componentCall == nullptr || objectCall == nullptr || rootCall == nullptr ||
+        instanceId == nullptr || inequality == nullptr) return 0;
+    const Bindings requested{componentCall, objectCall, rootCall, instanceId, inequality};
+    const auto* current = bindings.load(std::memory_order_acquire);
+    if (current != nullptr) return Matches(*current, requested) ? 1u : 0u;
+
+    auto* candidate = new (std::nothrow) Bindings(requested);
+    if (candidate == nullptr) return 0;
+    // Publish all five bindings together; the winner lives for the process lifetime.
+    if (bindings.compare_exchange_strong(current, candidate,
+        std::memory_order_acq_rel, std::memory_order_acquire)) return 1;
+    const bool identical = Matches(*current, requested);
+    delete candidate;
+    return identical ? 1u : 0u;
+}
