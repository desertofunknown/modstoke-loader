+++ b/Il2CppInterop.Native/VideoPlaybackManager.cpp
@@ -0,0 +1,133 @@
+// SPDX-License-Identifier: LGPL-3.0-only
+#include "VideoPlaybackManager.h"
+#include <atomic>
+#include <cstdint>
+#include <exception>
+#include <new>
+
+#if defined(_WIN32)
+#define INTEROP_EXPORT extern "C" __declspec(dllexport)
+#else
+#define INTEROP_EXPORT extern "C" __attribute__((visibility("default")))
+#endif
+
+namespace
+{
+    struct Configuration
+    {
+        void* Corlib;
+        void* (*ExceptionFromName)(void*, const char*, const char*, const char*);
+        void (*Raise)(void*);
+    };
+    static_assert(sizeof(Configuration) == 24);
+    std::atomic<const Configuration*> configuration{nullptr};
+
+    bool Matches(const Configuration& left, const Configuration& right) noexcept
+    {
+        return left.Corlib == right.Corlib && left.ExceptionFromName == right.ExceptionFromName &&
+            left.Raise == right.Raise;
+    }
+
+    [[noreturn]] void RejectReentry()
+    {
+        const auto* config = configuration.load(std::memory_order_acquire);
+        if (config == nullptr) std::terminate();
+        auto* exception = config->ExceptionFromName(config->Corlib, "System", "InvalidOperationException",
+            "VideoPlaybackMgr cannot overlap manager operations across threads, reenter Update, or access a manager during destruction.");
+        if (exception == nullptr) throw std::bad_alloc();
+        config->Raise(exception);
+        std::terminate();
+    }
+}
+
+namespace VideoPlayback
+{
+    std::mutex ManagerCall::gate;
+    ManagerCall* ManagerCall::active = nullptr;
+
+    bool HasManagerReentryBindings() noexcept
+    {
+        return configuration.load(std::memory_order_acquire) != nullptr;
+    }
+
+    ManagerCall::ManagerCall(void* manager, ManagerCallKind kind)
+        : ManagerCall(manager, nullptr, kind)
+    {
+    }
+
+    ManagerCall::ManagerCall(ManagerObject* owner, ManagerCallKind kind)
+        : ManagerCall(nullptr, owner, kind)
+    {
+    }
+
+    bool ManagerCall::ConflictsWith(const ManagerCall& call) const noexcept
+    {
+        return kind != ManagerCallKind::Access || call.kind == ManagerCallKind::Destroy ||
+            call.thread != thread;
+    }
+
+    ManagerCall::ManagerCall(void* manager, ManagerObject* owner, ManagerCallKind kind)
+        : manager(manager), owner(owner), kind(kind), thread(std::this_thread::get_id())
+    {
+        if (manager == nullptr && owner == nullptr) return;
+        {
+            std::lock_guard<std::mutex> lock(gate);
+            bool conflict = false;
+            // Dispose clears m_Ptr before its call frame leaves. Check the wrapper first
+            // so another routed call cannot race that store or retain a stale snapshot.
+            for (auto* call = active; call != nullptr; call = call->next)
+            {
+                if (owner != nullptr && call->owner == owner && ConflictsWith(*call))
+                {
+                    conflict = true;
+                    break;
+                }
+            }
+            if (!conflict)
+            {
+                if (owner != nullptr) this->manager = owner->m_Ptr;
+                if (this->manager == nullptr) return;
+                for (auto* call = active; call != nullptr; call = call->next)
+                {
+                    if (call->manager == this->manager && ConflictsWith(*call))
+                    {
+                        conflict = true;
+                        break;
+                    }
+                }
+            }
+            if (!conflict)
+            {
+                next = active;
+                active = this;
+                return;
+            }
+        }
+        RejectReentry();
+    }
+
+    ManagerCall::~ManagerCall() noexcept
+    {
+        if (manager == nullptr) return;
+        std::lock_guard<std::mutex> lock(gate);
+        auto** entry = &active;
+        while (*entry != this) entry = &(*entry)->next;
+        *entry = next;
+    }
+}
+
+INTEROP_EXPORT std::uint32_t Il2CppInterop_ConfigureVideoManagerReentry(
+    std::uint32_t abi, const Configuration* config, std::uint32_t size) noexcept
+{
+    if (abi != 1 || config == nullptr || size != sizeof(Configuration) ||
+        config->Corlib == nullptr || config->ExceptionFromName == nullptr || config->Raise == nullptr) return 0;
+    const auto* current = configuration.load(std::memory_order_acquire);
+    if (current != nullptr) return Matches(*current, *config) ? 1u : 0u;
+    auto* candidate = new (std::nothrow) Configuration(*config);
+    if (candidate == nullptr) return 0;
+    if (configuration.compare_exchange_strong(current, candidate,
+        std::memory_order_acq_rel, std::memory_order_acquire)) return 1;
+    const bool identical = Matches(*current, *candidate);
+    delete candidate;
+    return identical ? 1u : 0u;
+}
