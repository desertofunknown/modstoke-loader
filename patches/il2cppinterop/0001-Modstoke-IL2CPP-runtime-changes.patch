+// SPDX-License-Identifier: LGPL-3.0-only
+using System;
+using System.Runtime.InteropServices;
+using System.Text;
+using Il2CppInterop.Runtime.InteropTypes;
+using Il2CppInterop.Runtime.Startup;
+
+namespace Il2CppInterop.Runtime.Injection;
+
+/// <summary>Initializes native ownership on a freshly allocated VFXSpawnerState wrapper.</summary>
+public static unsafe partial class NativeVfxSpawnerState
+{
+    /// <remarks>
+    /// The caller must supply a fresh, unpublished exact VFXSpawnerState allocated by il2cpp_object_new
+    /// and rooted by its generated pointer constructor. Do not call concurrently on the same object.
+    /// Native creation and ownership transfer execute together; the original native finalizer and Dispose
+    /// retain responsibility for cleanup. The exception factory must retain its native exception.
+    /// </remarks>
+    public static void InitializeOwned(Il2CppObjectBase value, Func<Il2CppObjectBase, Exception> exceptionFactory)
+    {
+        ArgumentNullException.ThrowIfNull(value);
+        ArgumentNullException.ThrowIfNull(exceptionFactory);
+        using var lease = new RuntimeCallLease();
+        try
+        {
+            var current = GetBinding(lease);
+            var frame = new CreateFrame
+            {
+                Create = current.Create,
+                Constructor = current.Constructor,
+                ConstructorMethod = current.ConstructorMethod,
+                Instance = current.ValidateInstance(value)
+            };
+            var address = &frame;
+            var args = stackalloc void*[1];
+            args[0] = &address;
+            var error = IntPtr.Zero;
+            IL2CPP.il2cpp_runtime_invoke(current.Method, IntPtr.Zero, args, ref error);
+            if (error != IntPtr.Zero)
+            {
+                var native = new Il2CppObjectBase(error);
+                try
+                {
+                    throw exceptionFactory(native) ??
+                        new InvalidOperationException("The VFX spawner exception factory returned no exception.");
+                }
+                finally { GC.KeepAlive(native); }
+            }
+            if (frame.Status == 3)
+                throw new OutOfMemoryException("Native VFX spawner creation exhausted memory.");
+            if (frame.Status == 4)
+            {
+                var length = 0;
+                while (length < 255 && frame.Error[length] != 0) length++;
+                throw new InvalidOperationException($"Native VFX spawner creation failed: {Encoding.UTF8.GetString(frame.Error, length)}.");
+            }
+            if (frame.Status != 2)
+                throw new InvalidOperationException("The native VFX spawner ownership transfer did not complete.");
+        }
+        finally { GC.KeepAlive(value); }
+    }
+
+    [StructLayout(LayoutKind.Sequential, Pack = 8)]
+    private struct CreateFrame
+    {
+        internal IntPtr Create;
+        internal IntPtr Constructor;
+        internal IntPtr ConstructorMethod;
+        internal IntPtr Instance;
+        internal uint Status;
+        internal fixed byte Error[256];
+    }
+
+    private readonly struct RuntimeCallLease : IDisposable
+    {
+        internal readonly Il2CppInteropRuntime Runtime;
+        internal readonly IntPtr Domain;
+        private readonly IntPtr thread;
+
+        public RuntimeCallLease()
+        {
+            Runtime = Il2CppInteropRuntime.Instance;
+            Domain = IntPtr.Zero;
+            thread = IntPtr.Zero;
+            Runtime.RetainNativeJob();
+            try
+            {
+                Domain = IL2CPP.il2cpp_domain_get();
+                if (Domain == IntPtr.Zero) throw new InvalidOperationException("No active IL2CPP domain is available.");
+                if (IL2CPP.il2cpp_thread_current() == IntPtr.Zero)
+                {
+                    thread = IL2CPP.il2cpp_thread_attach(Domain);
+                    if (thread == IntPtr.Zero) throw new InvalidOperationException("Could not attach the VFX spawner caller to IL2CPP.");
+                }
+            }
+            catch
+            {
+                Runtime.ReleaseNativeJob();
+                throw;
+            }
+        }
+
+        public void Dispose()
+        {
+            try { if (thread != IntPtr.Zero) IL2CPP.il2cpp_thread_detach(thread); }
+            finally { Runtime.ReleaseNativeJob(); }
+        }
+    }
+}
