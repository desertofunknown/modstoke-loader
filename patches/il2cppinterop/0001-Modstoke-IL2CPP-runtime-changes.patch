+    static_assert(offsetof(Request, Count) == 40);
+    static_assert(offsetof(Request, Assembly) == 48);
+    static_assert(offsetof(Request, Mutex) == 56);
+    static_assert(offsetof(Request, Lock) == 64);
+    static_assert(offsetof(Request, Unlock) == 72);
+    static_assert(offsetof(Request, Window) == 80);
+    static_assert(offsetof(Request, Domain) == 88);
+    static_assert(offsetof(Request, GetDomain) == 96);
+    static_assert(offsetof(Request, GetThread) == 104);
+    static_assert(offsetof(Request, MonoManagerSlot) == 112);
+    static_assert(offsetof(Request, CallbackSlot) == 120);
+}
