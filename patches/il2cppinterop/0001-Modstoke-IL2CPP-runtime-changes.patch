new file mode 100644
index 0000000..acbffd6
--- /dev/null
+++ b/Il2CppInterop.HarmonySupport/InventoryCallTrace.cs
@@ -0,0 +1,146 @@
+using System.Globalization;
+using System.Reflection;
+using System.Runtime.InteropServices;
+using Il2CppInterop.Runtime;
+using Il2CppInterop.Runtime.InteropTypes;
+
+namespace Il2CppInterop.HarmonySupport;
+
+internal static class InventoryCallTrace
+{
+    private static readonly object Sync = new();
+    private static readonly Dictionary<string, int> Counts = new();
+    private static readonly StreamWriter Writer = Open();
+    private static readonly long Deadline = Environment.TickCount64 + 15 * 60 * 1000;
+    private static int sequence;
+
+    internal static bool Matches(MethodBase method) => Writer != null && ((method.DeclaringType?.FullName, method.Name) switch
+    {
+        ("TheForest.Items.Inventory.PlayerInventory", "TryEquip" or "AddItem") => true,
+        ("Sons.Inventory.InventoryEdibleItem", "TryPerformAction") => true,
+        ("TheForest.Player.Actions.PlayerConsumeItemAction", "ConsumeItem" or "ApplyStats" or "ConsumeComplete") => true,
+        ("Sons.Gameplay.PickUp" or "Sons.Gameplay.ClothingPickUp" or "Sons.Gameplay.GatherablePickup" or "Sons.Gameplay.ZiplinePickup", "Collect") => true,
+        ("Sons.Inventory.InventoryLayoutItemGroup", "OnInteractWithItem") => true,
+        _ => false
+    });
+
+    private static StreamWriter Open()
+    {
+        try
+        {
+            if (!string.Equals(Path.GetFileName(Environment.ProcessPath), "SonsOfTheForest.exe", StringComparison.OrdinalIgnoreCase))
+                return null;
+            var folder = Path.Combine(Path.GetDirectoryName(Environment.ProcessPath), "OpenACAI", "Runtime");
+            var flag = Path.Combine(folder, "inventory-diagnostic.once");
+            if (!File.Exists(flag)) return null;
+            var path = Path.Combine(folder, "inventory-diagnostic-" + DateTime.UtcNow.ToString("yyyyMMdd-HHmmss", CultureInfo.InvariantCulture)
+                + "-" + Environment.ProcessId + ".log");
+            var writer = new StreamWriter(new FileStream(path, FileMode.CreateNew, FileAccess.Write, FileShare.Read)) { AutoFlush = true };
+            try
+            {
+                writer.WriteLine("Inventory call diagnostic; bounded to 15 minutes and 64 calls per signature; no gameplay changes.");
+                File.Delete(flag);
+                return writer;
+            }
+            catch { writer.Dispose(); throw; }
+        }
+        catch { return null; }
+    }
+
+    public static int Begin(string signature)
+    {
+        try
+        {
+            lock (Sync)
+            {
+                if (Writer == null || Environment.TickCount64 >= Deadline) return 0;
+                Counts.TryGetValue(signature, out var count);
+                if (count >= 64) return 0;
+                Counts[signature] = count + 1;
+                int id = ++sequence;
+                Writer.WriteLine(DateTime.UtcNow.ToString("O", CultureInfo.InvariantCulture) + " #" + id + " ENTER " + signature);
+                return id;
+            }
+        }
+        catch { return 0; }
+    }
+
+    public static void Arguments(int id, object[] values)
+    {
+        if (id == 0) return;
+        try
+        {
+            lock (Sync)
+                for (int i = 0; i < values.Length; i++)
+                    Writer.WriteLine("#" + id + " ARG " + i + " " + Describe(values[i]));
+        }
+        catch { }
+    }
+
+    public static void Finish(int id, object result)
+    {
+        if (id == 0) return;
+        try { lock (Sync) Writer.WriteLine("#" + id + " RETURN " + Describe(result)); }
+        catch { }
+    }
+
+    public static void Failure(int id, Exception error, object[] values)
+    {
+        if (id == 0) return;
+        try
+        {
+            lock (Sync)
+            {
+                Writer.WriteLine("#" + id + " FAIL " + error);
+                for (int i = 0; i < values.Length; i++)
+                {
+                    Writer.WriteLine("#" + id + " FAILED-ARG " + i + " " + Describe(values[i]));
+                    if (values[i] is not Il2CppObjectBase native) continue;
+                    var type = native.GetType();
+                    if (!type.IsGenericType || type.GetGenericTypeDefinition() != typeof(Il2CppSystem.Nullable<>)) continue;
+                    var preloader = AppDomain.CurrentDomain.GetAssemblies()
+                        .FirstOrDefault(a => a.GetName().Name == "Modstoke.Preloader");
+                    var storage = preloader?.GetType("Modstoke.Preloader.InteropNativeValueStorage+ValueType`1");
+                    var field = storage?.MakeGenericType(type).GetField("Class", BindingFlags.NonPublic | BindingFlags.Static);
+                    if (field?.GetValue(null) is IntPtr expected)
+                        Writer.WriteLine("#" + id + " STORAGE-EXPECTED " + ClassName(expected) + " @0x" + expected.ToString("X"));
+                }
+            }
+        }
+        catch { }
+    }
+
+    private static string Describe(object value)
+    {
+        if (value == null) return "null";
+        if (value is not Il2CppObjectBase native)
+            return value.GetType().IsPrimitive || value.GetType().IsEnum ? Convert.ToString(value, CultureInfo.InvariantCulture) : value.GetType().FullName;
+        var type = value.GetType();
+        var actual = native.ObjectClass;
+        var expected = Il2CppClassPointerStore.GetNativeClassPointer(type);
+        var text = type.FullName + " actual=" + ClassName(actual) + " @0x" + actual.ToString("X")
+            + " expected=" + ClassName(expected) + " @0x" + expected.ToString("X");
+        if (IL2CPP.il2cpp_class_is_valuetype(actual))
+        {
+            uint alignment = 0;
+            var size = IL2CPP.il2cpp_class_value_size(actual, ref alignment);
+            if (size > 0 && size <= 32 && !IL2CPP.il2cpp_class_has_references(actual))
+            {
+                var bytes = new byte[size];
+                Marshal.Copy(IL2CPP.il2cpp_object_unbox(native.Pointer), bytes, 0, size);
+                text += " payload=" + Convert.ToHexString(bytes);
+            }
+        }
+        GC.KeepAlive(value);
+        return text;
+    }
+
+    private static string ClassName(IntPtr klass)
+    {
+        if (klass == IntPtr.Zero) return "<none>";
+        var name = IL2CPP.il2cpp_type_get_name(IL2CPP.il2cpp_class_get_type(klass));
+        try { return Marshal.PtrToStringUTF8(name) ?? "<unknown>"; }
+        finally { if (name != IntPtr.Zero) IL2CPP.il2cpp_free(name); }
+    }
+}
