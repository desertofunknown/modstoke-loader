+                "Native NavMesh restoration was not published during startup. Use a matching native host, runtime and preloader.");
+            return name switch
+            {
+                "NavMeshData" => graph.Data,
+                "NavMeshBuildSettings" => graph.Settings,
+                "NavMeshBuildDebugSettings" => graph.DebugSettings,
+                "NavMeshBuildDebugFlags" => graph.DebugFlags,
+                "NavMeshBuildSource" => graph.Source,
+                "NavMeshBuildMarkup" => graph.Markup,
+                "NavMeshBuildSourceShape" => graph.SourceShape,
+                "NavMeshCollectGeometry" => graph.CollectGeometry,
+                "NavMeshBuilder" => graph.Builder,
+                _ => throw new ArgumentException("The type is not part of the published NavMesh graph.", nameof(name))
+            };
+        }
+    }
