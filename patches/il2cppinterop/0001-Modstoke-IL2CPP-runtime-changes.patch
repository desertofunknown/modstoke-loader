@@ -0,0 +1,203 @@
+using System;
+using System.Collections.Generic;
+using System.Reflection;
+using System.Reflection.Emit;
+using System.Runtime.CompilerServices;
+using System.Runtime.InteropServices;
+
+namespace Il2CppInterop.Runtime.Injection;
+
+internal sealed class ManagedValueLayout
+{
+    private ManagedValueLayout(Type type, int size, int alignment, int packing,
+        IReadOnlyList<ManagedValueFieldLayout> fields)
+    {
+        Type = type;
+        Size = size;
+        Alignment = alignment;
+        Packing = packing;
+        Fields = fields;
+    }
+
+    public Type Type { get; }
+    public int Size { get; }
+    public int Alignment { get; }
+    public int Packing { get; }
+    public IReadOnlyList<ManagedValueFieldLayout> Fields { get; }
+
+    public static ManagedValueLayout Create(Type type)
+    {
+        if (type == null)
+            throw new ArgumentNullException(nameof(type));
+
+        return Create(type, new Dictionary<Type, ManagedValueLayout>(), new HashSet<Type>());
+    }
+
+    private static ManagedValueLayout Create(Type type, Dictionary<Type, ManagedValueLayout> completed,
+        HashSet<Type> active)
+    {
+        if (completed.TryGetValue(type, out var cached))
+            return cached;
+        if (!active.Add(type))
+            throw new NotSupportedException($"Recursive value layout is not supported: {type}.");
+
+        try
+        {
+            if (type == typeof(void) || type.IsPointer || type.IsByRef ||
+                type.IsByRefLike || !type.IsValueType)
+                throw new NotSupportedException($"Type {type} is not supported reference-free value data. References, pointers, function pointers and byref-like values are unsupported.");
+
+            var leaf = type.IsPrimitive || type.IsEnum || type == typeof(IntPtr) || type == typeof(UIntPtr);
+            if (type.ContainsGenericParameters)
+                throw new NotSupportedException($"Open generic {type} has no concrete value layout.");
+            if (!leaf && !type.IsLayoutSequential && !type.IsExplicitLayout)
+                throw new NotSupportedException($"Composite {type} must use Sequential or Explicit layout; Auto layout is unsupported.");
+            if (HasAttribute(type, "System.Runtime.CompilerServices.InlineArrayAttribute"))
+                throw new NotSupportedException($"Inline array {type} is unsupported: native field reflection cannot describe its full element storage.");
+
+            var packing = type.StructLayoutAttribute?.Pack ?? 0;
+            if (packing != 0 && (packing > 128 || packing < 1 || (packing & (packing - 1)) != 0))
+                throw new NotSupportedException($"Type {type} has unsupported packing {packing}.");
+
+            var fields = new List<ManagedValueFieldLayout>();
+            if (!leaf)
+            {
+                foreach (var field in type.GetFields(BindingFlags.Instance | BindingFlags.Public |
+                                                     BindingFlags.NonPublic | BindingFlags.DeclaredOnly))
+                {
+                    if (HasAttribute(field, typeof(FixedBufferAttribute).FullName!))
+                        throw new NotSupportedException($"Fixed buffer {type}.{field.Name} is unsupported: native field reflection cannot describe its full element storage.");
+                    if (IsFunctionPointerField(field))
+                        throw new NotSupportedException($"Function pointer field {type}.{field.Name} is unsupported.");
+
+                    var layout = Create(field.FieldType, completed, active);
+                    fields.Add(new ManagedValueFieldLayout(field, MeasureOffset(type, field), layout));
+                }
+            }
+
+            var size = MeasureSize(type);
+            var probe = typeof(AlignmentProbe<>).MakeGenericType(type);
+            var alignment = MeasureOffset(probe, probe.GetField(nameof(AlignmentProbe<int>.Value))!);
+            if (size <= 0)
+                throw new NotSupportedException($"Type {type} has invalid payload size {size}.");
+            if (alignment < 1 || alignment > 128 || (alignment & (alignment - 1)) != 0)
+                throw new NotSupportedException($"Type {type} has unsupported alignment {alignment}.");
+
+            foreach (var field in fields)
+            {
+                if (field.Offset < 0 || field.Offset > size || field.Layout.Size > size - field.Offset)
+                    throw new NotSupportedException($"Field {type}.{field.Field.Name} extends outside its {size}-byte payload.");
+            }
+
+            fields.Sort((left, right) =>
+            {
+                var comparison = left.Offset.CompareTo(right.Offset);
+                return comparison != 0 ? comparison : left.Field.MetadataToken.CompareTo(right.Field.MetadataToken);
+            });
+
+            var result = new ManagedValueLayout(type, size, alignment, packing, fields.AsReadOnly());
+            completed.Add(type, result);
+            return result;
+        }
+        finally
+        {
+            active.Remove(type);
+        }
+    }
+
+    private static bool HasAttribute(MemberInfo member, string fullName)
+    {
+        foreach (var attribute in member.GetCustomAttributesData())
+        {
+            if (attribute.AttributeType.FullName == fullName)
+                return true;
+        }
+
+        return false;
+    }
+
+    internal static bool IsFunctionPointerField(FieldInfo field)
+    {
+        // .NET 6 exposes function-pointer FieldType as IntPtr. Preserve the signature distinction.
+        var signature = field.Module.ResolveSignature(field.MetadataToken);
+        var index = 1; // Skip the FIELD calling convention.
+        while (index < signature.Length && (signature[index] == 0x1f || signature[index] == 0x20))
+        {
+            // CMOD_REQD / CMOD_OPT are followed by a compressed TypeDefOrRef token.
+            index++;
+            if (index >= signature.Length)
+                throw new NotSupportedException($"Invalid field signature for {field}.");
+            var prefix = signature[index];
+            if ((prefix & 0x80) == 0)
+                index++;
+            else if ((prefix & 0xc0) == 0x80)
+                index += 2;
+            else if ((prefix & 0xe0) == 0xc0)
+                index += 4;
+            else
+                throw new NotSupportedException($"Invalid field signature for {field}.");
+        }
+
+        if (index >= signature.Length || signature[0] != 0x06)
+            throw new NotSupportedException($"Invalid field signature for {field}.");
+        return signature[index] == 0x1b; // ELEMENT_TYPE_FNPTR
+    }
+
+    private static int MeasureSize(Type type)
+    {
+        var method = new DynamicMethod("ManagedValueSize", typeof(int), Type.EmptyTypes,
+            typeof(ManagedValueLayout).Module, true);
+        var il = method.GetILGenerator();
+        il.Emit(OpCodes.Sizeof, type);
+        il.Emit(OpCodes.Ret);
+        return ((Func<int>)method.CreateDelegate(typeof(Func<int>)))();
+    }
+
+    private static int MeasureOffset(Type type, FieldInfo field)
+    {
+        var method = new DynamicMethod("ManagedValueOffset", typeof(int), Type.EmptyTypes,
+            typeof(ManagedValueLayout).Module, true) { InitLocals = true };
+        var il = method.GetILGenerator();
+        var array = il.DeclareLocal(type.MakeArrayType());
+        var element = il.DeclareLocal(type.MakeByRefType(), pinned: true);
+        // Array storage is zeroed without constructors and keeps large payloads off the stack.
+        // Pin the element across both address conversions so a GC cannot invalidate the difference.
+        il.Emit(OpCodes.Ldc_I4_1);
+        il.Emit(OpCodes.Newarr, type);
+        il.Emit(OpCodes.Stloc, array);
+        il.Emit(OpCodes.Ldloc, array);
+        il.Emit(OpCodes.Ldc_I4_0);
+        il.Emit(OpCodes.Ldelema, type);
+        il.Emit(OpCodes.Stloc, element);
+        il.Emit(OpCodes.Ldloc, element);
+        il.Emit(OpCodes.Ldflda, field);
+        il.Emit(OpCodes.Conv_I);
+        il.Emit(OpCodes.Ldloc, element);
+        il.Emit(OpCodes.Conv_I);
+        il.Emit(OpCodes.Sub);
+        il.Emit(OpCodes.Conv_Ovf_I4);
+        il.Emit(OpCodes.Ret);
+        return ((Func<int>)method.CreateDelegate(typeof(Func<int>)))();
+    }
+
+    [StructLayout(LayoutKind.Sequential, Pack = 128)]
+    private struct AlignmentProbe<T>
+    {
+        public byte Prefix;
+        public T Value;
+    }
+}
+
+internal sealed class ManagedValueFieldLayout
+{
+    public ManagedValueFieldLayout(FieldInfo field, int offset, ManagedValueLayout layout)
+    {
+        Field = field;
+        Offset = offset;
+        Layout = layout;
+    }
+
+    public FieldInfo Field { get; }
+    public int Offset { get; }
+    public ManagedValueLayout Layout { get; }
+}
