+                Track(text);
+                return new NativeArgument { Kind = 0, Text = text };
+            }
+            if (argument.Class == Il2CppClassPointerStore<bool>.NativeClassPtr)
+            {
+                if (argument.Integer is not (0 or 1))
+                    throw new NotSupportedException("Native attribute Boolean values must be zero or one.");
+                return new NativeArgument { Kind = 2, Value = argument.Integer };
+            }
+            var klass = UnityVersionHandler.Wrap((Il2CppClass*)argument.Class);
+            var integer = Il2CppClassPointerStore<int>.NativeClassPtr;
+            if (klass == null || argument.Class != integer && (!klass.EnumType ||
+                IL2CPP.il2cpp_class_from_type(IL2CPP.il2cpp_class_enum_basetype(argument.Class)) != integer))
+                throw new NotSupportedException("Native attribute values require Boolean, Int32 or an Int32 enum.");
+            return new NativeArgument { Kind = 1, Value = argument.Integer };
+        }
+
+        IntPtr Allocate(int size)
+        {
+            if (size == 0) return IntPtr.Zero;
+            var pointer = Marshal.AllocCoTaskMem(size);
+            Track(pointer);
+            new Span<byte>((void*)pointer, size).Clear();
+            return pointer;
+        }
+        void Track(IntPtr pointer)
+        {
+            try { allocations.Add(pointer); }
+            catch { Marshal.FreeCoTaskMem(pointer); throw; }
+        }
+    }
+
+    public void Dispose()
+    {
+        var pointer = Interlocked.Exchange(ref batch, IntPtr.Zero);
+        if (pointer == IntPtr.Zero) return;
+        if (binding.Unregister(2, pointer) != 1)
+        {
+            Interlocked.Exchange(ref batch, pointer);
+            throw new InvalidOperationException("Native attribute records could not be removed; their owners must remain alive.");
+        }
+        RemovePresence();
+    }
+
+    private void RemovePresence()
+    {
+        foreach (var entry in entries)
+        {
+            if (entry.Kind == OwnerKind.Class) ValueTypeAttributes.RemoveClass(entry.Owner);
+            else if (entry.Kind == OwnerKind.Field) ValueTypeAttributes.RemoveField(entry.Owner);
+        }
+    }
+
+    internal static IntPtr Constructor(string image, string ns, string name, params IntPtr[] parameterClasses)
+    {
+        var klass = IL2CPP.GetIl2CppClass(image, ns, name);
+        if (klass == IntPtr.Zero) throw new NotSupportedException("The native attribute class is unavailable: " + name);
+        return Constructor(klass, parameterClasses);
+    }
+
+    private static IntPtr Constructor(IntPtr klass, params IntPtr[] parameterClasses)
+    {
+        if (klass == IntPtr.Zero || parameterClasses.Any(pointer => pointer == IntPtr.Zero))
+            throw new NotSupportedException("A native attribute constructor type is unavailable.");
+        InjectorHelpers.InitializeClass((Il2CppClass*)klass);
+        var iterator = IntPtr.Zero;
+        IntPtr method;
+        while ((method = IL2CPP.il2cpp_class_get_methods(klass, ref iterator)) != IntPtr.Zero)
+        {
+            if (Marshal.PtrToStringUTF8(IL2CPP.il2cpp_method_get_name(method)) != ".ctor" ||
+                IL2CPP.il2cpp_method_get_param_count(method) != parameterClasses.Length) continue;
+            var matches = true;
+            for (var i = 0; i < parameterClasses.Length; i++)
+            {
+                var parameter = IL2CPP.il2cpp_method_get_param(method, checked((uint)i));
+                var signature = UnityVersionHandler.Wrap((Il2CppTypeStruct*)parameter);
+                if (signature == null || signature.ByRef ||
+                    IL2CPP.il2cpp_class_from_type(parameter) != parameterClasses[i]) { matches = false; break; }
+            }
