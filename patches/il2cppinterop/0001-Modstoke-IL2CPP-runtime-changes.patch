+// SPDX-License-Identifier: LGPL-3.0-only
+using System;
+using System.Runtime.InteropServices;
+using System.Threading;
+using Il2CppInterop.Runtime.Runtime;
+using Il2CppInterop.Runtime.Startup;
+
+namespace Il2CppInterop.Runtime.Injection;
+
+internal sealed unsafe partial class NativeMethodParameterReflection
+{
+    private static readonly Lazy<AsyncBinding> AsyncShared = new(() => new AsyncBinding());
+    private static IDetour? failedAsyncHook;
+
+    internal void EnableAsyncMessages()
+    {
+        if (Volatile.Read(ref batch) == IntPtr.Zero)
+            throw new ObjectDisposedException(nameof(NativeMethodParameterReflection));
+        if (!ReferenceEquals(binding.Runtime, Il2CppInteropRuntime.Instance) ||
+            binding.Domain != IL2CPP.il2cpp_domain_get() || IL2CPP.il2cpp_thread_current() == IntPtr.Zero)
+            throw new NotSupportedException("Async message reflection requires the registration's attached native domain.");
+        _ = AsyncShared.Value;
+    }
+
+    [StructLayout(LayoutKind.Sequential)]
+    private struct AsyncConfiguration
+    {
+        internal IntPtr OriginalInitialize, ObjectClass, StringClass, ByteClass;
+    }
+
+    [UnmanagedFunctionPointer(CallingConvention.Cdecl)]
+    private delegate void InitializeMessage(IntPtr message, IntPtr reflectionMethod);
+    [UnmanagedFunctionPointer(CallingConvention.Cdecl)]
+    private delegate IntPtr GetAsyncEntry(uint abi);
+    [UnmanagedFunctionPointer(CallingConvention.Cdecl)]
+    private delegate uint ConfigureAsync(uint abi, ref AsyncConfiguration configuration, uint size);
+
+    private sealed class AsyncBinding
+    {
+        private readonly IDetour hook;
+
+        internal AsyncBinding()
+        {
+            var owner = Shared.Value;
+            if (Marshal.SizeOf<AsyncConfiguration>() != 32)
+                throw new PlatformNotSupportedException("Async message reflection requires the inspected x64 configuration.");
+            var target = InjectorHelpers.Il2CppModule.BaseAddress + 0x4E5C90;
+            var expected = Convert.FromHexString("48895C240848896C2410488974241857");
+            var actual = new byte[expected.Length];
+            Marshal.Copy(target, actual, 0, actual.Length);
+            if (!actual.AsSpan().SequenceEqual(expected))
+                throw new NotSupportedException("The native async message initializer was changed or does not match.");
+            RequireLayout("System.Reflection", "RuntimeMethodInfo", 40,
+                ("mhandle", 0x10), ("name", 0x18), ("reftype", 0x20));
+            RequireLayout("System.Runtime.Remoting.Messaging", "MonoMethodMessage", 120,
+                ("method", 0x10), ("args", 0x18), ("names", 0x20), ("arg_types", 0x28),
+                ("ctx", 0x30), ("rval", 0x38), ("exc", 0x40), ("asyncResult", 0x48),
+                ("call_type", 0x50), ("uri", 0x58), ("properties", 0x60),
+                ("identity", 0x68), ("methodSignature", 0x70));
+            var objectClass = Il2CppClassPointerStore<Il2CppSystem.Object>.NativeClassPtr;
+            var stringClass = Il2CppClassPointerStore<string>.NativeClassPtr;
+            var byteClass = Il2CppClassPointerStore<byte>.NativeClassPtr;
+            if (objectClass == IntPtr.Zero || stringClass == IntPtr.Zero || byteClass == IntPtr.Zero)
+                throw new NotSupportedException("Native async message array types are unavailable.");
+
+            var get = Marshal.GetDelegateForFunctionPointer<GetAsyncEntry>(
+                NativeAnimationCall.GetNativeExport("Il2CppInterop_GetAsyncMethodMessageEntry"));
+            var configure = Marshal.GetDelegateForFunctionPointer<ConfigureAsync>(
+                NativeAnimationCall.GetNativeExport("Il2CppInterop_ConfigureAsyncMethodMessages"));
+            var entry = get(1);
+            if (entry == IntPtr.Zero)
+                throw new NotSupportedException("The native async message adapter is unavailable.");
+            IDetour? candidate = null;
+            var configured = false;
+            try
+            {
+                candidate = owner.Runtime.DetourProvider.Create(target,
+                    Marshal.GetDelegateForFunctionPointer<InitializeMessage>(entry));
+                if (candidate.Detour != entry)
+                    throw new NotSupportedException("Async message forwarding must not introduce a managed frame.");
+                _ = candidate.GenerateTrampoline<InitializeMessage>();
+                var configuration = new AsyncConfiguration
+                {
+                    OriginalInitialize = candidate.OriginalTrampoline,
+                    ObjectClass = objectClass,
+                    StringClass = stringClass,
+                    ByteClass = byteClass
+                };
