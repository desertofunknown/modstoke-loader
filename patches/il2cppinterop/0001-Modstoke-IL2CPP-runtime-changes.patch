+    /// <summary>Bridges CLR handle storage and an exact native numeric NativeArray to a protected bulk call.</summary>
+    /// <remarks>
+    /// Generated public adapters pass their by-value stream local by reference here. The stream,
+    /// handle allocation and numeric allocation remain caller-owned and must stay live and synchronized.
+    /// Native handle resolution, masked writes and partial mutations are not copied or rolled back.
+    /// </remarks>
+    public static void InvokeBulkArray<TStream, THandle, TArray>(BulkArrayOperation operation,
+        ref TStream stream, IntPtr handles, int count, TArray buffer, bool useMask,
+        Func<Il2CppObjectBase, Exception> exceptionFactory)
+        where TStream : struct where THandle : struct where TArray : Il2CppObjectBase
