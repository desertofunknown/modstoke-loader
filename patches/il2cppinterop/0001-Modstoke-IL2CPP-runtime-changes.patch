+    }
+
+    [UnmanagedFunctionPointer(CallingConvention.Cdecl)] private delegate IntPtr Unary(IntPtr owner);
+    [UnmanagedFunctionPointer(CallingConvention.Cdecl)] private delegate IntPtr Binary(IntPtr owner, IntPtr filter);
+    [UnmanagedFunctionPointer(CallingConvention.Cdecl)] private delegate byte Predicate(IntPtr owner, IntPtr filter);
+    [UnmanagedFunctionPointer(CallingConvention.Cdecl)] private delegate IntPtr GetEntry(uint abi, uint kind);
+    [UnmanagedFunctionPointer(CallingConvention.Cdecl)] private delegate uint Configure(uint abi, ref Configuration config, uint size);
+    [UnmanagedFunctionPointer(CallingConvention.Cdecl)] private delegate IntPtr RegisterBatch(uint abi, NativeEntry* entries, uint count);
+    [UnmanagedFunctionPointer(CallingConvention.Cdecl)] private delegate uint UnregisterBatch(uint abi, IntPtr batch);
+
+    private static void ConfigureData(ref Configuration config)
+    {
+        var typedList = Il2CppClassPointerStore<Il2CppSystem.Collections.Generic.IList<Il2CppSystem.Reflection.CustomAttributeTypedArgument>>.NativeClassPtr;
+        var namedList = Il2CppClassPointerStore<Il2CppSystem.Collections.Generic.IList<Il2CppSystem.Reflection.CustomAttributeNamedArgument>>.NativeClassPtr;
+        var typedCollection = Il2CppClassPointerStore<Il2CppSystem.Collections.ObjectModel.ReadOnlyCollection<Il2CppSystem.Reflection.CustomAttributeTypedArgument>>.NativeClassPtr;
+        var namedCollection = Il2CppClassPointerStore<Il2CppSystem.Collections.ObjectModel.ReadOnlyCollection<Il2CppSystem.Reflection.CustomAttributeNamedArgument>>.NativeClassPtr;
+        if (typedList == IntPtr.Zero || namedList == IntPtr.Zero || typedCollection == IntPtr.Zero || namedCollection == IntPtr.Zero ||
