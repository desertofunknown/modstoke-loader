+    static_assert(offsetof(AsyncConfig, ObjectClass) == 8);
+    static_assert(offsetof(AsyncConfig, StringClass) == 16);
+    static_assert(offsetof(AsyncConfig, ByteClass) == 24);
+    static_assert(sizeof(MessageLayout) == 0x78);
+    static_assert(offsetof(MessageLayout, method) == 0x10);
+    static_assert(offsetof(MessageLayout, args) == 0x18);
+    static_assert(offsetof(MessageLayout, names) == 0x20);
+    static_assert(offsetof(MessageLayout, directions) == 0x28);
+    static_assert(offsetof(MessageLayout, asyncResult) == 0x48);
+    static_assert(offsetof(MessageLayout, callType) == 0x50);
+
+    std::mutex configurationMutex;
+    Config configuration{};
+    std::atomic<bool> configured{false};
+    std::mutex asyncConfigurationMutex;
+    AsyncConfig asyncConfiguration{};
+    std::atomic<bool> asyncConfigured{false};
+
+    template<typename T>
+    T Read(const void* address, std::size_t offset)
+    {
+        T value;
+        std::memcpy(&value, static_cast<const std::byte*>(address) + offset, sizeof(T));
+        return value;
+    }
+
+    class PinnedHandle
+    {
+    public:
+        explicit PinnedHandle(void* object) : handle(object == nullptr ? 0 : configuration.HandleNew(object, true))
+        {
+            if (handle == 0) throw std::bad_alloc();
+        }
+        ~PinnedHandle() noexcept
+        {
+            if (handle != 0) configuration.HandleFree(handle);
+        }
+        PinnedHandle(const PinnedHandle&) = delete;
+        PinnedHandle& operator=(const PinnedHandle&) = delete;
+        std::uint32_t Get() const noexcept { return handle; }
+        void Release() noexcept { handle = 0; }
+    private:
+        std::uint32_t handle;
+    };
+
+    struct Record
+    {
+        const void* method;
+        std::vector<std::string> names;
+        std::vector<std::uint32_t> defaults;
+        std::mutex cacheMutex;
+        std::unordered_map<void*, std::uint32_t> arrays;
+
+        ~Record() noexcept
+        {
+            for (const auto& item : arrays) configuration.HandleFree(item.second);
+            for (const auto handle : defaults)
+                if (handle != 0) configuration.HandleFree(handle);
+        }
+    };
+
+    using Records = std::unordered_map<const void*, std::shared_ptr<Record>>;
+    struct Registry
+    {
+        std::shared_mutex mutex;
+        Records records;
+    };
+
+    Registry& GetRegistry()
+    {
+        // Published records and their returned strings survive process shutdown ordering.
+        static Registry* registry = new Registry;
+        return *registry;
+    }
+
+    struct Batch
+    {
+        std::vector<std::shared_ptr<Record>> records;
+    };
+
+    std::shared_ptr<Record> Find(const void* method)
+    {
+        auto& registry = GetRegistry();
+        std::shared_lock<std::shared_mutex> lock(registry.mutex);
+        const auto found = registry.records.find(method);
+        return found == registry.records.end() ? nullptr : found->second;
+    }
+
+    void InitializeMessage(void* object, void* reflectionMethod)
+    {
+        (void)asyncConfigured.load(std::memory_order_acquire);
+        const auto* method = reflectionMethod == nullptr ? nullptr : Read<const void*>(reflectionMethod, 0x10);
+        const auto record = method == nullptr ? nullptr : Find(method);
+        if (object == nullptr || !record || Read<const void*>(method, 0x38) != nullptr)
+        {
+            asyncConfiguration.OriginalInitialize(object, reflectionMethod);
+            return;
+        }
+
+        auto* message = static_cast<MessageLayout*>(object);
+        configuration.WriteBarrier(message, &message->method, reflectionMethod);
+        const auto count = record->names.size();
+        const auto allocate = [message, count](void* klass, void** field)
+        {
+            void* const array = configuration.ArrayNew(klass, count);
+            if (array == nullptr) throw std::bad_alloc();
+            configuration.WriteBarrier(message, field, array);
+            return array;
+        };
+        allocate(asyncConfiguration.ObjectClass, &message->args);
+        allocate(asyncConfiguration.ByteClass, &message->directions);
+        configuration.WriteBarrier(message, &message->asyncResult, nullptr);
+        message->callType = 0;
+        void* const names = allocate(asyncConfiguration.StringClass, &message->names);
+        auto** elements = reinterpret_cast<void**>(static_cast<std::byte*>(names) + 0x20);
+        for (std::size_t i = 0; i < count; ++i)
+            configuration.WriteBarrier(names, &elements[i], configuration.StringNew(record->names[i].c_str()));
+
+        const auto types = Read<const void* const*>(method, 0x30);
+        auto* directions = static_cast<std::byte*>(message->directions) + 0x20;
+        for (std::size_t i = 0; i < count; ++i)
+        {
+            const auto flags = Read<std::uint32_t>(types[i], 8);
+            const bool byRef = (flags & 0x20000000u) != 0;
+            const bool output = (flags & 2u) != 0;
+            directions[i] = static_cast<std::byte>(byRef ? (output ? 2 : 3) : (output ? 5 : 1));
+        }
+        // The caller supplies argument values after initialization. Other message fields survive.
+    }
+
+    const char* GetName(const void* method, std::uint32_t index)
+    {
+        (void)configured.load(std::memory_order_acquire);
+        const auto record = Find(method);
+        if (!record) return configuration.OriginalGetName(method, index);
+        return index < record->names.size() ? record->names[index].c_str() : nullptr;
+    }
+
+    void* GetParameters(const void* method, void* reflectedClass)
+    {
+        (void)configured.load(std::memory_order_acquire);
+        const auto record = Find(method);
+        if (!record || record->names.empty())
+            return configuration.OriginalGetParameters(method, reflectedClass);
+
+        std::lock_guard<std::mutex> lock(record->cacheMutex);
+        const auto cached = record->arrays.find(reflectedClass);
+        if (cached != record->arrays.end()) return configuration.HandleGet(cached->second);
+
+        void* const array = configuration.ArrayNew(configuration.ArrayElementClass, record->names.size());
+        if (array == nullptr) throw std::bad_alloc();
+        PinnedHandle arrayHandle(array);
+        void* const member = configuration.GetMethodObject(method, reflectedClass);
+        PinnedHandle memberHandle(member);
+        const auto types = Read<const void* const*>(method, 0x30);
+        for (std::size_t i = 0; i < record->names.size(); ++i)
+        {
+            auto* const parameter = static_cast<ParameterLayout*>(configuration.ObjectNew(configuration.ParameterClass));
+            if (parameter == nullptr) throw std::bad_alloc();
+            auto** const element = reinterpret_cast<void**>(static_cast<std::byte*>(array) + 0x20 + i * sizeof(void*));
+            configuration.WriteBarrier(array, element, parameter);
+            const auto attributes = Read<std::uint16_t>(types[i], 8);
+            parameter->attributes = attributes;
+            parameter->position = static_cast<std::int32_t>(i);
+            configuration.WriteBarrier(parameter, &parameter->type, configuration.TypeGetObject(types[i]));
+            configuration.WriteBarrier(parameter, &parameter->member, member);
+            configuration.WriteBarrier(parameter, &parameter->name, configuration.StringNew(record->names[i].c_str()));
+            const auto handle = record->defaults[i];
+            void* const defaultValue = (attributes & 0x1000u) != 0
+                ? (handle == 0 ? nullptr : configuration.HandleGet(handle))
+                : configuration.DefaultValue(attributes);
+            configuration.WriteBarrier(parameter, &parameter->defaultValue, defaultValue);
+        }
