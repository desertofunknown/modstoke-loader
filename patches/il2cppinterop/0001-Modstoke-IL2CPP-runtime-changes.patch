+    // The image/class owner must retain all storage before publishing, then expose the assembly separately.
+    internal static NativeTypeNameLookup PrepareOwnedImage(string namespaze, IntPtr image,
+        IReadOnlyList<(string Name, IntPtr Class)> types) => new(namespaze, image, types, true);
