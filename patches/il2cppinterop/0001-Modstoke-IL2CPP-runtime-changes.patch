+    private static NativeJobSchedule CreateTransformSchedule<TTransforms>(NativeJobRegistration registration,
+        in TTransforms transforms, bool readOnly, int mode, int batchSize) where TTransforms : struct
+    {
+        ArgumentNullException.ThrowIfNull(registration);
