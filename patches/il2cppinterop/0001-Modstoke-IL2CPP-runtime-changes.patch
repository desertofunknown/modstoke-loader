+            var raw = (NativeClassStructHandler_29_1.Il2CppClass_29_1*)klass.Pointer;
+            if (raw->nested_type_count != 0 && raw->nestedTypes == null)
+                throw new NotSupportedException("Prepared native nesting has no complete child table.");
+            for (var i = 0; i < raw->nested_type_count; i++)
+                pending.Enqueue(((IntPtr)raw->nestedTypes[i], item.Class, names));
+        }
+        return result;
+    }
+
+    private static INativeClassStruct RequireClass(IntPtr pointer, IntPtr image)
+    {
+        var klass = UnityVersionHandler.Wrap((Il2CppClass*)pointer);
+        var signature = klass?.ByValArg;
+        if (klass == null || signature == null || (IntPtr)klass.Image != image || klass.Class != klass.ClassPointer ||
