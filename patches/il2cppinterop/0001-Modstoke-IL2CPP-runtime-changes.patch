+// SPDX-License-Identifier: LGPL-3.0-only
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Runtime.InteropServices;
+using System.Security.Cryptography;
+using System.Threading;
+using Il2CppInterop.Runtime.Runtime;
+using Il2CppInterop.Runtime.Runtime.VersionSpecific.Class;
+using Il2CppInterop.Runtime.Startup;
+
+namespace Il2CppInterop.Runtime.Injection;
+
+// Preparation is private; the owner must retain its class and assembly metadata before publication.
+internal sealed unsafe partial class NativeTypeNameLookup : IDisposable
+{
+    [StructLayout(LayoutKind.Sequential)]
+    private struct Configuration
+    {
+        internal IntPtr OriginalLookup, EqualsIgnoreCase;
+    }
+
+    [StructLayout(LayoutKind.Sequential)]
+    private struct NativeEntry
+    {
+        internal IntPtr Image, Class, Namespace;
+        internal uint NameCount;
+        internal IntPtr Names;
+    }
+
+    private readonly record struct Declaration(IntPtr Class, string Namespace, string[] Names);
+    private static readonly Lazy<Binding> Shared = new(() => new Binding());
+    private static Binding? failedBinding;
+    private readonly Binding binding;
+    private IntPtr batch;
+
+    internal NativeTypeNameLookup(string namespaze, IntPtr image, IReadOnlyList<(string Name, IntPtr Class)> types)
+        : this(namespaze, image, types, false) { }
+
+    private NativeTypeNameLookup(string namespaze, IntPtr image, IReadOnlyList<(string Name, IntPtr Class)> types,
+        bool ownedImage)
+    {
+        if (image == IntPtr.Zero || types.Count == 0 || namespaze.Contains('\0'))
+            throw new ArgumentException("Native type names require an image, namespace and complete class set.");
+        binding = Shared.Value;
+        binding.RequireContext();
+        var declarations = ReadDeclarations(namespaze, image, types);
+        var entries = new NativeEntry[declarations.Count];
+        var allocations = new List<IntPtr>();
+        try
+        {
+            for (var i = 0; i < declarations.Count; i++)
+            {
+                var declaration = declarations[i];
+                var names = Allocate(checked(declaration.Names.Length * IntPtr.Size));
+                for (var index = 0; index < declaration.Names.Length; index++)
+                    Marshal.WriteIntPtr(names, checked(index * IntPtr.Size), String(declaration.Names[index]));
+                entries[i] = new NativeEntry
+                {
+                    Image = image, Class = declaration.Class, Namespace = String(declaration.Namespace),
+                    NameCount = checked((uint)declaration.Names.Length), Names = names
+                };
+            }
+            if (ownedImage) batch = PrepareOwnedBatch(image, entries, declarations);
+            else
+                fixed (NativeEntry* pointer = entries)
+                    batch = binding.Prepare(1, pointer, checked((uint)entries.Length));
+            if (batch == IntPtr.Zero)
+                throw new NotSupportedException("Native type-name preparation rejected its declarations or duplicate names.");
+            if (ownedImage) AddOwnedAssembly(image);
+            else AddEnumeration(image, declarations);
+        }
+        catch
+        {
+            Dispose();
+            throw;
+        }
+        finally
+        {
+            for (var i = allocations.Count - 1; i >= 0; i--) Marshal.FreeCoTaskMem(allocations[i]);
+        }
+
+        IntPtr Allocate(int bytes)
+        {
+            var pointer = Marshal.AllocCoTaskMem(bytes);
+            Track(pointer);
+            return pointer;
+        }
+        IntPtr String(string value)
+        {
+            var pointer = Marshal.StringToCoTaskMemUTF8(value);
+            Track(pointer);
+            return pointer;
+        }
+        void Track(IntPtr pointer)
+        {
+            try { allocations.Add(pointer); }
+            catch { Marshal.FreeCoTaskMem(pointer); throw; }
+        }
+    }
+
+    private static List<Declaration> ReadDeclarations(string namespaze, IntPtr image,
+        IReadOnlyList<(string Name, IntPtr Class)> types)
+    {
+        var result = new List<Declaration>();
+        var pending = new Queue<(IntPtr Class, IntPtr Parent, string[] Names)>();
+        var seen = new HashSet<IntPtr>();
+        foreach (var type in types)
+        {
+            var klass = RequireClass(type.Class, image);
+            if (klass.DeclaringType != null || Marshal.PtrToStringUTF8(klass.Name) != type.Name ||
+                Marshal.PtrToStringUTF8(klass.Namespace) != namespaze)
+                throw new NotSupportedException("A prepared root differs from its original native name or namespace.");
+            pending.Enqueue((type.Class, IntPtr.Zero, Array.Empty<string>()));
+        }
+        while (pending.TryDequeue(out var item))
+        {
+            if (!seen.Add(item.Class))
+                throw new NotSupportedException("Prepared native nesting repeats a class or contains a cycle.");
+            var klass = RequireClass(item.Class, image);
