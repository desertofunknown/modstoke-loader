+++ b/Il2CppInterop.Runtime/Injection/NativeTransitionAnimations.cs
@@ -0,0 +1,215 @@
+// SPDX-License-Identifier: LGPL-3.0-only
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Runtime.InteropServices;
+using System.Security.Cryptography;
+using System.Threading;
+using Il2CppInterop.Runtime.InteropTypes;
+using Il2CppInterop.Runtime.Runtime;
+using Il2CppInterop.Runtime.Runtime.VersionSpecific.MethodInfo;
+using Il2CppInterop.Runtime.Startup;
+
+namespace Il2CppInterop.Runtime.Injection;
+
+/// <summary>Retains a native VisualElement receiver for restored transition animation calls.</summary>
+public static class NativeTransitionAnimations
+{
+    private const string AssemblyName = "UnityEngine.UIElementsModule.dll";
+    private const string Namespace = "UnityEngine.UIElements";
+    private static readonly Lazy<Binding> Shared = new(() => new Binding());
+
+    /// <remarks>
+    /// Acquire and use the receiver on an attached thread in its original native domain. Dispose the lease in
+    /// a finally block after the forwarded call completes; do not dispose it concurrently with that call.
+    /// T must be the generated VisualElement wrapper. Only original UIElements descendants inheriting its
+    /// transition animation implementation are accepted.
+    /// </remarks>
+    public static Receiver<T> Acquire<T>(Il2CppObjectBase receiver) where T : Il2CppObjectBase
+    {
+        ArgumentNullException.ThrowIfNull(receiver);
+        var runtime = Il2CppInteropRuntime.Instance;
+        runtime.RetainNativeJob();
+        T? value = null;
+        try
+        {
+            var domain = IL2CPP.il2cpp_domain_get();
+            if (domain == IntPtr.Zero || IL2CPP.il2cpp_thread_current() == IntPtr.Zero)
+                throw new InvalidOperationException("Transition animations require an attached native-domain thread.");
+            var binding = Shared.Value;
+            if (!ReferenceEquals(binding.Runtime, runtime) || binding.Domain != domain)
+                throw new InvalidOperationException("Transition animations cannot cross native runtimes or domains.");
+            if (typeof(T).FullName != Namespace + ".VisualElement" ||
+                typeof(T).Assembly.GetName().Name != "UnityEngine.UIElementsModule" || typeof(T).IsGenericType ||
+                Il2CppClassPointerStore<T>.NativeClassPtr != binding.VisualElement)
+                throw new ArgumentException("The transition receiver wrapper must have the exact native VisualElement identity.");
+
+            binding.RequireReceiver(IL2CPP.il2cpp_object_get_class(receiver.Pointer));
+            value = receiver.Cast<T>();
+            return new Receiver<T>(runtime, domain, receiver, value);
+        }
+        catch
+        {
+            try { runtime.ReleaseNativeJob(); }
+            finally
+            {
+                GC.KeepAlive(value);
+                GC.KeepAlive(receiver);
+            }
+            throw;
+        }
+    }
+
+    /// <summary>Keeps the receiver wrappers and their original runtime alive through a forwarded call.</summary>
+    public sealed class Receiver<T> : IDisposable where T : Il2CppObjectBase
+    {
+        private readonly Il2CppInteropRuntime runtime;
+        private readonly IntPtr domain;
+        private readonly Il2CppObjectBase receiver;
+        private readonly T value;
+        private int disposed;
+
+        internal Receiver(Il2CppInteropRuntime runtime, IntPtr domain, Il2CppObjectBase receiver, T value)
+        {
+            this.runtime = runtime;
+            this.domain = domain;
+            this.receiver = receiver;
+            this.value = value;
+        }
+
+        /// <summary>Gets the validated wrapper while this lease remains active.</summary>
+        public T Value
+        {
+            get
+            {
+                if (Volatile.Read(ref disposed) != 0) throw new ObjectDisposedException(nameof(Receiver<T>));
+                if (!ReferenceEquals(runtime, Il2CppInteropRuntime.Instance) ||
+                    IL2CPP.il2cpp_domain_get() != domain || IL2CPP.il2cpp_thread_current() == IntPtr.Zero)
+                    throw new InvalidOperationException("The transition receiver requires its original attached native domain.");
+                return value;
+            }
+        }
+
+        public void Dispose()
+        {
+            if (Interlocked.Exchange(ref disposed, 1) != 0) return;
+            try { runtime.ReleaseNativeJob(); }
+            finally
+            {
+                GC.KeepAlive(value);
+                GC.KeepAlive(receiver);
+            }
+        }
+    }
+
+    private sealed class Binding
+    {
+        internal readonly Il2CppInteropRuntime Runtime = Il2CppInteropRuntime.Instance;
+        internal readonly IntPtr Domain = IL2CPP.il2cpp_domain_get();
+        internal readonly IntPtr VisualElement;
+        private readonly IntPtr image;
+        private readonly IntPtr transitions;
+        private readonly HashSet<IntPtr> originalDefinitions = new();
+        private readonly HashSet<IntPtr> validatedReceivers = new();
+        private readonly object gate = new();
+
+        internal Binding()
+        {
+            if (!OperatingSystem.IsWindows() || RuntimeInformation.ProcessArchitecture != Architecture.X64 ||
+                Runtime.UnityVersion != new Version(2022, 2, 16) || Domain == IntPtr.Zero ||
+                UnityVersionHandler.methodInfoStructHandler is not NativeMethodInfoStructHandler_29_1)
+                throw new PlatformNotSupportedException("Transition animations require the inspected Windows x64 metadata-29 ABI.");
+            using (var stream = File.OpenRead(InjectorHelpers.Il2CppModule.FileName!))
+            using (var hash = SHA256.Create())
+                if (Convert.ToHexString(hash.ComputeHash(stream)) !=
+                    "9BEED2673A205A07F9CB00A6911CA7B3372F74F98F8AA05D90A021423980AA9B")
+                    throw new NotSupportedException("Transition animations require the inspected GameAssembly image.");
+
+            image = IL2CPP.GetIl2CppImage(AssemblyName);
+            if (image == IntPtr.Zero)
+                throw new NotSupportedException("The native UIElements image is unavailable.");
+            var count = IL2CPP.il2cpp_image_get_class_count(image);
+            for (uint index = 0; index < count; index++)
+            {
+                var definition = IL2CPP.il2cpp_image_get_class(image, index);
+                if (definition == IntPtr.Zero || IL2CPP.il2cpp_class_get_image(definition) != image ||
+                    RuntimeSpecificsStore.IsInjected(definition) || IL2CPP.il2cpp_class_is_inflated(definition) ||
+                    !originalDefinitions.Add(definition))
+                    throw new NotSupportedException("The native UIElements image has inconsistent original type definitions.");
+            }
+            // Published synthetic classes can share this image without belonging to its original definition table.
+            VisualElement = IL2CPP.GetIl2CppClass(AssemblyName, Namespace, "VisualElement");
+            transitions = IL2CPP.GetIl2CppClass(AssemblyName, Namespace + ".Experimental", "ITransitionAnimations");
+            if (!originalDefinitions.Contains(VisualElement) || !originalDefinitions.Contains(transitions) ||
+                IL2CPP.il2cpp_class_is_valuetype(VisualElement) || IL2CPP.il2cpp_class_is_interface(VisualElement) ||
+                IL2CPP.il2cpp_class_is_generic(VisualElement) || !IL2CPP.il2cpp_class_is_interface(transitions) ||
+                IL2CPP.il2cpp_class_is_generic(transitions) || !DeclaresTransitions(VisualElement) ||
+                !IL2CPP.il2cpp_class_is_assignable_from(transitions, VisualElement))
+                throw new NotSupportedException("The original VisualElement transition animation contract is unavailable.");
+            validatedReceivers.Add(VisualElement);
+        }
+
+        internal void RequireReceiver(IntPtr pointer)
+        {
+            lock (gate)
+            {
+                if (validatedReceivers.Contains(pointer)) return;
+                if (pointer == IntPtr.Zero || !IL2CPP.il2cpp_class_is_assignable_from(VisualElement, pointer) ||
+                    !IL2CPP.il2cpp_class_is_assignable_from(transitions, pointer))
+                    throw new ArgumentException("The transition receiver must inherit the native VisualElement implementation.");
+                var visited = new HashSet<IntPtr>();
+                for (var current = pointer; current != VisualElement; current = IL2CPP.il2cpp_class_get_parent(current))
+                {
+                    if (current == IntPtr.Zero || !visited.Add(current))
+                        throw new NotSupportedException("The native transition receiver has an invalid VisualElement ancestry.");
+                    RequireOriginalDefinition(current);
+                    if (DeclaresTransitions(current))
+                        throw new NotSupportedException("The native transition receiver redeclares ITransitionAnimations.");
+                }
+                // Cache only after the complete ancestry is proven to inherit the inspected implementation.
+                validatedReceivers.Add(pointer);
+            }
+        }
+
+        private void RequireOriginalDefinition(IntPtr pointer)
+        {
+            if (IL2CPP.il2cpp_class_get_image(pointer) != image || RuntimeSpecificsStore.IsInjected(pointer) ||
+                IL2CPP.il2cpp_class_is_valuetype(pointer) || IL2CPP.il2cpp_class_is_interface(pointer))
+                throw new NotSupportedException("Transition receivers must use original native UIElements classes.");
+            if (!IL2CPP.il2cpp_class_is_inflated(pointer))
+            {
+                if (!originalDefinitions.Contains(pointer) || IL2CPP.il2cpp_class_is_generic(pointer))
+                    throw new NotSupportedException("The native transition receiver is not an original closed UIElements type.");
+                return;
+            }
+
+            var reflected = Il2CppType.TypeFromPointer(pointer);
+            Il2CppSystem.Type? definition = null;
+            try
+            {
+                if (reflected.ContainsGenericParameters)
+                    throw new NotSupportedException("A generic transition receiver must be closed.");
+                definition = reflected.GetGenericTypeDefinition();
+                var original = definition == null ? IntPtr.Zero : IL2CPP.il2cpp_class_from_system_type(definition.Pointer);
+                if (!originalDefinitions.Contains(original) || RuntimeSpecificsStore.IsInjected(original) ||
+                    IL2CPP.il2cpp_class_get_image(original) != image || !IL2CPP.il2cpp_class_is_generic(original) ||
+                    IL2CPP.il2cpp_class_is_inflated(original))
+                    throw new NotSupportedException("The generic transition receiver does not resolve to an original UIElements definition.");
+            }
+            finally
+            {
+                GC.KeepAlive(definition);
+                GC.KeepAlive(reflected);
+            }
+        }
+
+        private bool DeclaresTransitions(IntPtr pointer)
+        {
+            var cursor = IntPtr.Zero;
+            for (var contract = IL2CPP.il2cpp_class_get_interfaces(pointer, ref cursor); contract != IntPtr.Zero;
+                contract = IL2CPP.il2cpp_class_get_interfaces(pointer, ref cursor))
+                if (contract == transitions) return true;
+            return false;
+        }
+    }
+}
