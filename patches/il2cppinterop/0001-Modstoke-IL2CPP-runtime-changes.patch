+        var fromName = InjectorHelpers.GetIl2CppExport("il2cpp_class_from_name");
+        if (fromName != RequireEntry(0x535A10, 5,
+                "0269B2898D5403DECE1A92C0EFE614278C1298134CAECE68600BBF824ED4EEBC"))
+            throw new NotSupportedException("The owned-image name export has an inconsistent address.");
+        // Its body may already carry our injection detour; validate and reuse that hook's target.
+        InjectorHelpers.EnableOwnedImageNameResolution(InjectorHelpers.Il2CppModule.BaseAddress + 0x551B70);
+        var arrayClass = OwnedArrayClass.Value;
+        IntPtr prepared;
+        fixed (NativeEntry* namePointer = names)
+        fixed (EnumerationEntry* typePointer = entries)
+            prepared = binding.PrepareOwned(1, namePointer, checked((uint)names.Length), typePointer,
+                checked((uint)entries.Length), arrayClass);
