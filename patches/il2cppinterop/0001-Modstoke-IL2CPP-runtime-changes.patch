@@ -0,0 +1,96 @@
+// SPDX-License-Identifier: LGPL-3.0-only
+using System;
+using System.Reflection;
+using System.Runtime.CompilerServices;
+using System.Runtime.ExceptionServices;
+using System.Threading;
+using Il2CppInterop.Runtime.InteropTypes;
+using Il2CppInterop.Runtime.Runtime;
+using Il2CppInterop.Runtime.Startup;
+
+namespace Il2CppInterop.Runtime.Injection;
+
+/// <summary>Publishes WWW's native declaration graph with all restored bodies bound before assembly exposure.</summary>
+public static class NativeWwwRegistration
+{
+    // Keep generator admission disabled until the owned native assembly-reference contract is established.
+    public const int PublishedGraphVersion = 0;
+    private static readonly object Gate = new();
+    private static NativeWwwMetadata? published;
+    private static ExceptionDispatchInfo? failure;
+    [ThreadStatic] private static NativeWwwMetadata? preparing;
+
+    public static IntPtr RequirePublishedClass() => RequireGraph().Class;
+
+    /// <summary>Runs the original CustomYieldInstruction constructor on an existing compatible WWW receiver.</summary>
+    public static void InitializeBase(Il2CppObjectBase receiver) => RequireGraph().InitializeBase(receiver);
+
+    /// <summary>Binds all forty-seven static bridges once, from the matching generated WWW initializer.</summary>
+    public static void BindBodies<T>(IntPtr nativeClass, Delegate[] callbacks, Type hashType, Type cachedBundleType)
+        where T : Il2CppObjectBase => RequireGraph().BindBodies<T>(nativeClass, callbacks, hashType, cachedBundleType);
+
+    /// <summary>Copies a borrowed CachedAssetBundle payload into its matching rooted native value proxy.</summary>
+    public static T ReadCachedAssetBundle<T>(IntPtr payload) where T : Il2CppObjectBase
+    {
+        if (typeof(T) != RequireGraph().CachedBundleType)
+            throw new ArgumentException("The WWW aggregate bridge requires its matching CachedAssetBundle proxy.", nameof(T));
+        return NativeValueReference<T>.Read(payload, false);
+    }
+
+    /// <summary>Requires the attached initial bootstrap thread before Unity's managed assembly cache exists.</summary>
+    internal static void PublishDuringBootstrap(IntPtr query)
+    {
+        var window = NativeTypePublication.GetWindow(query);
+        lock (Gate)
+        {
+            failure?.Throw();
+            if (published != null)
+            {
+                published.RequireContext();
+                return;
+            }
+            var runtime = Il2CppInteropRuntime.Instance;
+            runtime.RetainNativeJob();
+            try
+            {
+                var player = NativeTypePublication.RequirePlayer();
+                NativeTypePublication.RequireEarlyWindow(window, player);
+                using var graph = new NativeWwwMetadata();
+                using var names = NativeTypeNameLookup.PrepareOwnedImage("UnityEngine", graph.Image,
+                    new[] { ("WWW", graph.Class) });
+                NativeTypePublication.RequireEarlyWindow(window, player);
+                graph.Retain();
+                preparing = graph;
+                try
+                {
+                    // Its cctor uses this thread's graph directly, before domain/cache publication.
+                    var assembly = Assembly.Load(new AssemblyName(NativeWwwImage.AssemblyName));
+                    var wrapper = assembly.GetType("UnityEngine.WWW", throwOnError: true)!;
+                    RuntimeHelpers.RunClassConstructor(wrapper.TypeHandle);
+                    if (!graph.BodiesBound)
+                        throw new InvalidOperationException("The generated WWW wrapper did not bind all restored bodies.");
+                    NativeTypePublication.RequireEarlyWindow(window, player);
+                    names.Publish();
+                    graph.PublishImage(query, player);
+                    Volatile.Write(ref published, graph);
+                }
+                finally { preparing = null; }
+            }
+            catch (Exception error)
+            {
+                Volatile.Write(ref failure, ExceptionDispatchInfo.Capture(error));
+                throw;
+            }
+            finally { runtime.ReleaseNativeJob(); }
+        }
+    }
+
+    private static NativeWwwMetadata RequireGraph()
+    {
+        Volatile.Read(ref failure)?.Throw();
+        var graph = Volatile.Read(ref published) ?? preparing ?? throw new InvalidOperationException(
+            "Native WWW was not published during startup. Use a matching native host, runtime and preloader.");
+        graph.RequireContext();
+        return graph;
+    }
+}
