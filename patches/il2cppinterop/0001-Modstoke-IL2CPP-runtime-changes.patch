diff --git a/Il2CppInterop.Native/AnimationInvokers.cpp b/Il2CppInterop.Native/AnimationInvokers.cpp
new file mode 100644
index 0000000..6080afc
--- /dev/null
+++ b/Il2CppInterop.Native/AnimationInvokers.cpp
@@ -0,0 +1,104 @@
+// SPDX-License-Identifier: LGPL-3.0-only
+#include <cstdint>
+
+#if defined(_WIN32)
+#define INTEROP_EXPORT extern "C" __declspec(dllexport)
+#else
+#define INTEROP_EXPORT extern "C" __attribute__((visibility("default")))
+#endif
+
+namespace
+{
+    // These frames remain native so il2cpp_runtime_invoke can catch Unity's C++ exceptions.
+    using Invoker = void (*)(void*, const void*, void*, void**, void*);
+
+    void BoolReferencesPointer(void* method, const void*, void*, void** args, void* result)
+    {
+        *static_cast<bool*>(result) =
+            reinterpret_cast<bool (*)(void*, void*, std::intptr_t)>(method)(
+                args[0], args[1], *static_cast<std::intptr_t*>(args[2]));
+    }
+
+    void PointerReference(void* method, const void*, void*, void** args, void* result)
+    {
+        *static_cast<std::intptr_t*>(result) =
+            reinterpret_cast<std::intptr_t (*)(void*)>(method)(args[0]);
+    }
+
+    void ObjectReference(void* method, const void*, void*, void** args, void* result)
+    {
+        *static_cast<void**>(result) = reinterpret_cast<void* (*)(void*)>(method)(args[0]);
+    }
+
+    void VoidReference(void* method, const void*, void*, void** args, void*)
+    {
+        reinterpret_cast<void (*)(void*)>(method)(args[0]);
+    }
+
+    void VoidReferences(void* method, const void*, void*, void** args, void*)
+    {
+        reinterpret_cast<void (*)(void*, void*)>(method)(args[0], args[1]);
+    }
+
+    void VoidReferenceIntReference(void* method, const void*, void*, void** args, void*)
+    {
+        reinterpret_cast<void (*)(void*, std::int32_t, void*)>(method)(
+            args[0], *static_cast<std::int32_t*>(args[1]), args[2]);
+    }
+
+    void FloatReference(void* method, const void*, void*, void** args, void* result)
+    {
+        *static_cast<float*>(result) = reinterpret_cast<float (*)(void*)>(method)(args[0]);
+    }
+
+    void FloatReferenceInt(void* method, const void*, void*, void** args, void* result)
+    {
+        *static_cast<float*>(result) = reinterpret_cast<float (*)(void*, std::int32_t)>(method)(
+            args[0], *static_cast<std::int32_t*>(args[1]));
+    }
+
+    void BoolReference(void* method, const void*, void*, void** args, void* result)
+    {
+        *static_cast<bool*>(result) = reinterpret_cast<bool (*)(void*)>(method)(args[0]);
+    }
+
+    void IntReference(void* method, const void*, void*, void** args, void* result)
+    {
+        *static_cast<std::int32_t*>(result) = reinterpret_cast<std::int32_t (*)(void*)>(method)(args[0]);
+    }
+
+    void VoidReferencePointersInt(void* method, const void*, void*, void** args, void*)
+    {
+        reinterpret_cast<void (*)(void*, void*, void*, std::int32_t)>(method)(
+            args[0], *static_cast<void**>(args[1]), *static_cast<void**>(args[2]),
+            *static_cast<std::int32_t*>(args[3]));
+    }
+
+    void VoidReferencePointersIntBool(void* method, const void*, void*, void** args, void*)
+    {
+        reinterpret_cast<void (*)(void*, void*, void*, std::int32_t, bool)>(method)(
+            args[0], *static_cast<void**>(args[1]), *static_cast<void**>(args[2]),
+            *static_cast<std::int32_t*>(args[3]), *static_cast<bool*>(args[4]));
+    }
+}
+
+INTEROP_EXPORT Invoker Il2CppInterop_GetAnimationInvoker(std::uint32_t abi, std::uint32_t signature)
+{
+    if (abi != 1) return nullptr;
+    switch (signature)
+    {
+        case 0: return &BoolReferencesPointer;
+        case 1: return &PointerReference;
+        case 2: return &ObjectReference;
+        case 3: return &VoidReference;
+        case 4: return &VoidReferences;
+        case 5: return &VoidReferenceIntReference;
+        case 6: return &FloatReference;
+        case 7: return &FloatReferenceInt;
+        case 8: return &BoolReference;
+        case 9: return &IntReference;
+        case 10: return &VoidReferencePointersInt;
+        case 11: return &VoidReferencePointersIntBool;
+        default: return nullptr;
+    }
+}
diff --git a/Il2CppInterop.Native/AnimationLifecycle.cpp b/Il2CppInterop.Native/AnimationLifecycle.cpp
new file mode 100644
index 0000000..45ebe64
--- /dev/null
+++ b/Il2CppInterop.Native/AnimationLifecycle.cpp
@@ -0,0 +1,59 @@
+// SPDX-License-Identifier: LGPL-3.0-only
+#include <atomic>
+#include <cstdint>
+
+#if defined(_WIN32)
+#define INTEROP_EXPORT extern "C" __declspec(dllexport)
+#else
+#define INTEROP_EXPORT extern "C" __attribute__((visibility("default")))
+#endif
+
+namespace
+{
+    using Destructor = void* (*)(void*, std::uint32_t);
+    using Begin = void* (*)(void*);
+    using End = void (*)(void*, int);
+
+    std::atomic_flag configurationClaimed = ATOMIC_FLAG_INIT;
+    std::atomic<Destructor> originalDestructor{nullptr};
+    Begin beginLifecycle = nullptr;
+    End endLifecycle = nullptr;
+
+    void* AnimationDestructor(void* node, std::uint32_t deleteFlags)
+    {
+        // The detour is installed only after configuration publishes all three pointers.
+        const Destructor original = originalDestructor.load(std::memory_order_acquire);
+        void* const token = beginLifecycle(node);
+        void* result;
+        try
+        {
+            result = original(node, deleteFlags);
+        }
+        catch (...)
+        {
+            if (token != nullptr) endLifecycle(token, 0);
+            throw;
+        }
+
+        if (token != nullptr) endLifecycle(token, 1);
+        return result;
+    }
+}
+
+INTEROP_EXPORT void* Il2CppInterop_GetAnimationDestructor(std::uint32_t abi)
+{
+    if (abi != 1) return nullptr;
+    return reinterpret_cast<void*>(&AnimationDestructor);
+}
+
+INTEROP_EXPORT int Il2CppInterop_ConfigureAnimationLifecycle(
+    std::uint32_t abi, void* original, void* begin, void* end)
+{
+    if (abi != 1 || original == nullptr || begin == nullptr || end == nullptr) return 0;
+    if (configurationClaimed.test_and_set(std::memory_order_relaxed)) return 0;
+
+    beginLifecycle = reinterpret_cast<Begin>(begin);
+    endLifecycle = reinterpret_cast<End>(end);
+    originalDestructor.store(reinterpret_cast<Destructor>(original), std::memory_order_release);
+    return 1;
+}
