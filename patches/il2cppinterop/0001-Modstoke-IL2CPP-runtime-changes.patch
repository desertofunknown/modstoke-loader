+    {
+        void* header[2];
+        void* method;
+        void* args;
+        void* names;
+        void* directions;
+        void* context;
+        void* result;
+        void* exception;
+        void* asyncResult;
+        std::int32_t callType;
+        std::uint32_t padding;
+        void* uri;
+        void* properties;
