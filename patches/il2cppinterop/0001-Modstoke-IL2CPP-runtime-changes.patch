+++ b/Il2CppInterop.Runtime/Injection/ValueTypeInjector.cs
@@ -0,0 +1,308 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Reflection;
+using System.Runtime.InteropServices;
+using System.Text;
+using Il2CppInterop.Runtime.Runtime;
+using Il2CppInterop.Runtime.Runtime.VersionSpecific.Class;
+using Il2CppInterop.Runtime.Runtime.VersionSpecific.FieldInfo;
+using Il2CppInterop.Runtime.Runtime.VersionSpecific.Type;
+using Il2CppInterop.Runtime.Startup;
+
+namespace Il2CppInterop.Runtime.Injection;
+
+/// <summary>Registers reference-free data layouts for native field inspection and payload copying.</summary>
+/// <remarks>
+/// This is not method, interface, constructor, generic-type or custom-attribute-object injection.
+/// Returned classes and their metadata remain valid for the process lifetime. CLR class-pointer
+/// stores and name lookup are deliberately unchanged; callers must use the returned data identity.
+/// Closed generics are represented by their concrete field layouts, not native generic instances.
+/// </remarks>
+public static unsafe class ValueTypeInjector
+{
+    // Native field metadata retains this bit independently of CLR formatter serialization.
+    private const ushort FieldAttributeNotSerialized = 0x0080;
+    private static readonly object Gate = new();
+    private static readonly Dictionary<Type, Registration> Registrations = new();
+
+    internal static IntPtr FindRegisteredDataType(Type type)
+    {
+        lock (Gate)
+            return Registrations.TryGetValue(type, out var registration) ? registration.Pointer : IntPtr.Zero;
+    }
+
+    /// <summary>Gets a native data class with the exact CLR payload size, alignment and field offsets.</summary>
+    /// <param name="type">A closed, reference-free value type with sequential or explicit layout.</param>
+    /// <param name="attributeTypes">Explicit CLR marker-attribute to native attribute-proxy mappings.</param>
+    public static IntPtr RegisterDataType(Type type, IReadOnlyDictionary<Type, Type>? attributeTypes = null)
+    {
+        ArgumentNullException.ThrowIfNull(type);
+        RequireSupportedLayout();
+        // Reject ineligible graphs before installing hooks or publishing any native metadata.
+        var layout = ManagedValueLayout.Create(type);
+        var plan = Plan.Create(layout, attributeTypes);
+        lock (Gate)
+        {
+            ValidateExistingPlans(plan, new HashSet<Type>());
+            InjectorHelpers.Setup();
+            ValueTypeAttributes.InstallHooks();
+            using var transaction = new RegistrationTransaction();
+            var pointer = transaction.Register(plan);
+            transaction.Commit();
+            return pointer;
+        }
+    }
+
+    private static void RequireSupportedLayout()
+    {
+        var version = Il2CppInteropRuntime.Instance.UnityVersion;
+        if (!OperatingSystem.IsWindows() || IntPtr.Size != 8 || version.Major != 2022 ||
+            version.Minor != 2 || version.Build != 16 ||
+            UnityVersionHandler.classStructHandler is not NativeClassStructHandler_29_1 ||
+            UnityVersionHandler.fieldInfoStructHandler is not NativeFieldInfoStructHandler_24_0 ||
+            UnityVersionHandler.typeStructHandler is not NativeTypeStructHandler_27_0)
+            throw new NotSupportedException("Native data registration currently requires Windows x64 Unity 2022.2.16 metadata.");
+    }
+
+    private static void ValidateExistingPlans(Plan plan, HashSet<Type> visited)
+    {
+        if (!visited.Add(plan.Layout.Type)) return;
+        if (Registrations.TryGetValue(plan.Layout.Type, out var existing) && !existing.Plan.Matches(plan))
+            throw new InvalidOperationException($"Native data attributes for {plan.Layout.Type} differ from its existing registration.");
+        foreach (var child in plan.Fields) ValidateExistingPlans(child, visited);
+    }
+
+    private sealed class Plan
+    {
+        internal ManagedValueLayout Layout { get; }
+        internal IntPtr[] Attributes { get; }
+        internal IntPtr[][] FieldAttributes { get; }
+        internal Plan[] Fields { get; }
+        internal IntPtr NativeClass { get; }
+
+        private Plan(ManagedValueLayout layout, IntPtr[] attributes, IntPtr[][] fieldAttributes, Plan[] fields,
+            IntPtr nativeClass = default)
+        {
+            Layout = layout;
+            Attributes = attributes;
+            FieldAttributes = fieldAttributes;
+            Fields = fields;
+            NativeClass = nativeClass;
+        }
+
+        internal static Plan Create(ManagedValueLayout layout, IReadOnlyDictionary<Type, Type>? mappings) =>
+            Create(layout, mappings, new Dictionary<Type, Plan>());
+
+        private static Plan Create(ManagedValueLayout layout, IReadOnlyDictionary<Type, Type>? mappings,
+            Dictionary<Type, Plan> completed)
+        {
+            if (completed.TryGetValue(layout.Type, out var existing)) return existing;
+            if (layout.Alignment > IntPtr.Size)
+                throw new NotSupportedException($"Over-aligned payload {layout.Type} needs a separate native allocation contract.");
+            if (NativeJobPayloadPlan.TryGetNativeClass(layout.Type, out var nativeClass))
+            {
+                // The exact container header codec validates this existing class and its native fields.
+                // Retain its native container identity and attributes instead of inventing a new one.
+                var native = new Plan(layout, Array.Empty<IntPtr>(), Array.Empty<IntPtr[]>(), Array.Empty<Plan>(), nativeClass);
+                completed.Add(layout.Type, native);
+                return native;
+            }
+            if (layout.Type.IsPrimitive || layout.Type.IsEnum)
+            {
+                var scalar = new Plan(layout, Array.Empty<IntPtr>(), Array.Empty<IntPtr[]>(), Array.Empty<Plan>());
+                completed.Add(layout.Type, scalar);
+                return scalar;
+            }
+            var fields = layout.Fields.Select(field => Create(field.Layout, mappings, completed)).ToArray();
+            var attributes = ValueTypeAttributes.Resolve(layout.Type, mappings);
+            var fieldAttributes = layout.Fields.Select(field => ValueTypeAttributes.Resolve(field.Field, mappings)).ToArray();
+            var plan = new Plan(layout, attributes, fieldAttributes, fields);
+            completed.Add(layout.Type, plan);
+            return plan;
+        }
+
+        internal bool Matches(Plan other) => NativeClass == other.NativeClass && Attributes.SequenceEqual(other.Attributes) &&
+            FieldAttributes.Length == other.FieldAttributes.Length &&
+            FieldAttributes.Select((set, i) => set.SequenceEqual(other.FieldAttributes[i])).All(equal => equal);
+    }
+
+    private sealed record Registration(Plan Plan, IntPtr Pointer);
+
+    private sealed class RegistrationTransaction : IDisposable
+    {
+        private readonly List<IntPtr> _allocations = new();
+        private readonly List<long> _tokens = new();
+        private readonly List<IntPtr> _classes = new();
+        private readonly List<IntPtr> _fields = new();
+        private readonly Dictionary<Type, Registration> _pending = new();
+        private bool _committed;
+
+        internal IntPtr Register(Plan plan)
+        {
+            var layout = plan.Layout;
+            if (Registrations.TryGetValue(layout.Type, out var existing)) return existing.Pointer;
+            if (_pending.TryGetValue(layout.Type, out existing)) return existing.Pointer;
+            if (plan.NativeClass != IntPtr.Zero) return plan.NativeClass;
+            if (layout.Type.IsPrimitive || layout.Type.IsEnum)
+                return ResolveNativeScalar(layout);
+
+            var fieldTypes = plan.Fields.Select(Register).ToArray();
+            var baseClass = UnityVersionHandler.Wrap((Il2CppClass*)Il2CppClassPointerStore<Il2CppSystem.ValueType>.NativeClassPtr);
+            if (baseClass == null) throw new NotSupportedException("The native System.ValueType class is unavailable.");
+            InjectorHelpers.InitializeClass(baseClass.ClassPointer);
+            if (baseClass.InstanceSize != sizeof(Il2CppObject))
+                throw new NotSupportedException("The native value-type object header does not match this registration layout.");
+
+            var klass = UnityVersionHandler.NewClass(baseClass.VtableCount);
+            _allocations.Add(klass.Pointer);
+            var byValArg = klass.ByValArg ??
+                throw new NotSupportedException("The native data class has no by-value type metadata.");
+            var thisArg = klass.ThisArg ??
+                throw new NotSupportedException("The native data class has no by-reference type metadata.");
+            var raw = (NativeClassStructHandler_29_1.Il2CppClass_29_1*)klass.Pointer;
+            klass.Image = InjectorHelpers.RequireInjectedImage().ImagePointer;
+            klass.Class = klass.CastClass = klass.ElementClass = klass.ClassPointer;
+            klass.Parent = baseClass.ClassPointer;
+            klass.Name = String(layout.Type.FullName ?? layout.Type.Name);
+            klass.Namespace = String("Il2CppInterop.Data");
+            // Synthetic data identity, not a counterfeit CLR type with missing methods/interfaces.
+            klass.Flags = Il2CppClassAttributes.TYPE_ATTRIBUTE_PUBLIC | Il2CppClassAttributes.TYPE_ATTRIBUTE_SEALED |
+                Il2CppClassAttributes.TYPE_ATTRIBUTE_EXPLICIT_LAYOUT;
+            klass.InstanceSize = klass.ActualSize = checked((uint)(sizeof(Il2CppObject) + layout.Size));
+            raw->stack_slot_size = raw->element_size = checked((uint)layout.Size);
+            klass.NativeSize = -1; // No P/Invoke marshaling contract is supplied by data registration.
+            raw->minimumAlignment = checked((byte)layout.Alignment);
+            raw->packingSize = checked((byte)layout.Packing);
+            raw->cctor_finished_or_no_cctor = 1;
+            klass.ValueType = true;
+            klass.SizeInited = klass.Initialized = klass.InitializedAndNoError = klass.IsVtableInitialized = true;
+            klass.HasFinalize = klass.EnumType = klass.IsGeneric = false;
+
+            var token = InjectorHelpers.CreateClassToken(klass.Pointer);
+            _tokens.Add(token);
+            thisArg.Data = byValArg.Data = (IntPtr)token;
+            thisArg.Type = byValArg.Type = Il2CppTypeEnum.IL2CPP_TYPE_VALUETYPE;
+            thisArg.ByRef = true;
+            klass.VtableCount = baseClass.VtableCount;
+            var tableBytes = checked(baseClass.VtableCount * sizeof(VirtualInvokeData));
+            Buffer.MemoryCopy((void*)baseClass.VTable, (void*)klass.VTable, tableBytes, tableBytes);
+            klass.TypeHierarchyDepth = checked((byte)(baseClass.TypeHierarchyDepth + 1));
+            klass.TypeHierarchy = (Il2CppClass**)Allocate(checked(klass.TypeHierarchyDepth * IntPtr.Size));
+            for (var i = 0; i < baseClass.TypeHierarchyDepth; i++) klass.TypeHierarchy[i] = baseClass.TypeHierarchy[i];
+            klass.TypeHierarchy[baseClass.TypeHierarchyDepth] = klass.ClassPointer;
+
+            klass.FieldCount = checked((ushort)layout.Fields.Count);
+            klass.Fields = (Il2CppFieldInfo*)Allocate(checked(klass.FieldCount * UnityVersionHandler.FieldInfoSize()));
+            for (var i = 0; i < layout.Fields.Count; i++)
+            {
+                var fieldLayout = layout.Fields[i];
+                var field = UnityVersionHandler.Wrap(klass.Fields + i * UnityVersionHandler.FieldInfoSize()) ??
+                    throw new InvalidOperationException($"Native field metadata for {fieldLayout.Field} is unavailable.");
