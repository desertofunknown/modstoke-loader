+        RaiseException(error, exceptionFactory);
+    }
+
+    private static BulkBinding GetBulkBinding(CallLease lease)
+    {
+        GetBinding(lease);
+        lock (Gate) return bulk ??= new BulkBinding();
+    }
+
+    private enum BulkOperation
+    {
+        ReadSceneInts, ReadSceneFloats, ReadStreamInts, ReadStreamFloats, WriteStreamInts, WriteStreamFloats
+    }
+
+    private sealed class BulkBinding
+    {
