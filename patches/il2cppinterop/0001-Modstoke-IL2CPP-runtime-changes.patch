diff --git a/Il2CppInterop.Runtime/Injection/NativeJobScheduler.cs b/Il2CppInterop.Runtime/Injection/NativeJobScheduler.cs
new file mode 100644
index 0000000..91d7dde
--- /dev/null
+++ b/Il2CppInterop.Runtime/Injection/NativeJobScheduler.cs
@@ -0,0 +1,191 @@
+using System;
+using System.Runtime.CompilerServices;
+using System.Runtime.InteropServices;
+
+namespace Il2CppInterop.Runtime.Injection;
+
+/// <summary>Submits supported CLR payloads to Unity's native job scheduler.</summary>
+/// <remarks>
+/// Windows x64 Unity 2022.2.16 only. Unity copies the payload before submission returns;
+/// changes to that copy are not copied back. Embedded pointer targets remain caller-owned
+/// and must survive completion. Complete or dispose each job or an owned downstream job,
+/// even after IsCompleted reports true. Complete reports producer failures in its dependency graph;
+/// registration-wide history remains available separately. Handle-returning methods require
+/// completion observers to release ownership across copied Unity handles.
+/// Exact NativeArray, NativeSlice and NativeArray.ReadOnly wrapper fields are projected to copied
+/// native headers; backing buffers remain caller-owned. Other references and automatic disposal are unsupported.
+/// </remarks>
+public static unsafe partial class NativeJobScheduler
+{
+    public static NativeJob Schedule<T>(NativeJobRegistration registration, in T payload,
+        NativeJob? dependency = null) where T : struct =>
+        Submit(registration, in payload, dependency, new NativeJobSchedule(NativeJobScheduleKind.Single, 2));
+
+    /// <summary>Schedules an indexed payload in single-job mode and returns its owner.</summary>
+    /// <remarks>
+    /// Complete or dispose the returned job or an owned downstream job, even after IsCompleted reports true.
+    /// Embedded pointer targets and projected native-container backing buffers must survive completion.
+    /// </remarks>
+    public static NativeJob ScheduleFor<T>(NativeJobRegistration registration, in T payload,
+        int length, NativeJob? dependency = null) where T : struct
+    {
+        if (length < 0) throw new ArgumentOutOfRangeException(nameof(length));
+        return Submit(registration, in payload, dependency,
+            new NativeJobSchedule(NativeJobScheduleKind.ParallelFor, 2, length, length));
+    }
+
+    public static NativeJob ScheduleParallelFor<T>(NativeJobRegistration registration, in T payload,
+        int length, int batchSize, NativeJob? dependency = null) where T : struct
+    {
+        if (length < 0) throw new ArgumentOutOfRangeException(nameof(length));
+        if (batchSize < 1) throw new ArgumentOutOfRangeException(nameof(batchSize));
+        return Submit(registration, in payload, dependency,
+            new NativeJobSchedule(NativeJobScheduleKind.ParallelFor, 1, length, batchSize));
+    }
+
+    public static void Run<T>(NativeJobRegistration registration, in T payload) where T : struct
+    {
+        using var job = Submit(registration, in payload, null, new NativeJobSchedule(NativeJobScheduleKind.Single, 0));
+        job.Complete();
+    }
+
+    public static void RunParallelFor<T>(NativeJobRegistration registration, in T payload,
+        int length) where T : struct
+    {
+        if (length < 0) throw new ArgumentOutOfRangeException(nameof(length));
+        using var job = Submit(registration, in payload, null,
+            new NativeJobSchedule(NativeJobScheduleKind.ParallelFor, 0, length, Math.Max(1, length)));
+        job.Complete();
+    }
+
+    private static NativeJob Submit<T>(NativeJobRegistration registration, in T payload,
+        NativeJob? dependency, in NativeJobSchedule schedule) where T : struct
+        => Submit(registration, in payload, dependency, in schedule, out _);
+
+    private static NativeJob Submit<T>(NativeJobRegistration registration, in T payload,
+        NativeJob? dependency, in NativeJobSchedule schedule,
+        out bool dependencyRetained) where T : struct
+    {
+        dependencyRetained = false;
+        ArgumentNullException.ThrowIfNull(registration);
+        RequireOutsideCallback();
+        if (RuntimeHelpers.IsReferenceOrContainsReferences<T>())
+            NativeJobPayloadPlan.Get(typeof(T));
+        if (registration.ManagedPayloadType != typeof(T))
+            throw new ArgumentException("The payload must have the registration's exact CLR type.", nameof(payload));
+        var runtime = registration.Runtime;
+        runtime.RetainNativeJob();
+        NativeJob? job = null;
+        try
+        {
+            var binding = NativeJobBindings.Get(runtime);
+            var reflection = registration.GetExecutionRegistration<T>().RequireSchedulingData();
+            job = new NativeJob(binding, registration, dependency);
+            // The caller's struct can be large. Keep the temporary copy off the managed stack.
+            var storage = new NativeJobEnvelope<T>[1];
+            ref var envelope = ref storage[0];
+            envelope.Payload = payload;
+            envelope.Execution = job.Execution!.Token;
+            // Completion cannot invalidate the dependency while its handle is being submitted.
+            if (dependency == null)
+                Invoke(job, in envelope, reflection, default, in schedule);
+            else
+                lock (dependency.Gate)
+                    Invoke(job, in envelope, reflection, dependency.GetDependency(binding), in schedule);
+            dependencyRetained = true;
+            return job;
+        }
+        catch (Exception error)
+        {
+            if (job == null || !job.SubmissionStarted)
+            {
+                if (job == null) runtime.ReleaseNativeJob();
+                else job.MarkCompleted();
+                throw;
+            }
+            // Run never enqueues this payload; the native stack has unwound before returning here.
+            if (schedule.Mode == 0)
+            {
+                job.MarkCompleted();
+                throw;
+            }
+            dependencyRetained = true;
+            job.SubmissionException = error;
+            throw new NativeJobSchedulingException(job, error);
+        }
+    }
+
+    private static void Invoke<T>(NativeJob job, in T payload, IntPtr reflection,
+        NativeJobHandle dependency, in NativeJobSchedule schedule) where T : struct
+    {
+        if (RuntimeHelpers.IsReferenceOrContainsReferences<T>())
+        {
+            ProjectedInvocation<T>.Invoke(job, in payload, reflection, dependency, in schedule);
+            return;
+        }
+        InvokeReferenceFree(job, in payload, reflection, dependency, in schedule);
+    }
+
+    private static void InvokeReferenceFree<T>(NativeJob job, in T payload, IntPtr reflection,
+        NativeJobHandle dependency, in NativeJobSchedule schedule) where T : struct
+    {
+        if (RuntimeHelpers.IsReferenceOrContainsReferences<T>())
+            throw new NotSupportedException("The native job projection still contains managed references.");
+        fixed (byte* pointer = &Unsafe.As<T, byte>(ref Unsafe.AsRef(in payload)))
+        {
+            var parameters = new NativeJobScheduleParameters
+            {
+                Dependency = dependency,
+                ScheduleMode = schedule.Mode,
+                ReflectionData = reflection,
+                JobDataPtr = (IntPtr)pointer
+            };
+            job.Binding.Submit(job, ref parameters, in schedule);
+        }
+    }
+
+    internal static void RequireOutsideCallback()
+    {
+        if (NativeJobCallback.IsInvoking)
+            throw new InvalidOperationException("Do not submit or wait for native jobs from a managed job callback.");
+    }
+}
+
+[StructLayout(LayoutKind.Sequential)]
+internal struct NativeJobHandle
+{
+    internal ulong JobGroup;
+    internal int Version;
+}
+
+[StructLayout(LayoutKind.Sequential)]
+internal unsafe struct NativeJobScheduleParameters
+{
+    internal NativeJobHandle Dependency;
+    internal int ScheduleMode;
+    internal IntPtr ReflectionData;
+    internal IntPtr JobDataPtr;
+}
+
+internal enum NativeJobScheduleKind { Single, ParallelFor, Transform, TransformReadOnly, Particle, ParallelForDeferred }
+
+internal readonly struct NativeJobSchedule
+{
+    internal readonly NativeJobScheduleKind Kind;
+    internal readonly int Mode;
+    internal readonly int Length;
+    internal readonly int BatchSize;
+    internal readonly IntPtr AdditionalData;
+    internal readonly IntPtr SafetyHandleData;
+
+    internal NativeJobSchedule(NativeJobScheduleKind kind, int mode, int length = 0, int batchSize = 0,
+        IntPtr additionalData = default, IntPtr safetyHandleData = default)
+    {
+        Kind = kind;
+        Mode = mode;
+        Length = length;
+        BatchSize = batchSize;
+        AdditionalData = additionalData;
+        SafetyHandleData = safetyHandleData;
+    }
+}
