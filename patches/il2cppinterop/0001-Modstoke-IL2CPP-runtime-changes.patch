--- /dev/null
+++ b/Il2CppInterop.Runtime/Injection/NativeMethodParameterReflection.cs
@@ -0,0 +1,302 @@
+// SPDX-License-Identifier: LGPL-3.0-only
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Reflection;
+using System.Runtime.InteropServices;
+using System.Security.Cryptography;
+using System.Threading;
+using Il2CppInterop.Runtime.Runtime;
+using Il2CppInterop.Runtime.Startup;
+
+namespace Il2CppInterop.Runtime.Injection;
+
+// The owning graph must retain this registration before any method escapes preparation.
+internal sealed unsafe partial class NativeMethodParameterReflection : IDisposable
+{
+    internal readonly record struct Entry(IntPtr Method, string[] Names, Il2CppSystem.Object?[]? DefaultValues = null);
+
+    [StructLayout(LayoutKind.Sequential)]
+    private struct NativeEntry
+    {
+        internal IntPtr Method;
+        internal uint Count;
+        internal IntPtr Names;
+        internal IntPtr DefaultValues;
+    }
+
+    [StructLayout(LayoutKind.Sequential)]
+    private struct Configuration
+    {
+        internal IntPtr OriginalGetName, OriginalGetParameters, GetMethodObject, TypeGetObject;
+        internal IntPtr ArrayNew, ObjectNew, StringNew, HandleNew, HandleGet, HandleFree;
+        internal IntPtr WriteBarrier, DefaultValue, ArrayElementClass, ParameterClass;
+    }
+
+    private static readonly Lazy<Binding> Shared = new(() => new Binding());
+    private static IDetour? failedNamesHook;
+    private static IDetour? failedParametersHook;
+    private readonly Binding binding;
+    private IntPtr batch;
+
+    internal NativeMethodParameterReflection(IEnumerable<Entry> source)
+    {
+        var runtime = Il2CppInteropRuntime.Instance;
+        var domain = IL2CPP.il2cpp_domain_get();
+        if (!runtime.NativeJobsReady || domain == IntPtr.Zero || IL2CPP.il2cpp_thread_current() == IntPtr.Zero)
+            throw new InvalidOperationException("Parameter reflection requires an attached live-domain thread.");
+        binding = Shared.Value;
+        if (!ReferenceEquals(binding.Runtime, runtime) || binding.Domain != domain)
+            throw new NotSupportedException("Parameter reflection cannot survive runtime or domain replacement.");
+        var entries = source.ToArray();
+        if (entries.Length == 0)
+            throw new ArgumentException("A method registration cannot be empty.", nameof(source));
+        var native = new NativeEntry[entries.Length];
+        var strings = new List<IntPtr>();
+        try
+        {
+            for (var i = 0; i < entries.Length; i++)
+            {
+                var names = entries[i].Names;
+                var defaults = entries[i].DefaultValues;
+                if (defaults != null && defaults.Length != names.Length)
+                    throw new ArgumentException("Parameter defaults must match the method's parameter count.", nameof(source));
+                if (defaults != null && (entries[i].Method == IntPtr.Zero ||
+                    IL2CPP.il2cpp_method_get_param_count(entries[i].Method) != names.Length))
+                    throw new ArgumentException("Parameter defaults require a matching native method signature.", nameof(source));
+                var table = names.Length == 0 ? IntPtr.Zero : Allocate(checked(names.Length * IntPtr.Size));
+                var values = defaults == null || defaults.Length == 0
+                    ? IntPtr.Zero : Allocate(checked(defaults.Length * IntPtr.Size));
+                for (var index = 0; index < names.Length; index++)
+                {
+                    if (string.IsNullOrEmpty(names[index]) || names[index].Contains('\0'))
+                        throw new ArgumentException("Each parameter needs its complete source name.", nameof(source));
+                    var name = Marshal.StringToCoTaskMemUTF8(names[index]);
+                    Track(name);
+                    Marshal.WriteIntPtr(table, index * IntPtr.Size, name);
+                    if (defaults != null)
+                        Marshal.WriteIntPtr(values, index * IntPtr.Size, DefaultPointer(entries[i].Method, index, defaults[index]));
+                }
+                native[i] = new NativeEntry
+                {
+                    Method = entries[i].Method, Count = checked((uint)names.Length), Names = table, DefaultValues = values
+                };
+            }
+            fixed (NativeEntry* pointer = native)
+                batch = binding.Register(2, pointer, checked((uint)native.Length));
+            if (batch == IntPtr.Zero)
+                throw new NotSupportedException("The native parameter reflection registration rejected its descriptors.");
+        }
+        finally
+        {
+            GC.KeepAlive(entries);
+            for (var i = strings.Count - 1; i >= 0; i--) Marshal.FreeCoTaskMem(strings[i]);
+        }
+
+        IntPtr Allocate(int size)
+        {
+            var value = Marshal.AllocCoTaskMem(size);
+            Track(value);
+            return value;
+        }
+        void Track(IntPtr value)
+        {
+            try { strings.Add(value); }
+            catch { Marshal.FreeCoTaskMem(value); throw; }
+        }
+    }
+
+    private static IntPtr DefaultPointer(IntPtr method, int index, Il2CppSystem.Object? value)
+    {
+        var parameter = IL2CPP.il2cpp_method_get_param(method, checked((uint)index));
+        var type = UnityVersionHandler.Wrap((Il2CppTypeStruct*)parameter);
+        if (type == null)
+            throw new NotSupportedException("A parameter default has no native type.");
+        if ((type.Attrs & (ushort)ParameterAttributes.HasDefault) == 0)
+        {
+            if (value != null) throw new ArgumentException("A parameter without a default cannot carry a default value.");
+            return IntPtr.Zero;
+        }
+        var expected = IL2CPP.il2cpp_class_from_type(parameter);
+        if (type.ByRef || expected == IntPtr.Zero)
+            throw new NotSupportedException("A parameter default requires a resolved, by-value native type.");
+        if (value == null)
+        {
+            if (IL2CPP.il2cpp_class_is_valuetype(expected))
+                throw new ArgumentException("A native value-type default must be boxed.");
+            return IntPtr.Zero;
+        }
+        var pointer = value.Pointer;
+        var actual = IL2CPP.il2cpp_object_get_class(pointer);
+        if (actual != expected && !IL2CPP.il2cpp_class_is_assignable_from(expected, actual))
+            throw new ArgumentException("A parameter default has an incompatible native type.");
+        return pointer;
+    }
+
+    public void Dispose()
+    {
+        var value = Interlocked.Exchange(ref batch, IntPtr.Zero);
+        if (value != IntPtr.Zero && binding.Unregister(1, value) != 1)
+        {
+            Interlocked.Exchange(ref batch, value);
+            throw new InvalidOperationException("Native parameter records could not be removed; their method storage must remain alive.");
+        }
+    }
+
+    [UnmanagedFunctionPointer(CallingConvention.Cdecl)]
+    private delegate IntPtr GetName(IntPtr method, uint index);
+    [UnmanagedFunctionPointer(CallingConvention.Cdecl)]
+    private delegate IntPtr GetParameters(IntPtr method, IntPtr reflectedClass);
+    [UnmanagedFunctionPointer(CallingConvention.Cdecl)]
+    private delegate IntPtr GetEntry(uint abi, uint kind);
