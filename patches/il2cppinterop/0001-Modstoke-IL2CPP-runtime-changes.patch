+// SPDX-License-Identifier: LGPL-3.0-only
+using System;
+using Il2CppInterop.Runtime.InteropTypes;
+using Il2CppInterop.Runtime.Startup;
+
+namespace Il2CppInterop.Runtime.Injection;
+
+/// <summary>Creates native UIElements query callbacks from native selectors.</summary>
+public static class NativeVisualQuery
+{
+    /// <remarks>
+    /// Call on an attached native thread. Keep the returned wrapper alive until the query completes or retains it.
+    /// Each invocation selects one value and appends it; null inputs fail only when the callback uses them.
+    /// </remarks>
+    public static Il2CppSystem.Action<T> CreateProjection<T, TResult>(
+        Il2CppSystem.Collections.Generic.List<TResult>? result, Il2CppSystem.Func<T, TResult>? selector)
+        where T : Il2CppObjectBase
+    {
+        var runtime = Il2CppInteropRuntime.Instance;
+        runtime.RetainNativeJob();
+        try
+        {
+            if (IL2CPP.il2cpp_domain_get() == IntPtr.Zero || IL2CPP.il2cpp_thread_current() == IntPtr.Zero)
+                throw new InvalidOperationException("Creating a visual query projection requires an attached native-domain thread.");
+            var visualElement = IL2CPP.GetIl2CppClass("UnityEngine.UIElementsModule.dll", "UnityEngine.UIElements", "VisualElement");
+            if (visualElement == IntPtr.Zero)
+                throw new NotSupportedException("The native UIElements VisualElement type is unavailable.");
+            var elementClass = Il2CppClassPointerStore<T>.NativeClassPtr;
+            if (elementClass == IntPtr.Zero || !IL2CPP.il2cpp_class_is_assignable_from(visualElement, elementClass))
+                throw new ArgumentException("The query element must have a native VisualElement identity.");
+
+            Action<T> callback = value =>
+            {
+                try { result!.Add(selector!.Invoke(value)); }
+                finally
+                {
+                    GC.KeepAlive(value);
+                    GC.KeepAlive(selector);
+                    GC.KeepAlive(result);
+                }
+            };
+            return DelegateSupport.ConvertDelegate<Il2CppSystem.Action<T>>(callback)!;
+        }
+        finally { runtime.ReleaseNativeJob(); }
+    }
+}
