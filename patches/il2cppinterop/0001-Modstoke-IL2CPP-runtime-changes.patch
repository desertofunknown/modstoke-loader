+INTEROP_EXPORT std::uint32_t Il2CppInterop_PublishTypeNameLookup(std::uint32_t abi, void* pending) noexcept
+{
+    if (abi != 1 || pending == nullptr || (!configured.load(std::memory_order_acquire) &&
+        !enumerationConfigured.load(std::memory_order_acquire))) return 0;
+    auto& owned = *static_cast<Pending*>(pending);
+    if (owned.published.load(std::memory_order_acquire)) return 1;
+    auto expected = owned.baseline;
+    if (!std::atomic_compare_exchange_strong_explicit(&GetRegistry().snapshot, &expected, owned.prepared,
+        std::memory_order_acq_rel, std::memory_order_acquire)) return 0;
+    owned.published.store(true, std::memory_order_release);
+    return 1;
+}
