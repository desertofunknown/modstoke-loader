+        {
+            BulkArrayOperation.ReadSceneInts => BulkOperation.ReadSceneInts,
+            BulkArrayOperation.ReadSceneFloats => BulkOperation.ReadSceneFloats,
+            BulkArrayOperation.ReadStreamInts => BulkOperation.ReadStreamInts,
+            BulkArrayOperation.ReadStreamFloats => BulkOperation.ReadStreamFloats,
+            BulkArrayOperation.WriteStreamInts => BulkOperation.WriteStreamInts,
+            BulkArrayOperation.WriteStreamFloats => BulkOperation.WriteStreamFloats,
+            _ => throw new ArgumentOutOfRangeException(nameof(operation))
+        };
+        var scene = rawOperation is BulkOperation.ReadSceneInts or BulkOperation.ReadSceneFloats;
+        if (BulkArrayShape<TStream, THandle>.IsScene != scene)
+            throw new NotSupportedException("The bulk animation operation requires its exact CLR handle type.");
