+                    "m_AllocatorLabel" when kind == ContainerKind.Array => (4, 12, IsExactType(fieldType, allocator)),
+                    _ => (0, 0, false)
+                };
+                if (bit == 0 || (found & bit) != 0 || !matches ||
+                    IL2CPP.il2cpp_field_get_parent(field) != klass ||
+                    IL2CPP.il2cpp_field_get_offset(field) != (long)header + offset)
+                    throw new NotSupportedException("Native container fields differ from the exact native job header contract.");
+                found |= bit;
+            }
+            if (found != (kind == ContainerKind.ReadOnly ? 3 : 7))
+                throw new NotSupportedException("Native container job header fields are incomplete.");
+        }
+
+        private static bool IsExactType(IntPtr type, IntPtr klass) => type != IntPtr.Zero &&
+            !IL2CPP.il2cpp_type_is_byref(type) && IL2CPP.il2cpp_class_from_type(type) == klass;
+
+        private static bool IsBufferPointer(IntPtr type, bool isSlice)
+        {
+            if (type == IntPtr.Zero) return false;
+            var signature = UnityVersionHandler.Wrap((Il2CppTypeStruct*)type);
+            if (signature == null || signature.ByRef || signature.ValueType || signature.Type != Il2CppTypeEnum.IL2CPP_TYPE_PTR ||
+                signature.Data == IntPtr.Zero) return false;
+            var target = UnityVersionHandler.Wrap((Il2CppTypeStruct*)signature.Data);
+            if (target == null || target.ByRef) return false;
+            if (!isSlice) return !target.ValueType && target.Type == Il2CppTypeEnum.IL2CPP_TYPE_VOID;
+            var nativeByte = Il2CppClassPointerStore<byte>.NativeClassPtr;
+            return nativeByte != IntPtr.Zero && target.Type == Il2CppTypeEnum.IL2CPP_TYPE_U1 &&
+                IsExactType(signature.Data, nativeByte);
+        }
+    }
+
+    private readonly struct NativeThread : IDisposable
+    {
+        private readonly IntPtr owned;
+
+        internal NativeThread(IntPtr domain)
+        {
+            owned = IntPtr.Zero;
+            if (IL2CPP.il2cpp_thread_current() != IntPtr.Zero) return;
+            owned = IL2CPP.il2cpp_thread_attach(domain);
+            if (owned == IntPtr.Zero) throw new InvalidOperationException("Could not attach the native job container caller to IL2CPP.");
+        }
+
+        public void Dispose()
+        {
+            if (owned != IntPtr.Zero) IL2CPP.il2cpp_thread_detach(owned);
+        }
+    }
+}
diff --git a/Il2CppInterop.Runtime/Injection/NativeJobExecution.cs b/Il2CppInterop.Runtime/Injection/NativeJobExecution.cs
new file mode 100644
index 0000000..126b558
--- /dev/null
+++ b/Il2CppInterop.Runtime/Injection/NativeJobExecution.cs
@@ -0,0 +1,114 @@
+using System;
+using System.Collections.Concurrent;
+using System.Collections.Generic;
+using System.Reflection;
+using System.Runtime.ExceptionServices;
+using System.Runtime.InteropServices;
+using System.Threading;
+
+namespace Il2CppInterop.Runtime.Injection;
+
+[StructLayout(LayoutKind.Sequential)]
+internal struct NativeJobEnvelope<T> where T : struct
+{
+    // Keep the producer's data address identical to the wrapper address for native field patches.
+    internal T Payload;
+    internal long Execution;
+}
+
+internal sealed class NativeJobExecution
+{
+    private static readonly ConcurrentDictionary<long, NativeJobExecution> Active = new();
+    private static readonly MethodInfo AdapterFactory = typeof(NativeJobExecution)
+        .GetMethod(nameof(CreateAdapter), BindingFlags.Static | BindingFlags.NonPublic)!;
+    private static long sequence;
+    private readonly NativeJobCallback.FailureState failure = new();
+    private readonly NativeJobRegistration registration;
+    internal long Token { get; }
+    internal Exception? FirstException => failure.FirstException;
+
+    private NativeJobExecution(long token, NativeJobRegistration registration)
+    {
+        Token = token;
+        this.registration = registration;
+    }
+
+    internal static NativeJobExecution Create(NativeJobRegistration registration)
+    {
+        var token = Interlocked.Increment(ref sequence);
+        if (token <= 0) throw new InvalidOperationException("Native job execution identifiers are exhausted.");
+        var execution = new NativeJobExecution(token, registration);
+        if (!Active.TryAdd(token, execution)) throw new InvalidOperationException("Duplicate native job execution identifier.");
+        return execution;
+    }
+
+    internal void ThrowIfFailed() => failure.ThrowIfFailed();
+    internal void Release() => Active.TryRemove(Token, out _);
+
+    internal static void RecordProjectionFailure(long token, Exception error)
+    {
+        if (token == 0 || !Active.TryGetValue(token, out var execution)) return;
+        execution.failure.Record(error);
+        execution.registration.RecordFailure(error);
+    }
+
+    internal static NativeJobRegistration CreateRegistration<T>(NativeJobRegistration original,
+        Delegate producer, Type userType, IReadOnlyDictionary<Type, Type>? attributes) where T : struct
+    {
+        var invoke = producer.GetType().GetMethod("Invoke", BindingFlags.Instance | BindingFlags.Public)!;
+        var ranges = invoke.GetParameters()[3].ParameterType.GetElementType()!;
+        Delegate adapter;
+        try
+        {
+            adapter = (Delegate)AdapterFactory.MakeGenericMethod(typeof(T), ranges)
+                .Invoke(null, new object[] { original, producer, invoke })!;
+        }
+        catch (TargetInvocationException error) when (error.InnerException != null)
+        {
+            ExceptionDispatchInfo.Capture(error.InnerException).Throw();
+            throw;
+        }
+        return NativeJobRegistration.GetOrCreate(adapter, userType, attributes);
+    }
+
+    private delegate void Producer<T, TRanges>(ref T payload, IntPtr additional, IntPtr patches,
+        ref TRanges ranges, int index) where T : struct;
+
+    private static Delegate CreateAdapter<T, TRanges>(NativeJobRegistration original,
+        Delegate producer, MethodInfo invoke) where T : struct
+    {
+        // Binding to the delegate's Invoke preserves multicast and closed/open target semantics.
+        var typed = (Producer<T, TRanges>)invoke.CreateDelegate(typeof(Producer<T, TRanges>), producer);
+        var adapter = new Adapter<T, TRanges>(original, typed);
+        return (Producer<NativeJobEnvelope<T>, TRanges>)adapter.Execute;
+    }
+
+    private sealed class Adapter<T, TRanges> where T : struct
+    {
+        private readonly NativeJobRegistration original;
+        private readonly Producer<T, TRanges> producer;
+
+        internal Adapter(NativeJobRegistration original, Producer<T, TRanges> producer)
+        {
+            this.original = original;
+            this.producer = producer;
+        }
+
+        internal void Execute(ref NativeJobEnvelope<T> envelope, IntPtr additional, IntPtr patches,
+            ref TRanges ranges, int index)
+        {
+            if (!Active.TryGetValue(envelope.Execution, out var execution))
+                throw new InvalidOperationException("Native job callback has no active execution owner.");
+            try
+            {
+                producer(ref envelope.Payload, additional, patches, ref ranges, index);
+            }
+            catch (Exception error)
+            {
+                execution.failure.Record(error);
+                original.RecordFailure(error);
+                throw;
+            }
+        }
+    }
+}
diff --git a/Il2CppInterop.Runtime/Injection/NativeJobHandles.Import.cs b/Il2CppInterop.Runtime/Injection/NativeJobHandles.Import.cs
new file mode 100644
index 0000000..1a17526
--- /dev/null
+++ b/Il2CppInterop.Runtime/Injection/NativeJobHandles.Import.cs
@@ -0,0 +1,52 @@
+using System;
+using System.Runtime.CompilerServices;
+using System.Threading;
+using Il2CppInterop.Runtime.Startup;
+
+namespace Il2CppInterop.Runtime.Injection;
+
+public static unsafe partial class NativeJobHandles
+{
+    // Import preserves a caller-owned native fence, not proof of a managed producer or native allocation ownership.
+    internal static NativeJob? ImportDependency<THandle>(Il2CppInteropRuntime runtime, THandle dependency)
+        where THandle : struct
+    {
+        NativeJobScheduler.RequireOutsideCallback();
+        HandleLayout<THandle>.Require();
+        var handle = Unsafe.As<THandle, NativeJobHandle>(ref dependency);
+        return ImportNativeDependency(runtime, handle);
+    }
+
+    // Only for handles captured through matched native bindings, never caller-supplied bytes.
+    internal static NativeJob? ImportNativeDependency(Il2CppInteropRuntime runtime, NativeJobHandle handle)
+    {
+        NativeJobScheduler.RequireOutsideCallback();
+        if (handle.JobGroup == 0) return null;
+
+        runtime.RetainNativeJob();
+        try
+        {
+            var binding = NativeJobBindings.Get(runtime);
+            var state = Volatile.Read(ref registry);
+            var owners = Array.Empty<NativeJob>();
+            NativeJobExecution? failure = null;
+            if (state != null)
+            {
+                if (!ReferenceEquals(state.Binding, binding))
+                    throw new NotSupportedException("Imported job handles cannot cross native runtime or domain boundaries.");
+                owners = state.Snapshot(handle, out failure);
+            }
+            // Snapshot owners already exist, so this wrapper is older than its subsequently submitted child.
+            return new NativeJob(binding, owners, failure) { Handle = handle };
+        }
+        catch
+        {
+            runtime.ReleaseNativeJob();
+            throw;
+        }
+    }
+
+    // Only for an unpublished import when submission retained no dependency. MarkCompleted releases
+    // this wrapper alone; it does not wait for the native fence or complete any upstream owners.
+    internal static void AbandonImportedDependency(NativeJob? dependency) => dependency?.MarkCompleted();
+}
diff --git a/Il2CppInterop.Runtime/Injection/NativeJobHandles.Registry.cs b/Il2CppInterop.Runtime/Injection/NativeJobHandles.Registry.cs
new file mode 100644
index 0000000..fe1521c
--- /dev/null
+++ b/Il2CppInterop.Runtime/Injection/NativeJobHandles.Registry.cs
@@ -0,0 +1,195 @@
+using System;
+using System.Collections.Generic;
+using System.Threading;
+
+namespace Il2CppInterop.Runtime.Injection;
+
+public static unsafe partial class NativeJobHandles
+{
+    internal sealed class Entry
+    {
+        internal readonly Key Key;
+        internal NativeJob? Owner;
+        internal Entry[] Inputs;
+        internal readonly HashSet<Entry> Parents = new();
+        internal NativeJobExecution? Failure;
+        internal bool Retired;
+        internal bool Queued;
+
+        internal Entry(Key key, NativeJob? owner, Entry[] inputs)
+        {
+            Key = key;
+            Owner = owner;
+            Inputs = inputs;
+        }
+    }
+
+    internal sealed class Registry
+    {
+        private readonly object gate = new();
+        private readonly Dictionary<Key, Entry> entries = new();
+        private readonly Dictionary<NativeJob, HashSet<Entry>> owners = new();
+        private readonly Queue<Entry> work = new();
+        private int activeEntries;
+        private int count;
+        internal NativeJobBindings Binding { get; }
+        internal int Count => Volatile.Read(ref count);
+
+        internal Registry(NativeJobBindings binding) => Binding = binding;
+
+        internal void Export(NativeJob owner, Key key)
+        {
+            lock (gate)
+            {
+                entries.TryGetValue(key, out var previous);
+                if (previous != null && ReferenceEquals(previous.Owner, owner)) return;
+                var inputs = previous != null ? new[] { previous } : Array.Empty<Entry>();
+                Publish(key, owner, inputs);
+            }
+        }
+
+        internal Scope? Capture(ReadOnlySpan<NativeJobHandle> handles)
+        {
+            NativeJobScheduler.RequireOutsideCallback();
+            lock (gate)
+            {
+                HashSet<Entry>? selected = null;
+                foreach (var handle in handles)
+                    if (handle.JobGroup != 0 && entries.TryGetValue(Key.From(handle), out var entry))
+                        (selected ??= new HashSet<Entry>()).Add(entry);
+                if (selected == null) return null;
+                var inputs = new Entry[selected.Count];
+                selected.CopyTo(inputs);
+                Binding.Runtime.RetainNativeJob();
+                try
+                {
+                    if (!ReferenceEquals(NativeJobBindings.Get(Binding.Runtime), Binding))
+                        throw new NotSupportedException("Captured job handles belong to a different native runtime or domain.");
+                    return new Scope(this, inputs);
+                }
+                catch { Binding.Runtime.ReleaseNativeJob(); throw; }
+            }
+        }
+
+        internal void Combined(Key result, Entry[] captured)
+        {
+            lock (gate)
+            {
+                var inputs = new HashSet<Entry>();
+                foreach (var input in captured)
+                    if (!input.Retired) inputs.Add(input);
+                if (inputs.Count == 0) return;
+                if (entries.TryGetValue(result, out var previous)) inputs.Add(previous);
+                var snapshot = new Entry[inputs.Count];
+                inputs.CopyTo(snapshot);
+                Publish(result, null, snapshot);
+            }
+        }
+
+        private void Publish(Key key, NativeJob? owner, Entry[] inputs)
+        {
+            var entry = new Entry(key, owner, inputs);
+            var nextCount = checked(activeEntries + 1);
+            entries.EnsureCapacity(entries.Count + 1);
+            work.EnsureCapacity(nextCount);
+            HashSet<Entry>? watched = null;
+            if (owner != null)
+            {
+                if (!owners.TryGetValue(owner, out watched)) watched = new HashSet<Entry>();
+                owners.EnsureCapacity(owners.Count + 1);
+                watched.EnsureCapacity(watched.Count + 1);
+            }
+            foreach (var input in inputs) input.Parents.EnsureCapacity(input.Parents.Count + 1);
+            // Reserve capacity before linking anything: publication cannot leave a partial graph on allocation failure.
+            foreach (var input in inputs) input.Parents.Add(entry);
+            if (owner != null)
+            {
+                owners[owner] = watched!;
+                watched!.Add(entry);
+            }
+            entries[key] = entry;
+            activeEntries = nextCount;
+            Volatile.Write(ref count, entries.Count);
+        }
+
+        internal NativeJob[] Snapshot(NativeJobHandle handle, out NativeJobExecution? failure)
+        {
+            lock (gate)
+            {
+                if (entries.TryGetValue(Key.From(handle), out var entry))
+                    return Snapshot(new[] { entry }, out failure);
+                failure = null;
+                return Array.Empty<NativeJob>();
+            }
+        }
+
+        internal NativeJob[] Snapshot(Entry[] roots, out NativeJobExecution? failure)
+        {
+            lock (gate)
+            {
+                failure = null;
+                var pending = new List<Entry>(roots);
+                var seen = new HashSet<Entry>();
+                var selected = new HashSet<NativeJob>();
+                for (var index = 0; index < pending.Count; index++)
+                {
+                    var entry = pending[index];
+                    if (!seen.Add(entry)) continue;
+                    if (entry.Retired) { failure ??= entry.Failure; continue; }
+                    if (entry.Owner != null) selected.Add(entry.Owner);
+                    pending.AddRange(entry.Inputs);
+                }
+                var result = new NativeJob[selected.Count];
+                selected.CopyTo(result);
+                Array.Sort(result, static (left, right) => left.Order.CompareTo(right.Order));
+                return result;
+            }
+        }
+
+        internal void OwnerCompleted(NativeJob owner)
+        {
+            lock (gate)
+            {
+                if (!owners.TryGetValue(owner, out var watched)) return;
+                foreach (var entry in watched) Enqueue(entry);
+                while (work.Count != 0)
+                {
+                    var entry = work.Dequeue();
+                    entry.Queued = false;
+                    TryRetire(entry);
+                }
+                Volatile.Write(ref count, entries.Count);
+            }
+        }
+
+        private void Enqueue(Entry entry)
+        {
+            if (entry.Retired || entry.Queued) return;
+            entry.Queued = true;
+            work.Enqueue(entry);
+        }
+
+        private void TryRetire(Entry entry)
+        {
+            if (entry.Retired || entry.Owner is { OwnershipReleased: false }) return;
+            foreach (var input in entry.Inputs)
+                if (!input.Retired) return;
+            entry.Failure = entry.Owner?.CompletedFailure;
+            foreach (var input in entry.Inputs) entry.Failure ??= input.Failure;
+            entry.Retired = true;
+            if (entries.TryGetValue(entry.Key, out var current) && ReferenceEquals(current, entry))
+                entries.Remove(entry.Key);
+            if (entry.Owner != null && owners.TryGetValue(entry.Owner, out var watched))
+            {
+                watched.Remove(entry);
+                if (watched.Count == 0) owners.Remove(entry.Owner);
+            }
+            foreach (var input in entry.Inputs) input.Parents.Remove(entry);
+            foreach (var parent in entry.Parents) Enqueue(parent);
+            entry.Parents.Clear();
+            entry.Inputs = Array.Empty<Entry>();
+            entry.Owner = null;
+            activeEntries--;
+        }
+    }
+}
diff --git a/Il2CppInterop.Runtime/Injection/NativeJobHandles.Scope.cs b/Il2CppInterop.Runtime/Injection/NativeJobHandles.Scope.cs
new file mode 100644
index 0000000..f8643f6
--- /dev/null
+++ b/Il2CppInterop.Runtime/Injection/NativeJobHandles.Scope.cs
@@ -0,0 +1,96 @@
+using System;
+using System.Runtime.CompilerServices;
+using System.Runtime.ExceptionServices;
+using System.Threading;
+
+namespace Il2CppInterop.Runtime.Injection;
+
+public static unsafe partial class NativeJobHandles
+{
+    /// <summary>Retains captured handle ownership across one native operation.</summary>
+    /// <remarks>
+    /// Use on the calling thread and keep alive until native invocation and reporting have finished.
+    /// Dispose only releases the operation lease; it does not assume native completion or cancel jobs.
+    /// Failures from captured owners can be reported even if another caller has already retired their entries.
+    /// </remarks>
+    public sealed class Scope : IDisposable
+    {
+        private readonly Registry registry;
+        private readonly Entry[] inputs;
+        private int consumed;
+        private int disposed;
+
+        internal Scope(Registry registry, Entry[] inputs)
+        {
+            this.registry = registry;
+            this.inputs = inputs;
+        }
+
+        /// <summary>Reports a successful native wait covering every captured input.</summary>
+        /// <remarks>Do not call after a failed wait or merely because IsCompleted returned true.</remarks>
+        public void Complete()
+        {
+            Consume();
+            CompleteOwners(false);
+        }
+
+        /// <summary>Records a successful native combination's output and its captured ownership.</summary>
+        /// <remarks>The result must be the actual native output for these captured input handles.</remarks>
+        public void Combined<THandle>(THandle result) where THandle : struct
+        {
+            HandleLayout<THandle>.Require();
+            var handle = Unsafe.As<THandle, NativeJobHandle>(ref result);
+            CombinedResult(handle);
+        }
+
+        /// <summary>Records a successful native combination's output from a native JobHandle location.</summary>
+        /// <remarks>The location must contain the readable actual native output for these captured inputs.</remarks>
+        public void CombinedBuffer(IntPtr result)
+        {
+            if (result == IntPtr.Zero) throw new ArgumentNullException(nameof(result));
+            var handle = Unsafe.ReadUnaligned<NativeJobHandle>(result.ToPointer());
+            CombinedResult(handle);
+        }
+
+        private void CombinedResult(NativeJobHandle handle)
+        {
+            Consume();
+            if (handle.JobGroup == 0)
+            {
+                // A default handle cannot retain an identity. Explicitly finish owned inputs
+                // rather than treating the native combine result itself as proof of completion.
+                CompleteOwners(true);
+                return;
+            }
+            registry.Combined(Key.From(handle), inputs);
+        }
+
+        private void Consume()
+        {
+            NativeJobScheduler.RequireOutsideCallback();
+            if (Volatile.Read(ref disposed) != 0) throw new ObjectDisposedException(nameof(Scope));
+            if (Interlocked.Exchange(ref consumed, 1) != 0)
+                throw new InvalidOperationException("A captured native operation can only be reported once.");
+        }
+
+        private void CompleteOwners(bool wait)
+        {
+            var owners = registry.Snapshot(inputs, out var failure);
+            ExceptionDispatchInfo? cleanupError = null;
+            foreach (var owner in owners)
+                try
+                {
+                    var observed = wait ? owner.WaitForCompletion() : owner.ObserveNativeCompletion();
+                    failure ??= observed;
+                }
+                catch (Exception error) { cleanupError ??= ExceptionDispatchInfo.Capture(error); }
+            cleanupError?.Throw();
+            failure?.ThrowIfFailed();
+        }
+
+        public void Dispose()
+        {
+            if (Interlocked.Exchange(ref disposed, 1) == 0) registry.Binding.Runtime.ReleaseNativeJob();
+        }
+    }
+}
diff --git a/Il2CppInterop.Runtime/Injection/NativeJobHandles.cs b/Il2CppInterop.Runtime/Injection/NativeJobHandles.cs
new file mode 100644
index 0000000..8fd40fd
--- /dev/null
+++ b/Il2CppInterop.Runtime/Injection/NativeJobHandles.cs
@@ -0,0 +1,147 @@
+using System;
+using System.Reflection;
+using System.Runtime.CompilerServices;
+using System.Runtime.InteropServices;
+using System.Threading;
+
+namespace Il2CppInterop.Runtime.Injection;
+
+/// <summary>Tracks owned jobs across copied Unity handles and explicitly observed native operations.</summary>
+/// <remarks>
+/// This is a low-level integration contract, not an automatic hook. Capture input handles before
+/// invoking Unity, report successful completion or combination, and dispose the capture afterward.
+/// IsCompleted alone does not release ownership. Unobserved native completion retains ownership;
+/// completing the original NativeJob also retires its exported aliases.
+/// </remarks>
+public static unsafe partial class NativeJobHandles
+{
+    private static Registry? registry;
+
+    /// <summary>The number of currently tracked native handle identities.</summary>
+    public static int TrackedHandleCount => Volatile.Read(ref registry)?.Count ?? 0;
+
+    /// <summary>Exports the exact Unity.Jobs.JobHandle value while retaining the managed owner.</summary>
+    /// <remarks>
+    /// Use only with completion/combination observers or retain the original NativeJob for explicit
+    /// completion. Export failures preserve access to the owner through NativeJobSchedulingException.
+    /// </remarks>
+    public static THandle Export<THandle>(NativeJob job) where THandle : struct
+    {
+        ArgumentNullException.ThrowIfNull(job);
+        NativeJobScheduler.RequireOutsideCallback();
+        try
+        {
+            HandleLayout<THandle>.Require();
+            var handle = RetainNativeHandle(job);
+            var result = default(THandle);
+            Unsafe.As<THandle, NativeJobHandle>(ref result) = handle;
+            return result;
+        }
+        catch (Exception error)
+        {
+            throw new NativeJobSchedulingException(job, error,
+                "Native job handle export failed; inspect Job before releasing any payload-owned resources.");
+        }
+    }
+
+    // The caller must preserve job on failure. This also tracks handles stored in native system state.
+    internal static NativeJobHandle RetainNativeHandle(NativeJob job)
+    {
+        lock (job.Gate)
+        {
+            var handle = job.GetDependency(job.Binding);
+            if (handle.JobGroup == 0)
+            {
+                job.Complete();
+                return default;
+            }
+            if (!ReferenceEquals(NativeJobBindings.Get(job.Binding.Runtime), job.Binding))
+                throw new NotSupportedException("The job's native runtime or domain is no longer active.");
+            var state = Volatile.Read(ref registry);
+            if (state == null)
+            {
+                var candidate = new Registry(job.Binding);
+                state = Interlocked.CompareExchange(ref registry, candidate, null) ?? candidate;
+            }
+            if (!ReferenceEquals(state.Binding, job.Binding))
+                throw new NotSupportedException("Exported job handles cannot cross native runtime or domain boundaries.");
+            state.Export(job, Key.From(handle));
+            return handle;
+        }
+    }
+
+    /// <summary>Captures one input before Unity may modify or clear its value.</summary>
+    public static Scope? Capture<THandle>(THandle handle) where THandle : struct
+    {
+        var state = Volatile.Read(ref registry);
+        if (state == null || state.Count == 0) return null;
+        HandleLayout<THandle>.Require();
+        var value = Unsafe.As<THandle, NativeJobHandle>(ref handle);
+        return state.Capture(new ReadOnlySpan<NativeJobHandle>(&value, 1));
+    }
+
+    /// <summary>Captures up to three native JobHandle locations before a native operation.</summary>
+    /// <remarks>Null locations are absent; each non-null location must contain a readable native JobHandle.</remarks>
+    public static Scope? CaptureLocations(IntPtr first, IntPtr second, IntPtr third)
+    {
+        var state = Volatile.Read(ref registry);
+        if (state == null || state.Count == 0) return null;
+        Span<NativeJobHandle> handles = stackalloc NativeJobHandle[3];
+        var count = 0;
+        if (first != IntPtr.Zero) handles[count++] = Unsafe.ReadUnaligned<NativeJobHandle>(first.ToPointer());
+        if (second != IntPtr.Zero) handles[count++] = Unsafe.ReadUnaligned<NativeJobHandle>(second.ToPointer());
+        if (third != IntPtr.Zero) handles[count++] = Unsafe.ReadUnaligned<NativeJobHandle>(third.ToPointer());
+        return state.Capture(handles[..count]);
+    }
+
+    /// <summary>Captures a set of inputs without retaining their source storage.</summary>
+    public static Scope? CaptureMany<THandle>(ReadOnlySpan<THandle> handles) where THandle : struct
+    {
+        var state = Volatile.Read(ref registry);
+        if (state == null || state.Count == 0) return null;
+        HandleLayout<THandle>.Require();
+        return state.Capture(MemoryMarshal.Cast<THandle, NativeJobHandle>(handles));
+    }
+
+    /// <summary>Captures a valid contiguous native JobHandle buffer before a native operation.</summary>
+    /// <remarks>The caller owns the buffer and must keep all count entries readable during this call.</remarks>
+    public static Scope? CaptureBuffer(IntPtr buffer, int count)
+    {
+        if (count < 0) throw new ArgumentOutOfRangeException(nameof(count));
+        if (count > 0 && buffer == IntPtr.Zero) throw new ArgumentNullException(nameof(buffer));
+        var state = Volatile.Read(ref registry);
+        if (state == null || state.Count == 0) return null;
+        return state.Capture(new ReadOnlySpan<NativeJobHandle>(buffer.ToPointer(), count));
+    }
+
+    internal static void OwnerCompleted(NativeJob owner) => Volatile.Read(ref registry)?.OwnerCompleted(owner);
+
+    internal readonly record struct Key(ulong Group, int Version)
+    {
+        internal static Key From(NativeJobHandle handle) => new(handle.JobGroup, handle.Version);
+    }
+
+    private static class HandleLayout<THandle> where THandle : struct
+    {
+        private static readonly bool Supported = Validate();
+
+        internal static void Require()
+        {
+            if (!Supported) throw new NotSupportedException("The handle must have Unity's exact reference-free JobHandle layout.");
+        }
+
+        private static bool Validate()
+        {
+            var type = typeof(THandle);
+            if (type.FullName != "Unity.Jobs.JobHandle" || type.Assembly.GetName().Name != "UnityEngine.CoreModule" ||
+                RuntimeHelpers.IsReferenceOrContainsReferences<THandle>() || Unsafe.SizeOf<THandle>() != sizeof(NativeJobHandle) ||
+                !type.IsLayoutSequential && !type.IsExplicitLayout) return false;
+            var fields = type.GetFields(BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic);
+            if (fields.Length != 2) return false;
+            var group = type.GetField("jobGroup", BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic);
+            var version = type.GetField("version", BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic);
+            return group?.FieldType == typeof(ulong) && version?.FieldType == typeof(int) &&
+                Marshal.OffsetOf<THandle>("jobGroup") == IntPtr.Zero && Marshal.OffsetOf<THandle>("version") == (IntPtr)8;
+        }
+    }
+}
diff --git a/Il2CppInterop.Runtime/Injection/NativeJobPayloadBridge.cs b/Il2CppInterop.Runtime/Injection/NativeJobPayloadBridge.cs
new file mode 100644
index 0000000..301bffd
--- /dev/null
+++ b/Il2CppInterop.Runtime/Injection/NativeJobPayloadBridge.cs
@@ -0,0 +1,129 @@
+using System;
+using System.Reflection;
+using System.Reflection.Emit;
+using System.Runtime.ExceptionServices;
+
+namespace Il2CppInterop.Runtime.Injection;
+
+internal static class NativeJobPayloadBridge
+{
+    private static readonly MethodInfo Factory = typeof(NativeJobPayloadBridge)
+        .GetMethod(nameof(Create), BindingFlags.Static | BindingFlags.NonPublic)!;
+
+    internal static Delegate Adapt(Delegate callback, MethodInfo invoke, NativeJobPayloadPlan plan)
+    {
+        if (plan.NativeType == plan.SourceType) return callback;
+        var ranges = invoke.GetParameters()[3].ParameterType.GetElementType()!;
+        try
+        {
+            return (Delegate)Factory.MakeGenericMethod(plan.SourceType, plan.NativeType, ranges)
+                .Invoke(null, new object[] { callback, invoke })!;
+        }
+        catch (TargetInvocationException error) when (error.InnerException != null)
+        {
+            ExceptionDispatchInfo.Capture(error.InnerException).Throw();
+            throw;
+        }
+    }
+
+    private delegate void Producer<T, TRanges>(ref T payload, IntPtr additional, IntPtr patches,
+        ref TRanges ranges, int index) where T : struct;
+    private delegate long ExecutionToken<T>(in T payload);
+
+    private static Delegate Create<TSource, TNative, TRanges>(Delegate callback, MethodInfo invoke)
+        where TSource : struct where TNative : struct
+    {
+        var producer = (Producer<TSource, TRanges>)invoke.CreateDelegate(typeof(Producer<TSource, TRanges>), callback);
+        return (Producer<TNative, TRanges>)new Adapter<TSource, TNative, TRanges>(producer).Execute;
+    }
+
+    private sealed class Frame<TSource, TNative> where TSource : struct where TNative : struct
+    {
+        internal TSource Managed;
+        internal TNative Native;
+    }
+
+    private sealed class Adapter<TSource, TNative, TRanges> where TSource : struct where TNative : struct
+    {
+        private static readonly NativeJobPayloadCopy<TSource, TNative> Encode = NativeJobPayloadBinding<TSource, TNative>.Encode;
+        private static readonly NativeJobPayloadCopy<TNative, TSource> Decode = NativeJobPayloadBinding<TSource, TNative>.Decode;
+        private static readonly ExecutionToken<TNative>? GetToken = CreateTokenReader();
+        private readonly Producer<TSource, TRanges> producer;
+
+        internal Adapter(Producer<TSource, TRanges> producer) => this.producer = producer;
+
+        internal void Execute(ref TNative payload, IntPtr additional, IntPtr patches, ref TRanges ranges, int index)
+        {
+            var token = GetToken == null ? 0 : GetToken(in payload);
+            Frame<TSource, TNative>? frame = null;
+            var decoded = false;
+            Exception? primary = null;
+            try
+            {
+                // One callback-local frame, never one shared mutable job object across workers.
+                frame = new Frame<TSource, TNative>();
+                Decode(in payload, out frame.Managed);
+                decoded = true;
+                producer(ref frame.Managed, additional, patches, ref ranges, index);
+            }
+            catch (Exception error)
+            {
+                primary = error;
+                NativeJobExecution.RecordProjectionFailure(token, error);
+                throw;
+            }
+            finally
+            {
+                if (decoded)
+                {
+                    try
+                    {
+                        // Encode off to the side. A conversion failure cannot destroy the live
+                        // envelope token or partially replace a worker's native container headers.
+                        Encode(in frame!.Managed, out frame.Native);
+                        payload = frame.Native;
+                    }
+                    catch (Exception error)
+                    {
+                        NativeJobExecution.RecordProjectionFailure(token, error);
+                        if (primary == null) throw;
+                        RetainCleanupFailure(primary, error);
+                    }
+                }
+            }
+        }
+
+        private static ExecutionToken<TNative>? CreateTokenReader()
+        {
+            var type = typeof(TSource);
+            if (!type.IsConstructedGenericType || type.GetGenericTypeDefinition() != typeof(NativeJobEnvelope<>))
+                return null;
+            var field = typeof(TNative).GetField(nameof(NativeJobEnvelope<int>.Execution),
+                BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.DeclaredOnly);
+            if (field?.FieldType != typeof(long))
+                throw new InvalidOperationException("The projected native job envelope lost its execution owner.");
+            var reader = new DynamicMethod("ReadJobExecution", typeof(long), new[] { typeof(TNative).MakeByRefType() },
+                typeof(NativeJobPayloadBridge).Module, true);
+            var il = reader.GetILGenerator();
+            il.Emit(OpCodes.Ldarg_0);
+            il.Emit(OpCodes.Ldfld, field);
+            il.Emit(OpCodes.Ret);
+            return (ExecutionToken<TNative>)reader.CreateDelegate(typeof(ExecutionToken<TNative>));
+        }
+    }
+
+    private static void RetainCleanupFailure(Exception primary, Exception cleanup)
+    {
+        try
+        {
+            const string key = "Il2CppInterop.NativeJobPayloadCleanup";
+            lock (primary)
+                primary.Data[key] = primary.Data[key] is Exception previous
+                    ? new AggregateException(previous, cleanup) : cleanup;
+        }
+        catch
+        {
+            // A custom Exception.Data implementation cannot replace the producer's original error.
+        }
+    }
+}
diff --git a/Il2CppInterop.Runtime/Injection/NativeJobPayloadPlan.cs b/Il2CppInterop.Runtime/Injection/NativeJobPayloadPlan.cs
new file mode 100644
index 0000000..ddd922b
--- /dev/null
+++ b/Il2CppInterop.Runtime/Injection/NativeJobPayloadPlan.cs
@@ -0,0 +1,203 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Reflection;
+using System.Reflection.Emit;
+using System.Runtime.InteropServices;
+using Il2CppInterop.Runtime.InteropTypes;
+
+namespace Il2CppInterop.Runtime.Injection;
+
+internal delegate void NativeJobPayloadCopy<TSource, TTarget>(in TSource source, out TTarget target);
+
+// Only the projected value crosses the native queue. Original CLR type identities stay unchanged.
+internal sealed class NativeJobPayloadPlan
+{
+    private static readonly object Gate = new();
+    private static readonly Dictionary<Type, NativeJobPayloadPlan> Plans = new();
+    private static readonly ModuleBuilder Module = AssemblyBuilder.DefineDynamicAssembly(
+        new AssemblyName("Il2CppNativeJobPayloads"), AssemblyBuilderAccess.Run)
+        .DefineDynamicModule("Il2CppNativeJobPayloads");
+    private static long sequence;
+
+    internal Type SourceType { get; }
+    internal Type NativeType { get; }
+    internal MethodInfo Encode { get; }
+    internal MethodInfo Decode { get; }
+    private readonly Func<IntPtr>? nativeClass;
+
+    private NativeJobPayloadPlan(Type source, Type native, MethodInfo encode, MethodInfo decode,
+        Func<IntPtr>? nativeClass = null)
+    {
+        SourceType = source;
+        NativeType = native;
+        Encode = encode;
+        Decode = decode;
+        this.nativeClass = nativeClass;
+    }
+
+    internal static NativeJobPayloadPlan Get(Type type)
+    {
+        lock (Gate)
+            return Plans.TryGetValue(type, out var cached) ? cached : Create(type, new HashSet<Type>());
+    }
+
+    internal static bool TryGetNativeClass(Type type, out IntPtr nativeClass)
+    {
+        nativeClass = IntPtr.Zero;
+        if (!type.IsConstructedGenericType || type.GetGenericTypeDefinition() != typeof(NativeJobContainerPayload<>))
+            return false;
+        var plan = Get(type.GetGenericArguments()[0]);
+        if (plan.NativeType != type || plan.nativeClass == null)
+            throw new NotSupportedException("The native job container projection has no exact native identity.");
+        // Do not enter native metadata while holding the emission cache lock.
+        nativeClass = plan.nativeClass();
+        return true;
+    }
+
+    private static NativeJobPayloadPlan Create(Type type, HashSet<Type> active)
+    {
+        if (Plans.TryGetValue(type, out var cached)) return cached;
+        if (type.ContainsGenericParameters || type.IsByRefLike || type.IsPointer || type.IsByRef || type == typeof(void))
+            throw new NotSupportedException($"Job payload {type} has no closed value representation.");
+        if (!active.Add(type)) throw new NotSupportedException($"Recursive job payload {type} is unsupported.");
+        try
+        {
+            if (!type.IsValueType)
+            {
+                if (!typeof(Il2CppObjectBase).IsAssignableFrom(type) || !type.IsConstructedGenericType ||
+                    type.GetGenericTypeDefinition().FullName is not
+                        ("Unity.Collections.NativeArray`1" or "Unity.Collections.NativeSlice`1" or
+                         "Unity.Collections.NativeArray`1+ReadOnly") ||
+                    type.Assembly.GetName().Name != "UnityEngine.CoreModule" || type.GetGenericArguments().Length != 1)
+                    throw new NotSupportedException($"Reference field {type} has no native job payload conversion contract.");
+                var native = typeof(NativeJobContainerPayload<>).MakeGenericType(type);
+                var codec = typeof(NativeJobContainerCodec<>).MakeGenericType(type);
+                const BindingFlags methods = BindingFlags.Static | BindingFlags.NonPublic;
+                var encode = EmitContainerCopy(type, native, codec.GetMethod("Encode", methods)!, false);
+                var decode = EmitContainerCopy(native, type, codec.GetMethod("Decode", methods)!, true);
+                var getClass = (Func<IntPtr>)codec.GetMethod("GetNativeClass", methods)!.CreateDelegate(typeof(Func<IntPtr>));
+                return Publish(new NativeJobPayloadPlan(type, native, encode, decode, getClass));
+            }
+
+            if (type.IsPrimitive || type.IsEnum || type == typeof(IntPtr) || type == typeof(UIntPtr))
+                return Identity(type);
+            if (!type.IsLayoutSequential && !type.IsExplicitLayout)
+                throw new NotSupportedException($"Job payload {type} requires sequential or explicit layout.");
+            var fields = type.GetFields(BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic |
+                BindingFlags.DeclaredOnly).OrderBy(field => field.MetadataToken).ToArray();
+            foreach (var field in fields)
+                if (ManagedValueLayout.IsFunctionPointerField(field))
+                    throw new NotSupportedException($"Function pointer field {type}.{field.Name} has no native job projection contract.");
+            var children = fields.Select(field => Create(field.FieldType, active)).ToArray();
+            if (children.Select((child, index) => child.NativeType == fields[index].FieldType).All(identity => identity))
+                return Identity(type);
+            if (!type.IsLayoutSequential || type.StructLayoutAttribute is not { Size: 0 } layout)
+                throw new NotSupportedException($"Container-bearing job payload {type} requires sequential layout without a fixed size.");
+            if (layout.Pack != 0 && (layout.Pack < 1 || layout.Pack > 128 || (layout.Pack & (layout.Pack - 1)) != 0))
+                throw new NotSupportedException($"Container-bearing job payload {type} has unsupported packing.");
+
+            var builder = Module.DefineType("NativeJobPayload_" + ++sequence,
+                TypeAttributes.Public | TypeAttributes.Sealed | TypeAttributes.SequentialLayout |
+                TypeAttributes.BeforeFieldInit, typeof(ValueType), (PackingSize)layout.Pack);
+            CopyMarkers(type, builder.SetCustomAttribute);
+            for (var index = 0; index < fields.Length; index++)
+            {
+                var field = builder.DefineField(fields[index].Name, children[index].NativeType, FieldAttributes.Public);
+                CopyMarkers(fields[index], field.SetCustomAttribute);
+            }
+            var projected = builder.CreateType()!;
+            var targets = fields.Select(field => projected.GetField(field.Name, BindingFlags.Public | BindingFlags.Instance)!).ToArray();
+            // Validate packing, offsets and the entire projected reference-free graph before registration.
+            ManagedValueLayout.Create(projected);
+            return Publish(new NativeJobPayloadPlan(type, projected,
+                EmitCompositeCopy(type, projected, fields, targets, children, false),
+                EmitCompositeCopy(projected, type, targets, fields, children, true)));
+        }
+        finally { active.Remove(type); }
+    }
+
+    private static NativeJobPayloadPlan Identity(Type type)
+    {
+        var copy = NewCopy(type, type);
+        var il = copy.GetILGenerator();
+        il.Emit(OpCodes.Ldarg_1);
+        il.Emit(OpCodes.Ldarg_0);
+        il.Emit(OpCodes.Ldobj, type);
+        il.Emit(OpCodes.Stobj, type);
+        il.Emit(OpCodes.Ret);
+        return Publish(new NativeJobPayloadPlan(type, type, copy, copy));
+    }
+
+    private static NativeJobPayloadPlan Publish(NativeJobPayloadPlan plan)
+    {
+        Plans.Add(plan.SourceType, plan);
+        return plan;
+    }
+
+    private static DynamicMethod NewCopy(Type source, Type target) =>
+        new("CopyJobPayload", typeof(void), new[] { source.MakeByRefType(), target.MakeByRefType() },
+            typeof(NativeJobPayloadPlan).Module, true);
+
+    private static MethodInfo EmitContainerCopy(Type source, Type target, MethodInfo conversion, bool decode)
+    {
+        var copy = NewCopy(source, target);
+        var il = copy.GetILGenerator();
+        il.Emit(OpCodes.Ldarg_1);
+        il.Emit(OpCodes.Ldarg_0);
+        if (decode) il.Emit(OpCodes.Ldobj, source);
+        else il.Emit(OpCodes.Ldind_Ref);
+        il.Emit(OpCodes.Call, conversion);
+        if (decode) il.Emit(OpCodes.Stind_Ref);
+        else il.Emit(OpCodes.Stobj, target);
+        il.Emit(OpCodes.Ret);
+        return copy;
+    }
+
+    private static MethodInfo EmitCompositeCopy(Type source, Type target, FieldInfo[] fields,
+        FieldInfo[] targets, NativeJobPayloadPlan[] children, bool decode)
+    {
+        var copy = NewCopy(source, target);
+        var il = copy.GetILGenerator();
+        il.Emit(OpCodes.Ldarg_1);
+        il.Emit(OpCodes.Initobj, target);
+        for (var index = 0; index < fields.Length; index++)
+        {
+            il.Emit(OpCodes.Ldarg_0);
+            il.Emit(OpCodes.Ldflda, fields[index]);
+            il.Emit(OpCodes.Ldarg_1);
+            il.Emit(OpCodes.Ldflda, targets[index]);
+            il.Emit(OpCodes.Call, decode ? children[index].Decode : children[index].Encode);
+        }
+        il.Emit(OpCodes.Ret);
+        return copy;
+    }
+
+    private static void CopyMarkers(MemberInfo source, Action<CustomAttributeBuilder> add)
+    {
+        foreach (var attribute in source.CustomAttributes)
+        {
+            if (ValueTypeAttributes.IsLayoutAttribute(attribute.AttributeType)) continue;
+            if (attribute.AttributeType.FullName == "Unity.Collections.DeallocateOnJobCompletionAttribute")
+                throw new NotSupportedException("Projected native container payloads require caller-owned buffers; automatic job deallocation is unsupported.");
+            if (attribute.ConstructorArguments.Count != 0 || attribute.NamedArguments.Count != 0)
+                throw new NotSupportedException($"Attribute {attribute.AttributeType} on {source} requires a native attribute value contract.");
+            add(new CustomAttributeBuilder(attribute.Constructor, Array.Empty<object>()));
+        }
+    }
+}
+
+internal static class NativeJobPayloadBinding<TSource, TNative>
+{
+    internal static readonly NativeJobPayloadCopy<TSource, TNative> Encode;
+    internal static readonly NativeJobPayloadCopy<TNative, TSource> Decode;
+
+    static NativeJobPayloadBinding()
+    {
+        var plan = NativeJobPayloadPlan.Get(typeof(TSource));
+        if (plan.NativeType != typeof(TNative))
+            throw new InvalidOperationException("The job payload codec does not match its registered native representation.");
+        Encode = (NativeJobPayloadCopy<TSource, TNative>)plan.Encode.CreateDelegate(typeof(NativeJobPayloadCopy<TSource, TNative>));
+        Decode = (NativeJobPayloadCopy<TNative, TSource>)plan.Decode.CreateDelegate(typeof(NativeJobPayloadCopy<TNative, TSource>));
+    }
+}
diff --git a/Il2CppInterop.Runtime/Injection/NativeJobRegistration.cs b/Il2CppInterop.Runtime/Injection/NativeJobRegistration.cs
new file mode 100644
index 0000000..35dda6f
--- /dev/null
+++ b/Il2CppInterop.Runtime/Injection/NativeJobRegistration.cs
@@ -0,0 +1,352 @@
+using System;
+using System.Collections.Generic;
+using System.Reflection;
+using System.Runtime.InteropServices;
+using Il2CppInterop.Runtime.Runtime;
+using Il2CppInterop.Runtime.Startup;
+
+namespace Il2CppInterop.Runtime.Injection;
+
+/// <summary>Retains Unity reflection data for a managed primary job-producer callback.</summary>
+/// <remarks>
+/// Registration does not schedule jobs. Unity owns the native record until domain teardown;
+/// it must not be freed after a job completes. Registrations retain their delegates until
+/// process exit. Use stable producer delegates rather than capturing per-job state.
+/// Secondary/deallocation callbacks and domain reloading are not handled by this adapter.
+/// Container-bearing CLR payloads require the typed NativeJobScheduler conversion path;
+/// ReflectionData describes their reference-free native projection, not their CLR storage.
+/// </remarks>
+public sealed unsafe class NativeJobRegistration
+{
+    private static readonly object Gate = new();
+    private static readonly Dictionary<RegistrationKey, NativeJobRegistration> Registrations = new();
+    private static readonly Dictionary<IntPtr, NativeJobRegistration> ReflectionRegistrations = new();
+    private static Il2CppInteropRuntime? registeredRuntime;
+    private static IntPtr registeredDomain;
+    private static IntPtr registrationMethod;
+    private readonly Il2CppInteropRuntime runtime;
+    private readonly NativeJobCallback callback;
+    private readonly Il2CppSystem.Type userType;
+    private readonly Delegate producer;
+    private readonly Type managedUserType;
+    private readonly IReadOnlyDictionary<Type, Type>? attributes;
+    private readonly NativeJobCallbackKind kind;
+    private NativeJobRegistration? executionRegistration;
+    private IntPtr reflectionData;
+
+    /// <summary>The exact CLR payload type accepted by this registration's callback.</summary>
+    public Type ManagedPayloadType => callback.ManagedPayloadType;
+
+    internal Il2CppInteropRuntime Runtime => runtime;
+
+    internal void RecordFailure(Exception error) => callback.RecordFailure(error);
+
+    internal NativeJobRegistration GetExecutionRegistration<T>() where T : struct
+    {
+        lock (runtime.NativeJobGate)
+        {
+            RequireStarted(runtime);
+            RequireScheduledKind();
+            if (ManagedPayloadType != typeof(T))
+                throw new ArgumentException("Execution payload differs from its registered producer.");
+            return executionRegistration ??= NativeJobExecution.CreateRegistration<T>(this, producer,
+                managedUserType, attributes);
+        }
+    }
+
+    internal IntPtr RequireSchedulingData()
+    {
+        RequireStarted(runtime);
+        RequireScheduledKind();
+        if (IL2CPP.il2cpp_domain_get() != registeredDomain)
+            throw new NotSupportedException("Job reflection data cannot survive native domain replacement.");
+        return reflectionData;
+    }
+
+    private NativeJobRegistration(Il2CppInteropRuntime runtime, NativeJobCallback callback, Il2CppSystem.Type userType,
+        Delegate producer, Type managedUserType, IReadOnlyDictionary<Type, Type>? attributes, NativeJobCallbackKind kind)
+    {
+        this.runtime = runtime;
+        this.callback = callback;
+        this.userType = userType;
+        this.producer = producer;
+        this.managedUserType = managedUserType;
+        this.attributes = attributes;
+        this.kind = kind;
+    }
+
+    private void RequireScheduledKind()
+    {
+        if (kind != NativeJobCallbackKind.Scheduled)
+            throw new InvalidOperationException("Animation registrations require a graph-owned execution and data lifetime.");
+    }
+
+    /// <summary>Native reflection data for the matching scheduler or animation graph contract.</summary>
+    public IntPtr ReflectionData
+    {
+        get
+        {
+            RequireStarted(runtime);
+            return reflectionData;
+        }
+    }
+
+    /// <summary>The first managed callback failure across jobs using this registration.</summary>
+    public Exception? FirstException => callback.FirstException;
+
+    /// <summary>Rethrows a recorded failure; it does not complete or fault a native JobHandle.</summary>
+    public void ThrowIfFailed() => callback.ThrowIfFailed();
+
+    /// <summary>Finds an existing managed registration; arbitrary native reflection pointers are not adopted.</summary>
+    public static NativeJobRegistration FromReflectionData(IntPtr reflectionData)
+    {
+        var current = Il2CppInteropRuntime.Instance;
+        lock (current.NativeJobGate)
+        {
+            RequireStarted(current);
+            if (!ReferenceEquals(registeredRuntime, current) || IL2CPP.il2cpp_domain_get() != registeredDomain)
+                throw new InvalidOperationException("Job reflection data does not belong to the active runtime and domain.");
+            lock (Gate)
+            {
+                if (reflectionData != IntPtr.Zero && ReflectionRegistrations.TryGetValue(reflectionData, out var registration))
+                    return registration;
+                throw new NotSupportedException("The reflection pointer is not an owned managed job registration.");
+            }
+        }
+    }
+
+    internal static NativeJobRegistration? FindAnimationRegistration(IntPtr reflectionData)
+    {
+        var current = Il2CppInteropRuntime.Instance;
+        lock (current.NativeJobGate)
+        lock (Gate)
+        {
+            if (!ReflectionRegistrations.TryGetValue(reflectionData, out var registration)) return null;
+            RequireStarted(current);
+            if (!ReferenceEquals(registration.runtime, current) || IL2CPP.il2cpp_domain_get() != registeredDomain)
+                throw new InvalidOperationException("Animation reflection data belongs to a different runtime or domain.");
+            if (registration.kind != NativeJobCallbackKind.Animation)
+                throw new ArgumentException("An animation node requires an animation producer registration.");
+            return registration;
+        }
+    }
+
+    /// <summary>Gets one registration per equal callback, user type and attribute mapping.</summary>
+    /// <param name="execute">A callback accepted by NativeJobCallback.Create.</param>
+    /// <param name="userType">Underlying job type, or null to use the callback payload type.</param>
+    /// <param name="attributeTypes">Explicit native marker-attribute mappings for job data.</param>
+    public static NativeJobRegistration GetOrCreate(Delegate execute, Type? userType = null,
+        IReadOnlyDictionary<Type, Type>? attributeTypes = null)
+        => GetOrCreate(execute, NativeJobCallbackKind.Scheduled, userType, attributeTypes);
+
+    /// <summary>Gets one registration per equal callback, invocation kind, user type and attribute mapping.</summary>
+    /// <remarks>Animation registrations cannot be submitted to NativeJobScheduler.</remarks>
+    public static NativeJobRegistration GetOrCreate(Delegate execute, NativeJobCallbackKind kind,
+        Type? userType = null, IReadOnlyDictionary<Type, Type>? attributeTypes = null)
+    {
+        ArgumentNullException.ThrowIfNull(execute);
+        NativeJobCallback.ValidateKind(kind);
+        if (kind == NativeJobCallbackKind.Animation && userType != null &&
+            NativeJobCallback.ValidateSignature(execute.GetType()).GetParameters()[0].ParameterType.GetElementType() != userType)
+            throw new ArgumentException("An animation job's user type must be its callback payload type.", nameof(userType));
+        var current = Il2CppInteropRuntime.Instance;
+        var key = new RegistrationKey(execute, kind, userType, attributeTypes);
+        lock (current.NativeJobGate)
+        {
+            RequireStarted(current);
+            if (!OperatingSystem.IsWindows() || RuntimeInformation.ProcessArchitecture != Architecture.X64 ||
+                current.UnityVersion != new Version(2022, 2, 16))
+                throw new NotSupportedException("Native managed-job registration requires Windows x64 Unity 2022.2.16.");
+            var domain = IL2CPP.il2cpp_domain_get();
+            if (domain == IntPtr.Zero) throw new InvalidOperationException("No active IL2CPP domain is available.");
+            lock (Gate)
+            {
+                if (registeredRuntime != null && (!ReferenceEquals(registeredRuntime, current) || registeredDomain != domain))
+                    throw new NotSupportedException("Native job registrations cannot be reused across runtime or domain replacement.");
+                if (Registrations.TryGetValue(key, out var existing))
+                {
+                    if (existing.reflectionData == IntPtr.Zero)
+                        throw new InvalidOperationException("This native job registration is already being created.");
+                    return existing;
+                }
+
+                using var attachment = new RegistrationThread(domain);
+                if (registrationMethod == IntPtr.Zero)
+                {
+                    registrationMethod = ResolveRegistrationMethod();
+                    registeredRuntime = current;
+                    registeredDomain = domain;
+                }
+                var callback = NativeJobCallback.Create(execute, kind, key.Attributes);
+                var nativeUserType = callback.PayloadType;
+                if (userType != null)
+                {
+                    var userClass = ValueTypeInjector.RegisterDataType(NativeJobPayloadPlan.Get(userType).NativeType, key.Attributes);
+                    nativeUserType = new Il2CppSystem.Type(IL2CPP.il2cpp_type_get_object(IL2CPP.il2cpp_class_get_type(userClass)));
+                }
+                var registration = new NativeJobRegistration(current, callback, nativeUserType,
+                    execute, userType ?? callback.ManagedPayloadType, key.Attributes, kind);
+                // Reserve the managed entry before Unity retains its record. No partially initialized
+                // registration escapes the lock, and failed native registration is never cached.
+                Registrations.Add(key, registration);
+                try
+                {
+                    registration.reflectionData = registration.InvokeRegistration();
+                    ReflectionRegistrations.Add(registration.reflectionData, registration);
+                    return registration;
+                }
+                catch
+                {
+                    Registrations.Remove(key);
+                    throw;
+                }
