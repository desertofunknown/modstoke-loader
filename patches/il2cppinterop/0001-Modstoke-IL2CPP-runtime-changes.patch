+                    var classes = entry.Attributes.Select(attribute => IL2CPP.il2cpp_method_get_class(attribute.Constructor)).ToArray();
+                    if (entry.Kind == OwnerKind.Class) ValueTypeAttributes.AddClass(entry.Owner, classes);
+                    else ValueTypeAttributes.AddField(entry.Owner, classes);
+                }
+                // Native publication is last: no fallible managed setup may abandon a live batch.
+                fixed (NativeEntry* pointer = native)
+                    batch = binding.Register(2, pointer, checked((uint)native.Length));
+                if (batch == IntPtr.Zero)
+                    throw new NotSupportedException("Native attribute reflection rejected its ownership records.");
+            }
+            catch { RemovePresence(); throw; }
+        }
+        finally
+        {
+            for (var i = allocations.Count - 1; i >= 0; i--) Marshal.FreeCoTaskMem(allocations[i]);
+        }
+
+        NativeArgument PrepareArgument(IntPtr type, Argument argument)
+        {
+            var signature = UnityVersionHandler.Wrap((Il2CppTypeStruct*)type);
+            if (signature == null || signature.ByRef || argument.Class == IntPtr.Zero ||
+                IL2CPP.il2cpp_class_from_type(type) != argument.Class)
+                throw new NotSupportedException("A native attribute argument does not match its parameter type.");
+            if (argument.Text != null)
+            {
