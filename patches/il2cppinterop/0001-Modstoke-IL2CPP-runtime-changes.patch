+
+namespace Il2CppInterop.Runtime.Injection;
+
+public static unsafe partial class NativeAnimationCalls
+{
+    /// <summary>Reads a value copy of an animation job using its native payload representation.</summary>
+    /// <remarks>
+    /// Call on Unity's main thread outside job callbacks, with graph evaluation synchronized by
+    /// the caller. This does not evaluate or pause the graph. Native container buffers stay
+    /// caller-owned and must outlive every use by the graph and any returned container header.
+    /// </remarks>
+    public static T ReadJobData<T>(IntPtr handleAddress, Func<Il2CppObjectBase, Exception> exceptionFactory)
+        where T : struct
+    {
+        ArgumentNullException.ThrowIfNull(exceptionFactory);
+        RequireAddress(handleAddress);
+        using var lease = new CallLease();
+        var current = GetBinding(lease);
+        RequireDataAccess(current, exceptionFactory);
+        var codec = DataCodec<T>.Instance;
+        codec.Validate(GetDataClass(current, handleAddress, exceptionFactory));
+        return codec.Read(current, handleAddress, exceptionFactory);
+    }
+
+    /// <summary>Replaces an animation job's value after its complete native conversion succeeds.</summary>
+    /// <remarks>Has the same graph synchronization and buffer-ownership contract as ReadJobData.</remarks>
+    public static void WriteJobData<T>(IntPtr handleAddress, in T value,
+        Func<Il2CppObjectBase, Exception> exceptionFactory) where T : struct
+    {
+        ArgumentNullException.ThrowIfNull(exceptionFactory);
+        RequireAddress(handleAddress);
+        using var lease = new CallLease();
+        var current = GetBinding(lease);
+        RequireDataAccess(current, exceptionFactory);
+        var codec = DataCodec<T>.Instance;
+        codec.Validate(GetDataClass(current, handleAddress, exceptionFactory));
+        codec.Write(current, handleAddress, in value, exceptionFactory);
+    }
+
+    private static void RequireDataAccess(Binding current, Func<Il2CppObjectBase, Exception> exceptionFactory)
+    {
+        if (NativeJobCallback.IsInvoking)
+            throw new InvalidOperationException("Animation job data cannot be accessed from a job callback.");
+        var error = IntPtr.Zero;
+        var result = IL2CPP.il2cpp_runtime_invoke(current.MainThread, IntPtr.Zero, null, ref error);
