+    const auto snapshot = std::atomic_load_explicit(&GetRegistry().snapshot, std::memory_order_acquire);
+    if (!snapshot || snapshot->ownedImages.find(image) == snapshot->ownedImages.end()) return 0;
+    // An owned miss must not fall through to the original image metadata lookup.
+    if (namespaze == nullptr || name == nullptr || name[0] == '\0') return 1;
+    for (const auto& record : snapshot->names)
+        if (record.image == image && record.parentIndex == noParent &&
+            record.namespaze == namespaze && record.name == name)
