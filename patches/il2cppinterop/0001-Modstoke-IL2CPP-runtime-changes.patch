+        internal uint Count;
+        internal IntPtr Arguments;
+        internal uint NamedCount;
+        internal IntPtr NamedProperties;
+    }
+    [StructLayout(LayoutKind.Sequential)]
+    private struct NativeNamedProperty { internal IntPtr Property; internal NativeArgument Value; }
+    [StructLayout(LayoutKind.Sequential)]
