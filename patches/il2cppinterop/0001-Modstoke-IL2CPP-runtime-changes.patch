@@ -0,0 +1,36 @@
+using System;
+using Il2CppInterop.Runtime.InteropTypes;
+
+namespace Il2CppInterop.Runtime.Injection;
+
+public static unsafe partial class NativeArrayMemory
+{
+    /// <summary>Boxes a NativeArray descriptor over existing caller-owned storage.</summary>
+    /// <remarks>The wrapper roots only the native box. The buffer is not copied or owned by this operation.</remarks>
+    public static TContainer CreateArrayView<TElement, TContainer>(IntPtr buffer, int length, int allocator)
+        where TElement : struct where TContainer : Il2CppObjectBase
+    {
+        if (allocator < 0) throw new ArgumentOutOfRangeException(nameof(allocator));
+        using var lease = new CallLease();
+        return NativeJobContainerCodec<TContainer>.DecodeArrayView<TElement>(buffer, length, allocator, false);
+    }
+
+    /// <summary>Boxes a NativeArray.ReadOnly descriptor over existing caller-owned storage.</summary>
+    /// <remarks>The wrapper roots only the native box. The buffer must outlive every use of the view.</remarks>
+    public static TContainer CreateReadOnlyArrayView<TElement, TContainer>(IntPtr buffer, int length)
+        where TElement : struct where TContainer : Il2CppObjectBase
+    {
+        using var lease = new CallLease();
+        return NativeJobContainerCodec<TContainer>.DecodeArrayView<TElement>(buffer, length, 1, true);
+    }
+
+    /// <summary>Reads a NativeArray or NativeArray.ReadOnly descriptor without transferring buffer ownership.</summary>
+    public static (IntPtr Buffer, int Length, int Allocator) ReadArrayView<TElement, TContainer>(
+        TContainer source, bool readOnly) where TElement : struct where TContainer : Il2CppObjectBase
+    {
+        ArgumentNullException.ThrowIfNull(source);
+        using var lease = new CallLease();
+        var descriptor = NativeJobContainerCodec<TContainer>.EncodeArrayView<TElement>(source, readOnly);
+        return (descriptor.Buffer, descriptor.Value0, readOnly ? 1 : descriptor.Value1);
+    }
+}
