+namespace
+{
+    using Manager = VideoPlayback::ManagerObject;
+
+    constexpr std::uint32_t CallCount = 4;
+    struct Bindings { void* calls[CallCount]; };
+    std::atomic<const Bindings*> bindings{nullptr};
+
+    bool Matches(const Bindings* current, void* const* calls) noexcept
+    {
+        for (std::uint32_t i = 0; i < CallCount; ++i)
+            if (current->calls[i] != calls[i]) return false;
+        return true;
+    }
+
+    void ConstructPlayback(void*, const void*)
+    {
+    }
+
+    void ConstructManager(void* self, const void*)
+    {
+        const auto* current = bindings.load(std::memory_order_acquire);
+        static_cast<Manager*>(self)->m_Ptr = reinterpret_cast<void* (*)()>(current->calls[0])();
+    }
+
+    void DisposeManager(void* self, const void*)
+    {
+        const auto* current = bindings.load(std::memory_order_acquire);
+        auto* manager = static_cast<Manager*>(self);
+        void* pointer = manager->m_Ptr;
+        if (pointer != nullptr)
+        {
+            // Preserve the pointer if native destruction unwinds.
+            reinterpret_cast<void (*)(void*)>(current->calls[1])(pointer);
+            manager->m_Ptr = nullptr;
+        }
+
+        // Suppression follows destruction and also runs for an already-null pointer.
+        reinterpret_cast<void (*)(void*, const void*)>(current->calls[2])(self, current->calls[3]);
+    }
+
+    void DisposeManagerGuarded(void* self, const void* metadata)
+    {
+        VideoPlayback::ManagerCall call(static_cast<Manager*>(self),
+            VideoPlayback::ManagerCallKind::Destroy);
+        DisposeManager(self, metadata);
+    }
+
+    // Metadata-29 invokers keep Unity exception unwinding entirely native.
+    void InvokeVoid0(void* method, const void* metadata, void* self, void**, void*)
+    {
+        reinterpret_cast<void (*)(void*, const void*)>(method)(self, metadata);
+    }
+
+    struct Entry { void* method; void* invoker; };
+    const Entry entries[] =
+    {
+        {reinterpret_cast<void*>(&ConstructPlayback), reinterpret_cast<void*>(&InvokeVoid0)},
+        {reinterpret_cast<void*>(&ConstructManager), reinterpret_cast<void*>(&InvokeVoid0)},
+        {reinterpret_cast<void*>(&DisposeManager), reinterpret_cast<void*>(&InvokeVoid0)}
+    };
+    static_assert(sizeof(entries) / sizeof(entries[0]) == 3);
+}
+
+INTEROP_EXPORT std::uint32_t Il2CppInterop_ConfigureVideoPlayback(
+    std::uint32_t abi, void* const* calls, std::uint32_t count) noexcept
+{
+    if (abi != 1 || count != CallCount || calls == nullptr) return 0;
+    for (std::uint32_t i = 0; i < CallCount; ++i)
+        if (calls[i] == nullptr) return 0;
+
+    const auto* current = bindings.load(std::memory_order_acquire);
+    if (current != nullptr) return Matches(current, calls) ? 1u : 0u;
+
+    auto* candidate = new (std::nothrow) Bindings;
+    if (candidate == nullptr) return 0;
+    for (std::uint32_t i = 0; i < CallCount; ++i)
+        candidate->calls[i] = calls[i];
+
+    // The winning immutable copy remains alive for the process lifetime.
+    if (bindings.compare_exchange_strong(current, candidate,
+        std::memory_order_acq_rel, std::memory_order_acquire)) return 1;
+
+    const bool identical = Matches(current, candidate->calls);
+    delete candidate;
+    return identical ? 1u : 0u;
+}
+
+INTEROP_EXPORT void* Il2CppInterop_GetVideoPlaybackEntry(
+    std::uint32_t abi, std::uint32_t method, std::uint32_t kind) noexcept
+{
+    if ((abi < 1 || abi > 3) || method >= 3 || kind > 1 ||
+        (abi >= 2 && !VideoPlayback::HasManagerReentryBindings()) ||
+        bindings.load(std::memory_order_acquire) == nullptr) return nullptr;
+    if (abi >= 2 && method == 2 && kind == 0)
+        return reinterpret_cast<void*>(&DisposeManagerGuarded);
+    return kind == 0 ? entries[method].method : entries[method].invoker;
+}
