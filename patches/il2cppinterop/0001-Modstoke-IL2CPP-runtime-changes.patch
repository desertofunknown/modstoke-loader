@@ -0,0 +1,45 @@
+// SPDX-License-Identifier: LGPL-3.0-only
+#pragma once
+#include <cstddef>
+#include <mutex>
+#include <thread>
+
+namespace VideoPlayback
+{
+    struct ManagerObject
+    {
+        void* klass;
+        void* monitor;
+        void* m_Ptr;
+    };
+    static_assert(sizeof(void*) == 8);
+    static_assert(offsetof(ManagerObject, m_Ptr) == 16);
+    static_assert(sizeof(ManagerObject) == 24);
+
+    bool HasManagerReentryBindings() noexcept;
+
+    enum class ManagerCallKind { Update, Destroy, Access };
+
+    // Ready callbacks may run on scheduler workers or inside the waiting caller.
+    // The registry lock covers stack-frame bookkeeping, never a native call or wait.
+    class ManagerCall
+    {
+        static std::mutex gate;
+        static ManagerCall* active;
+        void* manager;
+        ManagerObject* const owner;
+        const ManagerCallKind kind;
+        const std::thread::id thread;
+        ManagerCall* next = nullptr;
+
+        ManagerCall(void* manager, ManagerObject* owner, ManagerCallKind kind);
+        bool ConflictsWith(const ManagerCall& call) const noexcept;
+
+    public:
+        ManagerCall(void* manager, ManagerCallKind kind);
+        ManagerCall(ManagerObject* owner, ManagerCallKind kind);
+        ~ManagerCall() noexcept;
+        ManagerCall(const ManagerCall&) = delete;
+        ManagerCall& operator=(const ManagerCall&) = delete;
+    };
+}
