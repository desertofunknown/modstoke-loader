+// SPDX-License-Identifier: LGPL-3.0-only
+#include <cstddef>
+#include <cstdint>
+
+#if defined(_WIN32)
+#define INTEROP_EXPORT extern "C" __declspec(dllexport)
+#else
+#define INTEROP_EXPORT extern "C" __attribute__((visibility("default")))
+#endif
+
+namespace
+{
+    struct DisplayFields
+    {
+        std::uint64_t handle;
+        std::int32_t width;
+        std::int32_t height;
+        std::uint32_t refreshNumerator;
+        std::uint32_t refreshDenominator;
+        std::int32_t workX;
+        std::int32_t workY;
+        std::int32_t workWidth;
+        std::int32_t workHeight;
+    };
+
+    struct DisplayInfo
+    {
+        DisplayFields fields;
+        void* name;
+    };
+
+    struct Position
+    {
+        std::int32_t x;
+        std::int32_t y;
+    };
+
+    struct ScreenFrame
+    {
+        void* call;
+        void* createHandle;
+        void* newString;
+        const char16_t* nameChars;
+        std::int32_t nameLength;
+        std::uint32_t mode;
+        DisplayFields display;
+        std::int32_t x;
+        std::int32_t y;
+        std::intptr_t nameHandle;
+        std::intptr_t operationHandle;
+        std::uint32_t status;
+    };
+
+    static_assert(sizeof(void*) == 8);
+    static_assert(offsetof(DisplayFields, width) == 8);
+    static_assert(offsetof(DisplayFields, refreshNumerator) == 16);
+    static_assert(offsetof(DisplayFields, workX) == 24);
+    static_assert(sizeof(DisplayFields) == 40);
+    static_assert(offsetof(DisplayInfo, name) == 40);
+    static_assert(sizeof(DisplayInfo) == 48);
+    static_assert(sizeof(Position) == 8);
+    static_assert(offsetof(ScreenFrame, nameLength) == 32);
+    static_assert(offsetof(ScreenFrame, display) == 40);
+    static_assert(offsetof(ScreenFrame, x) == 80);
+    static_assert(offsetof(ScreenFrame, nameHandle) == 88);
+    static_assert(offsetof(ScreenFrame, operationHandle) == 96);
+    static_assert(offsetof(ScreenFrame, status) == 104);
+    static_assert(sizeof(ScreenFrame) == 112);
+
+    void CallScreen(ScreenFrame* frame)
+    {
+        const auto createHandle = reinterpret_cast<std::intptr_t (*)(void*, bool)>(frame->createHandle);
+        DisplayInfo display{};
+        if (frame->mode == 0)
+        {
+            reinterpret_cast<void (*)(DisplayInfo*)>(frame->call)(&display);
+            if (display.name != nullptr)
+            {
+                frame->nameHandle = createHandle(display.name, true);
+                if (frame->nameHandle == 0)
+                {
+                    frame->status = 1;
+                    return;
+                }
+            }
+            frame->display = display.fields;
+        }
+        else if (frame->mode == 1)
+        {
+            display.fields = frame->display;
+            if (frame->nameChars != nullptr)
+            {
+                const auto newString = reinterpret_cast<void* (*)(const char16_t*, std::int32_t)>(frame->newString);
+                display.name = newString(frame->nameChars, frame->nameLength);
+                if (display.name == nullptr)
+                {
+                    frame->status = 1;
+                    return;
+                }
+                frame->nameHandle = createHandle(display.name, true);
+                if (frame->nameHandle == 0)
+                {
+                    frame->status = 1;
+                    return;
+                }
+            }
+            Position position{frame->x, frame->y};
+            // The matched Windows implementation retains only the copied display handle
+            // and position. Neither this value nor its string is borrowed after the call.
+            void* operation = reinterpret_cast<void* (*)(DisplayInfo*, Position*)>(frame->call)(&display, &position);
+            if (operation != nullptr)
+            {
+                // The ICall returns an IL2CPP object, not its embedded engine operation pointer.
+                frame->operationHandle = createHandle(operation, true);
+                if (frame->operationHandle == 0)
+                {
+                    frame->status = 1;
+                    return;
+                }
+            }
+        }
+        else
+        {
+            frame->status = 1;
+            return;
+        }
+        frame->status = 2;
+    }
+
+    void InvokeScreen(void* method, const void*, void*, void** args, void*)
+    {
+        reinterpret_cast<void (*)(ScreenFrame*)>(method)(*static_cast<ScreenFrame**>(args[0]));
+    }
+}
+
+// String allocation and Unity exceptions stay in native frames protected by il2cpp_runtime_invoke.
+INTEROP_EXPORT void* Il2CppInterop_GetScreenEntry(std::uint32_t abi, std::uint32_t entry)
+{
+    if (abi != 1) return nullptr;
+    switch (entry)
+    {
+        case 0: return reinterpret_cast<void*>(&CallScreen);
+        case 1: return reinterpret_cast<void*>(&InvokeScreen);
+        default: return nullptr;
+    }
+}
