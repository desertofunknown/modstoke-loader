+++ b/Il2CppInterop.Runtime/Injection/NativeJobScheduler.Handles.cs
@@ -0,0 +1,51 @@
+using System;
+
+namespace Il2CppInterop.Runtime.Injection;
+
+public static unsafe partial class NativeJobScheduler
+{
+    /// <summary>Schedules one payload and exports its owned Unity JobHandle.</summary>
+    public static THandle ScheduleWithHandle<T, THandle>(NativeJobRegistration registration, in T payload,
+        THandle dependency) where T : struct where THandle : struct =>
+        SubmitWithHandle(registration, in payload, dependency, new NativeJobSchedule(NativeJobScheduleKind.Single, 2));
+
+    /// <summary>Schedules an indexed payload in single-job mode and exports its Unity JobHandle.</summary>
+    public static THandle ScheduleForWithHandle<T, THandle>(NativeJobRegistration registration, in T payload,
+        int length, THandle dependency) where T : struct where THandle : struct
+    {
+        if (length < 0) throw new ArgumentOutOfRangeException(nameof(length));
+        return SubmitWithHandle(registration, in payload, dependency,
+            new NativeJobSchedule(NativeJobScheduleKind.ParallelFor, 2, length, length));
+    }
+
+    /// <summary>Schedules an indexed payload in parallel mode and exports its Unity JobHandle.</summary>
+    public static THandle ScheduleParallelForWithHandle<T, THandle>(NativeJobRegistration registration, in T payload,
+        int length, int batchSize, THandle dependency) where T : struct where THandle : struct
+    {
+        if (length < 0) throw new ArgumentOutOfRangeException(nameof(length));
+        if (batchSize < 1) throw new ArgumentOutOfRangeException(nameof(batchSize));
+        return SubmitWithHandle(registration, in payload, dependency,
+            new NativeJobSchedule(NativeJobScheduleKind.ParallelFor, 1, length, batchSize));
+    }
+
+    private static THandle SubmitWithHandle<T, THandle>(NativeJobRegistration registration, in T payload,
+        THandle dependency, in NativeJobSchedule schedule)
+        where T : struct where THandle : struct
+    {
+        ArgumentNullException.ThrowIfNull(registration);
+        RequireOutsideCallback();
+        var imported = NativeJobHandles.ImportDependency(registration.Runtime, dependency);
+        var dependencyRetained = false;
+        try
+        {
+            var job = Submit(registration, in payload, imported, in schedule,
+                out dependencyRetained);
+            return NativeJobHandles.Export<THandle>(job);
+        }
+        finally
+        {
+            // Submission/export failures that preserve Job must preserve its dependency graph as well.
+            if (!dependencyRetained) NativeJobHandles.AbandonImportedDependency(imported);
+        }
+    }
+}
diff --git a/Il2CppInterop.Runtime/Injection/NativeJobScheduler.Particles.cs b/Il2CppInterop.Runtime/Injection/NativeJobScheduler.Particles.cs
new file mode 100644
index 0000000..581dfab
--- /dev/null
+++ b/Il2CppInterop.Runtime/Injection/NativeJobScheduler.Particles.cs
@@ -0,0 +1,131 @@
+using System;
+using Il2CppInterop.Runtime.InteropTypes;
+
+namespace Il2CppInterop.Runtime.Injection;
+
+public static unsafe partial class NativeJobScheduler
+{
+    /// <summary>Submits one managed particle producer and publishes its handle to the native particle system.</summary>
+    /// <remarks>
+    /// The producer must implement Unity's particle callback contract. Submit on the Unity main thread;
+    /// keep the system and its data alive until completion. Native simulation and the explicit dependency
+    /// are combined before submission. Complete or dispose the returned owner or its owned downstream job;
+    /// native internal completion alone cannot release the managed owner. The live particle-list descriptor
+    /// remains owned by the system and is not copied to caller-owned temporary storage.
+    /// </remarks>
+    public static NativeJob ScheduleParticleSystem<T>(NativeJobRegistration registration, in T payload,
+        Il2CppObjectBase particleSystem, NativeJob? dependency = null) where T : struct =>
+        SubmitParticleSystem(registration, in payload, particleSystem, dependency, false, 0, out _);
+
+    /// <summary>Submits indexed or batch particle work using Unity's dependency-deferred particle count.</summary>
+    /// <remarks>Producer, thread, lifetime and completion requirements match ScheduleParticleSystem.</remarks>
+    public static NativeJob ScheduleParticleSystemParallelFor<T>(NativeJobRegistration registration, in T payload,
+        Il2CppObjectBase particleSystem, int batchSize, NativeJob? dependency = null) where T : struct
+    {
+        if (batchSize < 1) throw new ArgumentOutOfRangeException(nameof(batchSize));
+        return SubmitParticleSystem(registration, in payload, particleSystem, dependency, true, batchSize, out _);
+    }
+
+    /// <summary>Submits one particle producer and exports its tracked Unity JobHandle.</summary>
+    /// <remarks>Requires the matching completion observers. Particle lifetime requirements match ScheduleParticleSystem.</remarks>
+    public static THandle ScheduleParticleSystemWithHandle<T, THandle>(NativeJobRegistration registration,
+        in T payload, Il2CppObjectBase particleSystem, THandle dependency) where T : struct where THandle : struct =>
+        SubmitParticleSystemWithHandle(registration, in payload, particleSystem, dependency, false, 0);
+
+    /// <summary>Submits indexed or batch particle work and exports its tracked Unity JobHandle.</summary>
+    /// <remarks>Requires the matching completion observers. Particle lifetime requirements match ScheduleParticleSystem.</remarks>
+    public static THandle ScheduleParticleSystemParallelForWithHandle<T, THandle>(NativeJobRegistration registration,
+        in T payload, Il2CppObjectBase particleSystem, int batchSize, THandle dependency)
+        where T : struct where THandle : struct
+    {
+        if (batchSize < 1) throw new ArgumentOutOfRangeException(nameof(batchSize));
+        return SubmitParticleSystemWithHandle(registration, in payload, particleSystem, dependency, true, batchSize);
+    }
+
+    private static THandle SubmitParticleSystemWithHandle<T, THandle>(NativeJobRegistration registration,
+        in T payload, Il2CppObjectBase particleSystem, THandle dependency, bool parallel, int batchSize)
+        where T : struct where THandle : struct
+    {
+        ArgumentNullException.ThrowIfNull(registration);
+        ArgumentNullException.ThrowIfNull(particleSystem);
+        RequireOutsideCallback();
+        var imported = NativeJobHandles.ImportDependency(registration.Runtime, dependency);
+        var dependencyRetained = false;
+        try
+        {
+            var job = SubmitParticleSystem(registration, in payload, particleSystem, imported, parallel, batchSize,
+                out dependencyRetained);
+            return NativeJobHandles.Export<THandle>(job);
+        }
+        finally
+        {
+            if (!dependencyRetained) NativeJobHandles.AbandonImportedDependency(imported);
+        }
+    }
+
+    private static NativeJob SubmitParticleSystem<T>(NativeJobRegistration registration, in T payload,
+        Il2CppObjectBase particleSystem, NativeJob? dependency, bool parallel, int batchSize,
+        out bool dependencyRetained) where T : struct
+    {
+        dependencyRetained = false;
+        ArgumentNullException.ThrowIfNull(registration);
+        ArgumentNullException.ThrowIfNull(particleSystem);
+        RequireOutsideCallback();
+        var runtime = registration.Runtime;
+        runtime.RetainNativeJob();
+        NativeJob? imported = null;
+        NativeJob? combined = null;
+        try
+        {
+            var binding = NativeJobBindings.Get(runtime);
+            var state = binding.CaptureParticleSystem(particleSystem);
+            imported = NativeJobHandles.ImportNativeDependency(runtime, state.Handle);
+            if (imported != null && dependency != null)
+            {
+                try { combined = CombineDependencies(imported, dependency); }
+                catch (NativeJobSchedulingException)
+                {
+                    // The failed fence owns its dependency graph and escapes in the exception.
+                    dependencyRetained = true;
+                    throw;
+                }
+            }
+
+            var schedule = new NativeJobSchedule(parallel ? NativeJobScheduleKind.ParallelForDeferred : NativeJobScheduleKind.Particle,
+                1, batchSize: batchSize, additionalData: state.Data);
+            var job = Submit(registration, in payload, combined ?? imported ?? dependency, in schedule,
+                out dependencyRetained);
+            try
+            {
+                // Track the native alias before publishing it, so the next system submission can
+                // import this managed owner and preserve its failures and dependency graph.
+                var handle = NativeJobHandles.RetainNativeHandle(job);
+                binding.PublishParticleSystem(particleSystem, handle);
+                return job;
+            }
+            catch (Exception error)
+            {
+                throw new NativeJobSchedulingException(job, error,
+                    "Particle work was submitted but handle tracking or publication failed; complete Job before releasing particle resources.");
+            }
+        }
+        finally
+        {
+            try
+            {
+                if (!dependencyRetained)
+                {
+                    // These unpublished wrappers own no managed callbacks. Discard their bookkeeping,
+                    // not their upstream owners; native fence storage remains Unity-owned.
+                    try { combined?.MarkCompleted(); }
+                    finally { NativeJobHandles.AbandonImportedDependency(imported); }
+                }
+            }
+            finally
+            {
+                try { runtime.ReleaseNativeJob(); }
+                finally { GC.KeepAlive(particleSystem); }
+            }
+        }
+    }
+}
