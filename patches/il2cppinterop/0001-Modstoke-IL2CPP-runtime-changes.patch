+using System;
+using System.Runtime.InteropServices;
+using Il2CppInterop.Runtime.Runtime;
+using Il2CppInterop.Runtime.Runtime.VersionSpecific.Assembly;
+using Il2CppInterop.Runtime.Runtime.VersionSpecific.AssemblyName;
+using Il2CppInterop.Runtime.Runtime.VersionSpecific.Class;
+using Il2CppInterop.Runtime.Runtime.VersionSpecific.Image;
+using Il2CppInterop.Runtime.Startup;
+
+namespace Il2CppInterop.Runtime.Injection;
+
+internal sealed unsafe partial class NativeTypeNameLookup
+{
+    [StructLayout(LayoutKind.Sequential)]
+    private struct AssemblyLookupConfiguration
+    {
+        internal IntPtr OriginalLoadFrom, ReserveString, Utf16ToUtf8;
+        internal IntPtr BasenameNoExtension, DestroyString, AssemblyGetObject;
+    }
+
+    private static readonly Lazy<AssemblyLookupBinding> AssemblyLookupShared = new(() => new AssemblyLookupBinding());
+    private static AssemblyLookupBinding? failedAssemblyLookupBinding;
+
+    private void AddOwnedAssembly(IntPtr image)
+    {
+        binding.RequireContext();
+        if (UnityVersionHandler.imageStructHandler is not NativeImageStructHandler_27_0 ||
+            UnityVersionHandler.assemblyStructHandler is not NativeAssemblyStructHandler_24_2 ||
+            UnityVersionHandler.assemblyNameStructHandler is not NativeAssemblyNameStructHandler_24_1 ||
+            UnityVersionHandler.assemblyStructHandler.Size() != 88)
+            throw new NotSupportedException("Owned assembly lookup requires the inspected native image and assembly layouts.");
+        var module = UnityVersionHandler.Wrap((Il2CppImage*)image) ??
+            throw new ArgumentException("The owned native image is null.", nameof(image));
+        var assembly = UnityVersionHandler.Wrap(module.Assembly) ??
+            throw new NotSupportedException("The owned native image has no assembly.");
+        var name = Marshal.PtrToStringUTF8(module.NameNoExt);
+        if (module.Dynamic != 0 || assembly.Image != module.ImagePointer || string.IsNullOrEmpty(name) ||
+            Marshal.PtrToStringUTF8(assembly.Name.Name) != name ||
+            Marshal.PtrToStringUTF8(module.Name) != name + ".dll")
+            throw new NotSupportedException("Owned assembly lookup requires matching stable assembly and module identities.");
+
+        uint count = 0;
+        var assemblies = IL2CPP.il2cpp_domain_get_assemblies(IL2CPP.il2cpp_domain_get(), ref count);
+        if (assemblies == null || count == 0)
+            throw new InvalidOperationException("Owned assembly lookup requires the original initialized domain assembly list.");
+        for (uint i = 0; i < count; i++)
+            RejectExistingAssembly(assemblies[i]);
+        // LoadFrom uses this separate fixed table; domain membership alone cannot establish precedence.
+        var game = InjectorHelpers.Il2CppModule.BaseAddress;
+        var fixedAssemblies = Marshal.ReadIntPtr(game + 0x5B3E8D8);
+        if (fixedAssemblies == IntPtr.Zero || Marshal.ReadInt32(game + 0x5B3E8F0) != 210)
+            throw new NotSupportedException("The converted native assembly table differs from its inspected layout.");
+        for (var i = 0; i < 210; i++)
+            RejectExistingAssembly(fixedAssemblies + i * 88);
+
+        var lookup = AssemblyLookupShared.Value;
+        var utf8 = Marshal.StringToCoTaskMemUTF8(name);
+        try
+        {
+            if (lookup.Add(1, batch, image, assembly.Pointer, utf8) != 1)
+                throw new NotSupportedException("The private owned assembly lookup rejected its identity or duplicate name.");
+        }
+        finally { Marshal.FreeCoTaskMem(utf8); }
+
+        void RejectExistingAssembly(IntPtr pointer)
+        {
+            var existing = UnityVersionHandler.Wrap((Il2CppAssembly*)pointer) ??
+                throw new NotSupportedException("The native assembly list contains a null assembly.");
+            if (existing.Pointer == assembly.Pointer || existing.Image == module.ImagePointer ||
+                Marshal.PtrToStringUTF8(existing.Name.Name) == name)
+                throw new InvalidOperationException("An existing native assembly cannot be replaced by an owned lookup entry.");
+        }
+    }
+
+    [UnmanagedFunctionPointer(CallingConvention.Cdecl)]
+    private delegate IntPtr NativeLoadFrom(IntPtr file, byte reflectionOnly, IntPtr stackMark);
+    [UnmanagedFunctionPointer(CallingConvention.Cdecl)]
+    private delegate uint ConfigureAssemblyLookup(uint abi, ref AssemblyLookupConfiguration config, uint size);
+    [UnmanagedFunctionPointer(CallingConvention.Cdecl)]
+    private delegate uint AddOwnedAssemblyLookup(uint abi, IntPtr batch, IntPtr image, IntPtr assembly, IntPtr name);
+
+    private sealed class AssemblyLookupBinding
+    {
+        internal readonly AddOwnedAssemblyLookup Add;
+        private readonly IDetour? hook;
+
+        internal AssemblyLookupBinding()
+        {
+            // The shared binding already verifies the complete player binary and runtime/domain ownership.
+            Shared.Value.RequireContext();
+            if (sizeof(AssemblyLookupConfiguration) != 48 || sizeof(Il2CppObject) != 16)
+                throw new PlatformNotSupportedException("Owned assembly lookup requires the inspected Windows x64 layout.");
+            RequireReflectionAssemblyClass();
+            var address = RequireEntry(0x4B54E0, 442,
+                "8538DB7EED188C24E23C5564603D7480DCB767E6D6D766823916C3F28210F14B");
+            _ = RequireEntry(0x2017C70, 5,
+                "08FF73C3C3D2F15C1FF2793521808C6816A225CF7D1936693324C592A49FEFAD");
+            _ = RequireEntry(0x2017C80, 12,
+                "877D2585AAEC3C7153E9077655A62D0565CBF22FA5E6A7EDED0B161D9AE26D61");
+            var config = new AssemblyLookupConfiguration
+            {
+                ReserveString = RequireEntry(0x4AE310, 383,
+                    "F2716E8EFAD14513BF62914AD9209E978EE3939F5AEB75658D31A0041763DEDF"),
+                Utf16ToUtf8 = RequireEntry(0x54F9A0, 435,
+                    "52E7A9FAA5292BABC501F41EEF95406AFF27106666554F957692F779DA545BD8"),
+                BasenameNoExtension = RequireEntry(0x54F020, 329,
+                    "ACE6D9FD7AFE15CBADD426E8ADEA47AC79D1A2A6F4636654C8DA6E0B121E21D4"),
+                DestroyString = RequireEntry(0x4ADA30, 95,
+                    "DA5A80F9073F791F535EF98C649E8253F6281994B11CE1811776DC1042A2C962"),
+                AssemblyGetObject = RequireEntry(0x4C7E30, 201,
+                    "82E26F81E1927F52FA6FF54B624C0ADDA7545A45C7E71CF4E1F8D680CF3A8CFD")
+            };
+            Add = Marshal.GetDelegateForFunctionPointer<AddOwnedAssemblyLookup>(
+                NativeAnimationCall.GetNativeExport("Il2CppInterop_AddOwnedAssemblyLookup"));
+            var get = Marshal.GetDelegateForFunctionPointer<GetEntry>(
+                NativeAnimationCall.GetNativeExport("Il2CppInterop_GetOwnedAssemblyLookupEntry"));
+            var configure = Marshal.GetDelegateForFunctionPointer<ConfigureAssemblyLookup>(
+                NativeAnimationCall.GetNativeExport("Il2CppInterop_ConfigureOwnedAssemblyLookup"));
+            var entry = get(1);
+            if (entry == IntPtr.Zero)
+                throw new NotSupportedException("The native owned assembly lookup ABI is unavailable.");
+            var runtime = Il2CppInteropRuntime.Instance;
+            runtime.RetainNativeJob();
+            var configured = false;
+            try
+            {
+                hook = runtime.DetourProvider.Create(address, Marshal.GetDelegateForFunctionPointer<NativeLoadFrom>(entry));
+                if (hook.Detour != entry)
+                    throw new NotSupportedException("Owned assembly loading must not introduce a managed callback frame.");
+                _ = hook.GenerateTrampoline<NativeLoadFrom>();
+                config.OriginalLoadFrom = hook.OriginalTrampoline;
+                if (configure(1, ref config, checked((uint)sizeof(AssemblyLookupConfiguration))) != 1)
+                    throw new NotSupportedException("The native owned assembly lookup could not be configured.");
+                configured = true;
+                hook.Apply();
+            }
+            catch
