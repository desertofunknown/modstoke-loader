+++ b/Il2CppInterop.Runtime/Injection/NativeAudioTypeRegistration.cs
@@ -0,0 +1,64 @@
+// SPDX-License-Identifier: LGPL-3.0-only
+using System;
+using System.Runtime.ExceptionServices;
+using Il2CppInterop.Runtime.Startup;
+
+namespace Il2CppInterop.Runtime.Injection;
+
+/// <summary>Publishes the original AudioType enum before generated wrappers resolve native signatures.</summary>
+public static class NativeAudioTypeRegistration
+{
+    public const int PublishedGraphVersion = 1;
+    private static readonly object Gate = new();
+    private static NativeAudioTypeMetadata? published;
+    private static ExceptionDispatchInfo? failure;
+
+    public static IntPtr RequirePublishedClass()
+    {
+        lock (Gate)
+        {
+            failure?.Throw();
+            var graph = published ?? throw new InvalidOperationException(
+                "Native AudioType was not published during startup. Use a matching native host, runtime and preloader.");
+            graph.RequireContext();
+            return graph.Class;
+        }
+    }
+
+    /// <summary>Requires the initial attached bootstrap thread, before any AudioType class-pointer store is used.</summary>
+    public static void PublishDuringBootstrap(IntPtr query)
+    {
+        var window = NativeTypePublication.GetWindow(query);
+        lock (Gate)
+        {
+            failure?.Throw();
+            if (published != null)
+            {
+                published.RequireContext();
+                return;
+            }
+
+            var runtime = Il2CppInteropRuntime.Instance;
+            runtime.RetainNativeJob();
+            try
+            {
+                var player = NativeTypePublication.RequirePlayer();
+                NativeTypePublication.RequireEarlyWindow(window, player);
+                using var graph = new NativeAudioTypeMetadata();
+                InjectorHelpers.AddPreparedTypesToLookup("UnityEngine", graph.Image,
+                    new[] { ("AudioType", graph.Class) }, () =>
+                    {
+                        NativeTypePublication.RequireEarlyWindow(window, player);
+                        graph.Retain();
+                    });
+                published = graph;
+            }
+            catch (Exception error)
+            {
+                failure = ExceptionDispatchInfo.Capture(error);
+                throw;
+            }
+            finally { runtime.ReleaseNativeJob(); }
+        }
+    }
+}
