+INTEROP_EXPORT void* Il2CppInterop_PrepareOwnedTypeLookup(
+    std::uint32_t abi, const Entry* names, std::uint32_t nameCount,
+    const EnumerationEntry* types, std::uint32_t typeCount, void* arrayClass) noexcept
+{
+    if (abi != 1 || names == nullptr || types == nullptr || arrayClass == nullptr ||
+        nameCount == 0 || nameCount != typeCount || !configured.load(std::memory_order_acquire) ||
+        !enumerationConfigured.load(std::memory_order_acquire)) return nullptr;
+    const void* const image = names[0].image;
+    if (image == nullptr) return nullptr;
+    try
+    {
+        auto pending = std::make_unique<Pending>();
+        pending->baseline = std::atomic_load_explicit(&GetRegistry().snapshot, std::memory_order_acquire);
+        if (pending->baseline)
+        {
+            if (pending->baseline->ownedImages.find(image) != pending->baseline->ownedImages.end() ||
+                pending->baseline->types.find(image) != pending->baseline->types.end()) return nullptr;
+            for (const auto& record : pending->baseline->names)
+                if (record.image == image) return nullptr;
+        }
+        for (std::uint32_t i = 0; i < nameCount; ++i)
+        {
+            if (names[i].image != image || types[i].image != image) return nullptr;
+            bool represented = false;
+            for (std::uint32_t j = 0; j < typeCount; ++j)
+                if (names[i].klass == types[j].klass)
+                {
+                    if (represented) return nullptr;
+                    represented = true;
+                }
+            if (!represented) return nullptr;
+        }
+        auto prepared = pending->baseline ? std::make_shared<Snapshot>(*pending->baseline) :
+            std::make_shared<Snapshot>();
+        if (!AddNames(*prepared, names, nameCount)) return nullptr;
+        // Ownership must accompany the complete declaration set in the same publication.
+        prepared->ownedImages.emplace(image, arrayClass);
+        pending->prepared = prepared;
+        if (!AddEnumeration(*pending, types, typeCount)) return nullptr;
+        return pending.release();
+    }
+    catch (const std::bad_alloc&) { return nullptr; }
+    catch (const std::length_error&) { return nullptr; }
+    catch (const std::system_error&) { return nullptr; }
+}
