+        bindings.load(std::memory_order_acquire) == nullptr) return nullptr;
+    const auto& entry = family == 0 ? sourceEntries[method] : markupEntries[method];
+    return kind == 0 ? entry.method : kind == 1 ? entry.invoker : entry.adjustor;
+}
