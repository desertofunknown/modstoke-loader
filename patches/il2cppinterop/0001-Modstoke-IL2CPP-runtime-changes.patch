+        lock (NativeJobGate)
+        {
+            if (nativeJobOwners != 0)
+                throw new InvalidOperationException("Complete owned native jobs before disposing the runtime.");
+            Volatile.Write(ref nativeJobState, 2);
+        }
+        base.Dispose();
     }
 }
