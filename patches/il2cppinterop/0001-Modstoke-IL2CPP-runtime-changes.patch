+    }
+
+    public void Dispose()
+    {
+        if (disposed || retained) return;
+        try
+        {
+            var methodsReleased = ReleaseMethods();
+            var attributesReleased = ReleaseAttributes();
+            if (!methodsReleased || !attributesReleased)
+                throw new InvalidOperationException("Native WWW registrations could not be removed; their owners must remain alive.");
+        }
+        catch
+        {
+            // Failed unregistration leaves native pointers live, so their complete graph must survive.
+            runtime.RetainNativeJob();
+            retained = true;
+            imageOwner?.Retain();
+            throw;
+        }
+        disposed = true;
+        if (classToken != 0) InjectorHelpers.s_InjectedClasses.TryRemove(classToken, out _);
+        classToken = 0;
+        Class = IntPtr.Zero;
+        for (var i = allocations.Count - 1; i >= 0; i--) Marshal.FreeHGlobal(allocations[i]);
+        allocations.Clear();
+        imageOwner?.Dispose();
+        imageOwner = null;
+    }
+
+    private void Track(IntPtr pointer)
+    {
+        try { allocations.Add(pointer); }
+        catch { Marshal.FreeHGlobal(pointer); throw; }
+    }
+
+    private IntPtr Allocate(int bytes)
+    {
+        var pointer = Marshal.AllocHGlobal(bytes);
+        Track(pointer);
+        new Span<byte>((void*)pointer, bytes).Clear();
+        return pointer;
+    }
+
+    private IntPtr String(string value)
+    {
+        var bytes = Encoding.UTF8.GetBytes(value);
+        var pointer = Allocate(checked(bytes.Length + 1));
+        Marshal.Copy(bytes, 0, pointer, bytes.Length);
+        return pointer;
+    }
+}
