+                    throw new InvalidOperationException("Unity returned an unexpected job reflection result type.");
+                var address = IL2CPP.il2cpp_object_unbox(result);
+                if (address == IntPtr.Zero) throw new InvalidOperationException("Unity's job reflection result has no value storage.");
+                var pointer = *(IntPtr*)address;
+                if (pointer == IntPtr.Zero) throw new InvalidOperationException("Unity returned a null job reflection pointer.");
+                return pointer;
+            }
+            finally
+            {
+                IL2CPP.il2cpp_gchandle_free(pin);
+            }
+        }
+        finally
