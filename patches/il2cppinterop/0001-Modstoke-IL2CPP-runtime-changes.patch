+using System;
+
+namespace Il2CppInterop.Runtime.Injection;
+
+public static unsafe partial class NativeJobScheduler
+{
+    /// <summary>Schedules a transform producer using Unity's writable hierarchy-aware scheduler.</summary>
+    /// <remarks>
+    /// The producer must implement Unity's transform callback contract, not an ordinary parallel-for loop.
+    /// The exact UnityEngine.Jobs.TransformAccessArray value is borrowed; do not mutate or dispose it
+    /// until completion. Native implicit hierarchy dependencies do not release unrelated managed owners.
+    /// Complete each owner or pass it as an explicit dependency.
+    /// </remarks>
+    public static NativeJob ScheduleParallelForTransform<T, TTransforms>(NativeJobRegistration registration,
+        in T payload, in TTransforms transforms, NativeJob? dependency = null)
+        where T : struct where TTransforms : struct
+    {
+        var schedule = CreateTransformSchedule(registration, in transforms, false, 1, 0);
+        return Submit(registration, in payload, dependency, in schedule);
+    }
+
+    /// <summary>Schedules a read-only transform producer with a positive batch size.</summary>
+    /// <remarks>Transform array ownership and producer requirements match ScheduleParallelForTransform.</remarks>
+    public static NativeJob ScheduleParallelForTransformReadOnly<T, TTransforms>(NativeJobRegistration registration,
+        in T payload, in TTransforms transforms, int batchSize, NativeJob? dependency = null)
+        where T : struct where TTransforms : struct
+    {
+        if (batchSize < 1) throw new ArgumentOutOfRangeException(nameof(batchSize));
+        var schedule = CreateTransformSchedule(registration, in transforms, true, 1, batchSize);
+        return Submit(registration, in payload, dependency, in schedule);
+    }
+
+    /// <summary>Runs a read-only transform producer synchronously using the array length as its batch size.</summary>
+    /// <remarks>Transform array ownership and producer requirements match ScheduleParallelForTransform.</remarks>
+    public static void RunParallelForTransformReadOnly<T, TTransforms>(NativeJobRegistration registration,
+        in T payload, in TTransforms transforms) where T : struct where TTransforms : struct
+    {
+        var schedule = CreateTransformSchedule(registration, in transforms, true, 0, 0);
+        using var job = Submit(registration, in payload, null, in schedule);
+        job.Complete();
+    }
+
+    /// <summary>Schedules a writable transform producer and exports its owned Unity JobHandle.</summary>
+    /// <remarks>Transform array ownership and producer requirements match ScheduleParallelForTransform.</remarks>
+    public static THandle ScheduleParallelForTransformWithHandle<T, TTransforms, THandle>(
+        NativeJobRegistration registration, in T payload, in TTransforms transforms, THandle dependency)
+        where T : struct where TTransforms : struct where THandle : struct
