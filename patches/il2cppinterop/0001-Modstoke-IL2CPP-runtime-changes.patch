@@ -0,0 +1,35 @@
+using System;
+using System.Reflection;
+
+namespace Il2CppInterop.Runtime.Injection;
+
+public static unsafe partial class NativeJobScheduler
+{
+    private delegate void ProjectedSubmit<T>(NativeJob job, in T payload, IntPtr reflection,
+        NativeJobHandle dependency, in NativeJobSchedule schedule) where T : struct;
+
+    private static class ProjectedInvocation<T> where T : struct
+    {
+        internal static readonly ProjectedSubmit<T> Invoke = Create();
+
+        private static ProjectedSubmit<T> Create()
+        {
+            var projection = NativeJobPayloadPlan.Get(typeof(T));
+            if (projection.NativeType == typeof(T))
+                throw new NotSupportedException("Reference-bearing job payloads require an explicit native projection.");
+            var method = typeof(NativeJobScheduler).GetMethod(nameof(InvokeProjected), BindingFlags.Static | BindingFlags.NonPublic)!
+                .MakeGenericMethod(typeof(T), projection.NativeType);
+            return (ProjectedSubmit<T>)method.CreateDelegate(typeof(ProjectedSubmit<T>));
+        }
+    }
+
+    private static void InvokeProjected<TSource, TNative>(NativeJob job, in TSource payload, IntPtr reflection,
+        NativeJobHandle dependency, in NativeJobSchedule schedule)
+        where TSource : struct where TNative : struct
+    {
+        // The native scheduler copies this bounded reference-free payload before returning.
+        var storage = new TNative[1];
+        NativeJobPayloadBinding<TSource, TNative>.Encode(in payload, out storage[0]);
+        InvokeReferenceFree(job, in storage[0], reflection, dependency, in schedule);
+    }
+}
