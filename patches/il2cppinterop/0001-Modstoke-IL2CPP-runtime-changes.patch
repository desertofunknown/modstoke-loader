+++ b/Il2CppInterop.Native/VideoReadyJobs.cpp
@@ -0,0 +1,350 @@
+// SPDX-License-Identifier: LGPL-3.0-only
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <exception>
+#include <memory>
+#include <mutex>
+#include <new>
+
+#if defined(_WIN32)
+#define INTEROP_EXPORT extern "C" __declspec(dllexport)
+#else
+#define INTEROP_EXPORT extern "C" __attribute__((visibility("default")))
+#endif
+
+namespace
+{
+    using JobFunction = void (*)(void*);
+    using SubmitJob = void (*)(void*, void*, JobFunction, void*, const void*);
+
+    struct Configuration
+    {
+        SubmitJob OriginalSubmit;
+        JobFunction OriginalReady;
+        std::uint32_t (*HandleNew)(void*, bool);
+        void* (*HandleGet)(std::uint32_t);
+        void (*HandleFree)(std::uint32_t);
+        void* Corlib;
+        void* (*ExceptionFromName)(void*, const char*, const char*, const char*);
+        void (*Raise)(void*);
+        void (*OriginalShutdown)(void*, std::uintptr_t, std::uint32_t);
+        void** SchedulerHolder;
+        void (*WaitForFence)(void*, std::uint64_t, std::uint32_t);
+    };
+    static_assert(sizeof(void*) == 8);
+    static_assert(sizeof(bool) == 1);
+    static_assert(sizeof(Configuration) == 88);
+    std::atomic<const Configuration*> configuration{nullptr};
+
+    struct CallbackSlot
+    {
+        std::uint64_t handle = 0;
+        std::uint32_t kind = 0;
+        std::uint32_t padding = 0;
+        void* target = nullptr;
+    };
+    struct CallbackRecord { CallbackSlot error, ready, end; };
+    static_assert(sizeof(CallbackSlot) == 24);
+    static_assert(sizeof(CallbackRecord) == 72);
+    static_assert(offsetof(CallbackRecord, ready) == 0x18);
+    static_assert(offsetof(CallbackSlot, kind) == 8);
+    static_assert(offsetof(CallbackSlot, target) == 16);
+
+    struct ReadyJob;
+    class Submission;
+    class SchedulerShutdown;
+    std::mutex gate;
+    ReadyJob* pending = nullptr;
+    Submission* submissions = nullptr;
+    SchedulerShutdown* shutdowns = nullptr;
+
+    void* CurrentScheduler(const Configuration& config)
+    {
+        auto* holder = *config.SchedulerHolder;
+        return holder == nullptr ? nullptr :
+            *reinterpret_cast<void**>(static_cast<std::byte*>(holder) + 0x30);
+    }
+
+    void WaitForPrevious(const Configuration& config, void* fence)
+    {
+        std::uint64_t handle;
+        std::memcpy(&handle, fence, sizeof(handle));
+        if (handle == 0) return;
+        config.WaitForFence(CurrentScheduler(config), handle, 1);
+        std::memset(fence, 0, 12);
+    }
+
+    [[noreturn]] void Raise(const Configuration& config, const char* type, const char* message)
+    {
+        auto* exception = config.ExceptionFromName(config.Corlib, "System", type, message);
+        if (exception == nullptr) throw std::bad_alloc();
+        config.Raise(exception);
+        std::terminate();
+    }
+
+    struct ReadyJob
+    {
+        CallbackRecord callbacks{};
+        const Configuration* const config;
+        void* scheduler = nullptr;
+        std::atomic<std::uint32_t> references{2};
+        ReadyJob* previous = nullptr;
+        ReadyJob* next = nullptr;
+        bool linked = false;
+        bool claimed = false;
+        bool canAbandon = true;
+
+        explicit ReadyJob(const Configuration* config) noexcept : config(config) {}
+
+        ~ReadyJob() noexcept
+        {
+            if (callbacks.ready.handle != 0)
+                config->HandleFree(static_cast<std::uint32_t>(callbacks.ready.handle));
+        }
+
+        void Unlink() noexcept
+        {
+            if (!linked) return;
+            if (previous != nullptr) previous->next = next;
+            else pending = next;
+            if (next != nullptr) next->previous = previous;
+            previous = next = nullptr;
+            linked = false;
+        }
+
+        void Release() noexcept
+        {
+            if (references.fetch_sub(1, std::memory_order_acq_rel) != 1) return;
+            {
+                std::lock_guard<std::mutex> lock(gate);
+                Unlink();
+            }
+            delete this;
+        }
+    };
+
+    class JobReference
+    {
+        ReadyJob* const job;
+
+    public:
+        explicit JobReference(ReadyJob* job) noexcept : job(job) {}
+        ~JobReference() noexcept { job->Release(); }
+        JobReference(const JobReference&) = delete;
+        JobReference& operator=(const JobReference&) = delete;
+    };
+
+    class Submission
+    {
+    public:
+        void* const scheduler;
+        Submission* next;
+        bool canAbandon = true;
+
+        explicit Submission(const Configuration& config)
+            : scheduler(CurrentScheduler(config))
+        {
+            std::lock_guard<std::mutex> lock(gate);
+            next = submissions;
+            submissions = this;
+        }
+
+        ~Submission() noexcept
+        {
+            std::lock_guard<std::mutex> lock(gate);
+            auto** entry = &submissions;
+            while (*entry != this) entry = &(*entry)->next;
+            *entry = next;
+        }
+        Submission(const Submission&) = delete;
+        Submission& operator=(const Submission&) = delete;
+    };
+
+    class SchedulerShutdown
+    {
+        void* const scheduler;
+        SchedulerShutdown* next;
+        bool exclusive = true;
+        const bool destroys;
+
+    public:
+        bool completed = false;
+
+        explicit SchedulerShutdown(void* scheduler)
+            : scheduler(scheduler), destroys(*reinterpret_cast<std::uint32_t*>(
+                static_cast<std::byte*>(scheduler) + 0x3C) == 0)
+        {
+            std::lock_guard<std::mutex> lock(gate);
+            for (auto* frame = shutdowns; frame != nullptr; frame = frame->next)
+            {
+                if (frame->scheduler != scheduler) continue;
+                exclusive = frame->exclusive = false;
+            }
+            next = shutdowns;
+            shutdowns = this;
+        }
+
+        ~SchedulerShutdown() noexcept
+        {
+            ReadyJob* abandoned = nullptr;
+            {
+                std::lock_guard<std::mutex> lock(gate);
+                bool reclaim = completed && destroys && exclusive;
+                for (auto* producer = submissions; producer != nullptr; producer = producer->next)
+                {
+                    if (producer->scheduler != scheduler) continue;
+                    producer->canAbandon = false;
+                    reclaim = false;
+                }
+                for (auto* job = pending; job != nullptr;)
+                {
+                    auto* nextJob = job->next;
+                    if (job->scheduler == scheduler && !job->claimed)
+                    {
+                        if (reclaim && job->canAbandon)
+                        {
+                            job->claimed = true;
+                            job->Unlink();
+                            job->next = abandoned;
+                            abandoned = job;
+                        }
+                        else job->canAbandon = false;
+                    }
+                    job = nextJob;
+                }
+                auto** entry = &shutdowns;
+                while (*entry != this) entry = &(*entry)->next;
+                *entry = next;
+            }
+            // Only full, exclusive teardown retires unactivated slots. Early returns,
+            // unwind and overlapping producers leave their job references intact.
+            while (abandoned != nullptr)
+            {
+                auto* nextJob = abandoned->next;
+                abandoned->next = nullptr;
+                abandoned->Release();
+                abandoned = nextJob;
+            }
+        }
+        SchedulerShutdown(const SchedulerShutdown&) = delete;
+        SchedulerShutdown& operator=(const SchedulerShutdown&) = delete;
+    };
+
+    std::unique_ptr<ReadyJob> RetainReady(const Configuration& config, const void* context)
+    {
+        if (context == nullptr)
+            Raise(config, "InvalidOperationException", "The video ready callback record is unavailable.");
+        const auto& source = static_cast<const CallbackRecord*>(context)->ready;
+        auto* callback = source.kind == 2 ? source.target : source.handle == 0 ? nullptr :
+            config.HandleGet(static_cast<std::uint32_t>(source.handle));
+        if (callback == nullptr)
+            Raise(config, "InvalidOperationException", "The video ready delegate is unavailable.");
+
+        auto owner = std::unique_ptr<ReadyJob>(new (std::nothrow) ReadyJob(&config));
+        if (!owner)
+            Raise(config, "OutOfMemoryException", "The video ready callback could not be retained.");
+        owner->callbacks.ready.kind = 2;
+        owner->callbacks.ready.handle = config.HandleNew(callback, true);
+        if (owner->callbacks.ready.handle == 0)
+            Raise(config, "OutOfMemoryException", "The video ready delegate could not be pinned.");
+        owner->callbacks.ready.target =
+            config.HandleGet(static_cast<std::uint32_t>(owner->callbacks.ready.handle));
+        if (owner->callbacks.ready.target == nullptr)
+            Raise(config, "InvalidOperationException", "The retained video ready delegate is unavailable.");
+        return owner;
+    }
+
+    void InvokeReady(void* context)
+    {
+        auto* job = static_cast<ReadyJob*>(context);
+        {
+            std::lock_guard<std::mutex> lock(gate);
+            job->claimed = true;
+        }
+        const JobReference invocation(job);
+        job->config->OriginalReady(&job->callbacks);
+    }
+
+    void Submit(void* batch, void* fence, JobFunction function, void* context, const void* dependency)
+    {
+        const auto* config = configuration.load(std::memory_order_acquire);
+        if (function != config->OriginalReady)
+        {
+            config->OriginalSubmit(batch, fence, function, context, dependency);
+            return;
+        }
+
+        auto owner = RetainReady(*config, context);
+        // Preserve the original fence wait before selecting the scheduler: work run by
+        // the wait can replace it. Only the first 12 bytes of the fence are cleared.
+        WaitForPrevious(*config, fence);
+        Submission producer(*config);
+        auto* job = owner.get();
+        {
+            std::lock_guard<std::mutex> lock(gate);
+            job->next = pending;
+            if (pending != nullptr) pending->previous = job;
+            pending = job;
+            job->linked = true;
+            job->scheduler = producer.scheduler;
+            job->canAbandon = producer.canAbandon;
+        }
+        owner.release();
+        const JobReference submission(job);
+        // The scheduler can invoke inline or unwind after publication. Only invocation
+        // or completed scheduler teardown consumes the separate job reference.
+        config->OriginalSubmit(batch, fence, &InvokeReady, job, dependency);
+    }
+
+    void Shutdown(void* scheduler, std::uintptr_t unused, std::uint32_t allowSteal)
+    {
+        const auto* config = configuration.load(std::memory_order_acquire);
+        SchedulerShutdown frame(scheduler);
+        config->OriginalShutdown(scheduler, unused, allowSteal);
+        frame.completed = true;
+    }
+
+    bool Matches(const Configuration& left, const Configuration& right) noexcept
+    {
+        return left.OriginalSubmit == right.OriginalSubmit && left.OriginalReady == right.OriginalReady &&
+            left.HandleNew == right.HandleNew && left.HandleGet == right.HandleGet &&
+            left.HandleFree == right.HandleFree && left.Corlib == right.Corlib &&
+            left.ExceptionFromName == right.ExceptionFromName && left.Raise == right.Raise &&
+            left.OriginalShutdown == right.OriginalShutdown &&
+            left.SchedulerHolder == right.SchedulerHolder && left.WaitForFence == right.WaitForFence;
+    }
+}
+
+INTEROP_EXPORT std::uint32_t Il2CppInterop_ConfigureVideoReadyJobs(
+    std::uint32_t abi, const Configuration* config, std::uint32_t size) noexcept
+{
