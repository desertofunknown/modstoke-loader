+        Getter<std::int32_t, &Get<std::int32_t, BuildMarkup, &BuildMarkup::area>>(),
+        Setter<std::int32_t, &Set<std::int32_t, BuildMarkup, &BuildMarkup::area>>(),
+        Getter<bool, &Get<bool, BuildMarkup, &BuildMarkup::inheritIgnoreFromBuild, true>>(),
+        Setter<bool, &Set<bool, BuildMarkup, &BuildMarkup::inheritIgnoreFromBuild, true>>(),
+        Getter<bool, &Get<bool, BuildMarkup, &BuildMarkup::ignoreFromBuild>>(),
+        Setter<bool, &Set<bool, BuildMarkup, &BuildMarkup::ignoreFromBuild>>(),
+        Getter<bool, &Get<bool, BuildMarkup, &BuildMarkup::overrideGenerateLinks>>(),
+        Setter<bool, &Set<bool, BuildMarkup, &BuildMarkup::overrideGenerateLinks>>(),
+        Getter<bool, &Get<bool, BuildMarkup, &BuildMarkup::generateLinks>>(),
+        Setter<bool, &Set<bool, BuildMarkup, &BuildMarkup::generateLinks>>(),
+        Getter<bool, &Get<bool, BuildMarkup, &BuildMarkup::ignoreChildren, true>>(),
+        Setter<bool, &Set<bool, BuildMarkup, &BuildMarkup::ignoreChildren, true>>(),
+        Getter<void*, &GetObject<BuildMarkup, &BuildMarkup::instanceID, &Bindings::rootCall>>(),
