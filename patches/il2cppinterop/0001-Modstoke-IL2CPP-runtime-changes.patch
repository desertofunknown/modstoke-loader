+{
+    using namespace NavMeshTypes;
+
+    struct Bindings
+    {
+        void* componentCall;
+        void* objectCall;
+        void* rootCall;
+        void* instanceId;
+        void* inequality;
+    };
+    std::atomic<const Bindings*> bindings{nullptr};
+    constexpr std::size_t ObjectHeaderSize = 16;
+
+    bool Matches(const Bindings& a, const Bindings& b) noexcept
+    {
+        return a.componentCall == b.componentCall && a.objectCall == b.objectCall &&
+            a.rootCall == b.rootCall && a.instanceId == b.instanceId && a.inequality == b.inequality;
+    }
+
+    template<typename T, typename Owner, auto Member, bool Inverse = false>
+    T Get(void* self, const void*)
+    {
+        if constexpr (std::is_same_v<T, bool>)
+            return Inverse ? (static_cast<Owner*>(self)->*Member) == 0 :
+                (static_cast<Owner*>(self)->*Member) != 0;
+        else
+            return static_cast<Owner*>(self)->*Member;
+    }
+
+    template<typename T, typename Owner, auto Member, bool Inverse = false>
+    void Set(void* self, T value, const void*)
+    {
+        if constexpr (std::is_same_v<T, bool>)
+            static_cast<Owner*>(self)->*Member = (Inverse ? !value : value) ? 1 : 0;
+        else
+            static_cast<Owner*>(self)->*Member = value;
+    }
+
+    template<auto Call>
+    void* InternalGet(std::int32_t id, const void*)
+    {
+        const auto* current = bindings.load(std::memory_order_acquire);
+        return reinterpret_cast<void* (*)(std::int32_t)>(current->*Call)(id);
+    }
+
+    template<typename Owner, auto Member, auto Call>
+    void* GetObject(void* self, const void* metadata)
+    {
+        return InternalGet<Call>(static_cast<Owner*>(self)->*Member, metadata);
+    }
+
+    template<typename Owner, auto Member>
+    void SetObject(void* self, void* value, const void*)
+    {
+        const auto* current = bindings.load(std::memory_order_acquire);
+        // Both compiled calls stay native; their unused MethodInfo is always null.
+        const bool exists = reinterpret_cast<bool (*)(void*, void*, const void*)>(
+            current->inequality)(value, nullptr, nullptr);
+        const std::int32_t id = exists && value != nullptr ?
+            reinterpret_cast<std::int32_t (*)(void*, const void*)>(current->instanceId)(value, nullptr) : 0;
+        static_cast<Owner*>(self)->*Member = id;
+    }
+
+    template<typename T, auto Method>
+    T BoxedGet(void* self, const void* metadata)
+    {
+        return Method(static_cast<std::uint8_t*>(self) + ObjectHeaderSize, metadata);
+    }
