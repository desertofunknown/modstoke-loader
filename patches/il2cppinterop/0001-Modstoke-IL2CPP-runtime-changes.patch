--- /dev/null
+++ b/Il2CppInterop.Runtime/IL2CPP.Images.cs
@@ -0,0 +1,44 @@
+// SPDX-License-Identifier: LGPL-3.0-only
+using System;
+using System.Collections.Generic;
+using System.Threading;
+
+namespace Il2CppInterop.Runtime;
+
+public static unsafe partial class IL2CPP
+{
+    private static readonly object ImagePublicationGate = new();
+
+    internal sealed class ImagePublication : IDisposable
+    {
+        private readonly Dictionary<string, IntPtr> images;
+        private bool disposed;
+
+        internal ImagePublication(string name, IntPtr image)
+        {
+            ArgumentException.ThrowIfNullOrEmpty(name);
+            if (image == IntPtr.Zero) throw new ArgumentException("The native image is null.", nameof(image));
+            Monitor.Enter(ImagePublicationGate);
+            try
+            {
+                images = new Dictionary<string, IntPtr>(Volatile.Read(ref ourImagesMap));
+                images.Add(name, image);
+            }
+            catch
+            {
+                Monitor.Exit(ImagePublicationGate);
+                throw;
+            }
+        }
+
+        // The caller holds the writer gate across native exposure; this commit cannot allocate.
+        internal void Publish() => Volatile.Write(ref ourImagesMap, images);
+
+        public void Dispose()
+        {
+            if (disposed) return;
+            disposed = true;
+            Monitor.Exit(ImagePublicationGate);
+        }
+    }
+}
