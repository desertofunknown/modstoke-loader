+                            method.MethodPointer == IntPtr.Zero || method.InvokerMethod == IntPtr.Zero ||
+                            (IntPtr)method.Class != attributeClass || method.ParametersCount != 1 ||
+                            (method.Flags & (Il2CppMethodFlags.METHOD_ATTRIBUTE_MEMBER_ACCESS_MASK |
+                                Il2CppMethodFlags.METHOD_ATTRIBUTE_STATIC)) != Il2CppMethodFlags.METHOD_ATTRIBUTE_PUBLIC ||
