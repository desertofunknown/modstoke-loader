+        const auto createHandle = reinterpret_cast<std::intptr_t (*)(void*, bool)>(frame->createHandle);
+        for (std::size_t index = 0; index != 3; ++index)
+        {
+            if (arrays[index] == nullptr) continue;
+            frame->handles[index] = createHandle(arrays[index], true);
+            if (frame->handles[index] == 0)
+            {
+                frame->status = 1;
+                return;
+            }
+        }
+        frame->status = 2;
+    }
+
+    void InvokeTriangulation(void* method, const void*, void*, void** args, void*)
+    {
+        reinterpret_cast<void (*)(TriangulationFrame*)>(method)(
+            *static_cast<TriangulationFrame**>(args[0]));
+    }
+}
+
+// Unity exceptions unwind only through native frames into il2cpp_runtime_invoke.
+INTEROP_EXPORT void* Il2CppInterop_GetNavigationEntry(std::uint32_t abi, std::uint32_t entry)
+{
+    if (abi != 1) return nullptr;
