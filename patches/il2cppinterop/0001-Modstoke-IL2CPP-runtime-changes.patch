+INTEROP_EXPORT std::uint32_t Il2CppInterop_ConfigureTypeNameLookup(
+    std::uint32_t abi, const Config* config, std::uint32_t size) noexcept
+{
+    if (abi != 1 || config == nullptr || size != sizeof(Config) ||
+        config->OriginalLookup == nullptr || config->EqualsIgnoreCase == nullptr) return 0;
+    try
+    {
+        std::lock_guard<std::mutex> lock(configurationMutex);
+        if (configured.load(std::memory_order_relaxed))
+            return configuration.OriginalLookup == config->OriginalLookup &&
+                configuration.EqualsIgnoreCase == config->EqualsIgnoreCase ? 1u : 0u;
+        (void)GetRegistry();
+        configuration = *config;
+        configured.store(true, std::memory_order_release);
+        return 1;
+    }
+    catch (const std::bad_alloc&) { return 0; }
+    catch (const std::system_error&) { return 0; }
+}
