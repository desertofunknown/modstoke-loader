+        return SubmitWithHandle(registration, in payload, dependency, in schedule);
+    }
+
+    /// <summary>Schedules a read-only transform producer and exports its owned Unity JobHandle.</summary>
+    /// <remarks>Transform array ownership and producer requirements match ScheduleParallelForTransform.</remarks>
+    public static THandle ScheduleParallelForTransformReadOnlyWithHandle<T, TTransforms, THandle>(
+        NativeJobRegistration registration, in T payload, in TTransforms transforms, int batchSize, THandle dependency)
+        where T : struct where TTransforms : struct where THandle : struct
