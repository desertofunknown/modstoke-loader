+using System;
+using System.Collections.Generic;
+using System.Threading;
+
+namespace Il2CppInterop.Runtime.Injection;
+
+public sealed partial class NativeJob
+{
+    private static long sequence;
+    private NativeJob[] dependencies;
+    private readonly NativeJobExecution? dependencyFailure;
+    private NativeJobExecution? completionFailure;
+    internal long Order { get; }
+    internal bool OwnershipReleased => Volatile.Read(ref completed);
+    internal NativeJobExecution? CompletedFailure => OwnershipReleased ? completionFailure : null;
+
+    // The caller retains the runtime and passes a private array before publishing this owner.
+    internal NativeJob(NativeJobBindings binding, NativeJob[] dependencies, NativeJobExecution? dependencyFailure = null)
+    {
+        Order = Interlocked.Increment(ref sequence);
+        if (Order <= 0) throw new InvalidOperationException("Native job owner identifiers are exhausted.");
+        Binding = binding;
+        this.dependencies = dependencies;
+        this.dependencyFailure = dependencyFailure;
+    }
