+    static_assert(sizeof(Request) == 128);
+    static_assert(offsetof(Request, Vector) == 0);
+    static_assert(offsetof(Request, Begin) == 8);
+    static_assert(offsetof(Request, End) == 16);
+    static_assert(offsetof(Request, Capacity) == 24);
