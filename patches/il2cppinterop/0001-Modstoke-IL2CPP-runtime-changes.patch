index 0000000..63f95ff
--- /dev/null
+++ b/Il2CppInterop.Native/CallbackExceptions.cpp
@@ -0,0 +1,1312 @@
+// SPDX-License-Identifier: LGPL-3.0-only
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <exception>
+#include <new>
+#include <string>
+#include <type_traits>
+
+#if defined(_WIN32)
+#define INTEROP_EXPORT extern "C" __declspec(dllexport)
+#else
+#define INTEROP_EXPORT extern "C" __attribute__((visibility("default")))
+#endif
+
+namespace
+{
+    using Invoker = void (*)(void*, const void*, void*, void**, void*);
+    struct Configuration
+    {
+        Invoker VoidInvoker;
+        Invoker StringInvoker;
+        void* Corlib;
+        void* (*ExceptionFromName)(void*, const char*, const char*, const char*);
+        void (*Raise)(void*);
+        std::uint32_t (*HandleNew)(void*, bool);
+        void* (*HandleGet)(std::uint32_t);
+        void (*HandleFree)(std::uint32_t);
+    };
+    static_assert(sizeof(void*) == 8);
+    static_assert(sizeof(Configuration) == 64);
+    std::atomic<const Configuration*> configuration{nullptr};
+
+    struct PinnedReference
+    {
+        const Configuration& config;
+        const std::uint32_t handle;
+
+        PinnedReference(const Configuration& config, void* value) :
+            config(config), handle(value == nullptr ? 0 : config.HandleNew(value, true))
+        {
+            if (value != nullptr && handle == 0) throw std::bad_alloc();
+        }
+        ~PinnedReference() noexcept
+        {
+            if (handle != 0) config.HandleFree(handle);
+        }
+        PinnedReference(const PinnedReference&) = delete;
+        PinnedReference& operator=(const PinnedReference&) = delete;
+    };
+
+    // Each concrete class and its parameterless constructor exists in the pinned corlib.
+    constexpr const char* ExceptionNames[] =
+    {
+        "Exception", "SystemException", "InvalidOperationException",
+        "ArgumentException", "ArgumentNullException", "ArgumentOutOfRangeException",
+        "NotSupportedException", "NotImplementedException", "NullReferenceException",
+        "IndexOutOfRangeException", "InvalidCastException", "ObjectDisposedException",
+        "OperationCanceledException", "TimeoutException"
+    };
+    constexpr auto ExceptionTypeCount = sizeof(ExceptionNames) / sizeof(ExceptionNames[0]);
+
+    struct Frame;
+    thread_local Frame* currentFrame = nullptr;
+
+    struct Frame
+    {
+        const Configuration& config;
+        const void* method;
+        Frame* const previous;
+        bool claimed = false;
+        bool failed = false;
+        std::uint32_t exceptionHandle = 0;
+        std::uint32_t returnHandle = 0;
+        std::uint32_t exceptionType = 0;
+        std::string message;
+
+        Frame(const Configuration& config, const void* method) noexcept :
+            config(config), method(method), previous(currentFrame) { currentFrame = this; }
+        ~Frame() noexcept
+        {
+            currentFrame = previous;
+            if (exceptionHandle != 0) config.HandleFree(exceptionHandle);
+            if (returnHandle != 0) config.HandleFree(returnHandle);
+        }
+        Frame(const Frame&) = delete;
+        Frame& operator=(const Frame&) = delete;
+
+        void RaiseFailure()
+        {
+            if (!failed) return;
+            void* exception = exceptionHandle == 0 ? nullptr : config.HandleGet(exceptionHandle);
+            if (exception == nullptr)
+            {
+                const char* text = message.empty()
+                    ? "A managed callback failed; its exception details were unavailable." : message.c_str();
+                exception = config.ExceptionFromName(config.Corlib, "System", ExceptionNames[exceptionType], text);
+                if (exception == nullptr) throw std::bad_alloc();
+                exceptionHandle = config.HandleNew(exception, true);
+                if (exceptionHandle == 0) throw std::bad_alloc();
+            }
+            // Both reverse-P/Invoke frames have returned before Unity begins C++ unwinding.
+            config.Raise(exception);
+            std::terminate();
+        }
+    };
+
+    void Invoke(bool withString, void* method, const void* metadata, void* self, void** args, void* result)
+    {
+        const auto* config = configuration.load(std::memory_order_acquire);
+        if (config == nullptr) std::terminate();
+        Frame frame(*config, metadata);
+        (withString ? config->StringInvoker : config->VoidInvoker)(method, metadata, self, args, result);
+        frame.RaiseFailure();
+    }
+
+    void InvokeVoid(void* method, const void* metadata, void* self, void** args, void* result)
+    {
+        Invoke(false, method, metadata, self, args, result);
+    }
+
+    void InvokeString(void* method, const void* metadata, void* self, void** args, void* result)
+    {
+        Invoke(true, method, metadata, self, args, result);
+    }
+
+    struct TargetMethod
+    {
+        alignas(void*) std::byte metadata[88];
+        void* trampoline;
+    };
+    static_assert(offsetof(TargetMethod, trampoline) == 88);
+    static_assert(sizeof(TargetMethod) == 96);
+
+    // Keep Hash128 typed by value so the compiler lowers both aggregate arguments and returns.
+    struct Hash128Value
+    {
+        std::uint64_t low;
+        std::uint64_t high;
+    };
+    static_assert(sizeof(Hash128Value) == 16);
+    static_assert(alignof(Hash128Value) == 8);
+    static_assert(std::is_standard_layout_v<Hash128Value>);
+    static_assert(std::is_trivial_v<Hash128Value>);
+    static_assert(offsetof(Hash128Value, low) == 0);
+    static_assert(offsetof(Hash128Value, high) == 8);
+
+    struct CachedAssetBundleValue
+    {
+        void* name;
+        Hash128Value hash;
+    };
+    static_assert(sizeof(CachedAssetBundleValue) == 24);
+    static_assert(alignof(CachedAssetBundleValue) == 8);
+    static_assert(std::is_standard_layout_v<CachedAssetBundleValue>);
+    static_assert(std::is_trivial_v<CachedAssetBundleValue>);
+    static_assert(offsetof(CachedAssetBundleValue, name) == 0);
+    static_assert(offsetof(CachedAssetBundleValue, hash) == 8);
+
+    struct Vector2Value
+    {
+        float x;
+        float y;
+    };
+    static_assert(sizeof(Vector2Value) == 8);
+    static_assert(alignof(Vector2Value) == 4);
+    static_assert(std::is_standard_layout_v<Vector2Value>);
+    static_assert(std::is_trivial_v<Vector2Value>);
+    static_assert(offsetof(Vector2Value, x) == 0);
+    static_assert(offsetof(Vector2Value, y) == 4);
+
+    struct Vector3Value
+    {
+        float x;
+        float y;
+        float z;
+    };
+    static_assert(sizeof(Vector3Value) == 12);
+    static_assert(alignof(Vector3Value) == 4);
+    static_assert(std::is_standard_layout_v<Vector3Value>);
+    static_assert(std::is_trivial_v<Vector3Value>);
+    static_assert(offsetof(Vector3Value, x) == 0);
+    static_assert(offsetof(Vector3Value, y) == 4);
+    static_assert(offsetof(Vector3Value, z) == 8);
+
+    struct Float4Value
+    {
+        float x;
+        float y;
+        float z;
+        float w;
+    };
+    static_assert(sizeof(Float4Value) == 16);
+    static_assert(alignof(Float4Value) == 4);
+    static_assert(std::is_standard_layout_v<Float4Value>);
+    static_assert(std::is_trivial_v<Float4Value>);
+    static_assert(offsetof(Float4Value, x) == 0);
+    static_assert(offsetof(Float4Value, y) == 4);
+    static_assert(offsetof(Float4Value, z) == 8);
+    static_assert(offsetof(Float4Value, w) == 12);
+
+    struct StyleSelectorPartValue
+    {
+        void* value;
+        std::int32_t type;
+        void* tempData;
+    };
+    static_assert(sizeof(StyleSelectorPartValue) == 24);
+    static_assert(alignof(StyleSelectorPartValue) == 8);
+    static_assert(std::is_standard_layout_v<StyleSelectorPartValue>);
+    static_assert(std::is_trivial_v<StyleSelectorPartValue>);
+    static_assert(offsetof(StyleSelectorPartValue, value) == 0);
+    static_assert(offsetof(StyleSelectorPartValue, type) == 8);
+    static_assert(offsetof(StyleSelectorPartValue, tempData) == 16);
+
+    void DirectVoid(void* self, const void* metadata)
+    {
+        const auto* config = configuration.load(std::memory_order_acquire);
+        const auto* target = static_cast<const TargetMethod*>(metadata);
+        Frame frame(*config, metadata);
+        reinterpret_cast<void (*)(void*, const void*)>(target->trampoline)(self, metadata);
+        frame.RaiseFailure();
+    }
+
+    void DirectString(void* self, void* message, const void* metadata)
+    {
+        const auto* config = configuration.load(std::memory_order_acquire);
+        const auto* target = static_cast<const TargetMethod*>(metadata);
+        Frame frame(*config, metadata);
+        reinterpret_cast<void (*)(void*, void*, const void*)>(target->trampoline)(self, message, metadata);
+        frame.RaiseFailure();
+    }
+
+    std::uint8_t DirectBooleanObject(void* self, void* value, const void* metadata)
+    {
+        const auto* config = configuration.load(std::memory_order_acquire);
+        const auto* target = static_cast<const TargetMethod*>(metadata);
+        Frame frame(*config, metadata);
+        const auto result = reinterpret_cast<std::uint8_t (*)(void*, void*, const void*)>(target->trampoline)(self, value, metadata);
+        frame.RaiseFailure();
+        return result;
+    }
+
+    void* DirectObjectObject(void* self, void* value, const void* metadata)
+    {
+        const auto* config = configuration.load(std::memory_order_acquire);
+        const auto* target = static_cast<const TargetMethod*>(metadata);
+        Frame frame(*config, metadata);
+        const auto result = reinterpret_cast<void* (*)(void*, void*, const void*)>(target->trampoline)(self, value, metadata);
+        frame.RaiseFailure();
+        return result;
+    }
+
+    std::uint8_t DirectBoolean(void* self, const void* metadata)
+    {
+        const auto* config = configuration.load(std::memory_order_acquire);
+        const auto* target = static_cast<const TargetMethod*>(metadata);
+        Frame frame(*config, metadata);
+        const auto result = reinterpret_cast<std::uint8_t (*)(void*, const void*)>(target->trampoline)(self, metadata);
+        frame.RaiseFailure();
+        return result;
+    }
+
+    void DirectReference(void* self, void* storage, const void* metadata)
+    {
+        const auto* config = configuration.load(std::memory_order_acquire);
+        const auto* target = static_cast<const TargetMethod*>(metadata);
+        Frame frame(*config, metadata);
+        reinterpret_cast<void (*)(void*, void*, const void*)>(target->trampoline)(self, storage, metadata);
+        frame.RaiseFailure();
+    }
+
+    std::uint8_t DirectBooleanReference(void* self, void* storage, const void* metadata)
+    {
+        const auto* config = configuration.load(std::memory_order_acquire);
+        const auto* target = static_cast<const TargetMethod*>(metadata);
+        Frame frame(*config, metadata);
+        const auto result = reinterpret_cast<std::uint8_t (*)(void*, void*, const void*)>(target->trampoline)(self, storage, metadata);
+        frame.RaiseFailure();
+        return result;
+    }
+
+    template<typename T>
+    T DirectScalar(void* self, const void* metadata)
+    {
+        const auto* config = configuration.load(std::memory_order_acquire);
+        const auto* target = static_cast<const TargetMethod*>(metadata);
+        Frame frame(*config, metadata);
+        const auto result = reinterpret_cast<T (*)(void*, const void*)>(target->trampoline)(self, metadata);
+        frame.RaiseFailure();
+        return result;
+    }
+
+    template<typename T>
+    void DirectVoidArgument(void* self, T value, const void* metadata)
+    {
+        const auto* config = configuration.load(std::memory_order_acquire);
+        const auto* target = static_cast<const TargetMethod*>(metadata);
+        Frame frame(*config, metadata);
+        reinterpret_cast<void (*)(void*, T, const void*)>(target->trampoline)(self, value, metadata);
+        frame.RaiseFailure();
+    }
+
+    template<typename T>
+    std::uint8_t DirectBooleanArgument(void* self, T value, const void* metadata)
+    {
+        const auto* config = configuration.load(std::memory_order_acquire);
+        const auto* target = static_cast<const TargetMethod*>(metadata);
+        Frame frame(*config, metadata);
+        const auto result = reinterpret_cast<std::uint8_t (*)(void*, T, const void*)>(target->trampoline)(self, value, metadata);
+        frame.RaiseFailure();
+        return result;
+    }
+
+    template<typename TResult, typename TArg>
+    TResult DirectScalarArgument(void* self, TArg value, const void* metadata)
+    {
+        const auto* config = configuration.load(std::memory_order_acquire);
+        const auto* target = static_cast<const TargetMethod*>(metadata);
+        Frame frame(*config, metadata);
+        const auto result = reinterpret_cast<TResult (*)(void*, TArg, const void*)>(target->trampoline)(self, value, metadata);
+        frame.RaiseFailure();
+        return result;
+    }
+
+    template<typename TFirst, typename TSecond>
+    void DirectVoidPair(void* self, TFirst first, TSecond second, const void* metadata)
+    {
+        const auto* config = configuration.load(std::memory_order_acquire);
+        const auto* target = static_cast<const TargetMethod*>(metadata);
+        Frame frame(*config, metadata);
+        reinterpret_cast<void (*)(void*, TFirst, TSecond, const void*)>(target->trampoline)(self, first, second, metadata);
+        frame.RaiseFailure();
+    }
+
+    template<typename TFirst, typename TSecond>
+    std::uint8_t DirectBooleanPair(void* self, TFirst first, TSecond second, const void* metadata)
+    {
+        const auto* config = configuration.load(std::memory_order_acquire);
