+                    handle, NativeAnimationCall.Signature.PointerReference, pointer, (handle, true));
+                Type = new NativeAnimationCall("UnityEngine.Playables.PlayableHandle::GetJobType_Injected",
+                    handle, NativeAnimationCall.Signature.ObjectReference,
