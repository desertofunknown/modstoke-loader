+// SPDX-License-Identifier: LGPL-3.0-only
+using System;
+using Il2CppInterop.Runtime.InteropTypes;
+using Il2CppInterop.Runtime.InteropTypes.Arrays;
+
+namespace Il2CppInterop.Runtime.Injection;
+
+/// <summary>Native-owner state for the stripped UIElements debugger properties.</summary>
+public static class NativeEventDebuggerState
+{
+    public static bool GetIsReplaying(Il2CppObjectBase owner) => ReadScalar(owner, 0) != 0;
+    public static void SetIsReplaying(Il2CppObjectBase owner, bool value) => WriteScalar(owner, 0, value ? 1 : 0);
+    public static float GetPlaybackSpeed(Il2CppObjectBase owner) => BitConverter.Int32BitsToSingle(ReadScalar(owner, 1));
+    public static void SetPlaybackSpeed(Il2CppObjectBase owner, float value) => WriteScalar(owner, 1, BitConverter.SingleToInt32Bits(value));
+    public static bool GetIsPlaybackPaused(Il2CppObjectBase owner) => ReadScalar(owner, 2) != 0;
+    public static void SetIsPlaybackPaused(Il2CppObjectBase owner, bool value) => WriteScalar(owner, 2, value ? 1 : 0);
+    public static bool GetSuspended(Il2CppObjectBase owner) => ReadScalar(owner, 3) != 0;
+    public static void SetSuspended(Il2CppObjectBase owner, bool value) => WriteScalar(owner, 3, value ? 1 : 0);
+    public static bool GetLog(Il2CppObjectBase owner) => ReadScalar(owner, 4) != 0;
+    public static void SetLog(Il2CppObjectBase owner, bool value) => WriteScalar(owner, 4, value ? 1 : 0);
+
+    public static Il2CppObjectBase? GetPanel(Il2CppObjectBase owner) => ReadReference(owner, 0);
+    public static void SetPanel(Il2CppObjectBase owner, Il2CppObjectBase? value) => WriteReference(owner, value, 0);
+
+    public static Il2CppObjectBase? GetCollection(Il2CppObjectBase owner, int index)
+    {
+        if (owner is null) throw new NullReferenceException();
+        if ((uint)index >= 7) throw new ArgumentOutOfRangeException(nameof(index));
+        return ReadReference(owner, index + 1);
+    }
+
+    public static void SetCollection(Il2CppObjectBase owner, Il2CppObjectBase? value, int index)
+    {
+        if (owner is null) throw new NullReferenceException();
+        if ((uint)index >= 7) throw new ArgumentOutOfRangeException(nameof(index));
+        WriteReference(owner, value, index + 1);
+    }
+
+    private static Il2CppObjectBase? ReadReference(Il2CppObjectBase owner, int index)
+    {
+        Il2CppReferenceArray<Il2CppSystem.Object>? slots = null;
+        Il2CppSystem.Object? value = null;
+        try
+        {
+            var key = RequireOwner(owner);
+            lock (Store.Sync)
+            {
+                if (!Store.References.TryGetValue(key, out slots)) return null;
+                value = slots[index];
+                // A pooled injected wrapper may be weak. Return an independently rooted alias.
+                return value == null ? null : new Il2CppSystem.Object(value.Pointer);
+            }
+        }
+        finally { GC.KeepAlive(value); GC.KeepAlive(slots); GC.KeepAlive(owner); }
+    }
+
+    private static void WriteReference(Il2CppObjectBase owner, Il2CppObjectBase? value, int index)
+    {
+        Il2CppReferenceArray<Il2CppSystem.Object>? slots = null;
+        Il2CppSystem.Object? reference = null;
+        try
+        {
+            var key = RequireOwner(owner);
+            reference = (Il2CppSystem.Object?)value;
+            lock (Store.Sync)
+            {
+                if (!Store.References.TryGetValue(key, out slots))
+                {
+                    if (reference == null) return;
+                    slots = new Il2CppReferenceArray<Il2CppSystem.Object>(8);
+                    slots[index] = reference;
+                    Store.References.Add(key, slots);
+                }
+                else
+                    slots[index] = reference!;
+            }
+        }
+        finally { GC.KeepAlive(reference); GC.KeepAlive(slots); GC.KeepAlive(value); GC.KeepAlive(owner); }
+    }
+
+    private static int ReadScalar(Il2CppObjectBase owner, int index)
+    {
+        Il2CppStructArray<int>? values = null;
+        try
+        {
+            var key = RequireOwner(owner);
+            lock (Store.Sync)
+                return Store.Scalars.TryGetValue(key, out values) ? values[index] : 0;
+        }
+        finally { GC.KeepAlive(values); GC.KeepAlive(owner); }
+    }
+
+    private static void WriteScalar(Il2CppObjectBase owner, int index, int value)
+    {
+        Il2CppStructArray<int>? values = null;
+        try
+        {
+            var key = RequireOwner(owner);
+            lock (Store.Sync)
+            {
+                if (!Store.Scalars.TryGetValue(key, out values))
+                {
+                    values = new Il2CppStructArray<int>(5);
+                    values[index] = value;
+                    Store.Scalars.Add(key, values);
+                }
+                else
+                    values[index] = value;
+            }
+        }
+        finally { GC.KeepAlive(values); GC.KeepAlive(owner); }
+    }
+
+    private static Il2CppSystem.Object RequireOwner(Il2CppObjectBase owner) =>
+        owner is null ? throw new NullReferenceException() : (Il2CppSystem.Object)owner;
+
+    private static class Store
+    {
+        // Do not initialize native tables before the accessor has checked its receiver.
+        static Store() { }
+
+        internal static readonly object Sync = new();
+        // Native ephemerons retain these native-only graphs across wrapper aliases, but do
+        // not root the key through a reference->owner cycle. Do not put CLR GCHandles here.
+        internal static readonly Il2CppSystem.Runtime.CompilerServices.ConditionalWeakTable<Il2CppSystem.Object, Il2CppStructArray<int>> Scalars = new();
+        internal static readonly Il2CppSystem.Runtime.CompilerServices.ConditionalWeakTable<Il2CppSystem.Object, Il2CppReferenceArray<Il2CppSystem.Object>> References = new();
+    }
+}
