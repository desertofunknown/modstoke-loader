+            }
+        }
+
+        private static void RequireLayout(string ns, string name, uint size, params (string Name, uint Offset)[] fields)
+        {
+            var pointer = IL2CPP.GetIl2CppClass("mscorlib.dll", ns, name);
+            if (pointer == IntPtr.Zero)
+                throw new NotSupportedException("A native async reflection class is unavailable: " + name);
+            InjectorHelpers.InitializeClass((Il2CppClass*)pointer);
+            if (UnityVersionHandler.Wrap((Il2CppClass*)pointer)?.InstanceSize != size)
+                throw new NotSupportedException("A native async reflection class has an incompatible layout: " + name);
+            foreach (var (fieldName, offset) in fields)
+            {
+                var field = IL2CPP.il2cpp_class_get_field_from_name(pointer, fieldName);
+                if (field == IntPtr.Zero || IL2CPP.il2cpp_field_get_offset(field) != offset)
+                    throw new NotSupportedException("A native async reflection field has an incompatible layout: " + name + "." + fieldName);
+            }
+        }
+    }
+}
