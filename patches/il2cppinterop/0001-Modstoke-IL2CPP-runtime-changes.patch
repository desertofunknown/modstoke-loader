+    internal static bool TryGetOwnedClass(IntPtr image, IntPtr namespaze, IntPtr name, out IntPtr klass)
+    {
+        klass = IntPtr.Zero;
+        // Ordinary injection needs no native ownership query until an owned batch can be published.
+        return Volatile.Read(ref ownedLookupRequired) &&
+            Shared.Value.FindOwned(1, image, namespaze, name, out klass) == 1;
+    }
+
