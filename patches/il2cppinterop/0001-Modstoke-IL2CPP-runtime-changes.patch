+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Reflection;
+using System.Reflection.Emit;
+using System.Runtime.CompilerServices;
+using Il2CppInterop.Common;
+using Il2CppInterop.Runtime.InteropTypes;
+using Il2CppInterop.Runtime.Runtime;
+using Microsoft.Extensions.Logging;
+
+namespace Il2CppInterop.Runtime.Injection;
+
+// Emission-time state shared by delegate and injected-method callbacks.
+internal sealed class NativeCallbackReferences
+{
+    private sealed class Reference
+    {
+        internal readonly int Index;
+        internal readonly int NativeIndex;
+        internal readonly Type Element;
+        internal readonly bool OutputOnly;
+        internal readonly bool IsNativeValue;
+        internal readonly LocalBuilder Value;
+        internal readonly LocalBuilder Address;
+        internal readonly LocalBuilder OwnsStorage;
+
+        internal Reference(ILGenerator il, ParameterInfo parameter, int index, int offset)
+        {
+            Index = index;
+            NativeIndex = index + offset;
+            Element = parameter.ParameterType.GetElementType()!;
+            OutputOnly = parameter.IsOut && !parameter.IsIn;
+            IsNativeValue = typeof(Il2CppSystem.ValueType).IsAssignableFrom(Element);
+            Value = il.DeclareLocal(Element);
+            Address = il.DeclareLocal(parameter.ParameterType);
+            OwnsStorage = il.DeclareLocal(typeof(bool));
+        }
+    }
+
+    private readonly ILGenerator il;
+    private readonly ParameterInfo[] parameters;
+    private readonly Reference?[] references;
+    private readonly int offset;
+    private readonly bool rawValueReferences;
+    private readonly bool allowNullJobRanges;
+
+    internal NativeCallbackReferences(ILGenerator il, ParameterInfo[] parameters, int offset,
+        bool rawValueReferences = false, bool allowNullJobRanges = false)
+    {
+        this.il = il;
+        this.parameters = parameters;
+        this.offset = offset;
+        this.rawValueReferences = rawValueReferences;
+        this.allowNullJobRanges = rawValueReferences && allowNullJobRanges;
+        references = new Reference?[parameters.Length];
+        for (var index = 0; index < parameters.Length; index++)
+        {
+            var type = parameters[index].ParameterType;
+            if (!type.IsByRef) continue;
+            var element = type.GetElementType()!;
+            if (element == typeof(string) || typeof(Il2CppObjectBase).IsAssignableFrom(element))
+                references[index] = new Reference(il, parameters[index], index, offset);
+        }
+        HasConverted = references.Any(reference => reference != null);
+    }
+
+    internal bool HasConverted { get; }
+
+    internal void Initialize(LocalBuilder phase)
+    {
+        var initialized = new List<Reference>();
+        foreach (var reference in references.Where(reference => reference != null)
+                     .Select(reference => reference!).OrderBy(reference => reference.OutputOnly))
+        {
+            EmitPhase(il, phase, reference.Index * 2);
+            var ready = il.DefineLabel();
+            if (AllowsNull(reference.Index))
+            {
+                // Leave the initialized address null and storage unowned; no synthetic ranges or writeback.
+                il.Emit(OpCodes.Ldarg, (short)reference.NativeIndex);
+                il.Emit(OpCodes.Brfalse, ready);
+            }
+            il.Emit(OpCodes.Ldarg, (short)reference.NativeIndex);
+            il.Emit(OpCodes.Conv_I);
+            il.Emit(OpCodes.Call, Method(nameof(RequireAddress)));
+            foreach (var earlier in initialized)
+            {
+                if (earlier.Element != reference.Element) continue;
+                var distinct = il.DefineLabel();
+                il.Emit(OpCodes.Ldarg, (short)reference.NativeIndex);
+                il.Emit(OpCodes.Ldarg, (short)earlier.NativeIndex);
+                il.Emit(OpCodes.Bne_Un, distinct);
+                il.Emit(OpCodes.Ldloc, earlier.Address);
+                il.Emit(OpCodes.Stloc, reference.Address);
+                il.Emit(OpCodes.Br, ready);
+                il.MarkLabel(distinct);
+            }
