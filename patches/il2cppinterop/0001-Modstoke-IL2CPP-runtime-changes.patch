diff --git a/Il2CppInterop.HarmonySupport/Il2CppDetourMethodPatcher.Bridge.cs b/Il2CppInterop.HarmonySupport/Il2CppDetourMethodPatcher.Bridge.cs
new file mode 100644
index 0000000..b2e1a55
--- /dev/null
+++ b/Il2CppInterop.HarmonySupport/Il2CppDetourMethodPatcher.Bridge.cs
@@ -0,0 +1,232 @@
+using System.Reflection;
+using System.Reflection.Emit;
+using System.Runtime.ExceptionServices;
+using System.Runtime.InteropServices;
+using System.Threading;
+using HarmonyLib;
+using HarmonyLib.Public.Patching;
+using Il2CppInterop.Runtime.Startup;
+using MonoMod.Core.Platforms;
+using MonoMod.RuntimeDetour;
+using MonoMod.Utils;
+using IDetour = Il2CppInterop.Runtime.Injection.IDetour;
+
+namespace Il2CppInterop.HarmonySupport;
+
+internal unsafe partial class Il2CppDetourMethodPatcher
+{
+    private sealed class PatchTarget
+    {
+        public Delegate Current;
+
+        public PatchTarget(Delegate current) => Current = current;
+    }
+
+    // Native code and generated methods cannot keep their managed owners alive.
+    private static readonly List<Il2CppDetourMethodPatcher> BridgeRoots = new();
+    private static readonly MethodInfo GenerateTrampolineMethod = typeof(IDetour).GetMethod(nameof(IDetour.GenerateTrampoline));
+    private static readonly FieldInfo CurrentTargetField = typeof(PatchTarget).GetField(nameof(PatchTarget.Current));
+
+    private readonly object bridgeLock = new();
+    private readonly List<MonoMod.Cil.ILContext> patchContexts = new();
+    private PatchTarget patchTarget;
+    private Type managedDelegateType;
+    private DataScope<DynamicReferenceCell> bridgeReference;
+    private Delegate nativeCallback;
+    private IDetour nativeDetour;
+    private Hook managedDetour;
+    private bool bridgeReady;
+    private Exception bridgeFailure;
+
+    private MethodBase UpdateBridge()
+    {
+        lock (bridgeLock)
+        {
+            if (bridgeFailure != null)
+                throw new InvalidOperationException("This method's hook activation failed. Its resources remain retained; restart before retrying.", bridgeFailure);
+
+            using var copiedDmd = CopyOriginal();
+            var context = new MonoMod.Cil.ILContext(copiedDmd.Definition);
+            MethodInfo method;
+            Type delegateType;
+            Delegate target;
+            try
+            {
+                HarmonyManipulator.Manipulate(copiedDmd.OriginalMethod, copiedDmd.OriginalMethod.GetPatchInfo(), context);
+                method = copiedDmd.Generate();
+                delegateType = managedDelegateType ?? DelegateTypeFactory.instance.CreateDelegateType(method);
+                target = method.CreateDelegate(delegateType);
+                PlatformTriple.Current.Compile(method);
+                // Harmony returns generated methods to callers, so their reference cells may outlive an update.
+                context.MakeReadOnly();
+                patchContexts.Add(context);
+            }
+            catch (Exception error)
+            {
+                try
+                {
+                    context.Dispose();
+                }
+                catch (Exception cleanupError)
+                {
+                    throw new AggregateException("Patch generation and context cleanup failed.", error, cleanupError);
+                }
+                throw;
+            }
+
+            if (bridgeReady)
+            {
+                // Each invocation retains the delegate it read, including during a concurrent update.
+                Volatile.Write(ref patchTarget.Current, target);
+                return method;
+            }
+
+            var retained = false;
+            try
+            {
+                patchTarget = new PatchTarget(target);
+                managedDelegateType = delegateType;
+                var dispatcher = GenerateBridgeDispatcher(method, delegateType);
+                using var nativeDmd = GenerateNativeToManagedTrampoline(dispatcher);
+                var nativeMethod = nativeDmd.Generate();
+                var nativeDelegateType = DelegateTypeFactory.instance.CreateDelegateType(nativeMethod, CallingConvention.Cdecl);
+                nativeCallback = nativeMethod.CreateDelegate(nativeDelegateType);
+                PlatformTriple.Current.Compile(nativeMethod);
+
+                managedDetour = new Hook(Original, dispatcher, applyByDefault: false);
+                nativeDetour = Il2CppInteropRuntime.Instance.DetourProvider.Create(originalNativeMethodInfo.MethodPointer, nativeCallback);
+
+                lock (BridgeRoots)
+                    BridgeRoots.Add(this);
+                retained = true;
+
+                PrepareNativeTrampoline(nativeDetour, nativeDelegateType);
+                var trampoline = nativeDetour.OriginalTrampoline;
+                if (trampoline == IntPtr.Zero)
+                    throw new InvalidOperationException("The native bridge has no original-method trampoline.");
+
+                // Publish the fallback before native code can enter the new callback.
+                modifiedNativeMethodInfo.MethodPointer = trampoline;
+                nativeDetour.Apply();
+                managedDetour.Apply();
+                bridgeReady = true;
+                return method;
+            }
+            catch (Exception error)
+            {
+                if (retained)
+                {
+                    // Apply may already have changed code. Do not finalize hooks or recycle a live reference cell.
+                    bridgeFailure = error;
+                    throw new InvalidOperationException("Native/managed hook activation failed. Resources remain retained; restart before retrying.", error);
+                }
+
+                try
+                {
+                    nativeDetour?.Dispose();
+                    managedDetour?.Dispose();
+                    bridgeReference.Dispose();
+                    nativeDetour = null;
+                    managedDetour = null;
+                    nativeCallback = null;
+                    patchTarget = null;
+                    managedDelegateType = null;
+                }
+                catch (Exception cleanupError)
+                {
+                    bridgeFailure = new AggregateException("Bridge preparation and cleanup failed.", error, cleanupError);
+                    lock (BridgeRoots)
+                        BridgeRoots.Add(this);
+                    throw bridgeFailure;
+                }
+                throw;
+            }
+        }
+    }
+
+    private MethodInfo GenerateBridgeDispatcher(MethodInfo method, Type delegateType)
+    {
+        var parameters = method.GetParameters();
+        using var dmd = new DynamicMethodDefinition("HarmonyDispatch_" + Original.Name,
+            method.ReturnType, parameters.Select(parameter => parameter.ParameterType).ToArray());
+        var il = dmd.GetILGenerator();
+        var trace = InventoryCallTrace.Matches(Original) && !method.ReturnType.IsByRef &&
+            parameters.All(p => !p.ParameterType.IsByRef && !p.ParameterType.IsPointer);
+        LocalBuilder traceId = null, traceArgs = null, result = null;
+        if (trace)
+        {
+            traceId = il.DeclareLocal(typeof(int));
+            traceArgs = il.DeclareLocal(typeof(object[]));
+            il.Emit(OpCodes.Ldstr, Original.DeclaringType.FullName + "::" + Original);
+            il.Emit(OpCodes.Call, typeof(InventoryCallTrace).GetMethod(nameof(InventoryCallTrace.Begin)));
+            il.Emit(OpCodes.Stloc, traceId);
+            var skip = il.DefineLabel();
+            il.Emit(OpCodes.Ldloc, traceId);
+            il.Emit(OpCodes.Brfalse, skip);
+            il.Emit(OpCodes.Ldc_I4, parameters.Length);
+            il.Emit(OpCodes.Newarr, typeof(object));
+            for (var i = 0; i < parameters.Length; i++)
+            {
+                il.Emit(OpCodes.Dup);
+                il.Emit(OpCodes.Ldc_I4, i);
+                il.Emit(OpCodes.Ldarg, checked((short)i));
+                if (parameters[i].ParameterType.IsValueType) il.Emit(OpCodes.Box, parameters[i].ParameterType);
+                il.Emit(OpCodes.Stelem_Ref);
+            }
+            il.Emit(OpCodes.Stloc, traceArgs);
+            il.Emit(OpCodes.Ldloc, traceId);
+            il.Emit(OpCodes.Ldloc, traceArgs);
+            il.Emit(OpCodes.Call, typeof(InventoryCallTrace).GetMethod(nameof(InventoryCallTrace.Arguments)));
+            il.MarkLabel(skip);
+            il.BeginExceptionBlock();
+        }
+        bridgeReference = il.EmitNewTypedReference(patchTarget, out _);
+        il.Emit(OpCodes.Volatile);
+        il.Emit(OpCodes.Ldfld, CurrentTargetField);
+        il.Emit(OpCodes.Castclass, delegateType);
+        for (var i = 0; i < parameters.Length; i++)
+            il.Emit(OpCodes.Ldarg, checked((short)i));
+        il.Emit(OpCodes.Callvirt, delegateType.GetMethod("Invoke"));
+        if (trace)
+        {
+            if (method.ReturnType != typeof(void))
+            {
+                result = il.DeclareLocal(method.ReturnType);
+                il.Emit(OpCodes.Stloc, result);
+            }
+            il.Emit(OpCodes.Ldloc, traceId);
+            if (result == null) il.Emit(OpCodes.Ldnull);
+            else
+            {
+                il.Emit(OpCodes.Ldloc, result);
+                if (method.ReturnType.IsValueType) il.Emit(OpCodes.Box, method.ReturnType);
+            }
+            il.Emit(OpCodes.Call, typeof(InventoryCallTrace).GetMethod(nameof(InventoryCallTrace.Finish)));
+            il.BeginCatchBlock(typeof(Exception));
+            var error = il.DeclareLocal(typeof(Exception));
+            il.Emit(OpCodes.Stloc, error);
+            il.Emit(OpCodes.Ldloc, traceId);
+            il.Emit(OpCodes.Ldloc, error);
+            il.Emit(OpCodes.Ldloc, traceArgs);
+            il.Emit(OpCodes.Call, typeof(InventoryCallTrace).GetMethod(nameof(InventoryCallTrace.Failure)));
+            il.Emit(OpCodes.Rethrow);
+            il.EndExceptionBlock();
+            if (result != null) il.Emit(OpCodes.Ldloc, result);
+        }
+        il.Emit(OpCodes.Ret);
+        return dmd.Generate();
+    }
+
+    private static void PrepareNativeTrampoline(IDetour detour, Type delegateType)
+    {
+        try
+        {
+            _ = GenerateTrampolineMethod.MakeGenericMethod(delegateType).Invoke(detour, null);
+        }
+        catch (TargetInvocationException error) when (error.InnerException != null)
+        {
+            ExceptionDispatchInfo.Capture(error.InnerException).Throw();
+            throw;
+        }
+    }
+}
diff --git a/Il2CppInterop.HarmonySupport/Il2CppDetourMethodPatcher.References.cs b/Il2CppInterop.HarmonySupport/Il2CppDetourMethodPatcher.References.cs
new file mode 100644
index 0000000..035a5e4
--- /dev/null
+++ b/Il2CppInterop.HarmonySupport/Il2CppDetourMethodPatcher.References.cs
@@ -0,0 +1,164 @@
+using System.Reflection;
+using System.Reflection.Emit;
+using System.Runtime.CompilerServices;
+using HarmonyLib;
+using Il2CppInterop.Runtime;
+using Il2CppInterop.Runtime.InteropTypes;
+using Il2CppInterop.Runtime.Runtime;
+using ValueType = Il2CppSystem.ValueType;
+
+namespace Il2CppInterop.HarmonySupport;
+
+internal unsafe partial class Il2CppDetourMethodPatcher
+{
+    private sealed class ConvertedReference
+    {
+        internal readonly int ParameterIndex;
+        internal readonly int NativeIndex;
+        internal readonly Type ElementType;
+        internal readonly bool OutputOnly;
+        internal readonly bool IsNativeValue;
+        internal readonly LocalBuilder Value;
+        internal readonly LocalBuilder ManagedAddress;
+        internal readonly LocalBuilder OwnsStorage;
+
+        internal ConvertedReference(ILGenerator il, ParameterInfo parameter, int index, int nativeIndex)
+        {
+            ParameterIndex = index;
+            NativeIndex = nativeIndex;
+            ElementType = parameter.ParameterType.GetElementType();
+            OutputOnly = parameter.IsOut && !parameter.IsIn;
+            IsNativeValue = typeof(ValueType).IsAssignableFrom(ElementType);
+            Value = il.DeclareLocal(ElementType);
+            ManagedAddress = il.DeclareLocal(parameter.ParameterType);
+            OwnsStorage = il.DeclareLocal(typeof(bool));
+        }
+    }
+
+    private static ConvertedReference[] CreateConvertedReferences(ILGenerator il,
+        ParameterInfo[] parameters, int paramStartIndex)
+    {
+        var references = new ConvertedReference[parameters.Length];
+        for (var index = 0; index < parameters.Length; index++)
+        {
+            var type = parameters[index].ParameterType;
+            if (!type.IsByRef) continue;
+            var element = type.GetElementType();
+            if (element == typeof(string) || typeof(Il2CppObjectBase).IsAssignableFrom(element))
+                references[index] = new ConvertedReference(il, parameters[index], index, index + paramStartIndex);
+        }
+        return references;
+    }
+
+    private static void EmitInitializeConvertedReferences(ILGenerator il,
+        ConvertedReference[] references, LocalBuilder phase)
+    {
+        // Read input-bearing aliases first. A preceding out parameter must not hide their value.
+        var initialized = new List<ConvertedReference>();
+        foreach (var reference in references.Where(reference => reference != null).OrderBy(reference => reference.OutputOnly))
+        {
+            il.Emit(OpCodes.Ldc_I4, reference.ParameterIndex * 2);
+            il.Emit(OpCodes.Stloc, phase);
+            il.Emit(OpCodes.Ldarg, (short)reference.NativeIndex);
+            il.Emit(OpCodes.Conv_I);
+            il.Emit(OpCodes.Call, AccessTools.Method(typeof(Il2CppDetourMethodPatcher), nameof(RequireReferenceAddress)));
+
+            var initializedLabel = il.DefineLabel();
+            foreach (var earlier in initialized)
+            {
+                if (earlier.ElementType != reference.ElementType) continue;
+                var differentStorage = il.DefineLabel();
+                il.Emit(OpCodes.Ldarg, (short)reference.NativeIndex);
+                il.Emit(OpCodes.Ldarg, (short)earlier.NativeIndex);
+                il.Emit(OpCodes.Bne_Un, differentStorage);
+                il.Emit(OpCodes.Ldloc, earlier.ManagedAddress);
+                il.Emit(OpCodes.Stloc, reference.ManagedAddress);
+                il.Emit(OpCodes.Br, initializedLabel);
+                il.MarkLabel(differentStorage);
+            }
+
+            if (reference.IsNativeValue)
+            {
+                // Value references point directly to unboxed payloads, including pure out storage.
+                il.Emit(OpCodes.Ldarg, (short)reference.NativeIndex);
+                il.Emit(OpCodes.Conv_I);
+                il.Emit(reference.OutputOnly ? OpCodes.Ldc_I4_1 : OpCodes.Ldc_I4_0);
+                il.Emit(OpCodes.Call, AccessTools.Method(
+                    typeof(NativeValueReference<>).MakeGenericType(reference.ElementType),
+                    nameof(NativeValueReference<Il2CppObjectBase>.Read)));
+                il.Emit(OpCodes.Stloc, reference.Value);
+            }
+            else if (!reference.OutputOnly)
+            {
+                il.Emit(OpCodes.Ldarg, (short)reference.NativeIndex);
+                il.Emit(OpCodes.Ldind_I);
+                il.Emit(OpCodes.Call, reference.ElementType == typeof(string)
+                    ? IL2CPPToManagedStringMethodInfo
+                    : AccessTools.Method(typeof(Il2CppObjectPool), nameof(Il2CppObjectPool.Get))
+                        .MakeGenericMethod(reference.ElementType));
+                il.Emit(OpCodes.Stloc, reference.Value);
+            }
+            il.Emit(OpCodes.Ldloca, reference.Value);
+            il.Emit(OpCodes.Stloc, reference.ManagedAddress);
+            il.Emit(OpCodes.Ldc_I4_1);
+            il.Emit(OpCodes.Stloc, reference.OwnsStorage);
+            il.MarkLabel(initializedLabel);
+            initialized.Add(reference);
+        }
+    }
+
+    private static void EmitConvertedReferenceWritebacks(ILGenerator il,
+        ConvertedReference[] references, LocalBuilder failed, string method)
+    {
+        foreach (var reference in references)
+        {
+            if (reference == null) continue;
+            var next = il.DefineLabel();
+            il.Emit(OpCodes.Ldloc, reference.OwnsStorage);
+            il.Emit(OpCodes.Brfalse, next);
+
+            // Each unique slot gets a chance to commit, including when another slot fails.
+            il.BeginExceptionBlock();
+            il.Emit(OpCodes.Ldarg, (short)reference.NativeIndex);
+            il.Emit(OpCodes.Conv_I);
+            il.Emit(OpCodes.Ldloc, reference.ManagedAddress);
+            il.Emit(OpCodes.Ldind_Ref);
+            if (reference.IsNativeValue)
+            {
+                il.Emit(OpCodes.Call, AccessTools.Method(
+                    typeof(NativeValueReference<>).MakeGenericType(reference.ElementType),
+                    nameof(NativeValueReference<Il2CppObjectBase>.Write)));
+            }
+            else
+            {
+                EmitConvertManagedTypeToIL2CPP(il, reference.ElementType);
+                il.Emit(OpCodes.Call, AccessTools.Method(typeof(Il2CppDetourMethodPatcher), nameof(StoreNativeReference)));
+            }
+            il.Emit(OpCodes.Ldloc, reference.ManagedAddress);
+            il.Emit(OpCodes.Ldind_Ref);
+            il.Emit(OpCodes.Call, AccessTools.Method(typeof(GC), nameof(GC.KeepAlive)));
+            il.BeginCatchBlock(typeof(Exception));
+            il.Emit(OpCodes.Ldstr, method);
+            il.Emit(OpCodes.Ldc_I4, reference.ParameterIndex * 2 + 1);
+            il.Emit(OpCodes.Call, ReportExceptionMethodInfo);
+            il.Emit(OpCodes.Ldc_I4_1);
+            il.Emit(OpCodes.Stloc, failed);
+            il.EndExceptionBlock();
+            il.MarkLabel(next);
+        }
+    }
+
+    [MethodImpl(MethodImplOptions.AggressiveInlining)]
+    private static void RequireReferenceAddress(IntPtr address)
+    {
+        if (address == IntPtr.Zero)
+            throw new ArgumentNullException(nameof(address), "Native reference storage is null.");
+    }
+
+    private static void StoreNativeReference(IntPtr address, IntPtr value)
+    {
+        // The native API stores the pointer and marks the destination for the IL2CPP GC.
+        // Do not substitute the plain-store fallback used by older generated field accessors.
+        IL2CPP.il2cpp_gc_wbarrier_set_field(IntPtr.Zero, address, value);
+    }
+}
