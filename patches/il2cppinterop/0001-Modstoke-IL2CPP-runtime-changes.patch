+    private static bool IsExactType(IntPtr type, IntPtr expectedClass) => type != IntPtr.Zero &&
+        !IL2CPP.il2cpp_type_is_byref(type) && IL2CPP.il2cpp_class_from_type(type) == expectedClass;
