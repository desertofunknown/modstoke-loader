+        fixed (byte* streamAddress = &Unsafe.As<TStream, byte>(ref stream))
+        {
+            // Match AnimationStream.isValid, which deliberately does not require inputStreamAccessor.
+            if (Unsafe.ReadUnaligned<uint>(streamAddress) < 2 ||
+                Unsafe.ReadUnaligned<IntPtr>(streamAddress + 8) == IntPtr.Zero ||
+                Unsafe.ReadUnaligned<IntPtr>(streamAddress + 16) == IntPtr.Zero ||
+                Unsafe.ReadUnaligned<IntPtr>(streamAddress + 24) == IntPtr.Zero ||
+                Unsafe.ReadUnaligned<IntPtr>(streamAddress + 32) == IntPtr.Zero ||
+                Unsafe.ReadUnaligned<IntPtr>(streamAddress + 48) == IntPtr.Zero)
+                throw new InvalidOperationException("The AnimationStream is invalid.");
+            if (handles == IntPtr.Zero) throw new NullReferenceException("Handle array is invalid.");
