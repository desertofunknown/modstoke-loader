+++ b/Il2CppInterop.Runtime/Injection/NativeStyleEnumRegistration.cs
@@ -0,0 +1,80 @@
+// SPDX-License-Identifier: LGPL-3.0-only
+using System;
+using System.Runtime.ExceptionServices;
+using Il2CppInterop.Runtime.InteropTypes;
+using Il2CppInterop.Runtime.Startup;
+
+namespace Il2CppInterop.Runtime.Injection;
+
+/// <summary>Publishes native ValuesEnum storage and dispatch during the first bootstrap.</summary>
+public static class NativeStyleEnumRegistration
+{
+    public const int PublishedGraphVersion = 1;
+    private static readonly object Gate = new();
+    private static NativeStyleEnumMetadata? graph;
+    private static ExceptionDispatchInfo? failure;
+
+    public static IntPtr RequirePublishedClass()
+    {
+        lock (Gate) return RequireGraph().Class;
+    }
+
+    internal static IntPtr RequireOwnerClass()
+    {
+        lock (Gate) return RequireGraph().OwnerClass;
+    }
+
+    /// <summary>Initializes the receiver's native base storage on the same object.</summary>
+    public static void Initialize(Il2CppObjectBase receiver)
+    {
+        NativeStyleEnumMetadata current;
+        lock (Gate) current = RequireGraph();
+        current.Initialize(receiver);
+    }
+
+    /// <summary>Binds both restored bodies before the wrapper can allocate native instances.</summary>
+    public static void BindOverrides<T>(IntPtr nativeClass, Action<T> updateAll, Action<T, int> updateOne)
+        where T : Il2CppObjectBase
+    {
+        lock (Gate) RequireGraph().BindOverrides(nativeClass, updateAll, updateOne);
+    }
+
+    /// <summary>Requires the loaded host's bootstrap export and its initial startup thread.</summary>
+    public static void PublishDuringBootstrap(IntPtr query)
+    {
+        var window = NativeTypePublication.GetWindow(query);
+        lock (Gate)
+        {
+            failure?.Throw();
+            if (graph?.Published == true) return;
+            var runtime = Il2CppInteropRuntime.Instance;
+            runtime.RetainNativeJob();
+            try
+            {
+                var player = NativeTypePublication.RequirePlayer();
+                NativeTypePublication.RequireEarlyWindow(window, player);
+                using var prepared = new NativeStyleEnumMetadata();
+                // Native reflection and injected-type lookups can retain identities before the append.
+                prepared.Retain();
+                graph = prepared;
+                prepared.Publish(() => NativeTypePublication.RequireEarlyWindow(window, player));
+            }
+            catch (Exception error)
+            {
+                failure = ExceptionDispatchInfo.Capture(error);
+                throw;
+            }
+            finally { runtime.ReleaseNativeJob(); }
+        }
+    }
+
+    private static NativeStyleEnumMetadata RequireGraph()
+    {
+        failure?.Throw();
+        var current = graph;
+        if (current?.Published != true)
+            throw new InvalidOperationException("Native ValuesEnum was not published during startup. Use a matching native host, runtime and preloader.");
+        current.RequireContext();
+        return current;
+    }
+}
diff --git a/Il2CppInterop.Runtime/Injection/NativeStyleEnumState.cs b/Il2CppInterop.Runtime/Injection/NativeStyleEnumState.cs
new file mode 100644
index 0000000..d54e243
--- /dev/null
+++ b/Il2CppInterop.Runtime/Injection/NativeStyleEnumState.cs
@@ -0,0 +1,88 @@
+// SPDX-License-Identifier: LGPL-3.0-only
+using System;
+using Il2CppInterop.Runtime.InteropTypes;
+using Il2CppInterop.Runtime.InteropTypes.Arrays;
+
+namespace Il2CppInterop.Runtime.Injection;
+
+/// <summary>Native-owner storage for the stripped style animation enum field.</summary>
+public static class NativeStyleEnumState
+{
+    public static Il2CppObjectBase? Get(Il2CppObjectBase owner)
+    {
+        Il2CppSystem.Object? key = null;
+        Il2CppSystem.Object? value = null;
+        Il2CppReferenceArray<Il2CppSystem.Object>? slots = null;
+        try
+        {
+            key = RequireOwner(owner);
+            lock (Store.Sync)
+            {
+                if (!Store.Values.TryGetValue(key, out slots)) return null;
+                value = slots[0];
+                if (value == null) return null;
+                RequireValue(value);
+                // The returned alias owns a root independently of the table and pooled wrappers.
+                return new Il2CppSystem.Object(value.Pointer);
+            }
+        }
+        finally { GC.KeepAlive(value); GC.KeepAlive(slots); GC.KeepAlive(key); GC.KeepAlive(owner); }
+    }
+
+    public static void Set(Il2CppObjectBase owner, Il2CppObjectBase? value)
+    {
+        Il2CppSystem.Object? key = null;
+        Il2CppSystem.Object? reference = null;
+        Il2CppReferenceArray<Il2CppSystem.Object>? slots = null;
+        try
+        {
+            key = RequireOwner(owner);
+            if (value != null) RequireValue(value);
+            reference = (Il2CppSystem.Object?)value;
+            lock (Store.Sync)
+            {
+                if (!Store.Values.TryGetValue(key, out slots))
+                {
+                    if (reference == null) return;
+                    slots = new Il2CppReferenceArray<Il2CppSystem.Object>(1);
+                    slots[0] = reference;
+                    Store.Values.Add(key, slots);
+                }
+                else
+                    slots[0] = reference!;
+            }
+        }
+        finally
+        {
+            GC.KeepAlive(reference); GC.KeepAlive(slots); GC.KeepAlive(value);
+            GC.KeepAlive(key); GC.KeepAlive(owner);
+        }
+    }
+
+    private static Il2CppSystem.Object RequireOwner(Il2CppObjectBase owner)
+    {
+        if (owner == null) throw new NullReferenceException();
+        var expected = NativeStyleEnumRegistration.RequireOwnerClass();
+        if (IL2CPP.il2cpp_thread_current() == IntPtr.Zero ||
+            !IL2CPP.il2cpp_class_is_assignable_from(expected, IL2CPP.il2cpp_object_get_class(owner.Pointer)))
+            throw new InvalidOperationException("Enum animation state requires its native style animation owner and an attached thread.");
+        return (Il2CppSystem.Object)owner;
+    }
+
+    private static void RequireValue(Il2CppObjectBase value)
+    {
+        if (IL2CPP.il2cpp_object_get_class(value.Pointer) != NativeStyleEnumRegistration.RequirePublishedClass())
+            throw new ArgumentException("Enum animation state requires the published native ValuesEnum identity.", nameof(value));
+    }
+
+    private static class Store
+    {
+        static Store() { }
+
+        internal static readonly object Sync = new();
+        // Both key and value are native objects. Ephemerons retain state across wrapper aliases
+        // without making a value-to-owner reference cycle keep the owner alive.
+        internal static readonly Il2CppSystem.Runtime.CompilerServices.ConditionalWeakTable<
+            Il2CppSystem.Object, Il2CppReferenceArray<Il2CppSystem.Object>> Values = new();
+    }
+}
