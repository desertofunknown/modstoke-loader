+                ("m_AnimatorBindingsVersion", 0, typeof(uint)), ("constant", 8, typeof(IntPtr)),
+                ("input", 16, typeof(IntPtr)), ("output", 24, typeof(IntPtr)),
+                ("workspace", 32, typeof(IntPtr)), ("inputStreamAccessor", 40, typeof(IntPtr)),
+                ("animationHandleBinder", 48, typeof(IntPtr)));
