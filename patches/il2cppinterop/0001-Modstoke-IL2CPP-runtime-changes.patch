+        InvokeBulk(BulkOperation.ReadSceneInts, stream, handles, buffer, count, false, exceptionFactory);
+
+    public static void ReadSceneFloats(IntPtr stream, IntPtr handles, IntPtr buffer, int count,
+        Func<Il2CppObjectBase, Exception> exceptionFactory) =>
+        InvokeBulk(BulkOperation.ReadSceneFloats, stream, handles, buffer, count, false, exceptionFactory);
+
+    public static void ReadStreamInts(IntPtr stream, IntPtr handles, IntPtr buffer, int count,
+        Func<Il2CppObjectBase, Exception> exceptionFactory) =>
+        InvokeBulk(BulkOperation.ReadStreamInts, stream, handles, buffer, count, false, exceptionFactory);
+
+    public static void ReadStreamFloats(IntPtr stream, IntPtr handles, IntPtr buffer, int count,
+        Func<Il2CppObjectBase, Exception> exceptionFactory) =>
+        InvokeBulk(BulkOperation.ReadStreamFloats, stream, handles, buffer, count, false, exceptionFactory);
+
+    public static void WriteStreamInts(IntPtr stream, IntPtr handles, IntPtr buffer, int count, bool useMask,
+        Func<Il2CppObjectBase, Exception> exceptionFactory) =>
+        InvokeBulk(BulkOperation.WriteStreamInts, stream, handles, buffer, count, useMask, exceptionFactory);
+
+    public static void WriteStreamFloats(IntPtr stream, IntPtr handles, IntPtr buffer, int count, bool useMask,
+        Func<Il2CppObjectBase, Exception> exceptionFactory) =>
+        InvokeBulk(BulkOperation.WriteStreamFloats, stream, handles, buffer, count, useMask, exceptionFactory);
+
+    private static void InvokeBulk(BulkOperation operation, IntPtr stream, IntPtr handles, IntPtr buffer,
+        int count, bool useMask, Func<Il2CppObjectBase, Exception> exceptionFactory)
+    {
+        ArgumentNullException.ThrowIfNull(exceptionFactory);
+        RequireAddress(stream);
+        if (count < 0) throw new ArgumentOutOfRangeException(nameof(count));
+        if (count != 0)
+        {
+            if (handles == IntPtr.Zero) throw new ArgumentNullException(nameof(handles));
+            if (buffer == IntPtr.Zero) throw new ArgumentNullException(nameof(buffer));
+        }
+        using var lease = new CallLease();
+        var call = GetBulkBinding(lease).Get(operation);
+        var args = stackalloc void*[5];
+        args[0] = stream.ToPointer();
+        args[1] = &handles;
+        args[2] = &buffer;
+        args[3] = &count;
+        args[4] = &useMask;
