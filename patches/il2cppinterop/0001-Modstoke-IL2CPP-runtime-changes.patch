+    static_assert(offsetof(Config, HandleFree) == 72);
+    static_assert(offsetof(Config, WriteBarrier) == 80);
+    static_assert(offsetof(Config, DefaultValue) == 88);
+    static_assert(offsetof(Config, ArrayElementClass) == 96);
+    static_assert(offsetof(Config, ParameterClass) == 104);
+    static_assert(sizeof(Entry) == 24);
+    static_assert(offsetof(Entry, method) == 0);
+    static_assert(offsetof(Entry, count) == 8);
+    static_assert(offsetof(Entry, names) == 16);
+    static_assert(sizeof(EntryWithDefaults) == 32);
+    static_assert(offsetof(EntryWithDefaults, defaults) == 24);
+    static_assert(sizeof(ParameterLayout) == 72);
+    static_assert(offsetof(ParameterLayout, attributes) == 0x10);
+    static_assert(offsetof(ParameterLayout, type) == 0x18);
+    static_assert(offsetof(ParameterLayout, defaultValue) == 0x20);
+    static_assert(offsetof(ParameterLayout, member) == 0x28);
+    static_assert(offsetof(ParameterLayout, name) == 0x30);
+    static_assert(offsetof(ParameterLayout, position) == 0x38);
+    static_assert(offsetof(ParameterLayout, marshalAs) == 0x40);
+    static_assert(sizeof(ArrayLayout) == 0x20);
+    static_assert(offsetof(ArrayLayout, length) == 0x18);
+    static_assert(sizeof(AsyncConfig) == 32);
