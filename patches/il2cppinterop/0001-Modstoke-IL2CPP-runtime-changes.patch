new file mode 100644
index 0000000..c2ecf24
--- /dev/null
+++ b/Il2CppInterop.Runtime/Injection/NativeJobScheduler.Deferred.cs
@@ -0,0 +1,42 @@
+using System;
+
+namespace Il2CppInterop.Runtime.Injection;
+
+public static unsafe partial class NativeJobScheduler
+{
+    /// <summary>Schedules indexed work using a native list count read after its dependency.</summary>
+    /// <remarks>
+    /// listData points to Unity's live native list header, not a copied count or a managed
+    /// NativeList wrapper. On the supported x64 player its Int32 length follows the data pointer.
+    /// The caller owns the header, optional native safety-handle storage and backing buffers;
+    /// all must remain valid until completion, including after a scheduling exception.
+    /// Count writers must be covered by dependency and leave a nonnegative count within
+    /// buffer capacity. Do not modify or resize them while this job can access them.
+    /// This API does not pin storage, patch deferred payload aliases or install collection safety.
+    /// Complete or dispose the returned job or an owned downstream job to release ownership.
+    /// </remarks>
+    public static NativeJob ScheduleParallelForDeferred<T>(NativeJobRegistration registration, in T payload,
+        IntPtr listData, int batchSize, NativeJob? dependency = null, IntPtr listSafetyHandle = default)
+        where T : struct =>
+        Submit(registration, in payload, dependency, DeferredSchedule(listData, batchSize, listSafetyHandle));
+
+    /// <summary>Schedules deferred-count work and exports its tracked Unity JobHandle.</summary>
+    /// <remarks>
+    /// Requires matching completion observers and the same caller-owned storage and dependency
+    /// obligations as ScheduleParallelForDeferred. A scheduling/export failure can retain Job.
+    /// </remarks>
+    public static THandle ScheduleParallelForDeferredWithHandle<T, THandle>(NativeJobRegistration registration,
+        in T payload, IntPtr listData, int batchSize, THandle dependency, IntPtr listSafetyHandle = default)
+        where T : struct where THandle : struct =>
+        SubmitWithHandle(registration, in payload, dependency, DeferredSchedule(listData, batchSize, listSafetyHandle));
+
+    private static NativeJobSchedule DeferredSchedule(IntPtr listData, int batchSize, IntPtr listSafetyHandle)
+    {
+        if (listData == IntPtr.Zero) throw new ArgumentNullException(nameof(listData));
+        if ((listData.ToInt64() & (IntPtr.Size - 1)) != 0)
+            throw new ArgumentException("The native list header must be pointer-aligned.", nameof(listData));
+        if (batchSize < 1) throw new ArgumentOutOfRangeException(nameof(batchSize));
+        return new NativeJobSchedule(NativeJobScheduleKind.ParallelForDeferred, 1,
+            batchSize: batchSize, additionalData: listData, safetyHandleData: listSafetyHandle);
+    }
+}
diff --git a/Il2CppInterop.Runtime/Injection/NativeJobScheduler.Dependencies.cs b/Il2CppInterop.Runtime/Injection/NativeJobScheduler.Dependencies.cs
new file mode 100644
index 0000000..079b473
--- /dev/null
+++ b/Il2CppInterop.Runtime/Injection/NativeJobScheduler.Dependencies.cs
@@ -0,0 +1,62 @@
+using System;
+using System.Threading;
+using Il2CppInterop.Runtime.Startup;
+
+namespace Il2CppInterop.Runtime.Injection;
+
+public static unsafe partial class NativeJobScheduler
+{
+    /// <summary>Creates one native fence for owned dependencies without waiting for them.</summary>
+    /// <remarks>
+    /// The returned owner can be supplied to Schedule or ScheduleParallelFor. Complete releases
+    /// the combined dependency graph and reports its producer failures. Dispose also completes
+    /// the graph but does not rethrow producer errors. Input owners remain valid for diagnostics.
+    /// </remarks>
+    public static NativeJob CombineDependencies(params NativeJob[] dependencies)
+    {
+        ArgumentNullException.ThrowIfNull(dependencies);
+        RequireOutsideCallback();
+        var snapshot = (NativeJob[])dependencies.Clone();
+        foreach (var dependency in snapshot) ArgumentNullException.ThrowIfNull(dependency);
+        // All multi-owner operations acquire newer owners first. A completion never locks upward.
+        Array.Sort(snapshot, static (left, right) => right.Order.CompareTo(left.Order));
+        var runtime = snapshot.Length == 0 ? Il2CppInteropRuntime.Instance : snapshot[0].Binding.Runtime;
+        runtime.RetainNativeJob();
+        NativeJob? job = null;
+        var acquired = 0;
+        try
+        {
+            var binding = NativeJobBindings.Get(runtime);
+            job = new NativeJob(binding, snapshot);
+            for (; acquired < snapshot.Length; acquired++) Monitor.Enter(snapshot[acquired].Gate);
+            var handles = new NativeJobHandle[snapshot.Length];
+            var count = 0;
+            NativeJob? previous = null;
+            foreach (var dependency in snapshot)
+            {
+                if (ReferenceEquals(previous, dependency)) continue;
+                previous = dependency;
+                var handle = dependency.GetDependency(binding);
+                if (handle.JobGroup != 0) handles[count++] = handle;
+            }
+            if (count == 1) job.Handle = handles[0];
+            else if (count > 1) binding.Combine(job, handles, count);
+            return job;
+        }
+        catch (Exception error)
+        {
+            if (job == null || !job.SubmissionStarted)
+            {
+                if (job == null) runtime.ReleaseNativeJob();
+                else job.MarkCompleted();
+                throw;
+            }
+            job.SubmissionException = error;
+            throw new NativeJobSchedulingException(job, error);
+        }
+        finally
+        {
+            while (acquired > 0) Monitor.Exit(snapshot[--acquired].Gate);
+        }
+    }
+}
diff --git a/Il2CppInterop.Runtime/Injection/NativeJobScheduler.Handles.cs b/Il2CppInterop.Runtime/Injection/NativeJobScheduler.Handles.cs
