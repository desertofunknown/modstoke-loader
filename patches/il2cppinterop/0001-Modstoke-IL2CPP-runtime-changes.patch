@@ -0,0 +1,129 @@
+using System;
+using System.Collections.Concurrent;
+using System.Reflection;
+using System.Reflection.Emit;
+using System.Runtime.CompilerServices;
+using System.Runtime.InteropServices;
+using Il2CppInterop.Runtime.InteropTypes;
+using Il2CppInterop.Runtime.Runtime;
+
+namespace Il2CppInterop.Runtime.Injection;
+
+// Shared signature and payload rules for reverse delegates and injected methods.
+internal sealed unsafe class NativeCallbackAbi
+{
+    private static readonly ConcurrentDictionary<Type, int> ValueSizes = new();
+    private readonly Type managedReturnType;
+
+    internal NativeCallbackAbi(MethodInfo method, bool hasThis)
+    {
+        managedReturnType = method.ReturnType;
+        var jobCallback = method.GetCustomAttribute<NativeJobCallbackMethodAttribute>(false);
+        UsesRawValueReferences = jobCallback != null;
+        AllowsNullJobRanges = jobCallback?.AllowsNullRanges == true;
+        IsNativeValueReturn = IsNativeValue(managedReturnType);
+        ReturnValueSize = IsNativeValueReturn ? GetValueSize(managedReturnType) : 0;
+        HasReturnBuffer = IsNativeValueReturn && !IsRegisterValueSize(ReturnValueSize);
+        // IL2CPP char is UTF-16; do not let delegate marshalling narrow it through ANSI char.
+        ReturnType = IsNativeValueReturn ? typeof(IntPtr) :
+            managedReturnType == typeof(char) ? typeof(ushort) : managedReturnType.NativeType();
+        ReceiverIndex = hasThis ? (HasReturnBuffer ? 1 : 0) : -1;
+        ArgumentOffset = (HasReturnBuffer ? 1 : 0) + (hasThis ? 1 : 0);
+        var parameters = method.GetParameters();
+        ParameterTypes = new Type[ArgumentOffset + parameters.Length + 1];
+        if (HasReturnBuffer) ParameterTypes[0] = typeof(IntPtr);
+        if (hasThis) ParameterTypes[ReceiverIndex] = typeof(IntPtr);
+        for (var index = 0; index < parameters.Length; index++)
+        {
+            var type = parameters[index].ParameterType;
+            if (IsNativeValue(type)) GetValueSize(type);
+            var nativeType = type == typeof(char) ? typeof(ushort) :
+                type.IsByRef && type.GetElementType() == typeof(char) ? typeof(ushort).MakeByRefType() : type.NativeType();
+            ParameterTypes[ArgumentOffset + index] = UsesRawValueReferences && type.IsByRef && type.GetElementType()!.IsValueType
+                ? typeof(IntPtr) : nativeType;
+        }
+        ParameterTypes[^1] = typeof(Il2CppMethodInfo*);
+    }
+
+    internal Type ReturnType { get; }
+    internal bool UsesRawValueReferences { get; }
+    internal bool AllowsNullJobRanges { get; }
+    internal Type[] ParameterTypes { get; }
+    internal int ReceiverIndex { get; }
+    internal int ArgumentOffset { get; }
+    internal bool HasReturnBuffer { get; }
+    internal bool IsNativeValueReturn { get; }
+    internal int ReturnValueSize { get; }
+
+    internal static bool IsNativeValue(Type type) => typeof(Il2CppSystem.ValueType).IsAssignableFrom(type);
+
+    internal static bool IsRegisterValueSize(int size) => size is 1 or 2 or 4 or 8;
+
+    internal static int GetValueSize(Type type) => ValueSizes.GetOrAdd(type, static valueType =>
+    {
+        if (!RuntimeInformation.IsOSPlatform(OSPlatform.Windows) ||
+            RuntimeInformation.ProcessArchitecture != Architecture.X64)
+            throw new PlatformNotSupportedException("By-value native callback proxies require the Windows x64 ABI.");
+        var nativeClass = Il2CppClassPointerStore.GetNativeClassPointer(valueType);
+        if (!IsNativeValue(valueType) || valueType.ContainsGenericParameters || nativeClass == IntPtr.Zero ||
+            !IL2CPP.il2cpp_class_is_valuetype(nativeClass) ||
+            IL2CPP.il2cpp_class_is_generic(nativeClass) && !IL2CPP.il2cpp_class_is_inflated(nativeClass))
+            throw new NotSupportedException("Native callback values require an exact constructed value class: " + valueType + ".");
+        uint alignment = 0;
+        var size = IL2CPP.il2cpp_class_value_size(nativeClass, ref alignment);
+        if (size <= 0) throw new NotSupportedException("The native callback value has no payload: " + valueType + ".");
+        // Resolve layout and constructor before a callback holds an unrooted native result.
+        RuntimeHelpers.RunClassConstructor(typeof(NativeValueReference<>).MakeGenericType(valueType).TypeHandle);
+        return size;
+    });
+
+    internal static bool TryEmitValueArgument(ILGenerator il, Type type, int nativeIndex)
+    {
+        if (!IsNativeValue(type)) return false;
+        // Win64 aggregates of 1/2/4/8 bytes are integer bits, not addresses.
+        il.Emit(IsRegisterValueSize(GetValueSize(type)) ? OpCodes.Ldarga : OpCodes.Ldarg, (short)nativeIndex);
+        il.Emit(OpCodes.Conv_I);
+        il.Emit(OpCodes.Ldc_I4_0);
+        il.Emit(OpCodes.Call, ValueMethod(type, nameof(NativeValueReference<Il2CppObjectBase>.Read)));
+        return true;
+    }
+
+    internal void EmitInitializeReturn(ILGenerator il)
+    {
+        if (!HasReturnBuffer) return;
+        il.Emit(OpCodes.Ldarg_0);
+        il.Emit(OpCodes.Call, typeof(NativeCallbackAbi).GetMethod(nameof(RequireReturnBuffer),
+            BindingFlags.Static | BindingFlags.NonPublic)!);
+    }
+
+    internal void EmitClearReturn(ILGenerator il)
+    {
+        if (!HasReturnBuffer) return;
+        var done = il.DefineLabel();
+        il.Emit(OpCodes.Ldarg_0);
+        il.Emit(OpCodes.Brfalse, done);
+        il.Emit(OpCodes.Ldarg_0);
+        il.Emit(OpCodes.Ldc_I4_0);
+        il.Emit(OpCodes.Ldc_I4, ReturnValueSize);
+        il.Emit(OpCodes.Initblk);
+        il.MarkLabel(done);
+    }
+
+    internal void EmitValueReturn(ILGenerator il, LocalBuilder managedResult, LocalBuilder? nativeReturn)
+    {
+        if (!IsNativeValueReturn) throw new InvalidOperationException("The callback does not return a native value proxy.");
+        if (HasReturnBuffer) il.Emit(OpCodes.Ldarg_0);
+        else il.Emit(OpCodes.Ldloca, nativeReturn ?? throw new ArgumentNullException(nameof(nativeReturn)));
+        il.Emit(OpCodes.Conv_I);
+        il.Emit(OpCodes.Ldloc, managedResult);
+        il.Emit(OpCodes.Call, ValueMethod(managedReturnType, nameof(NativeValueReference<Il2CppObjectBase>.Write)));
+    }
+
+    private static MethodInfo ValueMethod(Type type, string name) => typeof(NativeValueReference<>)
+        .MakeGenericType(type).GetMethod(name, BindingFlags.Static | BindingFlags.NonPublic)!;
+
+    private static void RequireReturnBuffer(IntPtr address)
+    {
+        if (address == IntPtr.Zero) throw new ArgumentNullException(nameof(address), "The native callback return buffer is null.");
+    }
+}
