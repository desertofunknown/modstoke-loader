--- /dev/null
+++ b/Il2CppInterop.Runtime/Injection/ClassInjector.GenericMethods.cs
@@ -0,0 +1,59 @@
+// SPDX-License-Identifier: LGPL-3.0-only
+using System;
+using System.Reflection;
+using System.Runtime.InteropServices;
+using Il2CppInterop.Runtime.Runtime;
+using Il2CppInterop.Runtime.Runtime.VersionSpecific.Class;
+using Il2CppInterop.Runtime.Runtime.VersionSpecific.MethodInfo;
+using Il2CppInterop.Runtime.Runtime.VersionSpecific.Type;
+
+namespace Il2CppInterop.Runtime.Injection;
+
+public static unsafe partial class ClassInjector
+{
+    internal static Il2CppMethodInfo* ConvertInflatedMethodInfo(MethodInfo method, INativeClassStruct declaringClass,
+        Il2CppGenericMethod genericMethod)
+    {
+        if (genericMethod.methodDefinition == null)
+            throw new ArgumentException("The native generic method has no definition.", nameof(genericMethod));
+        var instantiation = genericMethod.context.method_inst;
+        if (instantiation == null)
+            throw new ArgumentException("The native generic method has no method instantiation.", nameof(genericMethod));
+        var pointer = ConvertMethodInfoCore(method, declaringClass, null, instantiation);
+        var converted = (INativeMethodInfoGenericContext)(UnityVersionHandler.Wrap(pointer)
+            ?? throw new NullReferenceException("Inflated native method metadata is null."));
+
+        // Native callers may pass a stack record. Keep our copy for the cached method's lifetime;
+        // its interned instantiations and type descriptors remain borrowed native metadata.
+        var context = (Il2CppGenericMethod*)Marshal.AllocHGlobal(sizeof(Il2CppGenericMethod));
+        *context = genericMethod;
+        converted.GenericMethod = context;
+        return pointer;
+    }
+
+    private static Il2CppTypeStruct* GetMethodArgumentType(Type definitionType, Il2CppGenericInst* instantiation)
+    {
+        var byRef = definitionType.IsByRef;
+        if (byRef) definitionType = definitionType.GetElementType()!;
+        if (!definitionType.IsGenericParameter || definitionType.DeclaringMethod == null)
+            return null;
+
+        // CLR proxies can erase rank; use the argument's position in the native instantiation.
+        var argument = UnityVersionHandler.Wrap(instantiation->type_argv[definitionType.GenericParameterPosition])
+            ?? throw new NullReferenceException("Native generic method argument metadata is null.");
+        // Argument descriptors and their payloads must outlive the cached native instantiation.
+        return byRef ? CreateByRefType(argument) : argument.TypePointer;
+    }
+
+    private static Il2CppTypeStruct* CreateByRefType(INativeTypeStruct elementType)
+    {
+        var type = UnityVersionHandler.NewType();
+        type.Data = elementType.Data;
+        type.Attrs = elementType.Attrs;
+        type.Type = elementType.Type;
+        type.ValueType = elementType.ValueType;
+        type.ByRef = true;
+        type.Pinned = elementType.Pinned;
+        return type.TypePointer;
+    }
+}
