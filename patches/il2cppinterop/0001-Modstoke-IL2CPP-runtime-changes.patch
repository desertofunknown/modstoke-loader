+    Config configuration{};
+    EnumerationConfig enumerationConfiguration{};
+    OwnedAssemblyConfig assemblyConfiguration{};
+    std::mutex configurationMutex;
+    std::atomic<bool> configured{false};
+    std::atomic<bool> enumerationConfigured{false};
+    std::atomic<bool> assemblyConfigured{false};
