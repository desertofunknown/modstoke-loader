+                {
+                    BulkOperation.ReadSceneInts => "AnimationSceneHandleUtility::ReadSceneIntsInternal",
+                    BulkOperation.ReadSceneFloats => "AnimationSceneHandleUtility::ReadSceneFloatsInternal",
+                    BulkOperation.ReadStreamInts => "AnimationStreamHandleUtility::ReadStreamIntsInternal",
+                    BulkOperation.ReadStreamFloats => "AnimationStreamHandleUtility::ReadStreamFloatsInternal",
+                    BulkOperation.WriteStreamInts => "AnimationStreamHandleUtility::WriteStreamIntsInternal",
+                    BulkOperation.WriteStreamFloats => "AnimationStreamHandleUtility::WriteStreamFloatsInternal",
+                    _ => throw new ArgumentOutOfRangeException(nameof(operation))
