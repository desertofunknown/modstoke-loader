+            0x06000002 or 0x06000004 => 8156,
+            0x06000005 => 8158,
+            0x06000006 => 8160,
+            0x06000007 => 8162,
+            0x06000008 => 8164,
+            0x06000009 => 8166,
+            0x0600001C or 0x06000028 or 0x0600002C => 8168,
+            0x06000029 => 8170,
+            0x0600002D => 8172,
+            0x0600002A => 8174,
+            0x06000026 => 8176,
+            0x0600000F => 8178,
+            _ => throw new ArgumentOutOfRangeException(nameof(sourceMethodToken))
