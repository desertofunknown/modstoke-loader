index 0000000..2493cc3
--- /dev/null
+++ b/Il2CppInterop.Runtime/Injection/NativeJob.cs
@@ -0,0 +1,158 @@
+using System;
+using System.Threading;
+
+namespace Il2CppInterop.Runtime.Injection;
+
+/// <summary>Owns the runtime lifetime of a submitted native job until explicit completion.</summary>
+/// <remarks>
+/// Dispose completes the job; it does not cancel it or free Unity's reflection record.
+/// There is no finalizer that calls Unity. Losing an uncompleted owner prevents runtime
+/// disposal rather than tearing down hooks beneath live callbacks. Pointer targets in
+/// the submitted payload must remain valid until Complete succeeds. Completing a job
+/// also releases its owned dependencies after their native work has finished.
+/// </remarks>
+public sealed partial class NativeJob : IDisposable
+{
+    internal object Gate { get; } = new();
+    internal NativeJobBindings Binding { get; }
+    internal NativeJobHandle Handle;
+    internal bool SubmissionStarted;
+    internal NativeJobExecution? Execution { get; }
+    private bool completed;
+
+    internal NativeJob(NativeJobBindings binding, NativeJobRegistration registration, NativeJob? dependency)
+        : this(binding, dependency == null ? Array.Empty<NativeJob>() : new[] { dependency })
+    {
+        Registration = registration;
+        Execution = NativeJobExecution.Create(registration);
+    }
+
+    /// <summary>The producer registration, or null for a dependency-only combination.</summary>
+    public NativeJobRegistration? Registration { get; }
+
+    /// <summary>A producer exception from this submission or its owned dependency graph.</summary>
+    /// <remarks>Checks this job first, then dependencies; not a chronological ordering across jobs.</remarks>
+    public Exception? FirstException => FindFailure()?.FirstException;
+
+    /// <summary>Reports a recorded graph failure without waiting for completion or releasing ownership.</summary>
+    public void ThrowIfFailed() => FindFailure()?.ThrowIfFailed();
+
+    /// <summary>A submission error, if native scheduling did not return successfully.</summary>
+    public Exception? SubmissionException { get; internal set; }
+
+    /// <summary>Queries native completion and flushes pending batches; does not release ownership.</summary>
+    public bool IsCompleted
+    {
+        get
+        {
+            NativeJobScheduler.RequireOutsideCallback();
+            lock (Gate)
+            {
+                if (completed) return true;
+                RequireKnownHandle();
+                if (Handle.JobGroup != 0 && !Binding.IsCompleted(ref Handle)) return false;
+                // A default or failed-submission handle alone cannot prove its dependencies finished.
+                if (Handle.JobGroup != 0 && SubmissionException == null) return true;
+                foreach (var dependency in CollectDependencies())
+                    lock (dependency.Gate)
+                    {
+                        if (dependency.completed) continue;
+                        dependency.RequireKnownHandle();
+                        if (dependency.Handle.JobGroup != 0 && !Binding.IsCompleted(ref dependency.Handle)) return false;
+                    }
+                return true;
+            }
+        }
+    }
+
+    /// <summary>Waits, releases dependency ownership, then reports a producer exception.</summary>
+    public void Complete() => WaitForCompletion()?.ThrowIfFailed();
+
+    internal NativeJobExecution? WaitForCompletion() => FinishCompletion(false);
+
+    internal NativeJobExecution? ObserveNativeCompletion() => FinishCompletion(true);
+
+    private NativeJobExecution? FinishCompletion(bool nativeCompletionObserved)
+    {
+        NativeJobScheduler.RequireOutsideCallback();
+        lock (Gate)
+        {
+            if (completed) return FindFailure();
+            if (!nativeCompletionObserved) RequireKnownHandle();
+            var graph = CollectDependencies();
+            var coversDependencies = nativeCompletionObserved || Handle.JobGroup != 0 && SubmissionException == null;
+            if (!nativeCompletionObserved && Handle.JobGroup != 0) Binding.Complete(Handle);
+            // Every dependency is older than this owner; completion only removes edges. Hold
+            // only this lock and one older lock, never the runtime gate, across native waits.
+            foreach (var dependency in graph)
+                lock (dependency.Gate)
+                {
+                    if (dependency.completed) continue;
+                    if (!coversDependencies)
+                    {
+                        dependency.RequireKnownHandle();
+                        if (dependency.Handle.JobGroup != 0) Binding.Complete(dependency.Handle);
+                    }
+                    dependency.MarkCompleted();
+                }
+            MarkCompleted();
+            return completionFailure;
+        }
+    }
+
+    /// <summary>Waits and releases ownership without rethrowing producer exceptions.</summary>
+    /// <remarks>Use Complete or ThrowIfFailed for producer errors. Native completion errors still propagate.</remarks>
+    public void Dispose() { WaitForCompletion(); }
+
+    internal NativeJobHandle GetDependency(NativeJobBindings binding)
+    {
+        if (!ReferenceEquals(Binding, binding))
+            throw new ArgumentException("The dependency belongs to a different native job runtime.");
+        if (SubmissionException != null)
+            throw new InvalidOperationException("A failed submission cannot be used as a dependency.", SubmissionException);
+        return completed ? default : Handle;
+    }
+
+    private void RequireKnownHandle()
+    {
+        if (SubmissionException != null && Handle.JobGroup == 0)
+            throw new InvalidOperationException(
+                "Scheduling failed without a usable completion handle. Native ownership is unresolved; " +
+                "runtime teardown is blocked for this process. Restart the game before retrying.", SubmissionException);
+    }
+
+    // Used before publication or while holding Gate. Never release on an unsuccessful native wait.
+    internal void MarkCompleted()
+    {
+        if (completed) return;
+        completionFailure = CaptureCompletedFailure();
+        Handle = default;
+        Execution?.Release();
+        Binding.Runtime.ReleaseNativeJob();
+        Volatile.Write(ref completed, true);
+        Volatile.Write(ref dependencies, Array.Empty<NativeJob>());
+        NativeJobHandles.OwnerCompleted(this);
+    }
+}
+
+/// <summary>Preserves access to a job whose native submission or handle export failed.</summary>
+/// <remarks>
+/// A native scheduling exception is not proof that no work was queued. If Unity supplied
+/// a valid handle, Job.Complete can recover ownership. Without one, the runtime lease
+/// remains retained for the process lifetime. No native allocation is freed speculatively.
+/// </remarks>
+public sealed class NativeJobSchedulingException : Exception
+{
+    public NativeJob Job { get; }
+
+    internal NativeJobSchedulingException(NativeJob job, Exception error)
+        : this(job, error, "Native job submission failed; inspect Job before releasing any payload-owned resources.")
+    {
+    }
+
+    internal NativeJobSchedulingException(NativeJob job, Exception error, string message)
+        : base(message, error)
+    {
+        Job = job;
+    }
+}
