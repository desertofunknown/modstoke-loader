new file mode 100644
index 0000000..aa607b1
--- /dev/null
+++ b/Il2CppInterop.Runtime/Runtime/NativeValueReturn.cs
@@ -0,0 +1,50 @@
+using System;
+using System.Threading;
+using Il2CppInterop.Runtime.InteropTypes;
+
+namespace Il2CppInterop.Runtime.Runtime;
+
+// Older reflection invokers return a box, whose payload must stay fixed during calli.
+internal sealed class NativeValueReturn<T> : IDisposable where T : Il2CppObjectBase
+{
+    private readonly T value;
+    private IntPtr handle;
+
+    internal NativeValueReturn()
+    {
+        value = NativeValueReference<T>.CreateDefault();
+        try
+        {
+            handle = IL2CPP.il2cpp_gchandle_new(value.Pointer, true);
+            if (handle == IntPtr.Zero)
+                throw new InvalidOperationException("The native invoker return value could not be pinned.");
+            ObjectPointer = IL2CPP.il2cpp_gchandle_get_target(handle);
+            if (ObjectPointer == IntPtr.Zero)
+                throw new InvalidOperationException("The native invoker return value pin has no target.");
+            Address = IL2CPP.il2cpp_object_unbox(ObjectPointer);
+            if (Address == IntPtr.Zero)
+                throw new InvalidOperationException("The native invoker return value has no payload.");
+        }
+        catch
+        {
+            Dispose();
+            throw;
+        }
+    }
+
+    internal IntPtr Address { get; }
+    internal IntPtr ObjectPointer { get; }
+
+    public void Dispose()
+    {
+        var pinnedHandle = Interlocked.Exchange(ref handle, IntPtr.Zero);
+        try
+        {
+            if (pinnedHandle != IntPtr.Zero) IL2CPP.il2cpp_gchandle_free(pinnedHandle);
+        }
+        finally
+        {
+            GC.KeepAlive(value);
+        }
+    }
+}
