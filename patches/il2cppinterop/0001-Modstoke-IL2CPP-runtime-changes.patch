+using System;
+using Il2CppInterop.Runtime.InteropTypes;
+
+namespace Il2CppInterop.Runtime.Injection;
+
+public static unsafe partial class NativeArrayMemory
+{
+    /// <summary>Boxes a NativeArray or NativeArray.ReadOnly view using a value proxy's native element size.</summary>
+    /// <remarks>
+    /// TElement must be the container's exact concrete, closed Il2CppSystem.ValueType-derived proxy
+    /// with an IntPtr constructor. Its CLR object layout is not used. Without resize, element sizes
+    /// must match; with resize, the source byte length must divide exactly into native elements.
+    /// Only the descriptor is copied. The wrapper roots its native box, not the buffer; the caller
+    /// retains storage ownership and synchronization and must keep the buffer alive through all
+    /// view and job uses. This operation does not allocate, copy or free buffer storage.
+    /// </remarks>
+    public static TContainer ReinterpretToArrayView<TElement, TContainer>(IntPtr buffer, int sourceLength,
+        int sourceElementSize, int allocator, bool readOnly, bool resize)
+        where TElement : Il2CppObjectBase where TContainer : Il2CppObjectBase
+    {
+        using var lease = new CallLease();
+        return NativeJobContainerCodec<TContainer>.DecodeProxyArrayView<TElement>(buffer, sourceLength,
+            sourceElementSize, allocator, readOnly, resize);
+    }
+
+    /// <summary>Reads an exact value-proxy NativeArray or NativeArray.ReadOnly descriptor and native element size.</summary>
+    /// <remarks>
+    /// The returned buffer is borrowed and is not kept alive by the source wrapper or this call.
+    /// The caller retains storage ownership and synchronization. ReadOnly views report allocator 1;
+    /// mutable views preserve their descriptor's allocator.
+    /// </remarks>
+    public static (IntPtr Buffer, int Length, int Allocator, int ElementSize) ReadNativeArrayView<TElement, TContainer>(
+        TContainer source, bool readOnly) where TElement : Il2CppObjectBase where TContainer : Il2CppObjectBase
+    {
+        ArgumentNullException.ThrowIfNull(source);
+        using var lease = new CallLease();
+        var (descriptor, elementSize) = NativeJobContainerCodec<TContainer>.EncodeProxyArrayView<TElement>(source, readOnly);
+        return (descriptor.Buffer, descriptor.Value0, readOnly ? 1 : descriptor.Value1, elementSize);
+    }
+}
