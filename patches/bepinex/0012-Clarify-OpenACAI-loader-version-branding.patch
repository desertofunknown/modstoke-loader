index 84c5dc8..178bd35 100644
--- a/BepInEx.Preloader.Core/Logging/ChainloaderLogHelper.cs
+++ b/BepInEx.Preloader.Core/Logging/ChainloaderLogHelper.cs
@@ -38,7 +38,8 @@ public static class ChainloaderLogHelper
         var bepinVersion = Paths.BepInExVersion;
         var consoleTitle = OpenACAIBranding.ConsoleTitle;
         log.Log(LogLevel.Message, $"{consoleTitle} ({File.GetLastWriteTime(Paths.ExecutablePath)})");
-        log.Log(LogLevel.Message, $"BepInEx IL2CPP runtime {OpenACAIBranding.BepInExRuntimeVersion} with OpenACAI RedLoader compatibility");
