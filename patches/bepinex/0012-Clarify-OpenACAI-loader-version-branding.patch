Subject: [PATCH 12/13] Clarify OpenACAI loader version branding

---
 BepInEx.Core/OpenACAIBranding.cs                 | 12 ++++++++++--
 .../Logging/ChainloaderLogHelper.cs              |  3 ++-
 OPENACAI_FORK_NOTES.md                           | 16 ++++++++++++++--
 3 files changed, 26 insertions(+), 5 deletions(-)

diff --git a/BepInEx.Core/OpenACAIBranding.cs b/BepInEx.Core/OpenACAIBranding.cs
index 675c655..641e44e 100644
--- a/BepInEx.Core/OpenACAIBranding.cs
+++ b/BepInEx.Core/OpenACAIBranding.cs
@@ -7,6 +7,7 @@ namespace BepInEx;
 public static class OpenACAIBranding
 {
     public const string LoaderName = "OpenACAI Loader";
+    public const string DevelopmentLoaderVersion = "development";
 
     private static readonly Regex ManifestVersionPattern =
         new Regex("\"version\"\\s*:\\s*\"(?<version>[^\"]+)\"", RegexOptions.Compiled);
@@ -20,11 +21,18 @@ public static class OpenACAIBranding
                 return version;
 
             version = TryReadInstalledManifestVersion();
-            return string.IsNullOrEmpty(version) ? BepInExRuntimeVersion : version;
+            return string.IsNullOrEmpty(version) ? DevelopmentLoaderVersion : version;
         }
     }
 
-    public static string LoaderDisplayName => LoaderName + " v" + LoaderVersion;
+    public static string LoaderDisplayName
+    {
+        get
+        {
+            var version = LoaderVersion;
+            return version == DevelopmentLoaderVersion ? LoaderName + " (" + version + ")" : LoaderName + " v" + version;
+        }
+    }
 
     public static string ConsoleTitle => LoaderDisplayName + " - " + Paths.ProcessName;
 
