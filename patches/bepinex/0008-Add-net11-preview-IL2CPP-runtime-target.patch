From 835ab87bbb65453ed2d077b2880bbd088f17699f Mon Sep 17 00:00:00 2001
From: Alex Cooper <alextcooper@openacai.com>
Date: Fri, 5 Jun 2026 08:19:28 -0500
Subject: [PATCH 08/13] Add net11 preview IL2CPP runtime target

---
 BepInEx.Core/BepInEx.Core.csproj                            | 2 +-
 BepInEx.Preloader.Core/BepInEx.Preloader.Core.csproj        | 2 +-
 .../Unity/BepInEx.Unity.Common/BepInEx.Unity.Common.csproj  | 2 +-
 .../Unity/BepInEx.Unity.IL2CPP/BepInEx.Unity.IL2CPP.csproj  | 5 ++---
 global.json                                                 | 6 ++++++
 5 files changed, 11 insertions(+), 6 deletions(-)
 create mode 100644 global.json

diff --git a/BepInEx.Core/BepInEx.Core.csproj b/BepInEx.Core/BepInEx.Core.csproj
index c2873d3..a07687d 100644
--- a/BepInEx.Core/BepInEx.Core.csproj
+++ b/BepInEx.Core/BepInEx.Core.csproj
@@ -1,7 +1,7 @@
 ﻿<Project Sdk="Microsoft.NET.Sdk">
     <PropertyGroup>
         <Description>BepInEx Core library</Description>
-        <TargetFrameworks>net35;netstandard2.0</TargetFrameworks>
+        <TargetFrameworks>net35;netstandard2.0;net11.0</TargetFrameworks>
         <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
         <!-- Force nuget assembly output on netstandard2.0 -->
         <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
diff --git a/BepInEx.Preloader.Core/BepInEx.Preloader.Core.csproj b/BepInEx.Preloader.Core/BepInEx.Preloader.Core.csproj
index 6002a99..b71f16a 100644
--- a/BepInEx.Preloader.Core/BepInEx.Preloader.Core.csproj
+++ b/BepInEx.Preloader.Core/BepInEx.Preloader.Core.csproj
@@ -1,7 +1,7 @@
 ﻿<Project Sdk="Microsoft.NET.Sdk">
     <PropertyGroup>
         <Description>Core classes and utilities for BepInEx Preloader</Description>
-        <TargetFrameworks>net35;netstandard2.0</TargetFrameworks>
+        <TargetFrameworks>net35;netstandard2.0;net11.0</TargetFrameworks>
     </PropertyGroup>
     <ItemGroup>
         <ProjectReference Include="..\BepInEx.Core\BepInEx.Core.csproj"/>
diff --git a/Runtimes/Unity/BepInEx.Unity.Common/BepInEx.Unity.Common.csproj b/Runtimes/Unity/BepInEx.Unity.Common/BepInEx.Unity.Common.csproj
index 45c8640..9dd3c6f 100644
--- a/Runtimes/Unity/BepInEx.Unity.Common/BepInEx.Unity.Common.csproj
+++ b/Runtimes/Unity/BepInEx.Unity.Common/BepInEx.Unity.Common.csproj
@@ -2,7 +2,7 @@
 
     <PropertyGroup>
         <Description>BepInEx common code for Unity games</Description>
-        <TargetFrameworks>net35;netstandard2.0</TargetFrameworks>
+        <TargetFrameworks>net35;netstandard2.0;net11.0</TargetFrameworks>
     </PropertyGroup>
 
     <ItemGroup>
diff --git a/Runtimes/Unity/BepInEx.Unity.IL2CPP/BepInEx.Unity.IL2CPP.csproj b/Runtimes/Unity/BepInEx.Unity.IL2CPP/BepInEx.Unity.IL2CPP.csproj
index dbd05d0..33095d7 100644
--- a/Runtimes/Unity/BepInEx.Unity.IL2CPP/BepInEx.Unity.IL2CPP.csproj
+++ b/Runtimes/Unity/BepInEx.Unity.IL2CPP/BepInEx.Unity.IL2CPP.csproj
@@ -1,7 +1,7 @@
 <Project Sdk="Microsoft.NET.Sdk">
     <PropertyGroup>
         <Description>BepInEx support library for Il2Cpp games</Description>
-        <TargetFramework>net10.0</TargetFramework>
+        <TargetFramework>net11.0</TargetFramework>
         <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
         <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
         <OutputPath>$(BuildDir)/Unity.IL2CPP</OutputPath>
@@ -19,8 +19,7 @@
         <PackageReference Include="Il2CppInterop.HarmonySupport" Version="1.5.2-ci.1063"/>
         <PackageReference Include="Il2CppInterop.ReferenceLibs" Version="1.0.0" IncludeAssets="compile" PrivateAssets="all"/>
         <PackageReference Include="Il2CppInterop.Runtime" Version="1.5.2-ci.1063"/>
-        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" PrivateAssets="all"/>
-        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" PrivateAssets="all"/>
+        <PackageReference Include="Microsoft.Extensions.Logging" Version="11.0.0-preview.4.26230.115" PrivateAssets="all"/>
         <PackageReference Include="MonoMod.RuntimeDetour" Version="22.7.31.1"/>
         <PackageReference Include="Samboy063.Cpp2IL.Core" Version="2022.1.0-development.1452"/>
     </ItemGroup>
diff --git a/global.json b/global.json
new file mode 100644
index 0000000..d45b452
--- /dev/null
+++ b/global.json
@@ -0,0 +1,6 @@
+{
+  "sdk": {
+    "version": "11.0.100-preview.4.26230.115",
+    "rollForward": "latestFeature"
+  }
+}
-- 
