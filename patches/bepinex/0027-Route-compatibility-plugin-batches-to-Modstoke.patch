+    // Bind only when legacy batch loading is requested; discovery does not start the owned runtime.
+    private static readonly Lazy<LoadCompatibilityPluginBatch> CompatibilityPluginBatch = new(() =>
+    {
+        var owner = Assembly.Load("OpenACAI.Endnight.Loader.Preloader")
+                            .GetType("OpenACAI.Endnight.Loader.Preloader.OpenACAICompatibilityPluginBatch", true);
+        var method = owner.GetMethod("Load", BindingFlags.Static | BindingFlags.NonPublic, null,
+                                     new[]
+                                     {
+                                         typeof(IList<PluginInfo>), typeof(Dictionary<string, PluginInfo>),
+                                         typeof(List<string>), typeof(Func<PluginInfo, Assembly, object>),
+                                         typeof(Action<PluginInfo>)
+                                     }, null)
+                     ?? throw new MissingMethodException(owner.FullName, "Load");
+        return (LoadCompatibilityPluginBatch)method.CreateDelegate(typeof(LoadCompatibilityPluginBatch));
+    });
 
