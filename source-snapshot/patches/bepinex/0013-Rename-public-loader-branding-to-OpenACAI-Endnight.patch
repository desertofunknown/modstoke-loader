--- a/BepInEx.Preloader.Core/Logging/ChainloaderLogHelper.cs
+++ b/BepInEx.Preloader.Core/Logging/ChainloaderLogHelper.cs
@@ -39,7 +39,7 @@ public static class ChainloaderLogHelper
         var consoleTitle = OpenACAIBranding.ConsoleTitle;
         log.Log(LogLevel.Message, $"{consoleTitle} ({File.GetLastWriteTime(Paths.ExecutablePath)})");
         log.Log(LogLevel.Message,
-                $"BepInEx compatibility runtime {OpenACAIBranding.BepInExRuntimeVersion}; RedLoader/SonsSDK compatibility is handled by OpenACAI Loader");
+                $"BepInEx compatibility runtime {OpenACAIBranding.BepInExRuntimeVersion}; RedLoader/SonsSDK compatibility is handled by {OpenACAIBranding.LoaderName}");
 
         if (ConsoleManager.ConsoleActive)
             ConsoleManager.SetConsoleTitle(consoleTitle);
diff --git a/OPENACAI_FORK_NOTES.md b/OPENACAI_FORK_NOTES.md
index a6d0076..ca6faad 100644
--- a/OPENACAI_FORK_NOTES.md
+++ b/OPENACAI_FORK_NOTES.md
@@ -2,7 +2,7 @@
 
 Developer: Alex Cooper
 
-This fork is transitional source for OpenACAI Loader's Sons Of The Forest
+This fork is transitional source for OpenACAI Endnight Loader's Sons Of The Forest
 runtime work. BepInEx remains credited upstream code under its existing license;
 OpenACAI changes are intended to unblock the `.NET 10` LTS and `.NET 11`
 preview runtime lines while the long-term loader is rewritten into
@@ -14,7 +14,7 @@ OpenACAI-owned modules.
 - Preserve BepInEx plugin compatibility while OpenACAI rewrites the runtime,
   patch host, plugin inventory, resolver, interop repair, and state reporting
   into OpenACAI namespaces.
-- Keep RedLoader/SonsSdk support as compatibility behavior in OpenACAI Loader,
+- Keep RedLoader/SonsSdk support as compatibility behavior in OpenACAI Endnight Loader,
   not as an external sidecar framework.
 
 ## Harmony And MonoMod Baseline
@@ -39,7 +39,7 @@ version, so changing that assembly version to the public OpenACAI release line
 would make otherwise-compatible plugins look mismatched. The public loader
 version is exposed through `OpenACAIBranding` from `OPENACAI_LOADER_VERSION` or
 `BepInEx\plugins\OpenACAILoader\openacai-loader.manifest.json`; missing manifest
-data now displays as `OpenACAI Loader (development)` rather than reusing the
+data now displays as `OpenACAI Endnight Loader (development)` rather than reusing the
 BepInEx runtime version.
 
 ## API Replacements Used
