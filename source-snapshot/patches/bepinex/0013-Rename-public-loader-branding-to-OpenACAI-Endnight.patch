 4 files changed, 29 insertions(+), 7 deletions(-)

diff --git a/BepInEx.Core/OpenACAIBranding.cs b/BepInEx.Core/OpenACAIBranding.cs
index 641e44e..a6c65a4 100644
--- a/BepInEx.Core/OpenACAIBranding.cs
+++ b/BepInEx.Core/OpenACAIBranding.cs
@@ -4,14 +4,27 @@ using System.Text.RegularExpressions;
 
 namespace BepInEx;
 
+/// <summary>
+/// Provides the public OpenACAI product name and version strings shown by the loader.
+/// </summary>
 public static class OpenACAIBranding
 {
-    public const string LoaderName = "OpenACAI Loader";
+    /// <summary>
+    /// Human-facing product name for the Sons Of The Forest loader.
+    /// </summary>
+    public const string LoaderName = "OpenACAI Endnight Loader";
+
+    /// <summary>
+    /// Version label used when a release manifest is not available.
+    /// </summary>
     public const string DevelopmentLoaderVersion = "development";
 
     private static readonly Regex ManifestVersionPattern =
         new Regex("\"version\"\\s*:\\s*\"(?<version>[^\"]+)\"", RegexOptions.Compiled);
 
+    /// <summary>
+    /// Gets the OpenACAI loader version from environment or installed manifest metadata.
+    /// </summary>
     public static string LoaderVersion
     {
         get
@@ -25,6 +38,9 @@ public static class OpenACAIBranding
         }
     }
 
+    /// <summary>
+    /// Gets the product name with the OpenACAI loader version appended for logs and windows.
+    /// </summary>
     public static string LoaderDisplayName
     {
         get
@@ -34,8 +50,14 @@ public static class OpenACAIBranding
         }
     }
 
+    /// <summary>
+    /// Gets the Windows console title used by the preloader.
+    /// </summary>
     public static string ConsoleTitle => LoaderDisplayName + " - " + Paths.ProcessName;
 
+    /// <summary>
+    /// Gets the BepInEx compatibility runtime version preserved for plugin compatibility.
+    /// </summary>
     public static string BepInExRuntimeVersion
     {
         get
diff --git a/BepInEx.Preloader.Core/Logging/ChainloaderLogHelper.cs b/BepInEx.Preloader.Core/Logging/ChainloaderLogHelper.cs
