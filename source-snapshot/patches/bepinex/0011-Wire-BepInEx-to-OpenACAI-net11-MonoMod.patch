diff --git a/Directory.Build.props b/Directory.Build.props
index d1d53d9..70bf814 100644
--- a/Directory.Build.props
+++ b/Directory.Build.props
@@ -17,13 +17,6 @@
         <PackageOutputPath>$(BuildDir)/NuGet</PackageOutputPath>
         <PackageIcon>logo.png</PackageIcon>
     </PropertyGroup>
-    <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0'">
-        <!-- MonoMod 25.x supports net10.0 today. OpenACAI's net11 branch is an
-             intentional preview experiment, so this disables MonoMod's runtime
-             support guard only for that preview target. -->
-        <MonoMod_CheckTargetRuntime>false</MonoMod_CheckTargetRuntime>
-        <MonoMod_ReallySkipCheckTargetRuntime>true</MonoMod_ReallySkipCheckTargetRuntime>
-    </PropertyGroup>
     <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
         <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
     </PropertyGroup>
diff --git a/Directory.Build.targets b/Directory.Build.targets
index 31ea814..058246e 100644
--- a/Directory.Build.targets
+++ b/Directory.Build.targets
@@ -1,9 +1 @@
-<Project>
