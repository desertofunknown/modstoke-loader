+++ b/BepInEx.Core/BepInEx.Core.csproj
@@ -8,8 +8,10 @@
     </PropertyGroup>
     <ItemGroup>
         <PackageReference Include="HarmonyX" Version="2.16.1" />
+        <PackageReference Include="MonoMod.Core" Version="1.3.5-openacai-net11.3"/>
+        <PackageReference Include="MonoMod.RuntimeDetour" Version="25.3.5-openacai-net11.3"/>
         <PackageReference Include="SemanticVersioning" Version="2.0.2"/>
-        <PackageReference Include="MonoMod.Utils" Version="25.0.12"/>
+        <PackageReference Include="MonoMod.Utils" Version="25.0.13-openacai-net11.3"/>
     </ItemGroup>
     <ItemGroup>
         <Compile Remove="Contract\IPlugin.cs"/>
