<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <AssemblyName>BepInEx.Unity.Common</AssemblyName>
    <RootNamespace>BepInEx.Unity.Common</RootNamespace>
    <Version>6.0.0</Version>
    <AssemblyVersion>6.0.0.0</AssemblyVersion>
    <FileVersion>6.0.0.0</FileVersion>
    <Title>Modstoke Unity Metadata Compatibility</Title>
    <Product>Modstoke Loader by OpenACAI</Product>
    <Company>OpenACAI</Company>
    <Description>Unity player metadata compatibility for Modstoke Loader by OpenACAI.</Description>
    <Copyright>Copyright (C) 2022 BepInEx Team; Copyright (C) 2026 Alex Cooper</Copyright>
    <PackageLicenseExpression>LGPL-2.1-only</PackageLicenseExpression>
    <ImplicitUsings>false</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DebugType>embedded</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AssetRipper.Primitives" Version="3.1.3" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
