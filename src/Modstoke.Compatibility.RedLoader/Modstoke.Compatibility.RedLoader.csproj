<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\dependencies\Modstoke.Dependencies.props" />
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>RedLoader</AssemblyName>
    <RootNamespace>RedLoader</RootNamespace>
    <Version>0.8.6</Version>
    <AssemblyVersion>0.8.6.0</AssemblyVersion>
    <FileVersion>0.8.6.0</FileVersion>
    <InformationalVersion>0.8.6</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Title>Modstoke RedLoader Compatibility</Title>
    <Description>RedLoader compatibility contracts hosted by Modstoke Loader by OpenACAI.</Description>
    <Product>Modstoke Loader by OpenACAI</Product>
    <Company>OpenACAI</Company>
    <Authors>BepInEx, Toni Macaroni</Authors>
    <PackageLicenseExpression>LGPL-2.1-only</PackageLicenseExpression>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DebugType>embedded</DebugType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Keep inherited API documentation without requiring comments on every legacy member. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Configurations>Debug;Release</Configurations>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="HarmonyX" Version="2.16.1" PrivateAssets="all" />
    <PackageReference Include="Iced" Version="1.21.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="6.0.0" IncludeAssets="compile" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="6.0.1" IncludeAssets="compile" PrivateAssets="all" />
    <PackageReference Include="MonoMod.RuntimeDetour" Version="25.3.4" PrivateAssets="all" />
    <PackageReference Include="MonoMod.Utils" Version="25.0.12" PrivateAssets="all" />
    <PackageReference Include="Samboy063.Cpp2IL.Core" Version="2022.1.0-pre-release.19" PrivateAssets="all" />
    <PackageReference Include="SemanticVersioning" Version="3.0.0" PrivateAssets="all" />
    <PackageReference Include="Samboy063.Tomlet" Version="5.4.0" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Alt.Json">
      <HintPath>$(ModstokeDependencyRoot)\managed\Alt.Json.dll</HintPath>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(RedFrameworkReferenceRoot)\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="mcs">
      <HintPath>$(RedCompatibilityLibraryRoot)\mcs.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RedFrameworkReferenceRoot)\UnityEngine.CoreModule-nstrip.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Common">
      <HintPath>$(RedCompatibilityLibraryRoot)\Il2CppInterop.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Generator">
      <HintPath>$(RedCompatibilityLibraryRoot)\Il2CppInterop.Generator.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.HarmonySupport">
      <HintPath>$(RedCompatibilityLibraryRoot)\Il2CppInterop.HarmonySupport.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(RedCompatibilityLibraryRoot)\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="RequireRedFrameworkReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(RedFrameworkReferenceRoot)\Il2Cppmscorlib.dll') Or !Exists('$(RedFrameworkReferenceRoot)\UnityEngine.CoreModule-nstrip.dll')"
           Text="Prepare the pinned compile-only references with dependencies/Prepare-RedFrameworkReferences.ps1 -RedCompatibilityLibraryRoot &quot;$(RedCompatibilityLibraryRoot)&quot;. Original dependency inputs and runtime libraries must not be replaced." />
  </Target>
</Project>
