<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\dependencies\Modstoke.Dependencies.props" />
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <AssemblyName>BepInEx.Preloader.Core</AssemblyName>
    <RootNamespace>BepInEx.Preloader.Core</RootNamespace>
    <Version>6.0.0</Version>
    <AssemblyVersion>6.0.0.0</AssemblyVersion>
    <FileVersion>6.0.0.0</FileVersion>
    <Title>Modstoke Preloader Compatibility</Title>
    <Product>Modstoke Loader by OpenACAI</Product>
    <Company>OpenACAI</Company>
    <Description>Legacy preloader contracts hosted by Modstoke Loader by OpenACAI.</Description>
    <Copyright>Copyright (C) 2022 BepInEx Team; Copyright (C) 2026 Alex Cooper</Copyright>
    <PackageLicenseExpression>LGPL-2.1-only</PackageLicenseExpression>
    <ImplicitUsings>false</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DebugType>embedded</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GameRoot Condition="'$(GameRoot)' == ''">$(MSBuildProjectDirectory)\..\..\..\..</GameRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Modstoke.Compatibility.BepInEx.Core\Modstoke.Compatibility.BepInEx.Core.csproj" Private="false" />
    <Reference Include="Mono.Cecil" HintPath="$(BepInExCoreRoot)\Mono.Cecil.dll" Private="false" />
    <PackageReference Include="SemanticVersioning" Version="2.0.2" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
