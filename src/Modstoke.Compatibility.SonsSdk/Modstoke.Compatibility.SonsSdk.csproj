    <Title>Modstoke Sons SDK Compatibility</Title>
    <Description>SonsSdk compatibility contracts hosted by Modstoke Loader by OpenACAI.</Description>
    <Product>Modstoke Loader by OpenACAI</Product>
    <Company>OpenACAI</Company>
    <Authors>BepInEx, Toni Macaroni</Authors>
    <PackageLicenseExpression>LGPL-2.1-only</PackageLicenseExpression>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DebugType>embedded</DebugType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Keep inherited API documentation without requiring comments on every legacy member. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

