<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\dependencies\Modstoke.Dependencies.props" />
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>Modstoke.Loader</AssemblyName>
    <Title>Modstoke Loader Core</Title>
    <Product>Modstoke Loader by OpenACAI</Product>
    <Company>OpenACAI</Company>
    <Description>Modstoke Loader core and Modstoke SDK by OpenACAI.</Description>
    <RootNamespace>Modstoke.Loader</RootNamespace>
    <ImplicitUsings>false</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <NoWarn>1701;1702</NoWarn>
    <GameRoot Condition="'$(GameRoot)' == ''">$(MSBuildProjectDirectory)\..\..\..\..</GameRoot>
    <GameInteropRoot Condition="'$(GameInteropRoot)' == ''">$(GameRoot)\BepInEx\interop</GameInteropRoot>
  </PropertyGroup>

  <Target Name="ValidateGameInteropReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(GameInteropRoot)\Il2Cppmscorlib.dll') Or !Exists('$(GameInteropRoot)\UnityEngine.UnityWebRequestAudioModule.dll')" Text="GameInteropRoot must contain the complete generated IL2CPP wrapper set. Launch the loader to generate BepInEx\interop, or set GameInteropRoot to an existing generated set. Unity base libraries cannot substitute for wrappers." />
  </Target>

