<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\dependencies\Modstoke.Dependencies.props" />
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <AssemblyName>BepInEx.Core</AssemblyName>
    <RootNamespace>BepInEx</RootNamespace>
    <Version>6.0.0</Version>
    <AssemblyVersion>6.0.0.0</AssemblyVersion>
    <FileVersion>6.0.0.0</FileVersion>
    <Title>Modstoke Core Compatibility</Title>
    <Product>Modstoke Loader by OpenACAI</Product>
    <Company>OpenACAI</Company>
    <Description>Legacy plugin, configuration and logging contracts hosted by Modstoke Loader by OpenACAI.</Description>
    <Copyright>Copyright (C) 2022 BepInEx Team; Copyright (C) 2026 Alex Cooper</Copyright>
    <PackageLicenseExpression>LGPL-2.1-only</PackageLicenseExpression>
    <ImplicitUsings>false</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Keep inherited API documentation without requiring comments on every legacy member. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <DebugType>embedded</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GameRoot Condition="'$(GameRoot)' == ''">$(MSBuildProjectDirectory)\..\..\..\..</GameRoot>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="0Harmony" HintPath="$(BepInExCoreRoot)\0Harmony.dll" Private="false" />
    <Reference Include="Mono.Cecil" HintPath="$(BepInExCoreRoot)\Mono.Cecil.dll" Private="false" />
    <Reference Include="MonoMod.Utils" HintPath="$(BepInExCoreRoot)\MonoMod.Utils.dll" Private="false" />
    <PackageReference Include="SemanticVersioning" Version="2.0.2" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
